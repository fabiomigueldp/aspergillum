{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "aspergillum:holy_water_droplet",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/holy_water"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.02
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [
          "variable.aspergillum_motion.direction_x",
          "variable.aspergillum_motion.direction_y",
          "variable.aspergillum_motion.direction_z"
        ]
      },
      "minecraft:particle_initial_speed": "variable.aspergillum_motion.speed",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.05 + math.random(0.0, 0.35)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -7.2, 0],
        "linear_drag_coefficient": 0.035
      },
      "minecraft:particle_motion_collision": {
        "enabled": true,
        "collision_drag": 0.35,
        "coefficient_of_restitution": 0.02,
        "collision_radius": 0.025,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.044 * variable.aspergillum_scale",
          "0.105 * variable.aspergillum_scale"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#D8F4FFFF",
            "0.72": "#8FD9F0F2",
            "1.0": "#D8F4FF00"
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
