{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "aspergillum:holy_water_droplet",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/holy_water"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.02
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [
          "variable.aspergillum_motion.direction_x",
          "variable.aspergillum_motion.direction_y",
          "variable.aspergillum_motion.direction_z"
        ]
      },
      "minecraft:particle_initial_speed": "variable.aspergillum_motion.speed",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.15 + math.random(0.0, 0.4)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -6.2, 0],
        "linear_drag_coefficient": 0.025
      },
      "minecraft:particle_motion_collision": {
        "enabled": true,
        "collision_drag": 0.35,
        "coefficient_of_restitution": 0.02,
        "collision_radius": 0.018,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.022 * variable.aspergillum_scale",
          "0.075 * variable.aspergillum_scale"
        ],
        "facing_camera_mode": "direction_y",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        },
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#E9FAFFFF",
            "0.55": "#A8E7F8F0",
            "0.86": "#62C8E7B8",
            "1.0": "#BEEFFC00"
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
