{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.aspergillum.action": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "blend_transition": 0.08,
          "blend_via_shortest_path": true,
          "transitions": [
            {
              "sprinkle": "q.is_cooldown_category('aspergillum_sprinkle', 'slot.weapon.mainhand') && q.cooldown_time_remaining('slot.weapon.mainhand') > 0.72"
            }
          ]
        },
        "sprinkle": {
          "animations": [
            {
              "sprinkle_first_person": "context.is_first_person == 1.0"
            },
            {
              "sprinkle_third_person": "context.is_first_person == 0.0"
            }
          ],
          "blend_transition": 0.08,
          "blend_via_shortest_path": true,
          "transitions": [
            {
              "recovery": "q.all_animations_finished"
            }
          ]
        },
        "recovery": {
          "blend_transition": 0.08,
          "blend_via_shortest_path": true,
          "transitions": [
            {
              "sprinkle": "q.is_cooldown_category('aspergillum_sprinkle', 'slot.weapon.mainhand') && q.cooldown_time_remaining('slot.weapon.mainhand') > 0.72"
            },
            {
              "idle": "q.cooldown_time_remaining('slot.weapon.mainhand') <= 0.0"
            }
          ]
        }
      }
    }
  }
}
