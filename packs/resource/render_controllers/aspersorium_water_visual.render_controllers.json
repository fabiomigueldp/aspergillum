{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.aspergillum.aspersorium_water_visual": {
      "geometry": "Geometry.default",
      "materials": [
        { "*": "Material.default" }
      ],
      "textures": [
        "Texture.default"
      ],
      "uv_anim": {
        "offset": [0, 0],
        "scale": [1, 1]
      },
      "part_visibility": [
        { "water_low": "query.property('aspergillum:water_visual_level') == 1" },
        { "water_mid": "query.property('aspergillum:water_visual_level') == 2" },
        { "water_high": "query.property('aspergillum:water_visual_level') == 3" },
        { "water_full": "query.property('aspergillum:water_visual_level') == 4" }
      ]
    }
  }
}
