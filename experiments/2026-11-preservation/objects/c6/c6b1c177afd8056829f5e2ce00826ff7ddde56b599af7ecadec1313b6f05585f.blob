import bpy,numpy as np,json
from scipy.sparse import coo_matrix
from scipy.sparse.csgraph import connected_components
from mathutils import Vector
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'V63-opposite-ankle-trial.blend',use_scripts=False);o=bpy.data.objects['Maria — túnica e mangas integradas'];p=np.array([v.co[:] for v in o.data.vertices]);edges=np.array([e.vertices[:] for e in o.data.edges]);seed=np.argmin(np.linalg.norm(p-np.array([-.226,-.206,2.0]),axis=1));out=[];last=None
for z in [2.11]:
 mask=p[:,2]<z;inds=np.where(mask)[0];idx=np.full(len(p),-1);idx[inds]=np.arange(len(inds));ee=edges[mask[edges].all(axis=1)];a=idx[ee];g=coo_matrix((np.ones(len(a)*2),(np.r_[a[:,0],a[:,1]],np.r_[a[:,1],a[:,0]])),shape=(len(inds),len(inds)));n,l=connected_components(g);sel=inds[l==l[idx[seed]]];bounds=[p[sel].min(axis=0).tolist(),p[sel].max(axis=0).tolist()];safe=len(sel)<5000 and bounds[0][2]>1.9
 out.append({'cut_z':float(z),'count':len(sel),'bounds':bounds,'isolated_from_body':safe})
 if safe:last=sel.copy()
json.dump(out,open(r+'V65-mask-connectivity-audit.json','w'),indent=2)

from mathutils.bvhtree import BVHTree
sel=last;w=np.zeros(len(p));t=np.clip((p[sel,2]-2.015)/.095,0,1);w[sel]=1-t*t*(3-2*t);q=p+w[:,None]*np.array([0,.08,-.10]);e0=np.linalg.norm(p[edges[:,0]]-p[edges[:,1]],axis=1);e1=np.linalg.norm(q[edges[:,0]]-q[edges[:,1]],axis=1);changed=(w[edges].max(axis=1)>0)&(e0>1e-9);ratio=e1[changed]/e0[changed];fs=[tuple(f.vertices) for f in o.data.polygons];bv=BVHTree.FromPolygons([Vector(v) for v in q],fs);pairs=[(a,b) for a,b in bv.overlap(bv) if a<b and not set(fs[a])&set(fs[b])];oldbv=BVHTree.FromPolygons([Vector(v) for v in p],fs);oldpairs=[(a,b) for a,b in oldbv.overlap(oldbv) if a<b and not set(fs[a])&set(fs[b])]
report={'mask_vertices':len(sel),'torso_and_upper_unchanged':True,'trial_delta_m':[0,.08,-.10],'edge_ratio_min_max':[float(ratio.min()),float(ratio.max())],'edge_ratio_p95':float(np.percentile(ratio,95)),'self_intersection_pairs_before':len(oldpairs),'after':len(pairs),'new_pairs':len(set(pairs)-set(oldpairs)),'saved_geometry':False}
json.dump(report,open(r+'V65-field-feasibility.json','w'),indent=2);print(report)
