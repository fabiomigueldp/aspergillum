import bpy,numpy as np,json
from pathlib import Path
R=Path(__file__).resolve().parents[1];bpy.ops.wm.open_mainfile(filepath=str(R.parents[1]/'paz-refinement/gui-test/checkpoint-V75-20261102/V75-tunic-lower-trial.blend'),use_scripts=False);o=bpy.data.objects['Maria — plano contínuo do manto'];o.hide_viewport=False;o.hide_set(False)
