bpy.context.view_layer.update();dg=bpy.context.evaluated_depsgraph_get();me=bpy.data.meshes.new_from_object(o.evaluated_get(dg),depsgraph=dg);me.transform(o.matrix_world);me.calc_loop_triangles();p=np.array([v.co[:] for v in me.vertices]);f=np.array([t.vertices[:] for t in me.loop_triangles]);n=np.array([v.normal[:] for v in me.vertices]);a=np.load(R/'evidence/seam-source-inspection.npz');s=np.load(R/'evidence/seam-partitions.npz');old=a['points'][160386:];np.savez_compressed(R/'evidence/mantle-hidden-source.npz',points=p,triangles=f,normals=n);src=set(map(tuple,np.sort(f,axis=1)));rest=s['rest_triangles']-160386;kept=set(map(tuple,np.sort(rest,axis=1)));missing=np.array(sorted(src-kept));boundary=s['rest_boundary_ids']-160386;np.savez_compressed(R/'evidence/mantle-cut-source-indices.npz',missing_triangles=missing,boundary_local_indices=boundary,boundary_combined_indices=s['rest_boundary_ids']);report={'controls':len(o.data.vertices),'evaluated_vertices':len(p),'combined_rest_vertices':len(old),'order_exact':bool(p.shape==old.shape and np.array_equal(p,old)),'max_error':float(abs(p-old).max()) if p.shape==old.shape else None,'evaluated_triangles':len(f),'retained_triangles':len(rest),'missing_triangles':len(missing),'extra_triangles':len(kept-src),'boundary_count':len(boundary),'boundary_min':int(boundary.min()),'boundary_max':int(boundary.max()),'boundary_controls':boundary[boundary<1600].tolist()};(R/'evidence/mantle-correspondence.json').write_text(json.dumps(report,ensure_ascii=False,indent=2));print(json.dumps(report,ensure_ascii=False))
