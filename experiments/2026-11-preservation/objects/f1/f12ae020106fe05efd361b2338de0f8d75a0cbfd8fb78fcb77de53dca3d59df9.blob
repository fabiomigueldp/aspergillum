"""Compare three saved trials without changing geometry or rerunning frozen gates."""
import sys,json,numpy as np
sys.dont_write_bytecode=True
from map_source_restore import O,BAND,SourceSampler
base=dict(np.load(BAND));p0=base['points'];f0=base['triangles'];a0=np.linalg.norm(np.cross(p0[f0[:,1]]-p0[f0[:,0]],p0[f0[:,2]]-p0[f0[:,0]]),axis=1)/2;src=SourceSampler();sp=src.d['points'];sf=src.d['triangles'];out={};initial=dict(np.load(O/'valley-source-mask-n8.npz'));common=np.unique(initial['v13_parent_face_indices'][(initial['v13_face_roles']==2)&(initial['face_parts']==0)])
for tag in ['valley-source-mask-n8','valley-source-corridor-n8','valley-source-c1-n8','valley-source-c1-n4']:
 d=dict(np.load(O/(tag+'.npz')));p=d['points'];f=d['triangles'];uv=d['source_uv'];mask=(d['v13_face_roles']==2)&(d['face_parts']==0);ids=np.flatnonzero(mask);t=p[f[ids]];raw=np.cross(t[:,1]-t[:,0],t[:,2]-t[:,0]);n=raw/np.linalg.norm(raw,axis=1)[:,None];q=uv[f[ids]].mean(1);ref,hi,_=src.sample(q,0);ht=sp[sf[hi]];hn=np.cross(ht[:,1]-ht[:,0],ht[:,2]-ht[:,0]);hn/=np.linalg.norm(hn,axis=1)[:,None];angle=np.rad2deg(np.arccos(np.clip((n*hn).sum(1),-1,1)));err=np.linalg.norm(t.mean(1)-ref,axis=1)*1000;parent=np.unique(d['v13_parent_face_indices'][d['v13_face_roles']==2]);weights=d['v13_source_projection_weight'];
 out[tag]={'faces':len(f),'vertices':len(p),'selected_v12_faces':len(parent),'selected_v12_area_mm2':float(a0[parent].sum()*1e6),'selected_v12_area_percent':float(100*a0[parent].sum()/a0.sum()),'weights_range':[float(weights.min()),float(weights.max())],'extrapolating_beyond_source_vertices':int(((weights<0)|(weights>1)).sum()),'restored_outer_face_centroids':len(ids),'candidate_normal_vs_same_uv_source_face_quantiles_deg':np.quantile(angle,[0,.5,.9,.99,1]).tolist(),'candidate_centroid_to_same_uv_source_quantiles_mm':np.quantile(err,[0,.5,.9,.99,1]).tolist(),'limits':'Normal comparison uses each candidate face normal and containing high-source triangle normal at its UV centroid, unweighted by face area. High-source normals vary within each candidate face. Not visual approval or global source-distance certificate.'}
 c=np.isin(d['v13_parent_face_indices'][ids],common);out[tag]['common_35_defect_faces']={'child_face_centroids':int(c.sum()),'normal_vs_source_quantiles_deg':np.quantile(angle[c],[0,.5,.9,.99,1]).tolist(),'centroid_to_source_quantiles_mm':np.quantile(err[c],[0,.5,.9,.99,1]).tolist()}
(O/'transition-field-comparison.json').write_text(json.dumps(out,indent=2));print(json.dumps(out,indent=2))
