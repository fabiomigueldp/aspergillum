import bpy
from pathlib import Path
p=Path(__file__).resolve().parent/'cuff-bounded-diagnostic.blend'
bpy.ops.wm.open_mainfile(filepath=str(p),use_scripts=False)
for o in bpy.data.objects:
 if o.type=='MESH': print(o.name,len(o.data.vertices),[(k.name,k.value) for k in o.data.shape_keys.key_blocks] if o.data.shape_keys else [])
