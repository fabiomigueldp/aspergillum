  "counterexamples": {
    "ambiguousDelivery": {
      "journalBefore": "{\"schemaVersion\":1,\"operation\":\"break\",\"phase\":\"effects-may-have-occurred\",\"address\":\"overworld:0,0,0\",\"occupancyGeneration\":\"abstract-generation-A\",\"rawRegistry\":\"{ \\\"schemaVersion\\\":1, \\\"entries\\\":{\\\"0,0,0\\\":{\\\"instanceId\\\":\\\"A\\\",\\\"unknown\\\":\\\"preserve\\\"}} }\",\"originalHand\":null,\"originalBlock\":\"air\"}",
      "journalAfter": "{\"schemaVersion\":1,\"operation\":\"break\",\"phase\":\"effects-may-have-occurred\",\"address\":\"overworld:0,0,0\",\"occupancyGeneration\":\"abstract-generation-A\",\"rawRegistry\":\"{ \\\"schemaVersion\\\":1, \\\"entries\\\":{\\\"0,0,0\\\":{\\\"instanceId\\\":\\\"A\\\",\\\"unknown\\\":\\\"preserve\\\"}} }\",\"originalHand\":null,\"originalBlock\":\"air\"}",
      "equalRecoveryJournal": true,
      "deliveredBefore": 0,
      "deliveredAfter": 1,
      "observation": "In the delivered history the item can be collected into an unavailable inventory; absence nearby is not proof of non-delivery.",
      "retryOutcomes": [
        1,
        2
      ]
    },
    "replayWithoutGeneration": {
      "validNewEvent": {
        "address": "0,0,0",
        "brokenPermutation": "occupied",
        "registry": "new-B"
      },
      "replayOldEvent": {
        "address": "0,0,0",
        "brokenPermutation": "occupied",
        "registry": "new-B"
      },
      "outcome": "Same handler inputs; current-registry identity cannot tell which occupation generated the event."
    },
    "downgrade": {
      "quarantinedJournal": "{\"schemaVersion\":1,\"operation\":\"break\",\"phase\":\"effects-may-have-occurred\",\"address\":\"overworld:0,0,0\",\"occupancyGeneration\":\"abstract-generation-A\",\"rawRegistry\":\"{ \\\"schemaVersion\\\":1, \\\"entries\\\":{\\\"0,0,0\\\":{\\\"instanceId\\\":\\\"A\\\",\\\"unknown\\\":\\\"preserve\\\"}} }\",\"originalHand\":null,\"originalBlock\":\"air\"}",
      "retainedRegistry": "{ \"schemaVersion\":1, \"entries\":{\"0,0,0\":{\"instanceId\":\"A\",\"unknown\":\"preserve\"}} }",
      "deliveriesBefore": 1,
      "deliveriesAfterOldHandler": 2,
      "outcome": "Old spawn-before-delete handler ignores journal and emits A again."
    },
    "reorderedCrash": {
      "programOrder": [
        "prepare-journal",
        "spawn-A"
      ],
      "persistedAfterCrash": {
        "journal": null,
        "registry": "{ \"schemaVersion\":1, \"entries\":{\"0,0,0\":{\"instanceId\":\"A\",\"unknown\":\"preserve\"}} }",
        "delivered": 1
      },
      "outcome": "If spawn survives but earlier journal write does not, quarantine evidence is absent. Readback before spawn does not establish flush ordering."
    },
    "legacyDoubleRollbackFailure": {
      "programOrder": [
        "write-snapshot",
        "remove-hand",
        "occupy throws-before",
        "restore-hand throws-before",
        "restore-block",
        "delete-snapshot"
      ],
      "final": {
        "hand": null,
        "registry": null,
        "block": "empty",
        "delivered": 0
      },
      "outcome": "Current defensive rollback can erase the only remaining item representation."
    }
  }
