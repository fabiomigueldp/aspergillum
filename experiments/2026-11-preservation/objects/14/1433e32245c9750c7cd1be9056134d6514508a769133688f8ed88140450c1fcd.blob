from pathlib import Path
import numpy as np,json
import os
os.environ.setdefault('MPLCONFIGDIR','/tmp/matplotlib-v9')
os.environ.setdefault('XDG_CACHE_HOME','/tmp/font-cache-v9')
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from PIL import Image,ImageDraw,ImageFont
R=Path(__file__).resolve().parents[1];B=R.parent
paths=[B/'body_interface_v8/anatomy_fit/baseline-welded.npz',B/'body_interface_v8/anatomy_fit/retained-anatomy.npz',R/'constrained_fit/intrinsic097-c30-iteration00.npz'];names=['Anatomia original reduzida','V8: compressão localizada','V9: forma local recuperada'];colors=['#3475aa','#b94343','#319671'];rows=[];coords=[]
for p in paths:
 d=np.load(p);tri=d['points'][d['triangles'][144]];a,b=tri[1]-tri[0],tri[2]-tri[0];u=a/np.linalg.norm(a);q=b@u;h=np.linalg.norm(b-q*u);xy=np.array([[0,0],[np.linalg.norm(a),0],[q,h]])*1000;coords.append(xy);rows.append({'path':str(p),'triangle':144,'source_face':int(d['source_face_indices'][144]) if 'source_face_indices' in d.files else 6360,'area_mm2':float(np.linalg.norm(np.cross(a,b))/2*1e6)})
fig,ax=plt.subplots(1,3,figsize=(13,4.2));allq=np.concatenate(coords);lo=allq.min(0)-1;hi=allq.max(0)+1
for a,xy,row,n,c in zip(ax,coords,rows,names,colors):
 a.fill(xy[:,0],xy[:,1],c,alpha=.22);a.plot(*np.vstack([xy,xy[0]]).T,color=c,lw=2);a.scatter(xy[:,0],xy[:,1],color=c,s=20);a.set_aspect('equal');a.set_xlim(lo[0],hi[0]);a.set_ylim(lo[1],hi[1]);a.set_xlabel('mm');a.set_ylabel('mm');a.set_title(n+'\nÁrea: %.3f mm²'%row['area_mm2']);a.grid(alpha=.2)
fig.suptitle('Face 144 da nuca: comparação intrínseca das arestas | NÃO é render Minecraft');fig.text(.5,.02,'Mesma face e escala. Rotação/posição removidas para medir forma. A V9 ainda tem pequena compressão em outras faces.',ha='center',fontsize=10);fig.tight_layout(rect=[0,.05,1,.92]);fig.savefig(R/'evidence/V8_V9_NAPE_TRIANGLE_SHAPE.png',dpi=160);(R/'evidence/V8_V9_NAPE_TRIANGLE_SHAPE.json').write_text(json.dumps(rows,indent=2));plt.close(fig)
font='/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf';f=ImageFont.truetype(font,25);small=ImageFont.truetype(font,20);im=Image.new('RGB',(1600,920),(30,35,40));dr=ImageDraw.Draw(im);dr.text((20,14),'V8 → V9 | anatomia nativa, casca/faixa congeladas | NÃO MINECRAFT',font=f,fill='white')
for i,(p,label) in enumerate([(R/'evidence/v8-control-left-ear.png','V8'),(R/'evidence/intrinsic097-left-ear.png','V9: qualidade geométrica melhor, orelha ainda não resolvida')]):
 dr.text((i*800+20,55),label,font=small,fill='white');a=Image.open(p).convert('RGB').resize((800,800));im.paste(a,(i*800,90))
dr.text((20,895),'A lâmina vermelha/azul continua visível. Nova sombra sob a faixa declarada; não houve retração da orelha.',font=small,fill=(215,220,225));im.save(R/'evidence/V8_V9_EAR_COMPARISON_NOT_MINECRAFT.png')
