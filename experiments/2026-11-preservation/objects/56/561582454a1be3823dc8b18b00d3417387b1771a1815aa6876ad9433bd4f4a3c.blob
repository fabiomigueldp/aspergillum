import bpy,numpy as np,json,shutil
from pathlib import Path
R=Path(__file__).resolve().parents[1];B=R.parent;P=B/'paired_retriangulated';shutil.copyfile(P/'evidence/cap-paired.npz',R/'evidence/cap-paired.npz');d=np.load(P/'evidence/band-paired.npz');v=d['points'].copy();old=v.copy();n=d['normals'].copy();f=d['triangles'];nv=len(v)//2;outer=f[np.all(f<nv,axis=1)];me=bpy.data.meshes.new('V3d external band unchanged');me.from_pydata(v[:nv].tolist(),[],outer.tolist());me.update();normal=np.array([x.normal[:] for x in me.vertices]);distance=np.linalg.norm(v[:nv]-v[nv:],axis=1);v[nv:]=v[:nv]-normal*distance[:,None];n[nv:]=-normal
# No inflation, no exterior displacement, no deleted triangles or alpha trick.
np.savez_compressed(R/'evidence/band-paired.npz',points=v,triangles=f,normals=n,source_indices=d['source_indices'],source_side=d['source_side']);cap=np.load(R/'evidence/cap-paired.npz');np.savez_compressed(R/'evidence/paired-shells.npz',points=np.concatenate([cap['points'],v]),triangles=np.concatenate([cap['triangles'],f+len(cap['points'])]),normals=np.concatenate([cap['normals'],n]),parts=np.array([0]*len(cap['triangles'])+[1]*len(f)))
delta=np.linalg.norm(v-old,axis=1);newdistance=np.linalg.norm(v[:nv]-v[nv:],axis=1);report={'method':'Keep external V75 sampled band surface EXACT. Rebuild internal positions along normals of the reduced exterior surface using each original pair distance. No thickness inflation.','triangles':len(f),'vertices':len(v),'outer_max_displacement':float(delta[:nv].max()),'inner_mean_displacement':float(delta[nv:].mean()),'inner_max_displacement':float(delta[nv:].max()),'original_paired_distance_range':[float(distance.min()),float(distance.max())],'new_paired_distance_range':[float(newdistance.min()),float(newdistance.max())],'max_paired_distance_difference':float(np.max(abs(distance-newdistance))),'normal_unit_error':float(np.max(abs(np.linalg.norm(normal,axis=1)-1))),'source_correspondence':'Outer vertices/normals exact source. Inner source_indices are correspondence references only, no longer exact source coordinates. Inner normals are negative exterior geometric normals.','cap':'Unchanged independently checked V3b cap.','status':'Needs independent intersections test and visual review. Not an addon.'};(R/'evidence/coherent-inner.json').write_text(json.dumps(report,indent=2));print(report)
