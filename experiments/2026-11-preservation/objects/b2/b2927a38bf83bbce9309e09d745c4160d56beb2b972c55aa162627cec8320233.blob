import bpy,json,time
from pathlib import Path
from mathutils import Vector
R=Path('lit_surface_v16/lighting_research').resolve();s=bpy.context.scene;c=s.camera
c.location=(.035,-3.5,3.58);c.rotation_euler=(Vector((.035,-.30,3.58))-c.location).to_track_quat('-Z','Y').to_euler();c.data.ortho_scale=.52
s.render.resolution_x=s.render.resolution_y=1000;s.render.resolution_percentage=100;s.render.use_border=True;s.render.use_crop_to_border=True;s.render.border_min_x=.27;s.render.border_max_x=.74;s.render.border_min_y=.40;s.render.border_max_y=.60
s.cycles.samples=64;s.cycles.use_adaptive_sampling=False;s.cycles.use_denoising=False;s.cycles.seed=0;s.render.threads_mode='FIXED';s.render.threads=2;s.render.image_settings.file_format='PNG'
records=[]
for y in [-1.0,-3.5,-10.0]:
 c.location.y=y;bpy.context.view_layer.update();s.render.filepath=str(R/f'distance-y{y:g}-band-crop.png');t=time.time();bpy.ops.render.render(write_still=True);records.append({'camera_y':y,'camera_clip_start':c.data.clip_start,'camera_clip_end':c.data.clip_end,'seconds':time.time()-t,'path':s.render.filepath})
(R/'camera-distance-renders.json').write_text(json.dumps({'version':bpy.app.version_string,'scope':'Diagnostic orthographic camera-distance sweep, same world geometry and framing; not asset correction','source':bpy.data.filepath,'records':records},indent=2))
