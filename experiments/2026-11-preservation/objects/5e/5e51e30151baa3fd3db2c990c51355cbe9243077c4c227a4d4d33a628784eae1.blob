   },
  }));
 }
+
+// Original maple-on-walnut marquetry. Only this new model consumes the map.
+export function crossbraceInlay(x,y){
+ const grain=walnutPaint(y,x),v=y/128,u=x/128;
+ const border=Math.min(Math.abs(v-.14),Math.abs(v-.86));
+ const diamonds=Math.abs(Math.abs(((u*4)%1)-.5)*2+Math.abs(v-.5)*4-.48);
+ const inlay=border<.018||(v>.32&&v<.68&&diamonds<.09);
+ return inlay?{rgb:[181,140,84],rough:202,metal:0,height:.008}:grain;
+}
