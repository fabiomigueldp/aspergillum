diff --git a/addons/altare/assets-src/atelier/crossbrace-model.mjs b/addons/altare/assets-src/atelier/crossbrace-model.mjs
new file mode 100644
index 0000000..4a86807
--- /dev/null
+++ b/addons/altare/assets-src/atelier/crossbrace-model.mjs
@@ -0,0 +1,68 @@
+import {box,rect,rotateCube} from '../block-primitives.mjs';
+
+// Cruzeta: an open walnut frame. A bay is a frame, never a solid chest.
+// The contour is compiled, so internal faces/posts are not merely hidden.
+export const crossbraceProfile=Object.freeze({top:16,slabBottom:14.2,outer:7.8,inner:6.2,railBottom:1.45,railTop:12.15,braceBottom:2.55,braceTop:12.25});
+const exposed=(mask,side)=>!!(mask&(1<<((side+4)%4)));
+const round=v=>Number(v.toFixed(9));
+function member(origin,size,surface='stone'){
+ const c=box(origin.map(round),size.map(round),surface);
+ for(const uv of Object.values(c.uv))uv.uv_size=uv.uv_size.map(v=>Math.min(128,v));return c;
+}
+function turn(c,side){
+ const out=rotateCube(c,side);
+ if(c.rotation){const [x,y,z]=c.rotation;out.rotation=side===1?[-z,y,x]:side===2?[-x,y,-z]:side===3?[z,y,-x]:[x,y,z];}
+ return out;
+}
+function brace(a,b,z){
+ const x=(a[0]+b[0])/2,y=(a[1]+b[1])/2,length=Math.hypot(b[0]-a[0],b[1]-a[1]);
+ const c=member([x-length/2,y-.42,z],[length,.84,.48],'wood_cross');
+ c.pivot=[x,y,z+.24];c.rotation=[0,0,round(Math.atan2(b[1]-a[1],b[0]-a[0])*180/Math.PI)];return c;
+}
+function post(corner){
+ const x=corner?-7.8:-8,w=corner?1.6:.8,z=-7.8,d=1.6;
+ const shaft=member([x,1.4,z+.12],[w,10.75,d-.24]);
+ const foot=member([x,0,z],[w,1.4,d],'wood_cross');
+ const cap=member([x,12.15,z],[w,2.05,d],'wood_cross');
+ // Inlaid maple lines and small diamond mortises are paint on real framing,
+ // not metallic/emissive decoration. The shaft retains vertical walnut grain.
+ for(const c of [foot,cap])for(const f of ['north','south','east','west'])c.uv[f]=rect('joinery_inlay',corner?0:64,0,corner?128:64,128);
+ return [foot,shaft,cap];
+}
+function mirror(c){
+ const out=structuredClone(c);out.origin[0]=round(-c.origin[0]-c.size[0]);
+ const e=out.uv.east,w=out.uv.west;if(e)out.uv.west=e;if(w)out.uv.east=w;return out;
+}
+export function crossbraceArchitecture(edges=15){
+ if(!Number.isInteger(edges)||edges<0||edges>15)throw Error('Invalid Cruzeta contour');
+ const bones=[],add=(name,cubes)=>bones.push({name,cubes});
+ for(let side=0;side<4;side++){
+  if(!exposed(edges,side))continue;
+  const left=exposed(edges,side+3),right=exposed(edges,side+1);
+  if(left)add(`crossbrace_corner_${side}`,post(true).map(c=>turn(c,side)));
+  else add(`crossbrace_half_${side}_left`,post(false).map(c=>turn(c,side)));
+  if(!right)add(`crossbrace_half_${side}_right`,post(false).map(mirror).map(c=>turn(c,side)));
+  const a=left?-6.2:-7.2,b=right?6.2:7.2;
+  const top=member([a,12.15,-7.62],[b-a,2.05,1.24],'wood_cross');
+  const bottom=member([a,1.45,-7.5],[b-a,1.05,1],'wood_cross');
+  top.uv.north=rect('joinery_inlay');top.uv.south=rect('joinery_inlay');
+  // Two half-depth members meet at the lap plane. Their visible faces are
+  // separated by .48, not coplanar. This stays deterministic in every bay.
+  const inset=.14;
+  const diagonalA=brace([a-inset,2.38],[b+inset,12.26],-7.48);
+  const diagonalB=brace([a-inset,12.26],[b+inset,2.38],-7);
+  add(`crossbrace_bay_${side}`,[top,bottom,diagonalA,diagonalB].map(c=>turn(c,side)));
+ }
+ return {bones};
+}
+export function crossbraceCollision(edges){
+ // One narrow perimeter frame envelope per exposed face, plus the slab.
+ // Unlike a full cube, the centre of the table is free. AABB envelopes are
+ // deliberately conservative across the diagonal openings, like trestles.
+ const result=[{origin:[-8,14.2,-8],size:[16,1.8,16]}];
+ for(let side=0;side<4;side++)if(exposed(edges,side)){
+  const c=rotateCube({origin:[-8,0,-7.8],size:[16,14.2,1.6],uv:{}},side);
+  result.push({origin:c.origin,size:c.size});
+ }
+ return result;
+}
diff --git a/addons/altare/docs/CROSSBRACE_0.12.0.md b/addons/altare/docs/CROSSBRACE_0.12.0.md
new file mode 100644
index 0000000..ca21898
--- /dev/null
+++ b/addons/altare/docs/CROSSBRACE_0.12.0.md
@@ -0,0 +1,57 @@
+# Cruzeta em nogueira — 0.12.0
+
+## Intenção e construção
+
+O oitavo modelo é uma mesa de marcenaria aberta. Não é uma recoloração da Arca ou uma variação dos Balaústres: cada vão tem travessa superior, travessa inferior e diagonais em X. Pés e cabeças escalonadas enquadram os montantes verticais. A nogueira escura recebe filetes e pequenos losangos de madeira clara, sem ouro ou emissividade, na travessa superior e nos encaixes.
+
+A construção vive em `assets-src/atelier/crossbrace-model.mjs`. Somente o contorno exposto recebe estrutura; uma quina usa um único montante. Em trechos contínuos, cada célula contribui com meio montante, formando uma junta compartilhada. Os veios permanecem verticais nos montantes e horizontais nas travessas/diagonais antes da rotação. As duas diagonais ocupam metades adjacentes da profundidade, com plano de encontro comum, sem duas faces exteriores coplanares no cruzamento. Não se declara uma simulação física de marcenaria.
+
+O tampo termina exatamente em y=16. A estrutura é idêntica sob todos os tecidos. A marchetaria é um mapa autoral procedural de 64², derivado no build; mapas das famílias anteriores não mudam. Textura de madeira e objetos litúrgicos não são imagens inventadas para o render: a prévia usa os arquivos distribuídos.
+
+## Estado e compatibilidade
+
+- 17 novos IDs: `altare:j_crossbrace_*` e `altare:u_crossbrace_walnut_*_none`. Não muda UUID, nome ou significado de qualquer estado anterior.
+- Dez desenhos de toalha e oito cores do Floral IHS. Sem aplique adicional; material fixo nogueira.
+- Sem toalha usa o codec simétrico já existente: somente `altare:edges`, 16 estados. A direção tem significado apenas quando uma toalha direcional é escolhida.
+- O leitor do codec simétrico deriva o material do design. Colunata continua mármore/0; Cruzeta usa nogueira/2. A ordem dos sete modelos antigos no editor é preservada; Cruzeta é acrescentada ao final.
+- Altare passa de 78.432 a **80.000** estados. A economia de 48 estados no novo bare impede ultrapassar o teto de 80.000; o teto não foi elevado. Com Aspergillum local: **89.744**, abaixo do teto diagnóstico de 90.000, mas acima da referência global de 65.536. Outros add-ons não estão incluídos.
+- A colisão possui até cinco caixas: tampo e até quatro envoltórias estreitas dos quadros. O centro está livre. Os pequenos vãos entre diagonais têm colisão conservadora, não recorte físico fino. Seleção conserva o cubo completo.
+- As geometrias novas usam no máximo **46 cubos e 211 faces**, abaixo do teto de 50 cubos por módulo, inclusive no isolado vestido. Não se acrescenta exceção de complexidade ao validador.
+- Mapas únicos: 33,2255859375 MiB antes de mipmaps/ícones, abaixo do teto existente de 33,25 MiB.
+
+Mundos anteriores só recebem a família após aplicar a ferramenta. Downgrade após colocar os novos IDs não é seguro: voltar ao acabamento anterior antes de remover a 0.12.0, sempre em cópia do mundo. O add-on não captura nem recria objetos acima da mensa.
+
+## Verificação reproduzível
+
+Na raiz:
+
+```
+npm --prefix addons/altare run check
+npm --prefix addons/altare run package
+node addons/altare/tools/capture-cpu.mjs
+```
+
+`crossbrace.node.ts` verifica orçamento, 17 acabamentos, codec simétrico, 16 contornos, dimensões de 1×1 a 16×8, quatro frentes, invariância sob dez tecidos, caixas de colisão e vértices rotacionados. Os testes existentes de marcenaria, editor e tecido incluem a nova família. O Estúdio 2.3.0 oferece dois presets: madeira exposta e linho curto.
+
+A prévia alternativa requer Python 3 com NumPy/Pillow e usa o adaptador geométrico compartilhado do projeto, incluindo transformações/UV reais, seguido de rasterização CPU. É **prévia técnica externa**, com iluminação simplificada e somente cor: não usa WebGL, PBR, iluminação nativa ou paridade Minecraft. O renderer oficial Chromium não pôde iniciar por restrição do ambiente; a restrição não foi contornada. Os manifests preservam os hashes dos modelos e mapas utilizados.
+
+## Resultados desta revisão
+
+- 108 testes Altare, 107 testes Aspergillum e 84 testes viewer aprovados; tipos, documentação e build aprovados.
+- Creator Tools no alvo 1.26.40: zero erros, zero avisos inesperados e 2.084 avisos limitados das famílias anteriores. Cruzeta não usa a exceção de complexidade. As consultas npm devolveram 502; a checagem foi offline, complementada pelos tipos estáveis instalados.
+- Os 397 blocos, 4.108 geometrias e 258 arquivos de textura anteriores são byte a byte idênticos à baseline. Os 78.432 estados antigos decodificam de modo idêntico; 1.568 estados novos e 25.088 reparos de contorno passaram.
+- Os 5.393 arquivos do pacote correspondem aos gerados. As 38 fontes de geometria/mapas das prévias correspondem ao pacote final.
+
+## Reteste no Minecraft
+
+1. Fazer uma cópia do mundo. Importar somente BP/RP Altare **[0,12,0]**, sem revisão concorrente, no alvo mínimo 1.26.40; sem experimentos.
+2. `/function altare/dev_kit`. Montar 1×1, 3×2, 7×2 e 8×2. Abrir Acabamento do altar e selecionar Cruzeta.
+3. Sem toalha: observar frente, verso, quatro quinas, interior e underside. Conferir cruzamentos sem cintilação, nenhuma duplicação de montantes e continuidade das travessas.
+4. Alternar todas as dez toalhas, principalmente linho curto, renda e Floral IHS verde/roxo. Conferir o verso do tecido através do quadro, centro ímpar e dois meios centros no par.
+5. Colocar pedra vanilla e caldeirinha sobre a mensa. Trocar de/para modelos antigos, aplicar, cancelar, restaurar e reabrir. Objetos superiores devem permanecer no lugar.
+6. Testar quatro frentes, remoção/reposição de módulos, salvar/reabrir e multiplayer. Reaplicar depois de redimensionar para recentralizar a toalha.
+7. Conferir luz através da mesa, colisão conservadora dos quadros, apoio do tampo, Content Log sem novos erros e profiling no dispositivo-alvo.
+
+Se a consulta de versão do Creator Tools falhar mesmo em `--offline`, o CLI pode cair no fallback 1.26.0 e rejeitar até arquivos já publicados. Neste ambiente, a validação é repetida com a opção existente `MCT_TEST_PINNED_MC_VERSION=1.26.40`, fixando o alvo declarado no manifest. Isso não altera schemas, arquivos ou a política de avisos.
+
+Build e validação offline não substituem essa etapa. A versão continua diagnóstica e não é promovida como fisicamente aprovada sem o teste do arquivo exato.
diff --git a/addons/altare/tests/crossbrace.node.ts b/addons/altare/tests/crossbrace.node.ts
new file mode 100644
index 0000000..40b42bf
--- /dev/null
+++ b/addons/altare/tests/crossbrace.node.ts
@@ -0,0 +1,64 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {crossbraceArchitecture,crossbraceCollision} from '../assets-src/atelier/crossbrace-model.mjs';
+import {atelierGeometry} from '../assets-src/atelier/geometry.mjs';
+import {DESIGNS,JOINERY_DESIGNS,CATALOG_PERMUTATIONS,sharedDesignFor,SHARED_TEXTILES} from '../src/domain/catalog.ts';
+import {planFinish,type Tile} from '../src/domain/surface.ts';
+import {encodeTile,decodeTile} from '../src/domain/block-codec.ts';
+import {customizationFromFinish,customizationFinish,customizationCapabilities,changeCustomization} from '../src/domain/customization.ts';
+import {collectionMaterials} from '../tools/catalog-pack.mjs';
+const grid=(w:number,d:number):Tile[]=>Array.from({length:w*d},(_,i)=>({position:{x:i%w,y:0,z:Math.floor(i/w)},stone:0,cloth:0,frontal:0,facing:0,edges:15}));
+function points(c:any){
+ const p=c.pivot??[0,0,0],r=(c.rotation??[0,0,0]).map((v:number)=>v*Math.PI/180),result:number[][]=[];
+ for(const x of [0,1])for(const y of [0,1])for(const z of [0,1]){
+  let v=c.origin.map((n:number,i:number)=>n+c.size[i]*[x,y,z][i]!-p[i]);
+  for(let axis=0;axis<3;axis++){const j=(axis+1)%3,k=(axis+2)%3,a=v[j],b=v[k];v[j]=a*Math.cos(r[axis])-b*Math.sin(r[axis]);v[k]=a*Math.sin(r[axis])+b*Math.cos(r[axis]);}
+  result.push(v.map((n:number,i:number)=>n+p[i]));
+ }return result;
+}
+test('Cruzeta adds seventeen finishes without relaxing either state ceiling',()=>{
+ assert.equal(DESIGNS.filter(d=>d.structure==='crossbrace').length,17);
+ assert.equal(CATALOG_PERMUTATIONS,80000);assert.ok(CATALOG_PERMUTATIONS+9744<=90000);
+ const bare=JOINERY_DESIGNS.find(d=>d.id==='altare:j_crossbrace_none')!;assert.equal(bare.codec,'symmetric');
+ for(let facing=0;facing<4;facing++)for(const [w,d] of [[1,1],[7,2],[8,2],[16,8]]){
+  for(const t of planFinish(grid(w!,d!),{stone:0,cloth:0,ornamental:false,facing,design:bare.id})){
+   const e=encodeTile(t);assert.deepEqual(Object.keys(e.states),['altare:edges']);assert.equal(t.stone,2);assert.equal(t.facing,0);assert.deepEqual(decodeTile(e.id,t.position,e.states),t);
+  }
+ }
+});
+test('Cruzeta carpentry does not change with textile, dye or front direction',()=>{
+ for(let edges=0;edges<16;edges++){
+  const bare=atelierGeometry('crossbrace','none','none',0,edges).doc['minecraft:geometry'][0];
+  const structure=(g:any)=>g.bones.filter((b:any)=>b.name.startsWith('crossbrace_'));
+  for(let facing=0;facing<4;facing++)for(const textile of SHARED_TEXTILES){
+   const g=atelierGeometry('crossbrace',textile==='floral'?'ruby':textile,'none',facing,edges).doc['minecraft:geometry'][0];
+   assert.deepEqual(structure(g),structure(bare));assert.ok(g.bones.flatMap((b:any)=>b.cubes).length<=50);
+   assert.ok(g.bones.find((b:any)=>b.name==='top').cubes.every((c:any)=>Math.abs(c.origin[1]+c.size[1]-16)<1e-9));
+   if(textile!=='none')for(const b of g.bones.filter((b:any)=>b.name.startsWith('drape_')))assert.ok(b.cubes.slice(0,2).every((c:any)=>c.uv.north&&c.uv.south||c.uv.east&&c.uv.west),'open frame cloth has a visible reverse');
+  }
+ }
+});
+test('Cruzeta compiled contours share corner posts and keep diagonal support inside collision bounds',()=>{
+ for(let edges=0;edges<16;edges++){
+  const bones=crossbraceArchitecture(edges).bones,collision=crossbraceCollision(edges);
+  assert.ok(collision.length<=5);assert.ok(!collision.some((b:any)=>[0,7,0].every((v,i)=>v>b.origin[i]&&v<b.origin[i]+b.size[i])));
+  for(const c of bones.flatMap((b:any)=>b.cubes))for(const p of points(c)){
+   assert.ok(p[0]!>=-8-1e-8&&p[0]!<=8+1e-8&&p[1]!>=0&&p[1]!<=14.2+1e-8&&p[2]!>=-8-1e-8&&p[2]!<=8+1e-8);
+   assert.ok(collision.some((b:any)=>p.every((v,i)=>v>=b.origin[i]-1e-7&&v<=b.origin[i]+b.size[i]+1e-7)),`uncovered wood vertex ${p}`);
+  }
+  assert.equal(bones.filter((b:any)=>b.name.startsWith('crossbrace_bay_')).length,[0,1,2,3].filter(s=>edges&(1<<s)).length);
+ }
+ const isolated=crossbraceArchitecture(15).bones;assert.equal(isolated.filter((b:any)=>b.name.includes('_corner_')).length,4);assert.ok(!isolated.some((b:any)=>b.name.includes('_half_')));
+ const continuous=crossbraceArchitecture(1).bones;assert.equal(continuous.filter((b:any)=>b.name.includes('_half_')).length,2);
+ const laps=isolated.find((b:any)=>b.name==='crossbrace_bay_0')!.cubes.slice(2);assert.equal(laps[0]!.origin[2]+laps[0]!.size[2],laps[1]!.origin[2]);
+});
+test('Cruzeta materials preserve wood, receive all shared cloths, and have no metallic body or extra relief',()=>{
+ for(const textile of SHARED_TEXTILES){const d=sharedDesignFor('crossbrace','walnut',textile,'none');const m=collectionMaterials(d);assert.equal(m.stone.texture,'altare_atelier_walnut');assert.equal(m.joinery_inlay.texture,'altare_crossbrace_inlay');}
+ assert.throws(()=>atelierGeometry('crossbrace','none','cross',0,15),/no applied relief/);
+});
+
+test('symmetric Cruzeta hides direction while preserving the draft for a later cloth',()=>{
+ const d=changeCustomization(customizationFromFinish({stone:0,cloth:0,ornamental:false,facing:3}),{model:'crossbrace',textile:'none'});
+ assert.equal(customizationCapabilities(d).directional,false);assert.equal(customizationFinish(d).facing,0);assert.equal(d.facing,3);
+ const clothed=changeCustomization(d,{textile:'agnus'});assert.equal(customizationCapabilities(clothed).directional,true);assert.equal(customizationFinish(clothed).facing,3);
+});
diff --git a/addons/altare/tools/capture-cpu.mjs b/addons/altare/tools/capture-cpu.mjs
new file mode 100644
index 0000000..a92e5a7
--- /dev/null
+++ b/addons/altare/tools/capture-cpu.mjs
@@ -0,0 +1,49 @@
+/** Fallback diagnostic, no browser/WebGL. Uses the project's actual geometry adapter. */
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import {spawnSync} from 'node:child_process';
+import * as THREE from '../../../viewer-3d/node_modules/three/build/three.module.js';
+import {buildBedrockGeometry} from '../../../viewer-3d/src/shared/bedrock-geometry.js';
+import {blockPreviewGeometry} from './block-preview-basis.mjs';
+import {planFinish} from '../src/domain/surface.ts';
+import {encodeTile} from '../src/domain/block-codec.ts';
+import {sharedDesignFor} from '../src/domain/catalog.ts';
+const root=path.resolve(import.meta.dirname,'..'),out=path.join(root,'out/crossbrace-cpu');fs.mkdirSync(out,{recursive:true});
+const read=p=>JSON.parse(fs.readFileSync(path.join(root,p),'utf8')),atlas=read('packs/resource/textures/terrain_texture.json').texture_data;
+const version=read('package.json').version;
+if(read('packs/behavior/manifest.json').header.version.join('.')!==version||read('packs/resource/manifest.json').header.version.join('.')!==version||read('out/build-manifest.json').version!==version)throw Error('CPU preview requires a matching complete build.');
+const scenes=[{id:'crossbrace-3x2-bare',w:3,d:2,textile:'none',direction:[-.52,.38,-1]}, {id:'crossbrace-7x2-linen',w:7,d:2,textile:'linen_short',direction:[-.45,.38,-1]}, {id:'crossbrace-8x2-floral',w:8,d:2,textile:'floral',color:'green',direction:[-.45,.38,-1]}, {id:'crossbrace-detail',w:1,d:1,textile:'none',direction:[-.65,.25,-1]}, {id:'crossbrace-7x2-bare',w:7,d:2,textile:'none',direction:[-.45,.38,-1]}, {id:'crossbrace-7x2-lace',w:7,d:2,textile:'lace',direction:[-.45,.38,-1]}];
+const hashes={};
+for(const scene of scenes){
+ const design=sharedDesignFor('crossbrace','walnut',scene.textile,'none',scene.color??'red'),meshes=[];
+ const tiles=planFinish(Array.from({length:scene.w*scene.d},(_,i)=>({position:{x:i%scene.w,y:0,z:Math.floor(i/scene.w)},stone:0,cloth:0,frontal:0,facing:0,edges:15})),{stone:0,cloth:0,ornamental:false,facing:0,design:design.id});
+ for(const tile of tiles){
+  const e=encodeTile(tile),block=read(`packs/behavior/blocks/${e.id.split(':')[1]}.block.json`)['minecraft:block'],q={block_state:k=>e.states[k]};
+  const component=Object.assign({},block.components,...block.permutations.filter(p=>Function('q',`return ${p.condition}`)(q)).map(p=>p.components));
+  const geomPath=`packs/resource/models/blocks/${component['minecraft:geometry'].identifier.replace('geometry.altare.','')}.geo.json`,doc=read(geomPath),g=blockPreviewGeometry(doc['minecraft:geometry'][0]);
+  hashes[geomPath]=crypto.createHash('sha256').update(fs.readFileSync(path.join(root,geomPath))).digest('hex');
+  const palette={named:{}};
+  for(const [name,m] of Object.entries(component['minecraft:material_instances'])){
+   const file='packs/resource/'+atlas[m.texture].textures[0]+'.png',material=new THREE.MeshBasicMaterial();material.userData.file=path.join(root,file);
+   hashes[file]=crypto.createHash('sha256').update(fs.readFileSync(material.userData.file)).digest('hex');
+   if(name==='*')palette.default=material;else palette.named[name]=material;
+  }
+  const built=buildBedrockGeometry(g,{identifier:g.description.identifier,textureWidth:128,textureHeight:128,formatVersion:doc.format_version},palette,{includePivots:false,includeLocators:false});
+  for(const [name,group] of built.boneGroups)group.visible=component['minecraft:geometry'].bone_visibility[name]??true;
+  built.root.position.set(tile.position.x,0,tile.position.z);built.root.updateMatrixWorld(true);
+  built.root.traverseVisible(o=>{if(!o.isMesh)return;const p=o.geometry.attributes.position,uv=o.geometry.attributes.uv,idx=o.geometry.index;
+   for(const group of o.geometry.groups){const material=Array.isArray(o.material)?o.material[group.materialIndex]:o.material;
+    if(!material?.userData.file)continue;
+    for(let i=group.start;i<group.start+group.count;i+=3){const points=[],coords=[];
+     for(let j=0;j<3;j++){const k=idx?idx.getX(i+j):i+j,vertex=new THREE.Vector3().fromBufferAttribute(p,k).applyMatrix4(o.matrixWorld);points.push(vertex.toArray());coords.push([uv.getX(k),uv.getY(k)]);}
+     meshes.push({points,uv:coords,texture:material.userData.file});
+    }
+   }
+  });
+ }
+ const file=path.join(out,scene.id+'.scene.json');fs.writeFileSync(file,JSON.stringify({...scene,triangles:meshes}));
+ const proc=spawnSync('python',[path.join(import.meta.dirname,'cpu-rasterize.py'),file,path.join(out,scene.id+'.png')],{stdio:'inherit'});if(proc.status!==0)throw Error('CPU rasterizer failed');
+}
+fs.writeFileSync(path.join(out,'manifest.json'),JSON.stringify({version,renderer:'CPU barycentric rasterization of shared buildBedrockGeometry meshes',limitation:'Alternative technical preview. No WebGL, PBR, game lighting or Minecraft parity. Official Chromium renderer unavailable in this execution environment.',sourceHashes:hashes,scenes:scenes.map(s=>({...s,file:s.id+'.png'}))},null,2)+'\n');
+console.log(out);
diff --git a/addons/altare/tools/cpu-rasterize.py b/addons/altare/tools/cpu-rasterize.py
new file mode 100644
index 0000000..1a5c007
--- /dev/null
+++ b/addons/altare/tools/cpu-rasterize.py
@@ -0,0 +1,47 @@
+"""Technical color-only preview; no browser, GPU, network or external process."""
+import json,sys
+from pathlib import Path
+import numpy as np
+from PIL import Image,ImageDraw,ImageFont
+s=json.loads(Path(sys.argv[1]).read_text()); W,H=2000,1100
+image=np.zeros((H,W,3),dtype=np.float64);image[:]=[232,227,215];zbuffer=np.full((H,W),-np.inf)
+direction=np.array(s['direction'],float);direction/=np.linalg.norm(direction)
+right=np.cross(direction,[0,1,0]);right/=np.linalg.norm(right);up=np.cross(right,direction)
+center=np.array([(s['w']-1)/2,.50,(s['d']-1)/2])
+allpts=np.array([p for t in s['triangles'] for p in t['points']]);proj=np.stack([(allpts-center)@right,(allpts-center)@up],1)
+scale=min((W-220)/(np.ptp(proj[:,0])),(H-270)/(np.ptp(proj[:,1])));offset=np.array([W/2,H/2+55])
+light=np.array([-.4,.85,-.55]);light/=np.linalg.norm(light)
+textures={}
+for t in s['triangles']:
+ p=np.array(t['points']);uv=np.array(t['uv']);pp=p-center
+ screen=np.stack([pp@right,-pp@up],1)*scale+offset;depth=pp@direction
+ a,b,c=screen;den=(b[1]-c[1])*(a[0]-c[0])+(c[0]-b[0])*(a[1]-c[1])
+ if abs(den)<1e-8:continue
+ x0=max(0,int(np.floor(screen[:,0].min())));x1=min(W-1,int(np.ceil(screen[:,0].max())))
+ y0=max(0,int(np.floor(screen[:,1].min())));y1=min(H-1,int(np.ceil(screen[:,1].max())))
+ if x0>x1 or y0>y1:continue
+ xx,yy=np.meshgrid(np.arange(x0,x1+1)+.5,np.arange(y0,y1+1)+.5)
+ w0=((b[1]-c[1])*(xx-c[0])+(c[0]-b[0])*(yy-c[1]))/den
+ w1=((c[1]-a[1])*(xx-c[0])+(a[0]-c[0])*(yy-c[1]))/den;w2=1-w0-w1
+ inside=(w0>=-1e-7)&(w1>=-1e-7)&(w2>=-1e-7)
+ zz=w0*depth[0]+w1*depth[1]+w2*depth[2];zview=zbuffer[y0:y1+1,x0:x1+1];mask=inside&(zz>zview+1e-9)
+ if not np.any(mask):continue
+ f=t['texture']
+ if f not in textures:textures[f]=np.array(Image.open(f).convert('RGBA'))
+ tex=textures[f];th,tw=tex.shape[:2]
+ u=w0*uv[0,0]+w1*uv[1,0]+w2*uv[2,0];v=w0*uv[0,1]+w1*uv[1,1]+w2*uv[2,1]
+ tx=np.minimum(tw-1,np.maximum(0,(u*tw).astype(int)));ty=np.minimum(th-1,np.maximum(0,((1-v)*th).astype(int)))
+ samples=tex[ty,tx];mask&=samples[:,:,3]>=128
+ n=np.cross(p[1]-p[0],p[2]-p[0]);n/=np.linalg.norm(n)
+ if n@direction<0:n=-n
+ shade=.65+.45*max(0,float(n@light));rgb=np.minimum(255,samples[:,:,:3]*shade)
+ image[y0:y1+1,x0:x1+1][mask]=rgb[mask];zview[mask]=zz[mask]
+im=Image.fromarray(image.astype('uint8'));draw=ImageDraw.Draw(im)
+try:
+ font=ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf',32);small=ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf',19)
+except OSError:font=small=ImageFont.load_default()
+draw.text((64,42),'ALTARE  /  CRUZETA EM NOGUEIRA',fill=(55,44,33),font=font)
+label={'none':'Sem toalha','linen_short':'Linho curto','floral':'Floral IHS verde','lace':'Renda floral'}.get(s['textile'],s['textile'])
+draw.text((64,90),f"{s['w']} × {s['d']} módulos  ·  {label}  ·  geometria e mapas reais do pacote",fill=(100,88,71),font=small)
+draw.text((64,H-48),'PRÉVIA TÉCNICA CPU · iluminação simplificada · não é captura do Minecraft',fill=(105,90,73),font=small)
+im.save(sys.argv[2]);print(sys.argv[2])
