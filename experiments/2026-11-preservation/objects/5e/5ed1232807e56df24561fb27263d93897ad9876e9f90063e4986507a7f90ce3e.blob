"""Final V10 controls: last rejection adjacency, alternative's director/self check.
No further candidate search or mutation; writes only independent diagnosis.
"""
from pathlib import Path
import numpy as np,json,sys,importlib.util,itertools,hashlib
sys.dont_write_bytecode=True
O=Path(__file__).resolve().parent;B=O.parents[1]
spec=importlib.util.spec_from_file_location('gate',B/'shell_band_v3/tools/independent_gate.py');gate=importlib.util.module_from_spec(spec);spec.loader.exec_module(gate)
def adjacent(d):
 v=d['points'];f=d['triangles'];vf=[[] for _ in range(len(v))]
 for i,tri in enumerate(f):
  for x in tri:vf[x].append(i)
 adj=set()
 for fs in vf:adj.update(itertools.combinations(fs,2))
 adj=np.array(sorted(adj),int);aa=v[f[adj[:,0]]];bb=v[f[adj[:,1]]];hit=np.zeros(len(adj),bool);rawhit=np.zeros(len(adj),bool)
 for orig,tar in [(aa,bb),(bb,aa)]:
  e1,e2=tar[:,1]-tar[:,0],tar[:,2]-tar[:,0]
  for k in range(3):
   pp=orig[:,k];dr=orig[:,(k+1)%3]-pp;h=np.cross(dr,e2);det=np.einsum('ij,ij->i',e1,h);lv=abs(det)>1e-20;rv=abs(det)>1e-12*np.linalg.norm(e1,axis=1)*np.linalg.norm(e2,axis=1)*np.linalg.norm(dr,axis=1);den=np.where(lv,det,1);ss=pp-tar[:,0];u=np.einsum('ij,ij->i',ss,h)/den;qq=np.cross(ss,e1);vv=np.einsum('ij,ij->i',dr,qq)/den;tt=np.einsum('ij,ij->i',e2,qq)/den;strict=(tt>1e-8)&(tt<1-1e-8)&(u>1e-8)&(vv>1e-8)&(u+vv<1-1e-8);hit|=rv&strict;rawhit|=lv&strict
 return {'pairs_tested':len(adj),'strict_crossing_pairs':int(hit.sum()),'pairs':adj[hit].tolist(),'scale_relative_parallel_tolerance':1e-12,'raw_absolute_tolerance_artifacts_removed':adj[rawhit&~hit].tolist()}
p=B/'bridge_ear_v10/structural_fit/relax075-continuation-iteration05.npz';d=np.load(p);rep={'candidate':str(p.relative_to(B)),'sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'explicit_adjacent_test':adjacent(d),'limits':'No ray exposure test repeated for the already rejected continuation candidate. No general coplanar/tangent/global-clearance certification.'};(O/'relax075-continuation-iteration05-adjacent-check.json').write_text(json.dumps(rep,indent=2));print(json.dumps(rep,indent=2),flush=True)
p=B/'bridge_ear_v10/structural_fit/relax065-t2-iteration03.npz';d=np.load(p);mid=np.load(B/'lateral_v7/evidence/director-cone-midfield.npz');where={int(x):i for i,x in enumerate(d['source_indices'])};oi=np.array([where[int(x)] for x in mid['outer_source_ids']]);ii=np.array([where[int(x)] for x in mid['inner_source_ids']]);v=d['points'];c=(v[oi]+v[ii])/2;delta=(v[ii]-v[oi])/2;half=np.linalg.norm(delta,axis=1);dire=delta/half[:,None];f=mid['triangles'];raw=np.cross(c[f[:,1]]-c[f[:,0]],c[f[:,2]]-c[f[:,0]]);n=raw/np.linalg.norm(raw,axis=1)[:,None];cos=np.einsum('ij,ikj->ik',n,dire[f]);cos*=np.sign(np.median(cos));mix=(cos.min(1)<0)&(cos.max(1)>0);rep={'candidate':str(p.relative_to(B)),'sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'self_gate':gate.review(p),'explicit_adjacent_test':adjacent(d),'mixed_director_faces':int(mix.sum()),'mixed_midface_indices':np.flatnonzero(mix).tolist(),'mixed_midface_uv':mid['uv'][f[mix]].tolist(),'nonpositive_director_products':int((cos<=0).sum()),'min_director_face_cosine':float(cos.min()),'paired_full_thickness_max_change_mm':float(np.max(abs(half-mid['half_thickness']))*2000),'limits':'This targeted control checks self crossings and offset-director transversality. It does not repeat all contacts, shape/visibility/contour tests or certify a viable alternative.'};(O/'relax065-t2-iteration03-targeted-check.json').write_text(json.dumps(rep,indent=2));print(json.dumps({k:v for k,v in rep.items() if k not in ['self_gate','mixed_midface_uv']},indent=2),flush=True)
