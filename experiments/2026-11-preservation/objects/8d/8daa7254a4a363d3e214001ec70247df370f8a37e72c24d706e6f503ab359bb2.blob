import numpy as np,json
from pathlib import Path
from PIL import Image
r=Path('lit_surface_v16/lighting_research');z=np.load(r/'coverage48-source-id-pixels.npz');a=z['masked'][:,:,:3];b=z['clip'][:,:,:3];rg=(slice(40,81),slice(220,301));lost=b[:,:,0]-a[:,:,0]
p=np.array(Image.open('opaque_transport_v15/evidence/shared-2048-band-front.png')).astype(float)[400:600,270:740,:3];q=np.array(Image.open('opaque_transport_v15/evidence/shared-2048-analytic-clip-control-band-front.png')).astype(float)[400:600,270:740,:3];dark=(q-p).mean(2);ll=lost[rg];dd=dark[rg];out={'scope':'Fixed48 samples BLACKMAN_HARRIS1.5, RGB emission binary IDs: band,shell,other object; world black. Only diagnostic shaders/world changed; saved geometry/UV/alpha/backface same. Compare to source48 adaptive lit image as spatial association, not exact path matching.','witnesses':{},'central_roi':{'pixels':int(ll.size),'lost_band_coverage_gt_0_01_pixels':int((ll>.01).sum()),'mean_lost_band_coverage_dark10':float(ll[dd>=10].mean()),'mean_lost_band_coverage_clean2':float(ll[abs(dd)<2].mean()),'pearson_darkening_vs_lost_band_coverage':float(np.corrcoef(dd.ravel(),ll.ravel())[0,1]),'minmax_lost_band_coverage':[float(ll.min()),float(ll.max())]}}
for x,y in [(493,471),(559,449),(510,468),(500,471),(559,440)]:out['witnesses'][str((x,y))]={'masked_band_shell_other':a[y-400,x-270].tolist(),'clip_band_shell_other':b[y-400,x-270].tolist(),'lost_band_coverage':float(lost[y-400,x-270]),'original_png_darkening':float(dark[y-400,x-270])}
print(json.dumps(out,indent=2));(r/'coverage48-comparison.json').write_text(json.dumps(out,indent=2))
