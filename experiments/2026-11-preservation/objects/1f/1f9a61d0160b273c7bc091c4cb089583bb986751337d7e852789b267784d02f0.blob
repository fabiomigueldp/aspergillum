import bpy,math,json
from mathutils import Vector
from mathutils.bvhtree import BVHTree
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'V59-child-tunic-trial.blend',use_scripts=False);o=bpy.data.objects['Menino — pé'];m=o.matrix_world.copy();inv=m.inverted();old=[m@v.co for v in o.data.vertices];new=[];floor=min(p.z for p in old)
for p in old:
 z=max(-1,min(1,(p.z-.535)/.037));y=p.y;q=p.copy();width=.78+.24*math.exp(-((y+.37)/.04)**2);q.x=-.04+(p.x+.04)*width
 if z<=0:q.z=floor+(.516-floor)*(1+z)**2
 else:q.z=.516+z*(.025+.030*math.exp(-((y+.28)/.045)**2)+.004*math.exp(-((y+.402)/.016)**2))
 new.append(q)
o.shape_key_add(name='Basis');k=o.shape_key_add(name='TESTE60 — calcanhar peito e antepé visíveis');k.value=1
for v,p in zip(k.data,new):v.co=inv@p
fs=[tuple(f.vertices) for f in o.data.polygons];bb=BVHTree.FromPolygons(new,fs);pairs=[(i,j) for i,j in bb.overlap(bb) if i<j and not set(fs[i])&set(fs[j])]
def av(p,f):return sum(((p[f[j]]-p[f[0]]).cross(p[f[j+1]]-p[f[0]])*.5 for j in range(1,len(f)-1)),Vector())
rat=[];flips=0
for f in fs:
 a,b=av(old,f),av(new,f)
 if a.length>1e-12:rat.append(b.length/a.length);flips+=a.dot(b)<0
report={'source':'V59','scope':'Only visible negative-X child foot','self_intersections':len(pairs),'flipped_faces':flips,'face_area_ratio_min':min(rat),'face_area_ratio_max':max(rat),'max_delta_m':max((a-b).length for a,b in zip(old,new)),'length_y_before_after':[[min(p.y for p in ps),max(p.y for p in ps)] for ps in [old,new]],'sole_min_z_before_after':[floor,min(p.z for p in new)],'no_individual_hidden_toes_invented':True,'rollback':'TESTE60=0 restores V59'};json.dump(report,open(r+'V60-child-foot-verification.json','w'),indent=2);bpy.ops.wm.save_as_mainfile(filepath=r+'V60-child-foot-trial.blend')
s=bpy.context.scene;s.cycles.samples=32;s.render.resolution_x=700;s.render.resolution_y=700;s.render.resolution_percentage=100;c=s.camera;ct=Vector((-.04,-.32,.57));c.data.ortho_scale=.34
for val,label in [(0,'V59'),(1,'V60')]:
 k.value=val
 for view,off in [('profile',(-3,0,0)),('threequarter',(-2,-3,0))]:
  c.location=ct+Vector(off);c.rotation_euler=(ct-c.location).to_track_quat('-Z','Y').to_euler();s.render.filepath=r+label+'-foot-close-'+view+'.png';bpy.ops.render.render(write_still=True)
print(report)
