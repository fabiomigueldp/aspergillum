from pathlib import Path
import numpy as np,json,sys
from mathutils.bvhtree import BVHTree
R=Path(__file__).resolve().parents[2];O=Path(__file__).resolve().parent
name=sys.argv[sys.argv.index('--')+1];a=np.load(O/(name+'-assembly.npz'));src=np.load(R/'integration_v6/evidence/seam-source-inspection.npz');p=src[next(k for k in src.files if k.startswith('key_TESTE74'))];f=src['triangles'];tree=BVHTree.FromPolygons(p.tolist(),f.tolist(),all_triangles=True)
tr=a['points'][a['triangles'][a['face_parts']==1]];area=np.linalg.norm(np.cross(tr[:,1]-tr[:,0],tr[:,2]-tr[:,0]),axis=1);rng=np.random.default_rng(20261103);chosen=rng.choice(len(tr),10000,p=area/area.sum());u=rng.random((10000,2));u[u.sum(1)>1]=1-u[u.sum(1)>1];pts=tr[chosen,0]+u[:,0,None]*(tr[chosen,1]-tr[chosen,0])+u[:,1,None]*(tr[chosen,2]-tr[chosen,0]);dist=np.array([tree.find_nearest(tuple(q))[3] for q in pts]);rep={'source':'TESTE74 evaluated source triangles','method':'10000 area-weighted uniform samples on bridge; one-sided nearest source triangle via Blender BVH; seed20261103','millimeters':{'min':float(dist.min()*1000),'median':float(np.median(dist)*1000),'p95':float(np.percentile(dist,95)*1000),'max':float(dist.max()*1000)},'limitations':'One-sided sampled fidelity, not exact Hausdorff or clearance; source itself intersects; no artistic approval.'};(O/(name+'-source-distance.json')).write_text(json.dumps(rep,indent=2));print(rep)
