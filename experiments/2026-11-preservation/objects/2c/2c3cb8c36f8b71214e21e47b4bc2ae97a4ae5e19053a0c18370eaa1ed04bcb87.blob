import bpy,numpy as np,json
from pathlib import Path
R=Path(__file__).resolve().parents[1];S=R.parent.parent/'paz-refinement/gui-test/checkpoint-V75-20261102/V75-tunic-lower-trial.blend';bpy.ops.wm.open_mainfile(filepath=str(S),use_scripts=False);o=bpy.data.objects['Maria — plano contínuo do manto'];o.hide_viewport=False;o.hide_set(False)
