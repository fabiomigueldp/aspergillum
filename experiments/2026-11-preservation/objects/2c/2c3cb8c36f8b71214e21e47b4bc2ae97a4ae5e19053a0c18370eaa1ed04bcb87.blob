np.savez_compressed(R/'evidence/mantle-control.npz',points=np.array([v.co[:] for v in o.data.vertices]),faces=np.array([list(f.vertices) for f in o.data.polygons]))
for name,fun in [('lab_i',lambda i:i//80),('lab_j',lambda i:i%80)]:
 a=o.data.attributes.new(name,'FLOAT','POINT')
 for i,x in enumerate(a.data):x.value=fun(i)
for m in o.modifiers:
 if m.type=='SUBSURF':m.levels=m.render_levels
bpy.context.view_layer.update();dg=bpy.context.evaluated_depsgraph_get();me=bpy.data.meshes.new_from_object(o.evaluated_get(dg),preserve_all_data_layers=True,depsgraph=dg);me.calc_loop_triangles();params=np.array([[me.attributes[n].data[i].value for n in ['lab_i','lab_j']] for i in range(len(me.vertices))]);v=np.array([o.matrix_world@x.co for x in me.vertices]);np.savez_compressed(R/'evidence/mantle-source-parameters.npz',params=params,points=v,triangles=np.array([t.vertices[:] for t in me.loop_triangles]),normals=np.array([x.normal[:] for x in me.vertices]));print('EVAL',len(v),'PARAM_EXTENTS',params.min(0),params.max(0),flush=True)
