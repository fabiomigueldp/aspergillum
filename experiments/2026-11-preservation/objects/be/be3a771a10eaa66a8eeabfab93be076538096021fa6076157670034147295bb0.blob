from audit_common import *
import sys
name,geo,tex=sys.argv[1:];geo=Path(geo);tex=Path(tex);scene=json_faces(geo,texture=tex);rows=[]
for i,r in enumerate(frozen_rays()):
 hit=trace_quads(scene,r['origin'],r['direction'],r['maxdist']);native=r['native'];changed=(None if native is None else native['part'])!=(None if hit is None else hit['part']);rows.append({k:v for k,v in r.items() if k not in ['origin','direction']}|{'candidate':hit,'changed_first_part':changed,'depth_delta_mm':hit['distance_mm']-native['distance_mm'] if hit is not None and native is not None else None})
 if i%100==0:print(name,i,flush=True)
central=[r for r in rows if r['offset_mm']==[0,0]];deltas=[r['depth_delta_mm']for r in rows if r['depth_delta_mm'] is not None];rep={'candidate':name,'geometry_path':str(geo.relative_to(B)),'geometry_sha256':sha(geo),'texture_path':str(tex.relative_to(B)),'texture_sha256':sha(tex),'method':'Independent float64 reconstruction of actual JSON face quads and actual PNG nearest mip0 alpha; 450 exact frozen V14 witness rays, front-facing surfaces. Native first hits reused from SHA-frozen completed V14 audit, no exporter imports.','central_count':len(central),'neighbor_count':len(rows),'central_changed_first_parts':sum(r['changed_first_part']for r in central),'neighbor_changed_first_parts':sum(r['changed_first_part']for r in rows),'native_band_to_candidate_shell':sum(r['native']is not None and r['native']['part']==0 and r['candidate']is not None and r['candidate']['part']==1 for r in rows),'native_shell_to_candidate_band':sum(r['native']is not None and r['native']['part']==1 and r['candidate']is not None and r['candidate']['part']==0 for r in rows),'native_hit_to_missing':sum(r['native']is not None and r['candidate']is None for r in rows),'depth_delta_mm_quantiles':np.quantile(deltas,[0,.5,.9,.99,1]).tolist(),'largest_front_shift':min(rows,key=lambda r: r['depth_delta_mm'] if r['depth_delta_mm']is not None else np.inf),'rows':rows,'limitations':'Bounded samples, three retained parts only, no raster camera, filtering/mips, legacy contextual occlusion or runtime.'};save(O/(name+'-critical-rays.json'),rep);print(json.dumps({k:v for k,v in rep.items()if k not in ['rows','largest_front_shift']},indent=2))
