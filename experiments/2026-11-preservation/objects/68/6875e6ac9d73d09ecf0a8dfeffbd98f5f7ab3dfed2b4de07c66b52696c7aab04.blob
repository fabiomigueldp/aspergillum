from pathlib import Path
import json, numpy as np
from mathutils import Vector
from mathutils.bvhtree import BVHTree
R=Path(__file__).resolve().parents[2];V=R/'shell_band_v5';s=np.load(V/'evidence/review-holdout-points.npz');q=s['points'];high=s['high_signed_nearest_plane'];head=np.load(R/'shell_band_v4/evidence/head-source.npz');params=np.load(R/'shell_band_v4/evidence/cap-source-parameters.npz')['params'];source=np.load(R/'shell_band_v3/evidence/cap-source.npz');ht=BVHTree.FromPolygons(head['points'].tolist(),head['triangles'].tolist(),all_triangles=True)
def bary(x,t):
 a,b,c=t;v=b-a;w=c-a;z=x-a;d00=v@v;d01=v@w;d11=w@w;d20=z@v;d21=z@w;den=d00*d11-d01*d01;u=(d11*d20-d01*d21)/den;v2=(d00*d21-d01*d20)/den;return np.array([1-u-v2,u,v2])
def evalmesh(path):
 d=np.load(path);f=d['triangles'];f=f[np.all(d['source_side'][f]==0,axis=1)];tree=BVHTree.FromPolygons(d['points'].tolist(),f.tolist(),all_triangles=True);near=[tree.find_nearest(Vector(x)) for x in q];sd=[]
 for x,_,_,_ in near:
  p,n,_,_=ht.find_nearest(x);sd.append(float((x-p).dot(n)))
 return d,f,near,np.array(sd)
b,bf,bn,bs=evalmesh(R/'shell_band_v4/curvature_candidate/evidence/cap-paired.npz');v,vf,vn,vs=evalmesh(V/'candidates/cap-restored.npz');ids=np.flatnonzero((high>0)&(vs<-.0001)&~((high>0)&(bs<-.0001)))
rim=source['points'][np.arange(44*112,45*112)];ra=rim;rb=np.roll(rim,-1,axis=0);rv=rb-ra
rows=[]
for i in ids:
 row={'sample_index':int(i),'source_point':q[i].tolist(),'source_head_signed_proxy':float(high[i]),'source_row_parameter':float(s['barycentric_weights'][i]@params[s['source_triangle_vertices'][i],0])};t=np.clip(((q[i]-ra)*rv).sum(axis=1)/(rv*rv).sum(axis=1),0,1);row['distance_source_point_to_rim112_polyline']=float(np.linalg.norm(q[i]-(ra+t[:,None]*rv),axis=1).min())
 for name,d,f,near,sd in [('V4',b,bf,bn,bs),('V5',v,vf,vn,vs)]:
  x,n,j,error=near[i];x=np.array(x);bc=bary(x,d['points'][f[j]]);hp,hn,hj,hd=ht.find_nearest(Vector(x));neighbors=ht.find_nearest_range(Vector(x),hd+1e-6);signs=[float((Vector(x)-z[0]).dot(z[1])) for z in neighbors];angles=[float(np.degrees(np.arccos(np.clip(hn.dot(z[1]),-1,1)))) for z in neighbors];sids=d['source_indices'][f[j]]
  row[name]={'nearest_outer_point':x.tolist(),'head_signed_nearest_plane':float(sd[i]),'source_surface_error':float(error),'outer_triangle_source_indices':sids.tolist(),'outer_projection_barycentric_weights':bc.tolist(),'outer_projection_near_triangle_edge':bool(bc.min()<1e-4),'outer_triangle_row_range':[float(params[sids,0].min()),float(params[sids,0].max())],'nearest_head_triangle':int(hj),'head_nearest_distance':float(hd),'head_faces_within_nearest_distance_plus_1e_6':len(neighbors),'head_near_tie_signed_proxy_range':[min(signs),max(signs)],'head_near_tie_max_normal_angle_degrees':max(angles),'head_near_ties_disagree_on_sign':min(signs)<0<max(signs)}
 row['same_nearest_outer_source_triangle']=sorted(row['V4']['outer_triangle_source_indices'])==sorted(row['V5']['outer_triangle_source_indices'])
 row['interpretation']='Unchanged exact source triangle with cyclic order difference: threshold classification is sensitive to Blender BVH floating-point projection, not geometric displacement of this face.' if row['same_nearest_outer_source_triangle'] else 'Changed local triangulation. Both versions already have negative head-plane sign; V5 crosses the chosen -0.0001 threshold. This is a measurable local proxy regression.'
 row['V5_crossing_beyond_negative_threshold']=float(-.0001-vs[i]);row['V4_margin_above_negative_threshold']=float(bs[i]+.0001);rows.append(row)
report={'purpose':'Describe three held-out local regressions without adapting geometry. Seed 20261104, 20000 fixed holdout samples.','new_negative_definition':'Source nearest-head-plane sign > 0; V5 sign < -0.0001; V4 did not satisfy sign < -0.0001. This threshold event does not necessarily mean V4 was outside.','units':'Blender coordinate units, interpreted as meters in the project.','ambiguity_test':'Outer closest-point barycentrics test whether projection is near a triangle edge (minimum < 1e-4). Head face near-ties queried within nearest distance + 1e-6 units; compare their proxy signs and normal angles. This is not a robust SDF or full nearest-feature uniqueness certificate.','samples':rows}
(V/'evidence/holdout-local-limitations.json').write_text(json.dumps(report,indent=2));print(json.dumps(report,indent=2))
