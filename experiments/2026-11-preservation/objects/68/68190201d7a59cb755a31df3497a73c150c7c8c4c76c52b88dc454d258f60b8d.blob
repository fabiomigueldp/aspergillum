import bpy, math, json
from mathutils import Vector, Matrix
from mathutils.bvhtree import BVHTree
from math import sin, cos, pi
ROOT='/workspace/scratch/212c580ada5b/'
bpy.ops.wm.open_mainfile(filepath=ROOT+'paz-refinement/Nossa_Senhora_da_Paz_v20_estudo.blend')
head=bpy.data.objects['Maria — anatomia feminina adaptada CC0']; R=bpy.data.objects['Maria — auréola lisa'].rotation_euler.to_matrix()@Matrix.Rotation(-pi/2,3,'X'); Ri=R.transposed(); mat=head.data.materials[0]
bpy.context.view_layer.update(); bvh=BVHTree.FromObject(head,bpy.context.evaluated_depsgraph_get())
def sample(x,z):
 hit,n,idx,dist=bvh.ray_cast(R@Vector((x-.44,.4,z)), R@Vector((0,1,0)),1.)
 return (Ri@hit).y if hit is not None else .86
def mesh(name,verts,faces):
 m=bpy.data.meshes.new(name);m.from_pydata(verts,[],faces);m.update();o=bpy.data.objects.new(name,m);bpy.context.collection.objects.link(o);o.data.materials.append(mat)
 for p in m.polygons:p.use_smooth=True
 return o
# Explicit asymmetric eyelid surface: elliptic upper plane ends in a recessed,
# sharp closed edge. Existing skin is reduced beneath it, not inflated globally.
N=96;M=32
for side in [-1,1]:
 verts=[];faces=[]
 for j in range(M+1):
  v=j/M
  for i in range(N+1):
   u=i/N; x=side*(.027+.076*u)
   line=3.303+.007*(2*u-1)**2+.002*(u-.5)
   z=line+(v-.35)*.060
   y=sample(x,z)
   envelope=sin(pi*u)**1.2
   # clear relief and tightly defined margin, never a tube.
   vv=(v-.35)
   if vv>=0:
    relief=.0065*envelope*sin(pi*min(1,vv/.65))**.7
    relief+=.0017*envelope*math.exp(-(vv/.025)**2)
   else:
    relief=.0018*envelope*sin(pi*(vv+.35)/.35)**2
   # small inward gap at meeting edge; contrasted by upper shelf.
   if abs(vv)<.018:relief-=.0011*envelope
   verts.append(tuple(R@Vector((x-.44,y-relief-.00015*sin(pi*v)*sin(pi*u),z))))
 for j in range(M):
  for i in range(N):
   a=j*(N+1)+i;faces.append((a,a+1,a+N+2,a+N+1))
 o=mesh('V22 — superfície palpebral '+str(side),verts,faces);o['status']='Experimental overlay; not production watertight topology'
# Fine close-fitting veil rim, based on actual curved shell boundary.
veil=bpy.data.objects['Maria — véu reconstruído de perfil'];verts=[];faces=[]
for j in range(5):
 t=j/4
 for i in range(112):
  a=2*pi*i/112;edge=3.50-.14*sin(a)**2-.35*max(0,-cos(a));z=edge+.008*t
  origin=R@Vector((-.44,1.012,z));direction=R@Vector((sin(a),-cos(a),0));hit,n,idx,dist=bvh.ray_cast(origin,direction,1)
  if hit is None:hit=veil.data.vertices[44*112+i].co.copy();n=direction
  verts.append(tuple(hit+n*(.001+.0015*sin(pi*t))))
for j in range(4):
 for i in range(112):
  a=j*112+i;b=j*112+(i+1)%112;faces.append((a,b,b+112,a+112))
mesh('V22 — borda esculpida do véu',verts,faces)
s=bpy.context.scene;s.render.resolution_x=600;s.render.resolution_y=800;s.render.resolution_percentage=100;s.cycles.samples=40
s.camera=bpy.data.objects['Retrato comparativo'];s.render.filepath=ROOT+'paz-sculpt-v22/face.png'
bpy.ops.wm.save_as_mainfile(filepath=ROOT+'paz-sculpt-v22/V22-superficies-experimentais.blend');bpy.ops.render.render(write_still=True)
c=s.camera;c.location=(-5,-.05,3.6);c.rotation_euler=(Vector((0,-.15,3.4))-c.location).to_track_quat('-Z','Y').to_euler();c.data.ortho_scale=1.05;s.render.filepath=ROOT+'paz-sculpt-v22/profile.png';bpy.ops.render.render(write_still=True)
