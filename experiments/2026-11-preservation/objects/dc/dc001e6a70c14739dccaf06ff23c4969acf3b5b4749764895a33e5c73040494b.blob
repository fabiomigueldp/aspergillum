import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import {twinPedestalCells} from '../addons/altare/assets-src/atelier/twin-pedestal-cell-study.mjs';
import {twinPedestalCollision} from '../addons/altare/assets-src/atelier/twin-pedestal-collision-study.mjs';
import {garment} from '../addons/altare/assets-src/atelier/garment.mjs';
import {clothTexture,seamTexture} from '../addons/altare/tools/universal-pack.mjs';
import {SHARED_TEXTILES,LITURGICAL_COLORS,centerRole} from '../addons/altare/src/domain/catalog.ts';
import {serializeCube} from '../addons/altare/assets-src/block-primitives.mjs';
const root=path.resolve(import.meta.dirname,'..'),output=path.join(root,'out/two-pedestal-integration');
const canonical=v=>Array.isArray(v)?v.map(canonical):v&&typeof v==='object'?Object.fromEntries(Object.keys(v).sort().map(k=>[k,canonical(v[k])])):v;
const hash=v=>crypto.createHash('sha256').update(JSON.stringify(canonical(v))).digest('hex');
const cubeSignature=cubes=>cubes.map(c=>JSON.stringify(canonical(c))).sort();
const recipes=SHARED_TEXTILES.flatMap(textile=>(textile==='floral'?LITURGICAL_COLORS:[undefined]).map(color=>({id:textile+(color?'_'+color:''),textile,palette:color,sourceTextile:textile==='floral'?'ruby':textile})));
const sets=Object.fromEntries(recipes.map(r=>[r.id,{visual:new Set(),logicalFacing:new Set(),rawVisual:new Set(),rawLogicalFacing:new Set(),contourRole:new Set(),cloth:new Set(),maxCubes:0,maxStructuralCubes:0,maxGarmentCubes:0,maxQuads:0,maxStructuralQuads:0,maxGarmentQuads:0}]));
const clothCache=new Map(),clothCubes=new Map([['none',0]]),clothQuads=new Map([['none',0]]),structural=new Set(),structuralFacing=new Set(),structuralNative=new Set(),rawStructural=new Set();let instances=0;
function clothKey(recipe,edges,facing,role){
 if(recipe.textile==='none')return 'none';
 const key=[recipe.id,edges,facing,role].join('/');if(clothCache.has(key))return clothCache.get(key);
 const d={textile:recipe.sourceTextile,palette:recipe.palette};
 const g=garment(d.textile,edges,{facing,surface:i=>`cloth_${i}`,twoSided:true});
 const materials={top:'linen',linen:'linen',seam:seamTexture(d)};
 for(let i=0;i<4;i++)materials[`cloth_${i}`]=clothTexture(d,i===facing?role:0);
 const cubes=g.bones.flatMap(b=>b.cubes).map(serializeCube).map(c=>({...c,uv:Object.fromEntries(Object.entries(c.uv).map(([face,uv])=>[face,{...uv,material_instance:materials[uv.material_instance]??uv.material_instance}]))}));
 const result=hash(cubeSignature(cubes));clothCache.set(key,result);clothCubes.set(result,cubes.length);clothQuads.set(result,cubes.reduce((n,c)=>n+Object.keys(c.uv).length,0));return result;
}
for(let width=1;width<=16;width++)for(let depth=1;depth<=8;depth++)for(let facing=0;facing<4;facing++){
 const plan=twinPedestalCells(width,depth,facing,{uvPolicy:'module-grain',capCuts:true}),collision=twinPedestalCollision(width,depth,facing);
 const nativeByCell=new Map(collision.cells.map(c=>[`${c.x},${c.z}`,c.nativeBoxes]));
 const nx=facing%2?depth:width,nz=facing%2?width:depth;
 for(const cell of plan.cells){
  instances++;
  const cubes=cell.doc['minecraft:geometry'][0].bones.flatMap(b=>b.cubes),visual=hash(cubeSignature(cubes));
  const quads=cubes.reduce((n,c)=>n+Object.keys(c.uv).length,0);
  const boxes=nativeByCell.get(`${cell.x},${cell.z}`);if(!boxes)throw Error('Missing native collision');
  const rawVisual=hash(cubes.map(c=>JSON.stringify(c)).sort());rawStructural.add(rawVisual);
  const native=hash([visual,boxes]);structural.add(visual);structuralNative.add(native);structuralFacing.add(`${native}/${facing}`);
  const edges=(cell.z===0?1:0)|(cell.x===nx-1?2:0)|(cell.z===nz-1?4:0)|(cell.x===0?8:0);
  let index=facing%2?cell.z:cell.x;if(facing>=2)index=width-1-index;
  const role=edges&(1<<facing)?centerRole(width,index):0;
  for(const recipe of recipes){
   const s=sets[recipe.id],cloth=clothKey(recipe,edges,facing,role),combined=`${native}/${cloth}`;
   s.maxCubes=Math.max(s.maxCubes,cubes.length+clothCubes.get(cloth));s.maxStructuralCubes=Math.max(s.maxStructuralCubes,cubes.length);s.maxGarmentCubes=Math.max(s.maxGarmentCubes,clothCubes.get(cloth));
   s.maxQuads=Math.max(s.maxQuads,quads+clothQuads.get(cloth));s.maxStructuralQuads=Math.max(s.maxStructuralQuads,quads);s.maxGarmentQuads=Math.max(s.maxGarmentQuads,clothQuads.get(cloth));
   s.rawVisual.add(`${rawVisual}/${cloth}`);s.rawLogicalFacing.add(`${rawVisual}/${cloth}/${facing}`);s.visual.add(combined);s.logicalFacing.add(`${combined}/${facing}`);s.contourRole.add(`${native}/${edges}/${role}/${facing}`);s.cloth.add(cloth);
  }
 }
}
function padded(n){let best;for(let a=1;a<=16;a++)for(let b=a;b<=16;b++)for(let c=b;c<=16;c++){const count=a*b*c;if(count>=n&&(!best||count<best.declared))best={cardinalities:[a,b,c],declared:count,padding:count-n};}if(!best)throw Error('Codebook exceeds three 16-valued properties');return best;}
const rows=recipes.map(r=>({recipe:r.id,textile:r.textile,palette:r.palette,combinedVisualAndNative:sets[r.id].visual.size,withLogicalFacing:sets[r.id].logicalFacing.size,rawKeyOrderVisual:sets[r.id].rawVisual.size,rawKeyOrderWithLogicalFacing:sets[r.id].rawLogicalFacing.size,naiveContourRoleFacing:sets[r.id].contourRole.size,clothSignatures:sets[r.id].cloth.size,maxCombinedCubes:sets[r.id].maxCubes,maxStructuralCubes:sets[r.id].maxStructuralCubes,maxGarmentCubes:sets[r.id].maxGarmentCubes,maxCombinedQuads:sets[r.id].maxQuads,maxCombinedTriangles:sets[r.id].maxQuads*2,maxStructuralQuads:sets[r.id].maxStructuralQuads,maxGarmentQuads:sets[r.id].maxGarmentQuads,packed:padded(sets[r.id].logicalFacing.size),fixedBank:{cardinalities:[16,16,5],declared:1280,padding:1280-sets[r.id].logicalFacing.size}}));
const totals={configurations:512,cellInstances:instances,recipes:recipes.length,rawKeyOrderModuleGrainVisual:rawStructural.size,moduleGrainVisual:structural.size,moduleGrainWithNative:structuralNative.size,bareWithLogicalFacing:structuralFacing.size,combinedPreservingRecipe:rows.reduce((n,r)=>n+r.combinedVisualAndNative,0),combinedPreservingRecipeAndFacing:rows.reduce((n,r)=>n+r.withLogicalFacing,0),rawKeyOrderPreservingRecipe:rows.reduce((n,r)=>n+r.rawKeyOrderVisual,0),rawKeyOrderPreservingRecipeAndFacing:rows.reduce((n,r)=>n+r.rawKeyOrderWithLogicalFacing,0),blindVisualTimesRecipes:structuralNative.size*recipes.length};
const declaredNewFamily=rows.reduce((n,r)=>n+r.packed.declared,0);
const projections={declaredNewFamily,padding:declaredNewFamily-totals.combinedPreservingRecipeAndFacing,scenarios:[51320,51608].map(existing=>({existing,newFamily:declaredNewFamily,altareTotal:existing+declaredNewFamily,remainingUnder80000:80000-existing-declaredNewFamily,knownCombinedWithAspergillum:existing+declaredNewFamily+9744}))};
const fixedBanks={declaredNewFamily:1280*recipes.length,padding:1280*recipes.length-totals.combinedPreservingRecipeAndFacing,extraVsMinimum:1280*recipes.length-declaredNewFamily,scenarios:[51320,51608].map(existing=>({existing,altareTotal:existing+1280*recipes.length,remainingUnder80000:80000-existing-1280*recipes.length,knownCombinedWithAspergillum:existing+1280*recipes.length+9744}))};
const files=['addons/altare/assets-src/atelier/twin-pedestal-cell-study.mjs','addons/altare/assets-src/atelier/twin-pedestal-collision-study.mjs','addons/altare/assets-src/atelier/twin-pedestal-prototype.mjs','addons/altare/assets-src/atelier/garment.mjs','addons/altare/assets-src/atelier/profiles.mjs','addons/altare/tools/universal-pack.mjs','addons/altare/src/domain/catalog.ts'];
const notes=['Shared garment is generated with twoSided:true for the open altar, including reverse drape faces.','Face complexity counts explicitly authored UV face records, including interior closure faces; no occlusion-based culling assumed. Every quad is two triangles. These are measurements, not gate changes.','Fixed bank uses index = low + 16*high + 256*page. Append page values without reordering low/high/page values or existing codebook entries. This preserves existing numeric mappings; a schema expansion still requires validation and must not renumber the palette.','Recount uses capCuts:true and continuous shaft UVs in the stabilized cell study. Baseline reports are preserved separately.','Packing enumerates all three-property products with each cardinality1..16, retaining recipe in its own ID and logical facing in the packed codebook, not as a fourth independent axis.','Canonical object keys remove insertion-order-only distinctions in source cubes; raw-key-order counts are reported alongside for comparison with the earlier 1,160-profile measurement.','Recipe identity is retained even when interior cells have the same visible material. Logical facing is retained in the second count, even for symmetric or hidden cloth.','Only actually co-occurring pedestal profile, contour, textile center role and facing are enumerated across all 512 permitted assemblies.','Garment is generated from the real shared generator with fixed edges. Face material slots are replaced by their actual texture keys; unused material bindings do not inflate signatures.','Collision is the existing nativeBoxes study output, not a new collision design. Cubes are hashed canonically as sorted multisets; arrays inside cubes retain order.','This measures structural-plus-garment composition keys, not a validated rendered integration. Existing wooden top reaches16 and linen occupies15.91..16: implement an explicit covered-top clipping/removal policy before rendering. Such changes can alter profile counts.','Garment defaults use stoneEdge8.28/cornerEnd8.34, as shared generator; pedestal-specific attachment fit and cube/block limits require validation.','The structural wood is deliberately not culled behind cloth. Removing hidden wooden faces could reduce counts, but is not assumed.','These are exact construction-codebook entry counts, not padded declared-state totals, theoretical minima, or approved runtime schemas. No catalog/runtime/world changes.'];
const report={schemaVersion:1,createdAt:new Date().toISOString(),totals,projections,fixedBanks,rows,notes,inputHashes:Object.fromEntries(files.map(file=>[file,crypto.createHash('sha256').update(fs.readFileSync(path.join(root,file))).digest('hex')]))};
fs.mkdirSync(output,{recursive:true});fs.writeFileSync(path.join(output,'pedestal-textile-budget.json'),JSON.stringify(report,null,2)+'\n');
fs.writeFileSync(path.join(output,'pedestal-textile-budget.md'),['# Two-pedestal textile composition budget','',...Object.entries(totals).map(([k,v])=>`- ${k}: ${v}`),'','## Per recipe',...rows.map(r=>`- ${r.recipe}: ${r.combinedVisualAndNative} visual/native entries; ${r.withLogicalFacing} preserving logical facing; ${r.clothSignatures} standalone cloth outputs; max ${r.maxCombinedCubes} composed cubes (${r.maxStructuralCubes} structural and ${r.maxGarmentCubes} garment individual maxima); max ${r.maxCombinedQuads} quads / ${r.maxCombinedTriangles} triangles; packed ${r.packed.declared} [${r.packed.cardinalities.join(",")}].`),'','## Declared budget',`New family: ${declaredNewFamily}; padding: ${projections.padding}.`,...projections.scenarios.map(s=>`- Existing ${s.existing} + family ${s.newFamily} = ${s.altareTotal}; remaining under80000: ${s.remainingUnder80000}; with sibling9744: ${s.knownCombinedWithAspergillum}.`),'','## Fixed-bank alternative',`17 recipes × 1280 [16,16,5] = ${fixedBanks.declaredNewFamily}; padding ${fixedBanks.padding}; ${fixedBanks.extraVsMinimum} more declared states than the minimum.`,...fixedBanks.scenarios.map(s=>`- Existing ${s.existing}: total ${s.altareTotal}; remaining under80000 ${s.remainingUnder80000}; with sibling9744 ${s.knownCombinedWithAspergillum}.`),'','## Scope and limitations',...notes.map(n=>`- ${n}`),'','Run: node --experimental-strip-types tools/audit-pedestal-textile-budget.mjs',''].join('\n'));
console.log(JSON.stringify({totals,projections,fixedBanks,rows,output},null,2));
