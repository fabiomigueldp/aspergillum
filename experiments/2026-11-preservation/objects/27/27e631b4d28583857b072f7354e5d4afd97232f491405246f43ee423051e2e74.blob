from pathlib import Path
import numpy as np,json,time
from mathutils.bvhtree import BVHTree
O=Path(__file__).resolve().parent;B=O.parent.parent;body=np.load(O/'source-part15.npz');src=np.load(B/'evidence/source_meshes.npz');meta=json.loads((B/'evidence/source-export.json').read_text());f=src['high_f'][:meta['parts'][0]['high_triangles']];v=src['high_v'][:f.max()+1];ta=BVHTree.FromPolygons(body['points'].tolist(),body['triangles'].tolist(),all_triangles=True,epsilon=0);tb=BVHTree.FromPolygons(v.tolist(),f.tolist(),all_triangles=True,epsilon=0);p=np.array(ta.overlap(tb),dtype=np.int64);print('Broadphase candidates',len(p),flush=True);pairs=[];ww=[]
for st in range(0,len(p),20000):
 pp=p[st:st+20000];a=body['points'][body['triangles'][pp[:,0]]];b=v[f[pp[:,1]]];ok=np.zeros(len(pp),bool)
 for orig,tar in [(a,b),(b,a)]:
  e1,e2=tar[:,1]-tar[:,0],tar[:,2]-tar[:,0]
  for k in range(3):
   x=orig[:,k];dr=orig[:,(k+1)%3]-x;h=np.cross(dr,e2);det=np.sum(e1*h,axis=1);valid=abs(det)>1e-20;den=np.where(valid,det,1);s=x-tar[:,0];u=np.sum(s*h,axis=1)/den;q=np.cross(s,e1);vv=np.sum(dr*q,axis=1)/den;t=np.sum(e2*q,axis=1)/den;z=valid&(t>1e-8)&(t<1-1e-8)&(u>1e-8)&(vv>1e-8)&(u+vv<1-1e-8);ok|=z;ww.append(x[z]+t[z,None]*dr[z])
 pairs.append(pp[ok]);print('Tested',st+len(pp),'strict batch',int(ok.sum()),flush=True)
pairs=np.concatenate(pairs) if pairs else np.zeros((0,2),int);w=np.concatenate(ww) if ww else np.zeros((0,3));r={'method':'Original evaluated V75 TESTE29 band versus original evaluated anatomy15; BVH epsilon0 plus vectorized strict float64 segments, both directions. Same criterion as gate; no alpha.','source_band_triangles':len(f),'source_body_triangles':len(body['triangles']),'bvh_candidates':len(p),'strict_pairs':len(pairs),'body_faces':len(np.unique(pairs[:,0])),'band_faces':len(np.unique(pairs[:,1])),'bbox_xyz':[w.min(0).tolist(),w.max(0).tolist()] if len(w) else None,'limitation':'Source baseline only; does not approve intentional overlap or V5 band contact.'};(O/'original-band-source-contact.json').write_text(json.dumps(r,indent=2));np.savez_compressed(O/'original-band-source-contact.npz',pairs=pairs,witnesses=w);print('COMPLETE',r,flush=True)
