from pathlib import Path
import json,gzip,hashlib,numpy as np
from PIL import Image
from scipy.spatial.transform import Rotation
O=Path(__file__).resolve().parent;V=O.parent;B=V.parent;W=V/'export_work';T=V/'resource_pack/textures/entity';records=[json.loads(x)for x in gzip.open(W/'transport_faces.jsonl.gz','rt')];prov=np.load(W/'pbr-texel-provenance.npz');geo=json.loads((V/'resource_pack/models/entity/paz_v75_v14_lab_sculpture.geo.json').read_text())['minecraft:geometry'][0]
col=np.array(Image.open(T/'paz_v75_v14_lab_pbr_experimental.png').convert('RGBA'));nr=np.array(Image.open(T/'paz_v75_v14_lab_pbr_experimental_normal_dx.png').convert('RGBA'));oldnr=np.array(Image.open(W/'legacy-normal-dx.png').convert('RGBA'));oldcol=np.array(Image.open(W/'legacy-color.png').convert('RGBA'));band=np.load(B/'band_shell_v13/constrained_fit/retained-band.npz');anatomy=np.load(B/'body_interface_v9/constrained_fit/retained-anatomy.npz');high=np.load(B/'shell_band_v3/evidence/band-source.npz');highuv=np.load(B/'shell_band_v3/evidence/band-source-parameters.npz')['uv'];wall=np.load(B/'shell_band_v3/evidence/band-source-wall-classes.npz')['wall_class'];low=np.load(B/'pbr_normals_v2/evidence/repaired_meshes.npz')
prov=dict(prov);band=dict(band);anatomy=dict(anatomy);high=dict(high);low=dict(low)
start_normal_hash=hashlib.sha256((T/'paz_v75_v14_lab_pbr_experimental_normal_dx.png').read_bytes()).hexdigest()
start_prov_hash=hashlib.sha256((W/'pbr-texel-provenance.npz').read_bytes()).hexdigest()
A=np.array([[1,0,0],[0,0,1],[0,-1,0.]])
def norm(v):return v/np.maximum(np.linalg.norm(v,axis=-1,keepdims=True),1e-30)
def basis(p):
 u=norm(p[1]-p[0]);w=p[2]-p[0];v=norm(w-(w@u)*u);return np.column_stack([u,v,np.cross(u,v)])
def decode(rgb):
 d=rgb.astype(float)/255*2-1;d[...,1]*=-1;return norm(d)
Y,X=np.mgrid[:20,:20];pix=np.stack([X+.5,Y+.5,np.ones_like(X)],-1);stats={p:{'faces':0,'covered_pixels':0,'max_angle_degrees':0.,'sum_angle_degrees':0.,'negative_tangent_z_pixels':0,'legacy_uncovered_sample_pixels':0,'identity_faces':0,'identity_color_normal_exact':True,'legacy_uncovered_sample_faces':[]}for p in [0,1,15]};checks={'legacy_color_exact':bool(np.array_equal(col[:2048,:2048],oldcol)),'legacy_normal_exact':bool(np.array_equal(nr[:2048,:2048],oldnr)),'source_wall_identity':True,'source_barycentric_range':True,'all_flat_tiles_neutral':True,'identity_flags_correct':True,'anatomy_rotations_correct':True};maxUV=0.;maxQ=0.;maxBarySum=0.
for r in records:
 p=r['part'];fi=r['native_triangle_index'];ci=r['cube_index'];cube=geo['bones'][p]['cubes'][ci];M=Rotation.from_euler('xyz',np.array(cube['rotation'])*[-1,-1,1],degrees=True).as_matrix();tx,ty=cube['uv']['south']['uv'];mask=col[ty:ty+20,tx:tx+20,3]>0;rgb=nr[ty:ty+20,tx:tx+20,:3];decoded=decode(rgb);actual=decoded@M.T;st=stats[p];st['faces']+=1;st['covered_pixels']+=int(mask.sum());st['negative_tangent_z_pixels']+=int((mask&(decoded[...,2]<0)).sum())
 if p==0 and band['face_parts'][fi]in [0,1]:
  ids=prov['band_high_source_face'][fi];b=prov['band_high_source_barycentric'][fi].astype(float);checks['source_wall_identity'] &= bool(np.all(wall[ids]==band['face_parts'][fi]));checks['source_barycentric_range'] &= bool(b.min()>=-1e-7 and b.max()<=1+1e-7);maxBarySum=max(maxBarySum,float(np.max(abs(b.sum(-1)-1))));uv=(highuv[high['triangles'][ids]]*b[...,None]).sum(-2);weights=pix@np.array(r['pixel_to_native_barycentric']).T;weights=np.maximum(weights,0);weights/=weights.sum(-1,keepdims=True);targetUV=weights@band['source_uv'][band['triangles'][fi]];maxUV=max(maxUV,float(abs(uv-targetUV).max()));expected=norm((high['normals'][high['triangles'][ids]]*b[...,None]).sum(-2))@A.T
 elif p==15:
  oldfi=int(anatomy['source_face_indices'][fi]);oldpts=low['low_v'][low['low_f'][oldfi]];newpts=anatomy['points'][anatomy['triangles'][fi]];identity=np.array_equal(oldpts,newpts);checks['identity_flags_correct'] &= identity==bool(prov['anatomy_identity_face'][fi]);Q=np.eye(3)if identity else basis(newpts@A.T)@basis(oldpts@A.T).T;Qgot=prov['anatomy_rotation_old_bb_to_new_bb'][fi];maxQ=max(maxQ,float(abs(Q-Qgot).max()));checks['anatomy_rotations_correct'] &= abs(np.linalg.det(Qgot)-1)<1e-10 and np.max(abs(Q-Qgot))<1e-10;xy=prov['anatomy_legacy_texel_xy'][fi];oldrgb=oldnr[xy[...,1],xy[...,0],:3];oc=oldcol[xy[...,1],xy[...,0]];k=int(np.argmax(np.linalg.norm(np.roll(oldpts,-1,axis=0)-oldpts,axis=1)));OM=basis(np.roll(oldpts@A.T,-k,axis=0));expected=norm(decode(oldrgb)@OM.T@Q.T);outside=int((mask&(oc[...,3]==0)).sum());st['legacy_uncovered_sample_pixels']+=outside
  if outside:st['legacy_uncovered_sample_faces'].append({'face':fi,'pixels':outside})
  if identity:
   st['identity_faces']+=1;st['identity_color_normal_exact'] &= bool(np.array_equal(rgb,oldrgb) and np.array_equal(col[ty:ty+20,tx:tx+20,:3],oc[...,:3]))
 else:
  checks['all_flat_tiles_neutral'] &= bool(np.all(rgb==[128,128,255]));expected=np.broadcast_to(M[:,2],(20,20,3))
 angles=np.degrees(np.arccos(np.clip((actual*expected).sum(-1),-1,1)))[mask];st['max_angle_degrees']=max(st['max_angle_degrees'],float(angles.max()));st['sum_angle_degrees']+=float(angles.sum())
for st in stats.values():st['mean_angle_degrees']=st.pop('sum_angle_degrees')/st['covered_pixels'];st['identity_color_normal_exact']=bool(st['identity_color_normal_exact'])
assert start_normal_hash==hashlib.sha256((T/'paz_v75_v14_lab_pbr_experimental_normal_dx.png').read_bytes()).hexdigest()
assert start_prov_hash==hashlib.sha256((W/'pbr-texel-provenance.npz').read_bytes()).hexdigest()
rep={'checks':{k:bool(v)for k,v in checks.items()},'stats':stats,'max_source_uv_error_from_float32_provenance':maxUV,'max_barycentric_sum_error':maxBarySum,'max_anatomy_frame_matrix_error':maxQ,'normal_file_sha256':start_normal_hash,'provenance_sha256':start_prov_hash,'interpretation':'Decoded normal vectors checked against explicit saved source-face lineage and independent cube frame. This verifies declared partial transfer, not a complete new highpoly bake.','limitations':['12,664 shell faces and258 band returns/closures have neutral normal placeholders, lacking source relief.','Changed anatomy uses per-face frame rotation of old sampled normal; highpoly/current-position correspondence is not established.','307 newly covered anatomy pixels use a declared nearest-covered-pixel fallback within the same legacy tile; this remains a resampling approximation.','DirectX green sign and tangent basis in real Minecraft are untested.']};(O/'pbr-independent-audit.json').write_text(json.dumps(rep,indent=2,allow_nan=False));print(json.dumps(rep,indent=2))
