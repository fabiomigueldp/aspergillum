import bpy,numpy as np,json,bmesh
from mathutils.bvhtree import BVHTree
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'interactive-whole-cloth-cage-study.blend',use_scripts=False);o=bpy.data.objects['GUI STUDY — whole-cloth cage NOT APPROVED'];bm=bmesh.new();bm.from_mesh(o.data);bmesh.ops.recalc_face_normals(bm,faces=bm.faces);bm.to_mesh(o.data);bm.free();cap=o.vertex_groups.new(name='Coverage cap source');cap.add(list(range(336)),1,'REPLACE');cap.add(list(range(336,len(o.data.vertices))),0,'REPLACE');th=o.vertex_groups.new(name='Thickness original ratio');th.add(list(range(336)),.1,'REPLACE');th.add(list(range(336,len(o.data.vertices))),1,'REPLACE');md=o.modifiers.new('Refine before coverage','SUBSURF');md.levels=2;md.render_levels=2;sw=o.modifiers.new('External coverage constraint','SHRINKWRAP');sw.target=bpy.data.objects['Maria — anatomia feminina adaptada CC0'];sw.wrap_method='NEAREST_SURFACEPOINT';sw.wrap_mode='ABOVE_SURFACE';sw.offset=.004;sw.vertex_group=cap.name;so=o.modifiers.new('Positive stone wall','SOLIDIFY');so.thickness=.006;so.offset=-1;so.vertex_group=th.name;so.thickness_vertex_group=0;bpy.context.view_layer.update();dg=bpy.context.evaluated_depsgraph_get();em=o.evaluated_get(dg).to_mesh();em.calc_loop_triangles();P=np.array([v.co[:] for v in em.vertices]);T=[list(t.vertices) for t in em.loop_triangles];weights=[]
for v in em.vertices:
 weights.append(next((g.weight for g in v.groups if g.group==cap.index),0))
o.evaluated_get(dg).to_mesh_clear();W=np.array(weights);tree=BVHTree.FromPolygons(P.tolist(),T,all_triangles=True);D=np.load(r+'neck-collar-exact-obstacles.npz');head=BVHTree.FromPolygons(D['skin_points'].tolist(),D['skin_triangles'].tolist(),all_triangles=True);pairs=tree.overlap(head);selfpairs=[(a,b) for a,b in tree.overlap(tree) if a<b and not set(T[a])&set(T[b])];capfaces=np.array([min(W[f])>.999 for f in T]);fullcapids=np.where(W>.999)[0];rp={'modifier_order':['Subsurf2','Shrinkwrap external4mm cap group','Solidify0.6..6mm inward'],'evaluated_vertices':len(P),'head_pairs_total':len(pairs),'head_pairs_pure_cap':sum(capfaces[a] for a,b in pairs).item(),'self_pairs_total':len(selfpairs),'self_pairs_touching_pure_cap':sum(capfaces[a] or capfaces[b] for a,b in selfpairs).item(),'pure_cap_vertices':len(fullcapids),'cap_bounds':[P[fullcapids].min(0).tolist(),P[fullcapids].max(0).tolist()],'blend_saved':False,'status':'snapshot triangle validation; shrinkwrap vertices alone not proof'};json.dump(rp,open(r+'interactive-cap-clearance-proof.json','w'),indent=2);np.savez(r+'interactive-cap-clearance-proof.npz',points=P,triangles=np.array(T),cap_weights=W);print(rp)
