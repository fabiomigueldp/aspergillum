bpy.ops.wm.open_mainfile(filepath=r+'cuff-manual-mask-filled-trial.blend',use_scripts=False);o=bpy.data.objects[name];m=o.data;a=m.attributes['.sculpt_mask'];raw=[v.value for v in a.data];dg=bpy.context.evaluated_depsgraph_get();sc=bpy.context.scene
v=next(a.spaces.active.region_3d for a in bpy.data.screens['Sculpting'].areas if a.type=='VIEW_3D');origin=v.view_matrix.inverted().translation
