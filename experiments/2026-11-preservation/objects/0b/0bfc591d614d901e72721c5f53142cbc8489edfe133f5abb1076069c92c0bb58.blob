allowed=support|visible;adj=[[] for _ in m.vertices]
for e in m.edges:
 i,j=e.vertices
 if i in allowed and j in allowed:adj[i].append(j);adj[j].append(i)
distances={i:0. for i in support};q=[(0.,i) for i in support];heapq.heapify(q)
while q:
 d,i=heapq.heappop(q)
 if d!=distances[i]:continue
 for j in adj[i]:
  nd=d+(m.vertices[i].co-m.vertices[j].co).length
  if nd<=.04 and nd<distances.get(j,1e9):distances[j]=nd;heapq.heappush(q,(nd,j))
accepted=visible&distances.keys()
for i,v in enumerate(a.data):v.value=raw[i] if i in accepted else old[i]
new=accepted-support
report={'camera_origin':list(origin),'raw_changed_count':len(changed),'visible_envelope_count':len(visible),'accepted_count':len(accepted),'new_support_count':len(new),'rejected_increment_count':len(changed-accepted),'posterior_support':sum(m.vertices[i].co.y>=0 and v.value>0 for i,v in enumerate(a.data)),'new_max_geodesic':max([distances[i] for i in new],default=0),'criteria':'Scene first-hit raycast within 0.2 mm; front-facing; original cuff bbox + 2mm; connected geodesic <=40mm from original support; no deformation'}
