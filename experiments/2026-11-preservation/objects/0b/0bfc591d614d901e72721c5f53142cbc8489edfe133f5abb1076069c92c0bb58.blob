for i in changed:
 p=o.matrix_world@m.vertices[i].co;ray=p-origin;dist=ray.length;hit,loc,normal,idx,obj,mat=sc.ray_cast(dg,origin,ray.normalized(),distance=dist+.001)
 if hit and obj.original==o and abs((loc-origin).length-dist)<.0002 and normal.dot(-ray)>0:visible.add(i)
# Constrain to previous anterior cuff envelope; connectivity can only traverse original support plus visible new vertices.
mins=[min(m.vertices[i].co[j] for i in support) for j in range(3)];maxs=[max(m.vertices[i].co[j] for i in support) for j in range(3)]
