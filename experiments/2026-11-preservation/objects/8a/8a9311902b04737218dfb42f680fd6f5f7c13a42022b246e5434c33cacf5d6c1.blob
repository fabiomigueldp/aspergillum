import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import crypto from 'node:crypto';
import {codec,blockLayout} from './compact-block-layout.mjs';
const root=path.resolve(import.meta.dirname,'..'),baseline=path.resolve(process.argv[2]??path.join(root,'../altare-two-pillars-integration-20261103')),art=path.resolve(process.argv[3]??path.join(root,'../altare-catalog-compaction-20261103'));
const reportDir=path.join(root,'out/state-compaction');fs.mkdirSync(reportDir,{recursive:true});const hashes={};const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
function bytes(dir,p){const b=fs.readFileSync(path.join(dir,p));hashes[path.relative(root,path.join(dir,p))]=sha(b);return b;}const json=(dir,p)=>JSON.parse(bytes(dir,p));
const product=s=>Object.entries(s??{}).reduce((rows,[k,vs])=>rows.flatMap(row=>vs.map(v=>({...row,[k]:v}))),[{}]);
const canonical=x=>Array.isArray(x)?x.map(canonical):x&&typeof x==='object'?Object.fromEntries(Object.entries(x).sort(([a],[b])=>a.localeCompare(b)).map(([k,v])=>[k,canonical(v)])):x;
const expressions=new Map();function evaluate(s,state){if(typeof s!=='string')return s;let f=expressions.get(s);if(!f){f=Function('q','math',`return (${s});`);expressions.set(s,f);}return f({block_state:k=>state[k]},{floor:Math.floor,mod:(a,b)=>a%b});}
function effective(b,s){const c=structuredClone(b.components),applied=new Set();for(const p of b.permutations??[])if(evaluate(p.condition,s)){for(const k of Object.keys(p.components)){assert(!applied.has(k),`Overlapping component ${k}`);applied.add(k);}Object.assign(c,structuredClone(p.components));}const g=c['minecraft:geometry'];if(g?.bone_visibility)for(const[k,v]of Object.entries(g.bone_visibility))g.bone_visibility[k]=!!evaluate(v,s);return canonical(c);}
function normalizeOld(s,kind){const occupied=s[kind==='aspersorium'?'aspergillum:has_aspergillum':'aspergillum:table_has_aspergillum'],cosmetic=s[kind==='aspersorium'?'aspergillum:cosmetic':'aspergillum:table_cosmetic'];return {cosmeticIndex:occupied?cosmetic:null,...(kind==='aspersorium'?{waterUnits:Math.min(16,s['aspergillum:water_base']+s['aspergillum:water_offset'])}:{})};}
for(const p of ["src/domain/block-state-layout.ts","tools/compact-block-layout.mjs","tools/generate-assets.mjs","package.json"])bytes(root,p);
const rows=[];let oldChecks=0,newChecks=0,reservedChecks=0;
for(const kind of ['aspersorium','sacristan_table']){
 const file=`packs/behavior/blocks/${kind}.block.json`,before=json(baseline,file)['minecraft:block'],after=json(root,file)['minecraft:block'],contract=blockLayout(kind);assert.deepEqual(after.description.states,contract.states);
 const encode=kind==='aspersorium'?codec.encodeAspersoriumContents:codec.encodeTableContents,decode=kind==='aspersorium'?codec.decodeAspersoriumContents:codec.decodeTableContents;
 const oldRows=product(before.description.states),newRows=product(after.description.states);let normalizationCount=0;
 for(const s of oldRows){const t=normalizeOld(s,kind),next={...encode(t),[contract.rotation]:s[contract.rotation]};assert.deepEqual(decode(next),t);const previous=effective(before,s),current=effective(after,next);
  if(t.cosmeticIndex===null){delete previous['minecraft:material_instances'];delete current['minecraft:material_instances'];}assert.deepEqual(current,previous);oldChecks++;
  const oldCosmetic=s[kind==='aspersorium'?'aspergillum:cosmetic':'aspergillum:table_cosmetic'];if((t.cosmeticIndex===null&&oldCosmetic!==0)||(kind==='aspersorium'&&s['aspergillum:water_base']+s['aspergillum:water_offset']>16))normalizationCount++;
 }
 for(const s of newRows){let t;try{t=decode(s);}catch(e){assert.match(e.message,/padding/);t=kind==='aspersorium'?{waterUnits:0,cosmeticIndex:null}:{cosmeticIndex:null};reservedChecks++;}
  const old=kind==='aspersorium'?{'aspergillum:water_base':t.waterUnits>=9?9:0,'aspergillum:water_offset':t.waterUnits>=9?t.waterUnits-9:t.waterUnits,'aspergillum:has_aspergillum':t.cosmeticIndex!==null,'aspergillum:cosmetic':t.cosmeticIndex??0}:{'aspergillum:table_has_aspergillum':t.cosmeticIndex!==null,'aspergillum:table_cosmetic':t.cosmeticIndex??0};old[contract.rotation]=s[contract.rotation];assert.deepEqual(effective(after,s),effective(before,old));newChecks++;
 }
 rows.push({kind,before:oldRows.length,after:newRows.length,normalizations:normalizationCount,states:contract.states});
}
for(const p of ["tools/build-audio.mjs","assets-src/audio/audio-recipes.json","assets-src/audio/audio-catalog.json"])assert.deepEqual(bytes(root,p),bytes(baseline,p),`Audio source changed: ${p}`);
const walk=(p)=>fs.readdirSync(p,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(p,e.name)):[path.join(p,e.name)]);
let sameResourceFiles=0,importedAudioFiles=0,sameToolchainResourceFiles=0;const rp='packs/resource';for(const p of walk(path.join(art,rp))){const rel=path.relative(art,p);if(rel===`${rp}/manifest.json`)continue;const reference=rel.endsWith('.ogg')?baseline:art;assert.deepEqual(bytes(root,rel),bytes(reference,rel),`Resource changed against its pinned reference: ${rel}`);sameResourceFiles++;if(rel.endsWith('.ogg'))importedAudioFiles++;else sameToolchainResourceFiles++;}
const count=(dir)=>walk(path.join(dir,'packs/behavior/blocks')).filter(p=>p.endsWith('.json')).reduce((n,p)=>n+product(JSON.parse(fs.readFileSync(p))['minecraft:block'].description.states).length,0);
const aspergillum=count(root),altare=count(path.join(root,'addons/altare'));assert.equal(aspergillum,5008);assert.equal(altare,59840);assert(aspergillum+altare<=65536);
for(const[p,h]of Object.entries(hashes))assert.equal(sha(fs.readFileSync(path.resolve(root,p))),h,`Input changed during proof: ${p}`);
const report={createdAt:new Date().toISOString(),status:'passed',oldChecks,newChecks,reservedChecks,sameResourceFiles,resourceReferences:{importedAudioFiles,sameToolchainResourceFiles},blocks:rows,budget:{aspergillum,altare,combined:aspergillum+altare,reference:65536,remaining:65536-aspergillum-altare},limits:['Raw state normalization is explicit; exact inverse restoration requires original snapshots.','Reserved codes render empty/dry but runtime rejects them, without claiming recovery from corruption.','Visible aliases use unchanged source art; the separate pixel audit proves only the non-item atlas half is sampled by empty geometry.','All 48 OGGs and WAV master files are restored to exact imported-baseline bytes; the diagnostic build verifies pinned hashes instead of re-encoding. The archived prior reconstruction changed PCM in 33 of 34 byte-different OGGs, established by two decoders.', 'No worlds, Minecraft engine or gameplay event handlers are exercised by this generated-asset proof.'],hashes};fs.writeFileSync(path.join(reportDir,'generated-asset-proof.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({...report,hashes:undefined},null,2));
