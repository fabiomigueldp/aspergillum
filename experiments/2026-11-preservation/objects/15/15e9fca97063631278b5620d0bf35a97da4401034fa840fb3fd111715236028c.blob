import bpy,numpy as np,json,sys,hashlib,time
from pathlib import Path
from mathutils import Vector
B=Path('.').resolve();R=B/'lit_surface_v16/lighting_research';E=B/'lit_surface_v16/evidence';T=B/'lit_surface_v16/transparent_trim';contract=np.load(B/'opaque_transport_v15/shared_mask/transport_arrays.npz');source_lookup={(int(pi),int(ci)):(int(nf),int(h)) for pi,ci,nf,h in zip(contract['part'],contract['cube_index'],contract['native_face'],contract['half'])}
tags=sys.argv[sys.argv.index('--')+1:];records=[]
for tag in tags:
 src=E/(tag+'-diagnostic.blend');assert src.exists(),src
 g=json.loads((T/(tag+'.geo.json')).read_text())['minecraft:geometry'][0];bones={int(b['name'].split('_')[1]):b for b in g['bones']};mapping=np.load(T/(tag+'-cube-map.npz'));lookup={(int(pi),int(ni)):int(oi) for pi,ni,oi in zip(mapping['part'],mapping['new_cube_index'],mapping['original_cube_index'])};assert len(lookup)==len(mapping['part'])
 ids={}
 for pi in [0,1,15]:
  cubes=bones[pi]['cubes'];assert all(len(c['uv'])==1 for c in cubes)
  ids[pi]=[source_lookup[(pi,lookup[(pi,i)])] for i in range(len(cubes))]
 arrays={};checks=[]
 for mode in ['ids','coverage']:
  bpy.ops.wm.open_mainfile(filepath=str(src));s=bpy.context.scene;s.render.threads_mode='FIXED';s.render.threads=2;s.cycles.samples=1 if mode=='ids' else 48;s.cycles.use_adaptive_sampling=False;s.cycles.use_denoising=False;s.cycles.seed=0;s.cycles.pixel_filter_type='BOX' if mode=='ids' else 'BLACKMAN_HARRIS';s.cycles.filter_width=.01 if mode=='ids' else 1.5;s.cycles.max_bounces=0;s.cycles.diffuse_bounces=0
  if mode=='coverage':bg=s.world.node_tree.nodes.get('Background');bg.inputs['Color'].default_value=(0,0,0,1);bg.inputs['Strength'].default_value=0
  cam=s.camera;cam.location=(.035,-3.5,3.58);cam.rotation_euler=(Vector((.035,-.3,3.58))-cam.location).to_track_quat('-Z','Y').to_euler();cam.data.ortho_scale=.52
  s.render.resolution_x=s.render.resolution_y=1000;s.render.resolution_percentage=100;s.render.use_border=True;s.render.use_crop_to_border=True;s.render.border_min_x=.27;s.render.border_max_x=.74;s.render.border_min_y=.4;s.render.border_max_y=.6
  for ob in s.objects:
   if ob.type!='MESH':continue
   me=ob.data;pi=int(ob.name.split(' ')[0].split('_')[1]);pos=np.array([v.co[:] for v in me.vertices],np.float32);uv=np.array([v.uv[:] for v in me.uv_layers.active.data],np.float32);h=lambda a:hashlib.sha256(a.tobytes()).hexdigest();before=[h(pos),h(uv)]
   if pi in ids:
    assert len(me.polygons)==len(ids[pi]);assert all(list(p.vertices)==list(range(p.index*4,p.index*4+4)) for p in me.polygons)
   a=me.color_attributes.new(name='SourceIdDiagnostic',type='FLOAT_COLOR',domain='CORNER')
   for p in me.polygons:
    nf,half=ids[pi][p.index] if pi in ids else (p.index,0)
    color=((nf+1)/65536,(pi+1)/32,(half+1)/4,1) if mode=='ids' else (int(pi==0),int(pi==1),int(pi not in[0,1]),1)
    for li in p.loop_indices:a.data[li].color=color
   assert before==[h(np.array([v.co[:] for v in me.vertices],np.float32)),h(np.array([v.uv[:] for v in me.uv_layers.active.data],np.float32))]
   if mode=='ids':checks.append({'part':pi,'polygons':len(me.polygons),'positions_sha256':before[0],'uv_sha256':before[1],'new_original_contract_mapping_verified':pi in ids})
  for m in bpy.data.materials:
   if not m.use_nodes:continue
   n=m.node_tree.nodes;l=m.node_tree.links
   for bs in list(n):
    if bs.type!='BSDF_DIFFUSE':continue
    em=n.new('ShaderNodeEmission');attr=n.new('ShaderNodeAttribute');attr.attribute_name='SourceIdDiagnostic';l.new(attr.outputs['Color'],em.inputs['Color'])
    for lk in list(bs.outputs[0].links):l.new(em.outputs[0],lk.to_socket)
    n.remove(bs)
  s.render.image_settings.file_format='OPEN_EXR';s.render.image_settings.color_depth='32';s.render.image_settings.color_mode='RGBA';s.render.filepath=str(R/f'{tag}-{mode}.exr');t=time.time();bpy.ops.render.render(write_still=True);im=bpy.data.images.load(s.render.filepath);arrays[mode]=np.array(im.pixels[:],np.float32).reshape(im.size[1],im.size[0],4)[::-1];records.append({'tag':tag,'mode':mode,'seconds':time.time()-t,'samples':s.cycles.samples,'filter':s.cycles.pixel_filter_type,'filter_width':s.cycles.filter_width})
 np.savez_compressed(R/(tag+'-identity-coverage.npz'),**arrays)
 (R/(tag+'-identity-provenance.json')).write_text(json.dumps({'source':str(src),'source_sha256':hashlib.sha256(src.read_bytes()).hexdigest(),'lineage':str(T/(tag+'-cube-map.npz')),'lineage_sha256':hashlib.sha256((T/(tag+'-cube-map.npz')).read_bytes()).hexdigest(),'mapping':'For parts0/1/15: output polygon index=new_cube_index (verified sole cube face and importer consecutive4indices); cube-map gives original_cube_index; V15 transport_arrays gives native_face,half. Other parts use unchanged polygon index.','geometry_and_UV_unchanged_by_diagnostic':checks,'records':[x for x in records if x['tag']==tag]},indent=2))
print('TRIM_IDENTITY_CONTROLS_DONE',tags)
