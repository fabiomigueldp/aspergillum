import numpy as np,json
from pathlib import Path
from mathutils import Vector
from mathutils.bvhtree import BVHTree
R=Path(__file__).resolve().parents[1];d=np.load(R/'evidence/repaired_meshes.npz');meta=json.load(open(R.parent/'evidence/source-export.json'));hv=d['high_v'];hf=d['high_f'];hn=d['high_n'];lv=d['low_v'];ns=np.zeros_like(lv);foff=0
for part in meta['parts']:
 f=hf[foff:foff+part['high_triangles']];foff+=part['high_triangles'];first=int(f.min());last=int(f.max())+1
 tree=BVHTree.FromPolygons(hv[first:last].tolist(),(f-first).tolist(),all_triangles=True)
 for i in range(part['vertex_start'],part['vertex_start']+part['vertex_count']):
  p,n,fi,dist=tree.find_nearest(Vector(lv[i]));a,b,c=hv[f[fi]];v0=b-a;v1=c-a;v2=np.array(p)-a
  d00=np.dot(v0,v0);d01=np.dot(v0,v1);d11=np.dot(v1,v1);d20=np.dot(v2,v0);d21=np.dot(v2,v1);den=d00*d11-d01*d01
  if abs(den)>1e-24:
   wb=(d11*d20-d01*d21)/den;wc=(d00*d21-d01*d20)/den;w=np.clip([1-wb-wc,wb,wc],0,1);w/=sum(w);normal=w@hn[f[fi]]
  else:normal=np.array(n)
  ns[i]=normal/max(np.linalg.norm(normal),1e-12)
 print('Normals matched source part',part['name'],flush=True)
np.savez_compressed(R/'evidence/part_normal_bake.npz',source_normal=ns,ao=d['ao'])
