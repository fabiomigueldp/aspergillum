D=json.load(open(r+'neck-boundary-integral-growth.json'));removed=set(D['removed_faces']);loops=json.load(open(r+'neck-contour-projection-audit.json'))['ordered_loops'];loops.sort(key=lambda c:p[c,0].mean());verts=p.tolist();newfaces=[];reports=[]
for ci,loop in enumerate(loops):
 yz=p[loop,1:];n=len(loop);area=sum(yz[i,0]*yz[(i+1)%n,1]-yz[(i+1)%n,0]*yz[i,1] for i in range(n))
 if area<0:loop=list(reversed(loop));yz=p[loop,1:]
 def inside(pt):
  y,z=pt;flag=False
  for a,b in zip(yz,np.roll(yz,-1,axis=0)):
   if (a[1]>z)!=(b[1]>z) and y<(b[0]-a[0])*(z-a[1])/(b[1]-a[1])+a[0]:flag=not flag
  return flag
 pts=[Vector(v) for v in yz];spacing=.002
 for z in np.arange(yz[:,1].min()+spacing,yz[:,1].max(),spacing):
  for y in np.arange(yz[:,0].min()+spacing,yz[:,0].max(),spacing):
   if inside((y,z)) and np.linalg.norm(yz-[y,z],axis=1).min()>.0007:pts.append(Vector((y,z)))
 vv,ee,ff,orig,_,faceorig=delaunay_2d_cdt(pts,[],[list(range(n))],1,1e-8,True)
 ff=[f for f,ids in zip(ff,faceorig) if 0 in ids];ee=list({tuple(sorted((a,b))) for f in ff for a,b in zip(f,f[1:]+f[:1])});used={v for f in ff for v in f};mapping={};fixed={};adj=collections.defaultdict(set)
 for j,ids in enumerate(orig):
  old=[k for k in ids if k<n]
  if old:mapping[j]=loop[old[0]];fixed[j]=p[loop[old[0]],0]
 assert len(fixed)==n
 for a,b in ee:adj[a].add(b);adj[b].add(a)
 interior=[j for j in range(len(vv)) if j not in fixed and j in used];loc={j:k for k,j in enumerate(interior)};M=lil_matrix((len(interior),len(interior)));rhs=np.zeros(len(interior))
 for j in interior:
  k=loc[j];M[k,k]=len(adj[j])
  for b in adj[j]:
   if b in fixed:rhs[k]+=fixed[b]
   else:M[k,loc[b]]=-1
 sol=spsolve(M.tocsr(),rhs);xs=dict(fixed)
 for j in interior:
  y,z=vv[j];h,_,_,_=hb.ray_cast(Vector((-1,y,z)),Vector((1,0,0)),2);x=float(sol[loc[j]])
  if h is not None:x=min(x,h.x-(.006 if ci==0 else .003))
  xs[j]=x;mapping[j]=len(verts);verts.append([x,y,z])
 # outer normal -X; inner +X
 for f in ff:
  out=[mapping[j] for j in f]
  if ci==0:out.reverse()
  newfaces.append(tuple(out))
 reports.append({'layer':ci,'boundary_vertices':n,'interior_vertices':len(interior),'triangles':len(ff),'clearance_target':.006 if ci==0 else .003})
kept=[f for i,f in enumerate(fs) if i not in removed];nf=kept+newfaces;start=len(kept);tree=BVHTree.FromPolygons(verts,nf);hp=[(a,b) for a,b in hb.overlap(tree) if b>=start];sp=set((a,b) for a,b in tree.overlap(tree) if a<b and b>=start and not set(nf[a])&set(nf[b]));ec=collections.Counter(tuple(sorted((a,b))) for f in nf for a,b in zip(f,f[1:]+f[:1]));tri=np.array(newfaces);vp=np.array(verts);ar=np.linalg.norm(np.cross(vp[tri[:,1]]-vp[tri[:,0]],vp[tri[:,2]]-vp[tri[:,0]]),axis=1)/2
report={'method':'Constrained Delaunay regular YZ grid, preserved boundary, separate explicit shell offsets; unchanged anatomy and outside faces','layers':reports,'removed_faces':len(removed),'new_faces':len(newfaces),'patch_head_pairs':len(hp),'self_pairs_involving_new_patch':len(sp),'nonmanifold_edges':sum(n!=2 for n in ec.values()),'new_area_min':float(ar.min()),'new_area_max':float(ar.max()),'head_pairs':hp,'self_pairs':list(sp),'nonmanifold_details':[(e,n) for e,n in ec.items() if n!=2],'contact_triangles':[[verts[v] for v in nf[b]] for a,b in hp], 'self_contact_triangles':[[[verts[v] for v in nf[a]], [verts[v] for v in nf[b]]] for a,b in sp]}
json.dump(report,open(r+'V82-retopology-verification.json','w'),indent=2);print({k:v for k,v in report.items() if k not in ['head_pairs','self_pairs']})
assert len(hp)==0 and len(sp)==0 and report['nonmanifold_edges']==0
mesh=bpy.data.meshes.new('V82 local regular shell mesh');mesh.from_pydata(verts,[],nf);mesh.update();obj=bpy.data.objects.new('TESTE82 — reparo local de tecido retopologizado',mesh);bpy.context.collection.objects.link(obj)
