import bpy,math,json
from mathutils import Vector,Matrix
from mathutils.bvhtree import BVHTree
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'V63-opposite-ankle-trial.blend',use_scripts=False);R=bpy.data.objects['Maria — auréola lisa'].rotation_euler.to_matrix()@Matrix.Rotation(-math.pi/2,3,'X');Ri=R.transposed();head=bpy.data.objects['Maria — anatomia feminina adaptada CC0'];dg=bpy.context.evaluated_depsgraph_get();hv=[v.co.copy() for v in head.evaluated_get(dg).data.vertices];hf=[tuple(f.vertices) for f in head.data.polygons];hb=BVHTree.FromPolygons(hv,hf)
def sm(t):t=max(0,min(1,t));return t*t*(3-2*t)
def edge(a):
 e=3.50-.14*math.sin(a)**2-.35*max(0,-math.cos(a));return e-.025*sm((e-3.38)/.185)
def shift(a):return (.035*max(0,math.cos(a))**4-.045*math.exp(-((abs(a)-1.25)/.22)**2))*(1-sm((abs(a)-1.43)/.14))
def surface(a,z):
 center=R@Vector((-.44,1.012,z));d=R@Vector((math.sin(a),-math.cos(a),0));return hb.ray_cast(center+d*.7,-d,1.4)
o=bpy.data.objects['TESTE 34 — conexão de superfícies avaliadas'];old=[v.co.copy() for v in o.data.vertices];new=[p.copy() for p in old];miss=0;changed=[]
for i,p in enumerate(old[:160386]):
 l=Ri@p;a=math.atan2(l.x+.44,-(l.y-1.012));ds=shift(a)
 if abs(ds)<1e-8:continue
 t=max(0,min(1,(3.539-l.z)/max(.015,3.539-edge(a))));ds*=sm(t)
 if abs(ds)<1e-8:continue
 h,n,_,_=surface(a,l.z);hn,nn,_,_=surface(a,l.z+ds)
 if h is None or hn is None:miss+=1;continue
 offset=max(-.002,min(.002,(p-h).dot(n)));new[i]=hn+nn*offset;changed.append(i)
if not o.data.shape_keys:o.shape_key_add(name='Basis')
k=o.shape_key_add(name='TESTE70 — borda frontal alta e cobertura temporal');k.value=1
for i,p in enumerate(new):k.data[i].co=p
band=bpy.data.objects['TESTE 29 — faixa embutida com terminação suave'];bc=band.copy();bc.data=band.data.copy();bc.name='TESTE70 — faixa coordenada reversível';bpy.context.collection.objects.link(bc)
for v in bc.data.vertices:
 p=v.co.copy();l=Ri@p;a=math.atan2(l.x+.44,-(l.y-1.012));ds=shift(a)
 if abs(ds)<1e-8:continue
 h,n,_,_=surface(a,l.z);hn,nn,_,_=surface(a,l.z+ds)
 if h is None or hn is None:miss+=1;continue
 offset=max(-.002,min(.004,(p-h).dot(n)));v.co=hn+nn*offset
band.hide_render=True;band.hide_set(True)
fs=[tuple(f.vertices) for f in o.data.polygons]
def pairs(p):
 b=BVHTree.FromPolygons(p,fs);return set((a,c) for a,c in b.overlap(b) if a<c and not set(fs[a])&set(fs[c]))
before=pairs(old);after=pairs(new);flips=0;rat=[];cs=set(changed)
def av(p,f):return sum(((p[f[j]]-p[f[0]]).cross(p[f[j+1]]-p[f[0]])*.5 for j in range(1,len(f)-1)),Vector())
for f in fs:
 if not any(i in cs for i in f):continue
 a,b=av(old,f),av(new,f)
 if a.length>1e-12:rat.append(b.length/a.length);flips+=a.dot(b)<0
report={'source':'V63','method':'Existing baked cap reprojection only; coordinated separate hem; no added panels, no skull change','changed_cap_vertices':len(changed),'ray_misses':miss,'max_delta_m':max((a-b).length for a,b in zip(old,new)),'mantle_coordinate_delta_max':max((old[i]-new[i]).length for i in range(160386,len(old))),'area_ratios':[min(rat),max(rat)],'flipped_faces':flips,'baseline_self_pairs':len(before),'new_self_pairs':len(after-before),'rollback':'TESTE70 cap key=0; hide TESTE70 band and unhide TESTE29'};json.dump(report,open(r+'V70-veil-verification.json','w'),indent=2);print(report)
if flips or (after-before):raise RuntimeError('Invalid cap warp; no blend saved')
bpy.ops.wm.save_as_mainfile(filepath=r+'V70-veil-trial.blend')
