import numpy as np,json,sys
from pathlib import Path
O=Path(__file__).resolve().parent;R=O.parents[1];prefix=sys.argv[1] if len(sys.argv)>1 else 'adaptive-consistent';a=np.load(O/(prefix+'-assembly.npz'));b=np.load(R/'integration_v6/evidence/seam-hermite-physical-7p5-assembly.npz');m=np.load(R/'lateral_v7/evidence/director-cone-midfield.npz');where={int(x):i for i,x in enumerate(a['source_indices'])};oi=np.array([where[int(x)] for x in m['outer_source_ids']]);ii=np.array([where[int(x)] for x in m['inner_source_ids']]);d=np.linalg.norm(a['points'][ii]-a['points'][oi],axis=1);central=np.where((m['uv'][:,1]>=.2)&(m['uv'][:,1]<=.8))[0];cone=np.load(R/'lateral_v7/evidence/director-cone-assembly.npz');r={'source_points_bitwise_exact':bool(np.array_equal(a['points'][~a['generated_vertices']],b['points'][~b['generated_vertices']])),'source_indices_exact':bool(np.array_equal(a['source_indices'],b['source_indices'])),'triangles_exact_including_restored_mantle_winding':bool(np.array_equal(a['triangles'],b['triangles'])),'face_parts_exact':bool(np.array_equal(a['face_parts'],b['face_parts'])),'central_strip_shell_bitwise_exact_to_cone_control':bool(np.array_equal(a['points'][np.r_[oi[central],ii[central]]],cone['points'][np.r_[oi[central],ii[central]]])),'paired_thickness_max_abs_delta_mm':float(np.max(np.abs(d-2*m['half_thickness']))*1000),'generated_shell_vertices_moved_over_1e_12':int(np.sum(np.linalg.norm(a['points']-b['points'],axis=1)>1e-12)),'source_faces_counts':{str(i):int(np.sum(a['face_parts']==i)) for i in range(3)}};(O/(prefix+'-preservation.json')).write_text(json.dumps(r,indent=2));print(json.dumps(r,indent=2))
