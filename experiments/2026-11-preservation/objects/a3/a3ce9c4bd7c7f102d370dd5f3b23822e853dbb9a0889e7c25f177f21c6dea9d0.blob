import bpy,json,sys
from pathlib import Path
from mathutils import Vector
root=Path('/workspace/scratch/212c580ada5b/paz-bedrock-v75-prototype-20261103')
src=Path('/workspace/scratch/212c580ada5b/paz-refinement/gui-test/checkpoint-V75-20261102/V75-tunic-lower-trial.blend')
bpy.ops.wm.open_mainfile(filepath=str(src),use_scripts=False)
data=[]
for o in bpy.context.scene.objects:
 if o.type in ('MESH','CURVE','SURFACE','FONT'):
  bb=[o.matrix_world@Vector(v) for v in o.bound_box]
  d={'name':o.name,'type':o.type,'hidden':o.hide_render,'hidden_get':o.hide_get(),'hide_viewport':o.hide_viewport,'vertices':len(o.data.vertices) if o.type=='MESH' else None,'bbox':[[min(v[i] for v in bb),max(v[i] for v in bb)] for i in range(3)],'materials':[{'name':m.name,'diffuse':list(m.diffuse_color),'nodes':[(n.type,n.name) for n in m.node_tree.nodes] if m.use_nodes else []} for m in o.data.materials if m],'modifiers':[(m.name,m.type,m.show_render) for m in o.modifiers]}
  data.append(d)
(root/'evidence/source-inventory.json').write_text(json.dumps(data,indent=2))
print(json.dumps([d for d in data if not d['hidden']],indent=2))
