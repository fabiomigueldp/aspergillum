 const claims = new Set<string>();
 function key(dimensionId: string, location: Vector3): string {
   return `${dimensionId}|${location.x},${location.y},${location.z}`;
+}
+
+/** A current replacement is a reason to preserve evidence, never to redeliver. */
+function isLoadedAir(dimension: Dimension, location: Vector3): boolean {
+  try {
+    const block = dimension.getBlock(location);
+    if (block !== undefined && block.isValid === true && block.isAir === true) return true;
+    console.error(`[Aspergillum] Break recovery location ${key(dimension.id, location)} is not confirmed as loaded air; snapshot retained for inspection`);
+  } catch (error) {
+    console.error(`[Aspergillum] Could not inspect break recovery location ${key(dimension.id, location)}: ${String(error)}; snapshot retained for inspection`);
+  }
+  return false;
 }
 
 /** Capture identity at dispatch; never consume a later replacement block's registry entry. */
