from pathlib import Path
import json,hashlib,numpy as np
from PIL import Image
B=Path(__file__).resolve().parents[1];old=B.parent/'shell_band_v4/curvature_candidate';new=B/'retained_candidate'
def sh(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def packet(r):
 g=json.loads((r/'resource_pack/models/entity/paired_cap_band.geo.json').read_text())['minecraft:geometry'][0]
 imgs=[np.array(Image.open(r/'resource_pack/textures/entity'/n)) for n in ['paired_cap_band.png','paired_cap_band_normal_per_wall_dx.png']]
 return g,imgs
og,oi=packet(old);ng,ni=packet(new);bandgeo=og['bones'][1]==ng['bones'][1];results=[]
for name,oa,na in zip(['albedo','normal'],oi,ni):
 identical=0
 for a,b in zip(og['bones'][1]['cubes'],ng['bones'][1]['cubes']):
  u,v=a['uv']['south']['uv'];w,h=a['uv']['south']['uv_size'];x,y=b['uv']['south']['uv'];ww,hh=b['uv']['south']['uv_size']
  identical+=int(np.array_equal(oa[v:v+h,u:u+w],na[y:y+hh,x:x+ww]))
 results.append({'texture':name,'identical_band_tiles':identical,'total_band_tiles':1912})
rep={'band_mesh_byte_identical':sh(old/'evidence/band-paired.npz')==sh(new/'evidence/band-paired.npz'),'band_JSON_cube_packets_identical':bandgeo,'band_texture_tiles':results,'canonical_normal_baker':{'path':'shell_band_v3/tools/bake_wall_normals_bounded.py','sha256':sh(B.parent/'shell_band_v3/tools/bake_wall_normals_bounded.py'),'method_change':False},'atlas_before':[2048,2048],'atlas_after':[2048,2048],'uncompressed_color_plus_normal_before_mips_mib_before':32,'uncompressed_color_plus_normal_before_mips_mib_after':32,'cube_faces_before':8132,'cube_faces_after':7548,'face_saving_fraction':(8132-7548)/8132,'cap_triangles_before':6220,'cap_triangles_after':5636,'cap_saving_fraction':(6220-5636)/6220,'resource_files_before_bytes':sum(p.stat().st_size for p in old.glob('resource_pack/**/*') if p.is_file()),'resource_files_after_bytes':sum(p.stat().st_size for p in new.glob('resource_pack/**/*') if p.is_file()),'performance_tested':False,'comment':'Disk bytes are not GPU memory or performance; V4 has an extra rejected diagnostic normalmap, so file totals are not equivalent workloads.'}
(B/'evidence/preservation-and-cost.json').write_text(json.dumps(rep,indent=2));print(json.dumps(rep,indent=2));assert rep['band_mesh_byte_identical'] and bandgeo and all(x['identical_band_tiles']==1912 for x in results)
