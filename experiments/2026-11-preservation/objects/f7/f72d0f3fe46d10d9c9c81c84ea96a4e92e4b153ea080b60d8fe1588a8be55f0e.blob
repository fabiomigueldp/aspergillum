import numpy as np,json
from pathlib import Path
from mathutils.bvhtree import BVHTree
from mathutils import Vector
from collections import Counter
R=Path(__file__).resolve().parents[2];V=R/'shell_band_v4';S=np.load(R/'shell_band_v3/evidence/cap-source.npz');sp=S['points'];sf=S['triangles'];wc=np.load(R/'shell_band_v3/evidence/cap-source-wall-classes.npz')['wall_class'];params=np.load(V/'evidence/cap-source-parameters.npz')['params'];head=np.load(V/'evidence/head-source.npz');ht=BVHTree.FromPolygons(head['points'].tolist(),head['triangles'].tolist(),all_triangles=True)
def sd(q):
 p,n,_,d=ht.find_nearest(Vector(q));return float((Vector(q)-p).dot(n))
# Match earlier crown definition, all triangle source row parameters below40.
mask=(wc==0)&(params[sf,0].max(axis=1)<40);tri=sf[mask];vs=sp[tri];area=np.linalg.norm(np.cross(vs[:,1]-vs[:,0],vs[:,2]-vs[:,0]),axis=1)/2;rng=np.random.default_rng(20261103);sel=rng.choice(len(tri),20000,p=area/area.sum());uv=rng.random((20000,2));rt=np.sqrt(uv[:,0]);w=np.column_stack([1-rt,rt*(1-uv[:,1]),rt*uv[:,1]]);points=(vs[sel]*w[:,:,None]).sum(axis=1);highsd=np.array([sd(p) for p in points]);base=np.load(R/'shell_band_v3/constrained_source/evidence/cap-paired.npz');old=base['source_indices'];pair=np.load(V/'evidence/cap-source-pairing.npz');mapping=dict(zip(pair['outer'].tolist(),pair['inner'].tolist()));report={'sample_count':len(points),'seed':20261103,'high_crown_area':float(area.sum()),'method':'Identical area-weighted high outer crown samples for all variants; nearest point on each reduced OUTER wall. Head sign is closest-face-plane proxy. Crown high triangles have max row parameter<40.','limitations':'Monte Carlo area estimate; nearest projection is not parameter-exact. Not an exact SDF or collision certificate.','high_positive_samples':int((highsd>0).sum()),'high_above_0_1mm_samples':int((highsd>.0001).sum()),'variants':{}}
for name,path in [('V3f',R/'shell_band_v3/constrained_source/evidence/cap-paired.npz'),('07',V/'curvature_candidate/evidence/iteration-07.npz'),('08',V/'curvature_candidate/evidence/iteration-08.npz')]:
 a=np.load(path);p=a['points'];f=a['triangles'];ids=a['source_indices'];n=len(p)//2;outer=f[np.all(f<n,axis=1)];tree=BVHTree.FromPolygons(p.tolist(),outer.tolist(),all_triangles=True);nearest=[tree.find_nearest(Vector(q)) for q in points];dist=np.array([q[3] for q in nearest]);low=np.array([sd(q[0]) for q in nearest]);reg=(highsd>0)&(low<-.0001);robust=(highsd>.0001)&(low<-.0001);lookup={int(v):i for i,v in enumerate(ids)};edges=Counter(tuple(sorted((int(t[k]),int(t[(k+1)%3])))) for t in outer for k in range(3));rim=list(range(44*112,45*112));pd=np.linalg.norm(params[ids[:n]]-params[ids[n:]],axis=1)
 report['variants'][name]={'triangles':len(f),'source_exact_positions':np.array_equal(p,sp[ids]),'source_exact_normals':np.array_equal(a['normals'],S['normals'][ids]),'v3f_all_points_retained':all(int(x) in lookup and np.array_equal(p[lookup[int(x)]],base['points'][i]) for i,x in enumerate(old)),'rim112_samples_retained':all(x in lookup for x in rim),'rim112_edges_retained':all(tuple(sorted([lookup[x],lookup[rim[(i+1)%112]]])) in edges for i,x in enumerate(rim)),'matches_source_pairmap':all(mapping[int(x)]==int(y) for x,y in zip(ids[:n],ids[n:])),'max_pair_parameter_difference':float(pd.max()),'error_mean':float(dist.mean()),'error_p95':float(np.quantile(dist,.95)),'error_p99':float(np.quantile(dist,.99)),'error_max':float(dist.max()),'new_negative_count':int(reg.sum()),'new_negative_area_fraction':float(reg.mean()),'conservative_new_negative_count':int(robust.sum()),'max_inward_depth_where_high_outside':float(max(0,-low[highsd>0].min())),'signed_delta_p01':float(np.quantile(low-highsd,.01))}
print(json.dumps(report,indent=2));(V/'evidence/review-v4-fixed-reference.json').write_text(json.dumps(report,indent=2))

np.savez_compressed(V/'evidence/review-fixed-points.npz',points=points,source_triangle_indices=np.flatnonzero(mask)[sel],source_triangle_vertices=tri[sel],barycentric_weights=w,high_signed_nearest_plane=highsd,seed=np.array(20261103),crown_row_threshold=np.array(40))
