r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'V55-child-neck-trial.blend',use_scripts=False);o=bpy.data.objects['Menino — cabeça colo retopologia V55 reversível'];data=json.load(open(r+'V55-ring-input.json'));p=[Vector(q) for q in data['p']];fs=[tuple(f) for f in data['keep']];loops=sorted(data['loops'],key=lambda l:sum(p[i].z for i in l)/len(l));L,U=loops;h=bpy.data.objects['Menino — base infantil anatômica CC0'];n=bpy.data.objects['Menino — pescoço'];dg=bpy.context.evaluated_depsgraph_get();hm=h.evaluated_get(dg).data;hb=BVHTree.FromObject(h,dg);nb=BVHTree.FromPolygons([n.matrix_world@v.co for v in n.evaluated_get(dg).data.vertices],[tuple(f.vertices) for f in n.data.polygons])
def order(l):
 z=sorted((math.atan2(p[i].y+.265,p[i].x-.025)%(2*math.pi),i) for i in l);return [i for a,i in z],[a for a,i in z]
L,la=order(L);U,ua=order(U)
def sample(ids,ang,a):
 aa=ang+[ang[0]+2*math.pi];vv=ids+[ids[0]]
 if a<aa[0]:a+=2*math.pi
 i=min(len(ids)-1,int(np.searchsorted(aa,a,side='right'))-1);return p[vv[i]].lerp(p[vv[i+1]],(a-aa[i])/(aa[i+1]-aa[i]))
def smoothnormal(q):
 loc,norm,idx,d=hb.find_nearest(q);poly=hm.polygons[idx];weights=[1/max((hm.vertices[i].co-loc).length,.0001)**2 for i in poly.vertices];return sum((hm.vertices[i].normal*w for i,w in zip(poly.vertices,weights)),Vector()).normalized()
def bounded(v,lim):return v if v.length<=lim else v.normalized()*lim
N=128;K=16;rings=[];angles=[i*2*math.pi/N for i in range(N)];controls=[]
for a in angles:
 lo=sample(L,la,a);up=sample(U,ua,a);d=up-lo;span=d.length;ln=Vector(((lo.x-.025)/(.048**2),(lo.y+.265)/(.052**2),(lo.z-1.64)/(.12**2))).normalized();un=smoothnormal(up);tl=(d-ln*d.dot(ln)).normalized()*span;tu=(d-un*d.dot(un)).normalized()*span*.8
 step=.003;ql1=nb.find_nearest(lo-tl.normalized()*step)[0];ql2=nb.find_nearest(lo-tl.normalized()*step*2)[0];qu1=hb.find_nearest(up+tu.normalized()*step)[0];qu2=hb.find_nearest(up+tu.normalized()*step*2)[0];al=bounded((ql2-2*ql1+lo)*(span/step)**2,span*.5);au=bounded((qu2-2*qu1+up)*(span*.8/step)**2,span*.5)
 A=up-lo-tl-.5*al;B=tu-tl-al;C=au-al;c3=10*A-4*B+.5*C;c4=-15*A+7*B-C;c5=6*A-3*B+.5*C;controls.append((lo,tl,al,c3,c4,c5))
for j in range(1,K):
 t=j/K;ring=[]
 for lo,tl,al,c3,c4,c5 in controls:
  q=lo+tl*t+.5*al*t*t+c3*t**3+c4*t**4+c5*t**5;ring.append(len(p));p.append(q)
 rings.append(ring)
newfaces=[]
def stitch(A,aa,B,ba):
 i=j=0
 while i<len(A) or j<len(B):
  an=aa[(i+1)%len(A)]+(2*math.pi if i+1>=len(A) else 0) if i<len(A) else 1e9;bn=ba[(j+1)%len(B)]+(2*math.pi if j+1>=len(B) else 0) if j<len(B) else 1e9
  if an<bn:newfaces.append((A[i%len(A)],A[(i+1)%len(A)],B[j%len(B)]));i+=1
  else:newfaces.append((A[i%len(A)],B[(j+1)%len(B)],B[j%len(B)]));j+=1
stitch(L,la,rings[0],angles)
for A,B in zip(rings[:-1],rings[1:]):
 for i in range(N):newfaces.append((A[i],A[(i+1)%N],B[(i+1)%N],B[i]))
stitch(rings[-1],angles,U,ua);fs+=newfaces;used=sorted({i for f in fs for i in f});pp=[p[i] for i in used];assert len(pp)==len(o.data.vertices)
old=[v.co.copy() for v in o.data.vertices];o.shape_key_add(name='Basis');key=o.shape_key_add(name='TESTE56 — tangentes e curvatura cervical');key.value=1
for v,q in zip(key.data,pp):v.co=q
faces=[tuple(f.vertices) for f in o.data.polygons];bv=BVHTree.FromPolygons(pp,faces);pairs=[(i,j) for i,j in bv.overlap(bv) if i<j and not set(faces[i])&set(faces[j])];rat=[];flips=0
def av(v,f):return sum(((v[f[j]]-v[f[0]]).cross(v[f[j+1]]-v[f[0]])*.5 for j in range(1,len(f)-1)),Vector())
for f in faces:
 a,b=av(old,f),av(pp,f)
 if a.length>1e-12:rat.append(b.length/a.length);flips+=a.dot(b)<0
report={'source':'V55','scope':'Only interior collar vertices; boundary loops fixed','max_delta_m':max((a-b).length for a,b in zip(pp,old)),'self_intersections':len(pairs),'area_ratio_min':min(rat),'area_ratio_max':max(rat),'flipped_faces':flips,'unchanged_vertices':sum((a-b).length<1e-9 for a,b in zip(pp,old)),'rollback':'TESTE56=0 restores V55; original head/neck remain hidden unchanged'};json.dump(report,open(r+'V56-child-neck-verification.json','w'),indent=2);bpy.ops.wm.save_as_mainfile(filepath=r+'V56-child-neck-trial.blend')
