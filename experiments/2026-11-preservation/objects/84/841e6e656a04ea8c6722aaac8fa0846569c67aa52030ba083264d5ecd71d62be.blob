"""Independent planar domain checks using high-precision polygon clipping."""
from pathlib import Path
import numpy as np,json,sys,mpmath as mp
from collections import Counter
O=Path(__file__).resolve().parent;B=O.parents[1];root=B/'ear_rim_v11/structural_rebuild';tag=sys.argv[1];d=np.load(root/(tag+'.npz'));meta=json.loads(str(d['provenance']));orig=np.load(root/meta['triangulation_cleanup']['input']);base=np.load(B/'lateral_v7/adaptive_patch/adaptive-consistent-assembly.npz');p=d['points'];mp.mp.dps=65
rows=[]
def cross(a,b):return a[0]*b[1]-a[1]*b[0]
def sub(a,b):return [a[0]-b[0],a[1]-b[1]]
def area(poly):
 return sum(cross(poly[i],poly[(i+1)%len(poly)]) for i in range(len(poly)))/2 if len(poly)>2 else mp.mpf(0)
def clip(poly,tr):
 for i in range(3):
  a,b=tr[i],tr[(i+1)%3];di=sub(b,a);out=[]
  if not len(poly):return []
  for j in range(len(poly)):
   x,y=poly[j],poly[(j+1)%len(poly)];dx=cross(di,sub(x,a));dy=cross(di,sub(y,a));ix=dx>=0;iy=dy>=0
   if ix:out.append(x)
   if ix!=iy:
    t=dx/(dx-dy);out.append([x[k]+t*(y[k]-x[k]) for k in range(2)])
  poly=out
 return poly

def bound(tris):
 cnt=Counter((int(t[k]),int(t[(k+1)%3])) for t in tris for k in range(3));return Counter({e:c-cnt[e[::-1]] for e,c in cnt.items() if c>cnt[e[::-1]]})
for par in meta['triangulation_cleanup']['affected_baseline_faces']:
 oldi=np.flatnonzero(orig['baseline_face_indices']==par);newi=np.flatnonzero(d['baseline_face_indices']==par);of=orig['triangles'][oldi];nf=d['triangles'][newi];bt=base['points'][base['triangles'][par]];n=np.cross(bt[1]-bt[0],bt[2]-bt[0]);drop=int(np.argmax(abs(n)));axes=[j for j in range(3) if j!=drop];sgn=1 if cross(bt[1,axes]-bt[0,axes],bt[2,axes]-bt[0,axes])>0 else -1;scale=float(np.linalg.norm(n)/abs(n[drop]));xy={int(i):[mp.mpf(float(p[i,axes[0]])),mp.mpf(float(p[i,axes[1]]))*sgn] for i in np.unique(np.r_[of.ravel(),nf.ravel()])}
 oo=[[xy[int(i)] for i in t] for t in of];nn=[[xy[int(i)] for i in t] for t in nf];aa=[area(t) for t in oo];bb=[area(t) for t in nn];inside=np.zeros((len(oo),len(nn)),float)
 for i,a in enumerate(oo):
  if area(a)<0:a=a[::-1]
  for j,b in enumerate(nn):inside[i,j]=float(abs(area(clip(a,b))))*scale
 overlap=[]
 for i in range(len(nn)):
  for j in range(i+1,len(nn)):
   ar=float(abs(area(clip(nn[i],nn[j]))))*scale
   if ar>1e-18:overlap.append({'new_faces':[int(newi[i]),int(newi[j])],'overlap_m2':ar})
 oldareas=np.array([float(abs(x))*scale for x in aa]);newareas=np.array([float(abs(x))*scale for x in bb]);ob=bound(of);nb=bound(nf);row={'baseline_face':int(par),'old_faces':oldi.tolist(),'new_faces':newi.tolist(),'positions_bit_identical_global':bool(np.array_equal(p,orig['points'])),'oriented_boundary_multiset_exact':ob==nb,'old_area_m2':float(oldareas.sum()),'new_area_m2':float(newareas.sum()),'absolute_area_change_m2':float(abs(newareas.sum()-oldareas.sum())),'new_reversed_triangles':int(sum(x<=0 for x in bb)),'new_internal_overlap_pairs_over_1e_18_m2':overlap,'new_triangle_max_uncovered_by_old_domain_m2':float(np.max(np.abs(newareas-inside.sum(0)))),'old_triangle_max_uncovered_by_new_domain_m2':float(np.max(np.abs(oldareas-inside.sum(1)))),'total_old_new_intersection_m2':float(inside.sum()),'tolerance_m2':1e-18};row['passes']=row['oriented_boundary_multiset_exact'] and not overlap and row['new_reversed_triangles']==0 and row['new_triangle_max_uncovered_by_old_domain_m2']<1e-18 and row['old_triangle_max_uncovered_by_new_domain_m2']<1e-18;rows.append(row)
report={'candidate':str(root/(tag+'.npz')),'method':'Independent projection to dominant source-face plane; mpmath65 decimal polygon clipping of every old/new triangle intersection and every new/new triangle pair. Verify oriented boundary multiset and per-triangle area coverage in both directions.','all_seven_domains_preserved':all(r['passes'] for r in rows),'patches':rows,'limits':['Numerical high precision on stored float64 coordinates, not symbolic original geometry.','Certification limited to these seven retriangulated planar inherited source patches. Does not certify arbitrary coplanar overlaps elsewhere.']};(O/(tag+'-planar-domain-check.json')).write_text(json.dumps(report,indent=2));print(json.dumps(report,indent=2))
