 bpy.ops.wm.open_mainfile(filepath=str(p));s=bpy.context.scene;c=s.camera.data;r[tag]={'clip_start':c.clip_start,'clip_end':c.clip_end,'dof_use':c.dof.use_dof,'pixel_filter_type':s.cycles.pixel_filter_type,'filter_width':s.cycles.filter_width,'samples':s.cycles.samples,'seed':s.cycles.seed,'sampling_pattern':s.cycles.sampling_pattern}
