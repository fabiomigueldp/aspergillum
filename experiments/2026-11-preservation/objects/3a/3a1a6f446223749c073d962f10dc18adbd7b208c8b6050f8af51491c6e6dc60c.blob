from audit_common import *
import sys
name,geo=sys.argv[1:];geo=Path(geo);g=readgeo(geo);bone=next(b for b in g['bones']if b['name']=='part_00');centers=[];bases=[];half=[];err=0
for c in bone['cubes']:
 q=cube_quad(c,'south');U=q[3]-q[0];V=q[0]-q[1];N=np.cross(U,V);N/=np.linalg.norm(N);Z=np.array(c['size'])[2]/16;basis=np.array([U/np.linalg.norm(U),V/np.linalg.norm(V),N]).T;center=(q[0]+q[2])/2-N*Z/2;centers.append(center);bases.append(basis);half.append(np.array(c['size'])/32)
centers=np.array(centers);bases=np.array(bases);half=np.array(half);d=np.load(SOURCE[0]);tri=d['points'][d['triangles']];norm=np.cross(tri[:,1]-tri[:,0],tri[:,2]-tri[:,0]);area=np.linalg.norm(norm,axis=1)/2;norm/=np.linalg.norm(norm,axis=1)[:,None];bary=np.array([[1/3]*3,[.8,.1,.1],[.1,.8,.1],[.1,.1,.8],[.45,.45,.1],[.1,.45,.45],[.45,.1,.45]]);points=np.einsum('sj,fjk->fsk',bary,tri).reshape(-1,3);normals=np.repeat(norm,7,axis=0);face=np.repeat(np.arange(len(tri)),7);weights=np.repeat(area/7,7);out=[];gaps=[];inside=[]
for lo in range(0,len(points),256):
 p=points[lo:lo+256];nn=normals[lo:lo+256];local=np.einsum('bci,cij->bcj',p[:,None]-centers[None],bases);direction=np.einsum('bi,cij->bcj',nn,bases);dd=np.abs(local)-half[None];contain=(dd<=1e-10).all(2);ins=contain.any(1);gap=np.linalg.norm(np.maximum(dd,0),axis=2).min(1);safe=np.abs(direction)>1e-14;aa=np.divide(-half[None]-local,direction,out=np.full_like(local,-np.inf),where=safe);bb=np.divide(half[None]-local,direction,out=np.full_like(local,np.inf),where=safe);mins=np.minimum(aa,bb);maxs=np.maximum(aa,bb);mins[~safe& (dd>0)]=np.inf;maxs[~safe& (dd>0)]=-np.inf;start=mins.max(2);end=maxs.min(2);valid=start<=end+1e-12
 # Positive endpoint of connected union of all box intervals containing sample t=0.
 reach=np.max(np.where(valid&(start<=1e-10)&(end>=-1e-10),end,-np.inf),axis=1)
 for k in range(len(centers)+1):
  new=np.max(np.where(valid&(start<=reach[:,None]+1e-12)&(end>=-1e-10),end,-np.inf),axis=1)
  if np.array_equal(new,reach):break
  reach=new
 out.extend(reach);gaps.extend(gap);inside.extend(ins)
out=np.array(out);gaps=np.array(gaps);inside=np.array(inside);finite=np.isfinite(out);np.savez_compressed(O/(name+'-full-band-surface.npz'),native_face=face,sample_point=points,sample_normal=normals,area_weight=weights,inside_cube_union=inside,distance_to_box_union=gaps,outward_union_exit=out)
def stat(mask):
 a=out[mask&finite]*1000;w=weights[mask&finite];ids=np.argsort(a);return {'samples':int(mask.sum()),'inside_sample_count':int((inside&mask).sum()),'missing_sample_count':int((~inside&mask).sum()),'maximum_uncontained_distance_mm':float(gaps[mask].max()*1000),'outward_exit_mm_quantiles':np.quantile(a,[0,.5,.9,.99,1]).tolist(),'area_weighted_outward_exit_mean_mm':float(np.sum(a*w)/w.sum()),'area_weighted_outward_exit_q50_q90_q99_mm':np.interp([.5,.9,.99],np.cumsum(w[ids])/w.sum(),a[ids]).tolist()}
report={'candidate':name,'geometry_sha256':sha(geo),'method':'Independent positive-volume OBBs reconstructed from actual JSON. Every native V13 band triangle gets seven fixed barycentric interior samples,31,108 total. Tests containment by union of boxes and outward endpoint of connected box-union interval along oriented native triangle normal. Cube metadata/provenance not used for test calculations.','barycentric_samples':bary.tolist(),'all':stat(np.ones(len(out),bool)),'face_parts':{str(k):stat(d['face_parts'][face]==k)for k in np.unique(d['face_parts'])},'v13_face_roles':{str(k):stat(d['v13_face_roles'][face]==k)for k in np.unique(d['v13_face_roles'])},'max_witness':{'native_face':int(face[np.nanargmax(np.where(finite,out,np.nan))]),'point':points[np.nanargmax(np.where(finite,out,np.nan))].tolist(),'outward_exit_mm':float(out[finite].max()*1000)},'limitations':'Finite surface sampling, not continuous Hausdorff/volume union computation. Outward interval is support extension along source normal, not Euclidean closest-surface error or proof of visible occlusion. Internal faces of overlapping cuboids may still render differently.'};save(O/(name+'-full-band-surface.json'),report);print(json.dumps(report,indent=2))
