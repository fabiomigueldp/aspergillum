import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import crypto from 'node:crypto';
const root='/workspace/scratch/212c580ada5b/altare-two-pillars-integration-20261103/addons/altare';
const {NATIVE_DESIGNS}=await import(root+'/src/domain/catalog.ts');const {decodeTile}=await import(root+'/src/domain/block-codec.ts');const {nativeCentered}=await import(root+'/src/domain/native-pedestal-layout.ts');const {NATIVE_CENTER_POSES,NATIVE_PLANS}=await import(root+'/src/domain/native-pedestal-data.ts');
const atlas=JSON.parse(fs.readFileSync(root+'/packs/resource/textures/terrain_texture.json')).texture_data;
const canonical=v=>Array.isArray(v)?v.map(canonical):v&&typeof v==='object'?Object.fromEntries(Object.keys(v).sort().map(k=>[k,canonical(v[k])])):v;
const sha=v=>crypto.createHash('sha256').update(typeof v==='string'?v:JSON.stringify(canonical(v))).digest('hex');
const geometries=new Map(),geometryFiles=new Map();for(const file of fs.readdirSync(root+'/packs/resource/models/blocks').filter(f=>f.startsWith('native_twin_'))){const p=root+'/packs/resource/models/blocks/'+file;const d=JSON.parse(fs.readFileSync(p));for(const g of d['minecraft:geometry']){geometries.set(g.description.identifier,g);geometryFiles.set(g.description.identifier,p);}}
const collisions=new Map(),floralGeometry=new Map(),sources={},rules={};let states=0,maxCubes=0,maxFaces=0,maxBoxes=0;
for(const d of NATIVE_DESIGNS){const file=root+'/packs/behavior/blocks/'+d.id.split(':')[1]+'.block.json',bytes=fs.readFileSync(file,'utf8');sources[d.id]=sha(bytes);const b=JSON.parse(bytes)['minecraft:block'];assert.equal(b.description.identifier,d.id);assert.equal(b.components['minecraft:light_dampening'],0);assert.deepEqual(b.components['minecraft:movable'],{movement_type:'immovable'});
 const rows=Object.entries(b.description.states).reduce((rs,[k,vs])=>rs.flatMap(r=>vs.map(v=>({...r,[k]:v}))),[{}]);const compiled=b.permutations.map(p=>({...p,fn:Function('q',`return (${p.condition})`)}));
 const defaults=Object.fromEntries(Object.entries(b.description.states).map(([k,vs])=>[k,vs[0]])),t0=decodeTile(d.id,{x:0,y:0,z:0},defaults);assert.equal(t0.nativePose,0);assert.equal(t0.facing,0);assert.equal(t0.edges,15);assert.equal(t0.frontal,nativeCentered(d.textile)?1:0);
 for(const s of rows){const t=decodeTile(d.id,{x:0,y:0,z:0},s),q={block_state:k=>s[k]},cs={...b.components},counts={};for(const p of compiled)if(p.fn(q)){Object.assign(cs,p.components);for(const k of Object.keys(p.components))counts[k]=(counts[k]??0)+1;}
  for(const [k,n] of Object.entries(counts))assert.equal(n,1,'overlapping rules '+d.id+'/'+k);
  const geomId=cs['minecraft:geometry'].identifier,g=geometries.get(geomId);assert.ok(g,geomId);const cubes=g.bones.flatMap(b=>b.cubes??[]),materials=cs['minecraft:material_instances'];
  for(const [slot,m] of Object.entries(materials)){assert.ok(atlas[m.texture],m.texture);assert.equal(m.render_method,'alpha_test');}
  for(const cube of cubes)for(const uv of Object.values(cube.uv))assert.ok(materials[uv.material_instance]??materials['*']);
  assert.equal(materials.wood_vertical.texture,'altare_atelier_walnut');assert.equal(materials.wood_horizontal.texture,'altare_joinery_walnut_horizontal');
  if(d.textile!=='none'){assert.equal(materials.top.texture,'altare_linen');for(let side=0;side<4;side++){let wanted;if(d.textile==='lace')wanted='ornate_lace';else if(d.textile.includes('_'))wanted='hem_'+(d.textile.endsWith('long')?'long':'short')+'_'+(d.textile.startsWith('gold')?'gold':'plain');else wanted='textile_'+d.textile+'_'+(side===t.facing?t.frontal:0)+(d.palette&&d.palette!=='red'?'_'+d.palette:'');assert.equal(materials['cloth_'+side].texture,'altare_'+wanted);}}
  const base=nativeCentered(d.textile)?NATIVE_CENTER_POSES[t.nativePose].basePose:t.nativePose,physical=cs['minecraft:collision_box'],key=sha(physical);if(collisions.has(base))assert.equal(collisions.get(base),key,'cloth or role changed collision');else collisions.set(base,key);
  assert.ok(Array.isArray(physical)&&physical.length<=16);for(const box of physical){assert.deepEqual(Object.keys(box).sort(),['origin','size']);for(let a=0;a<3;a++){assert.ok(box.size[a]>0);assert.ok(box.origin[a]>=(a===1?0:-8)-1e-6);assert.ok(box.origin[a]+box.size[a]<=(a===1?16:8)+1e-6);}}
  if(d.textile==='ruby'){if(floralGeometry.has(t.nativePose))assert.equal(floralGeometry.get(t.nativePose),geomId,'color changed structural/cloth mesh');else floralGeometry.set(t.nativePose,geomId);}
  maxCubes=Math.max(maxCubes,cubes.length);maxFaces=Math.max(maxFaces,cubes.reduce((n,c)=>n+Object.keys(c.uv).length,0));maxBoxes=Math.max(maxBoxes,physical.length);states++;
 }
 rules[d.id]={states:rows.length,permutationRules:compiled.length};
}
assert.equal(states,8232);assert.equal(collisions.size,448);assert.equal(floralGeometry.size,504);assert.equal(Object.keys(NATIVE_PLANS).length,768);
const locales=await import(root+'/assets-src/locales.mjs');for(const [lang,l]of Object.entries(locales.locales)){assert.ok(l['altare.structure.twin_pedestal']);assert.ok(l['altare.placement.pending']);}
const report={version:JSON.parse(fs.readFileSync(root+'/package.json')).version,recipes:NATIVE_DESIGNS.length,states,baseCollisionProfiles:collisions.size,floralPosesComparedAcross8Colors:floralGeometry.size,geometryResources:geometries.size,maxCubes,maxFaces,maxBoxes,default:'Every recipe resolves isolated1×1/front0; directional textiles use whole motif',checks:'All declared states decoded; no component-rule overlaps; actual terrain atlas bindings; oriented cloth materials; material-independent collisions; geometry shared by floral colors; pt/en strings',blockHashes:sources,rules};fs.writeFileSync('/tmp/altare-independent-generated-audit.json',JSON.stringify(report,null,2));console.log(JSON.stringify({...report,blockHashes:'in report',rules:'in report'},null,2));
