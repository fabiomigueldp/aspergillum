from audit_common import *
rows=[]
for tier in ['0300','0700','1400']:
 root=B/'opaque_transport_v15/opaque_band'/('budget-'+tier);origpath=root/'band.geo.json';prpath=root/'pruned/band.geo.json';certpath=root/'pruned/containment-certificate.json';g=readgeo(origpath);pg=readgeo(prpath);a=g['bones'][0]['cubes'];b=pg['bones'][0]['cubes'];cert=json.load(open(certpath));removed=[];checks={'same_cube_count':len(a)==len(b),'same_cube_transforms':True,'remaining_uv_unchanged':True,'no_added_faces':True,'certificate_exact_removed_face_set':True,'all_claimed_occluders_different':True,'all_four_corners_strictly_inside':True,'combined_only_same_band_pruning':True};mins=[];err=[]
 for ci,(c,p)in enumerate(zip(a,b)):
  checks['same_cube_transforms']&={k:v for k,v in c.items()if k!='uv'}=={k:v for k,v in p.items()if k!='uv'};checks['no_added_faces']&=set(p['uv'])<=set(c['uv']);checks['remaining_uv_unchanged']&=all(c['uv'][f]==v for f,v in p['uv'].items());removed.extend((ci,f)for f in set(c['uv'])-set(p['uv']))
 checks['certificate_exact_removed_face_set']=sorted(removed)==sorted((w['cube'],w['face'])for w in cert['witnesses'])
 for w in cert['witnesses']:
  q=cube_quad(a[w['cube']],w['face']);c=a[w['occluding_cube']];checks['all_claimed_occluders_different']&=w['cube']!=w['occluding_cube'];cq=cube_quad(c,'south');U=cq[3]-cq[0];V=cq[0]-cq[1];N=np.cross(U,V);N/=np.linalg.norm(N);basis=np.column_stack([U/np.linalg.norm(U),V/np.linalg.norm(V),N]);center=(cq[0]+cq[2])/2-N*c['size'][2]/32;local=(q-center)@basis;clear=np.array(c['size'])/32-np.abs(local);m=float(clear.min()*1000);mins.append(m);err.append(float(np.max(np.abs(q-w['face_corners_native']))));checks['all_four_corners_strictly_inside']&=m>=.001-1e-9
 og=readgeo(root/'combined-v14.geo.json');pgg=readgeo(root/'pruned/combined-v14.geo.json');combined_expected=json.loads(json.dumps(og['bones'][0]));[(combined_expected['cubes'][ci]['uv'].pop(f))for ci,f in removed];checks['combined_only_same_band_pruning']=all(x==y for x,y in zip(og['bones'][1:],pgg['bones'][1:]))and pgg['bones'][0]==combined_expected
 row={'tier':int(tier),'checks':checks,'removed_quads':len(removed),'retained_band_quads':sum(len(c['uv'])for c in b),'total_band_quads':len(a)*6,'minimum_independent_clearance_mm':min(mins),'maximum_certificate_corner_error_blocks':max(err),'hashes':{str(p.relative_to(B)):sha(p)for p in [origpath,prpath,certpath,root/'pruned/combined-v14.geo.json']}};rows.append(row)
save(O/'opaque-pruning-independent.json',{'method':'Independently reconstruct removed face corners and occluder oriented halfspaces from original JSON only, ignoring reported centers/bases. A face with four corners strictly inside one other convex cuboid lies entirely inside that cuboid. Check pruned JSON only removes certified faces and does not alter surviving coordinates/UVs.','rows':rows,'conclusion':'These removals preserve the outer boundary of the union of opaque closed original cuboids; certificates are not camera-dependent visibility guesses. Finite independent arithmetic has >=1 micrometre clearance.','limitations':'Proof is geometric opaque-solid model only, with observer outside solids. It does not certify engine face handling/material/filtering or remove overlapping partially internal faces.'});print(json.dumps(rows,indent=2))
