from audit_common import *
W=B/'opaque_transport_v15/shared_mask';frozen=np.load(B/'assembly_transport_v14/independent_validation/critical-gap-plane-sampling.npz');X=frozen['offset_x_blocks'];Y=frozen['offset_y_blocks'];nativePart=frozen['native_part'];nativeDepth=frozen['native_depth_blocks'];nativeFace=frozen['native_face'];oldPart=frozen['alpha_part'];r=json.load(open(B/'assembly_transport_v14/independent_validation/critical-ray-alpha-comparison.json'))['central_rays'][-1];origin=np.array(r['origin']);direction=np.array(r['direction']);direction/=np.linalg.norm(direction);U=np.cross(direction,[0,0,1.]);U/=np.linalg.norm(U);V=np.cross(direction,U);hx=float(abs(X).max());hy=float(abs(Y).max());rows=[]
for N in [128,512,2048]:
 gp=W/f'shared_mask_{N}.geo.json';tp=W/f'shared_mask_{N}.png';s=json_faces(gp,texture=tp);n=s['n'];q=s['q'];nd=n@direction;safe=abs(nd)>1e-15;t0=np.divide(np.einsum('ij,ij->i',q[:,0]-origin,n),nd,out=np.full(len(n),np.inf),where=safe);tx=np.divide(-(n@U),nd,out=np.zeros(len(n)),where=safe);ty=np.divide(-(n@V),nd,out=np.zeros(len(n)),where=safe);p0=origin+t0[:,None]*direction;dx=U+tx[:,None]*direction;dy=V+ty[:,None]*direction;dp=p0-q[:,0];a0=np.einsum('ij,ij->i',dp,s['U'])/s['lU'];b0=np.einsum('ij,ij->i',dp,s['V'])/s['lV'];ax=np.einsum('ij,ij->i',dx,s['U'])/s['lU'];bx=np.einsum('ij,ij->i',dx,s['V'])/s['lV'];ay=np.einsum('ij,ij->i',dy,s['U'])/s['lU'];by=np.einsum('ij,ij->i',dy,s['V'])/s['lV'];te=abs(tx)*hx+abs(ty)*hy;ae=abs(ax)*hx+abs(ay)*hy;be=abs(bx)*hx+abs(by)*hy;ids=np.flatnonzero((nd< -1e-12)&(t0+te>=0)&(t0-te<=.04)&(a0+ae>=0)&(a0-ae<1)&(b0+be>=0)&(b0-be<1));depth=np.full(X.shape,np.inf);parts=np.full(X.shape,-1,int);cubes=np.full(X.shape,-1,int)
 for i in ids:
  t=t0[i]+tx[i]*X+ty[i]*Y;a=a0[i]+ax[i]*X+ay[i]*Y;b=b0[i]+bx[i]*X+by[i]*Y;ok=(t>=0)&(t<=.04)&(a>=0)&(a<1)&(b>=0)&(b<1);uv=s['uv'][i];xx=np.floor(uv[0]+a[ok]*uv[2]).astype(int);yy=np.floor(uv[1]+b[ok]*uv[3]).astype(int);opaque=np.zeros(X.shape,bool);opaque[ok]=s['texture'][yy,xx,3]>0;win=opaque&(t<depth);depth[win]=t[win];parts[win]=s['part'][i];cubes[win]=s['cube'][i]
 spot=[]
 for y,x in [(0,0),(0,200),(200,0),(200,200),(100,100),(50,150),(150,50),(100,0),(0,100),(200,100),(100,200)]:
  rr=trace_quads(s,origin+X[y,x]*U+Y[y,x]*V,direction,.04);same=(rr['part']==int(parts[y,x])if rr else parts[y,x]<0);err=abs(rr['distance_mm']-depth[y,x]*1000)if rr else 0;spot.append({'grid_xy':[x,y],'part_matches_full_unpruned_trace':bool(same),'depth_delta_mm':float(err)})
 reg=(nativePart==0)&(parts==1);change=nativePart!=parts;delta=(depth-nativeDepth)*1000;finite=np.isfinite(delta);row={'resolution':N,'geometry_sha256':sha(gp),'texture_sha256':sha(tp),'candidate_faces_after_conservative_affine_window_bounds':len(ids),'samples':X.size,'grid_size':list(X.shape),'square_width_mm':.4,'sample_pitch_mm':.002,'changed_component_samples':int(change.sum()),'native_band_to_candidate_shell_samples':int(reg.sum()),'V14_native_band_to_shell_samples':int(((nativePart==0)&(oldPart==1)).sum()),'native_hit_to_missing':int(((nativePart>=0)&(parts<0)).sum()),'depth_delta_mm_quantiles':np.quantile(delta[finite],[0,.5,.9,.99,1]).tolist(),'maximum_shell_ahead_native_mm':float((-delta[reg]).max())if reg.any()else 0,'direct_unfiltered_spot_checks':spot};rows.append(row);np.savez_compressed(O/f'shared-{N}-dense-window.npz',native_part=nativePart,native_depth=nativeDepth,native_face=nativeFace,candidate_part=parts,candidate_depth=depth,candidate_cube=cubes,offset_x_blocks=X,offset_y_blocks=Y);print(json.dumps(row,indent=2),flush=True)
save(O/'shared-dense-window.json',{'method':'Reuses the exact frozen V14 201x201 ray-offset grid and native float64 first-hit arrays around protected sample7442. Candidate actual JSON planes/UV/PNG are independently decoded. Affine t/u/v interval extrema over the entire square conservatively discard impossible quads; each surviving face is evaluated on all40401 grid points. Eleven direct traces against every candidate face cross-check bounds/evaluation.','rows':rows,'limitations':'Known dense-window failure neighborhood only. Finite grid, nearest mip0/front-facing surfaces, three retained parts, no engine or continuous-area claim.'})
