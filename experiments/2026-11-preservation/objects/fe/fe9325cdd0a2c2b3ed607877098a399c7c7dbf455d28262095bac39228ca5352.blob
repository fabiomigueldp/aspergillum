import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';
import * as THREE from '../../../viewer-3d/node_modules/three/build/three.module.js';
import {buildBedrockGeometry} from '../../../viewer-3d/src/shared/bedrock-geometry.js';
import {blockPreviewGeometry} from './block-preview-basis.mjs';
import {twinPedestalGeometry} from '../assets-src/atelier/twin-pedestal-prototype.mjs';
const root=path.resolve(import.meta.dirname,'..'),out=path.join(root,'out/two-pedestal-refined-study');fs.mkdirSync(out,{recursive:true});
const materials={wood_vertical:'atelier_walnut',wood_horizontal:'joinery_walnut_horizontal',inlay:'crossbrace_inlay'};
const all=[];
for(const [w,d] of [[3,2],[7,2],[1,1],[1,3],[2,3],[16,8]]){
 const model=twinPedestalGeometry(w,d),g=blockPreviewGeometry(model.doc['minecraft:geometry'][0]),palette={named:{}};
 for(const [key,name] of Object.entries(materials)){const m=new THREE.MeshBasicMaterial();m.userData.texture=path.join(root,`packs/resource/textures/blocks/${name}.png`);palette.named[key]=m;palette.default??=m;}
 const built=buildBedrockGeometry(g,{identifier:g.description.identifier,textureWidth:128,textureHeight:128,formatVersion:model.doc.format_version},palette,{includePivots:false,includeLocators:false});built.root.updateMatrixWorld(true);
 const triangles=[];built.root.traverseVisible(o=>{if(!o.isMesh)return;const p=o.geometry.attributes.position,uv=o.geometry.attributes.uv,idx=o.geometry.index;
  for(const group of o.geometry.groups){const m=Array.isArray(o.material)?o.material[group.materialIndex]:o.material;
   for(let i=group.start;i<group.start+group.count;i+=3){const points=[],coords=[];for(let j=0;j<3;j++){const k=idx?idx.getX(i+j):i+j;points.push(new THREE.Vector3().fromBufferAttribute(p,k).applyMatrix4(o.matrixWorld).toArray());coords.push([uv.getX(k),uv.getY(k)]);}triangles.push({points,uv:coords,texture:m.userData.texture});}
  }
 });
 const id=`two-pedestal-${w}x${d}`;fs.writeFileSync(path.join(out,id+'.geo.json'),JSON.stringify(model.doc,null,2));fs.writeFileSync(path.join(out,id+'.scene.json'),JSON.stringify({id,w,d,version:'0.12.3 · estudo 2 não integrado',title:'ALTARE  /  DOIS PEDESTAIS EM NOGUEIRA',subtitle:`Estudo geométrico real · ${w} × ${d} módulos · não integrado ao editor`,footer:'PRÉVIA TÉCNICA CPU · protótipo não instalado · não é captura do Minecraft',textile:'none',center:[0,.5,0],direction:[-.8,.55,-1],profile:model.profile,triangles}));all.push({id,w,d,triangles:triangles.length,cubes:g.bones.reduce((a,b)=>a+b.cubes.length,0),geometryHash:crypto.createHash('sha256').update(JSON.stringify(model.doc)).digest('hex')});
}
fs.writeFileSync(path.join(out,'manifest.json'),JSON.stringify({prototype:true,unregistered:true,studyRevision:2,baseVersion:'0.12.3',geometries:all,materialFiles:materials,sourceHash:crypto.createHash('sha256').update(fs.readFileSync(path.join(root,'assets-src/atelier/twin-pedestal-prototype.mjs'))).digest('hex')},null,2));console.log(out);
