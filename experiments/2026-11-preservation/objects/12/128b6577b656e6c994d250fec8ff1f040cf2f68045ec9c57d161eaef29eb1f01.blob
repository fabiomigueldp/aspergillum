"""Direct native triangle nearest distances and exact OBB ray intervals.
Blender mathutils BVH used for closest point on actual native triangles.
Sampling is finite; this is not a global Hausdorff/clearance certificate.
"""
from pathlib import Path
import json,sys,hashlib,time
import numpy as np
from mathutils import Vector
from mathutils.bvhtree import BVHTree
W=Path(__file__).resolve().parent;B=W.parents[1]
z=np.load(B/'band_shell_v13/constrained_fit/retained-band.npz');P=z['points'];F=z['triangles'];T=P[F];N=np.cross(T[:,1]-T[:,0],T[:,2]-T[:,0]);area=np.linalg.norm(N,axis=1)/2;N/=np.linalg.norm(N,axis=1)[:,None]
bvh=BVHTree.FromPolygons(P.tolist(),F.tolist(),all_triangles=True)
shell=np.load(B/'ear_rim_v11/structural_rebuild/retained-shell.npz');sbvh=BVHTree.FromPolygons(shell['points'].tolist(),shell['triangles'].tolist(),all_triangles=True)
anatomy=np.load(B/'body_interface_v9/constrained_fit/retained-anatomy.npz');abvh=BVHTree.FromPolygons(anatomy['points'].tolist(),anatomy['triangles'].tolist(),all_triangles=True)
WTS=np.array([[1/3,1/3,1/3],[.6,.2,.2],[.2,.6,.2],[.2,.2,.6],[.45,.45,.1],[.45,.1,.45],[.1,.45,.45]])
S=np.einsum('kc,fcd->fkd',WTS,T).reshape(-1,3);SN=np.repeat(N,len(WTS),axis=0);FI=np.repeat(np.arange(len(F)),len(WTS));SU=np.einsum('kc,fcd->fkd',WTS,z['source_uv'][F]).reshape(-1,2)

def stats(x):
 x=np.asarray(x);return {'count':len(x),'min':float(x.min()) if len(x) else None,'median':float(np.median(x)) if len(x) else None,'p95':float(np.percentile(x,95)) if len(x) else None,'p99':float(np.percentile(x,99)) if len(x) else None,'max':float(x.max()) if len(x) else None}

def first_ray_box(points,normals,C,M,H):
 out=[];miss=0
 for st in range(0,len(points),512):
  p=points[st:st+512];n=normals[st:st+512];origin=p+n*.02;delta=origin[:,None,:]-C[None,:,:];local=np.einsum('qci,cij->qcj',delta,M);di=-np.einsum('qi,cij->qcj',n,M)
  with np.errstate(divide='ignore',invalid='ignore'):
   a=(-H[None,:,:]-local)/di;b=(H[None,:,:]-local)/di
  near=np.minimum(a,b).max(2);far=np.maximum(a,b).min(2);valid=(far>=np.maximum(near,0))&(near<.04);hit=np.where(valid,np.maximum(near,0),np.inf).min(1);out.extend(.02-hit)
 return np.asarray(out)

for D in sorted(W.glob('budget-*')):
 print('METRICS',D.name,flush=True);d=np.load(D/'band.npz');C=d['cube_centers'];M=d['cube_bases'];H=d['cube_sizes']/2
 # Exact first intersection with the union of solid OBBs along sampled normal rays.
 delta=first_ray_box(S,SN,C,M,H);good=np.isfinite(delta)
 # Nearest any cube triangle is not an exposed union distance, intentionally not reported as that.
 # Exposed solid-face samples: 7x7 deterministic grid, remove strictly interior samples.
 out=[];owner=[];faceaxis=[];aa=np.linspace(-1,1,7)
 for i in range(len(C)):
  for axis in range(3):
   rest=[a for a in range(3) if a!=axis]
   for side in [-1,1]:
    loc=np.zeros((49,3));loc[:,axis]=side*H[i,axis];xy=np.array([(a,b)for a in aa for b in aa]);loc[:,rest]=xy*H[i,rest];out.extend(loc@M[i].T+C[i]);owner.extend([i]*49);faceaxis.extend([axis]*49)
 Q=np.array(out);owner=np.array(owner);faceaxis=np.array(faceaxis)
 # Spatial hash indexes conservative world AABBs, exact local containment after lookup.
 wh=np.einsum('cij,cj->ci',np.abs(M),H);cell=.008;grid={}
 for i,(lo,hi) in enumerate(zip(C-wh,C+wh)):
  g0=np.floor(lo/cell).astype(int);g1=np.floor(hi/cell).astype(int)
  for a in range(g0[0],g1[0]+1):
   for b in range(g0[1],g1[1]+1):
    for c in range(g0[2],g1[2]+1):grid.setdefault((a,b,c),[]).append(i)
 buckets={}
 for i,key in enumerate(map(tuple,np.floor(Q/cell).astype(int))):buckets.setdefault(key,[]).append(i)
 inside=np.zeros(len(Q),bool)
 for key,qi in buckets.items():
  ii=np.array(grid.get(key,[]));qi=np.array(qi)
  for st in range(0,len(qi),512):
   kk=qi[st:st+512];loc=np.einsum('qci,cij->qcj',Q[kk,None,:]-C[None,ii,:],M[ii]);hit=np.all(np.abs(loc)<H[None,ii,:]-1e-8,axis=2);hit &= owner[kk,None]!=ii[None,:];inside[kk]=np.any(hit,axis=1)
 ext=Q[~inside];eo=owner[~inside];ea=faceaxis[~inside];dist=[];nearface=[];npnt=[];ndir=[]
 for p in ext:
  hit=bvh.find_nearest(Vector(p));npnt.append(hit[0]);nearface.append(hit[2]);dist.append(hit[3]);ndir.append(float(np.dot(p-np.array(hit[0]),hit[1])))
 dist=np.array(dist)*1000;nearface=np.array(nearface);npnt=np.array(npnt);ndir=np.array(ndir)*1000
 worst=np.argsort(dist)[-30:][::-1]
 # Signed nearest plane for shell/anatomy is not an inside-volume certificate.
 ad=[];sd=[]
 for p in ext:
  x=abvh.find_nearest(Vector(p));ad.append((x[3],float(np.dot(p-np.array(x[0]),x[1]))))
  x=sbvh.find_nearest(Vector(p));sd.append((x[3],float(np.dot(p-np.array(x[0]),x[1]))))
 ad=np.array(ad)*1000;sd=np.array(sd)*1000
 crest=[]
 for v in [3.,13.]:
  ids=np.flatnonzero(np.isclose(z['source_uv'][:,1],v,atol=1e-8)&(z['source_side']==0));cp=P[ids];cn=z['normals'][ids];cn/=np.linalg.norm(cn,axis=1)[:,None];cd=first_ray_box(cp,cn,C,M,H);crest.append({'v':v,'native_vertex_count':len(ids),'outward_normal_first_union_offset_mm':stats(cd[np.isfinite(cd)]*1000),'misses':int((~np.isfinite(cd)).sum())})
 report={'candidate':D.name,'cube_count':len(C),'geometry_json_sha256':hashlib.sha256((D/'band.geo.json').read_bytes()).hexdigest(),'native_surface_samples':len(S),'source_triangle_sample_count_each':7,'native_normal_ray_method':'Origin 20 mm outward, direction inward normal, exact ray slab intervals over all positive-depth OBBs; first entry in 40 mm. Signed offset positive means candidate reaches outward of sampled native point. Finite face samples only; not exact Hausdorff or arbitrary-direction envelope.','native_normal_ray_misses':int((~good).sum()),'native_normal_ray_outward_offset_mm':stats(delta[good]*1000),'native_outer_normal_ray_offset_mm':stats(delta[(z['face_parts'][FI]==0)&good]*1000),'native_inner_normal_ray_offset_mm':stats(delta[(z['face_parts'][FI]==1)&good]*1000),'source_containment_negative_ray_offsets_gt_0_01mm':int(np.sum(delta[good]<-.00001)),'all_cube_surface_samples':len(Q),'samples_strictly_inside_other_cube':int(inside.sum()),'exposed_cube_surface_samples':len(ext),'exposed_cube_to_native_actual_triangle_distance_mm':stats(dist),'exposed_cube_to_native_signed_closest_plane_mm':stats(ndir),'exposed_major_thickness_faces_distance_mm':stats(dist[ea==2]),'exposed_tangent_side_faces_distance_mm':stats(dist[ea!=2]),'crest_vertices':crest,'exposed_cube_to_anatomy_unsigned_distance_mm':stats(ad[:,0]),'exposed_cube_to_anatomy_signed_nearest_plane_mm':stats(ad[:,1]),'exposed_cube_to_shell_unsigned_distance_mm':stats(sd[:,0]),'exposed_cube_to_shell_signed_nearest_plane_mm':stats(sd[:,1]),'signed_nearest_plane_caveat':'Negative plane sign near a triangle is not a robust signed distance or new-contact classification. Shared baseline contact needs independent ray/triangle comparison.','worst_exposed_samples':[{'point':ext[i].tolist(),'cube':int(eo[i]),'cube_face_axis':int(ea[i]),'nearest_native_face':int(nearface[i]),'nearest_native_point':npnt[i].tolist(),'distance_mm':float(dist[i])}for i in worst],'sampling_caveats':['Face-grid area weighting is not uniform: reported quantiles are deterministic sample quantiles, not area percentiles.','Strictly interior removal excludes hidden cube faces but does not form a Boolean union mesh. Coplanar shared faces may remain sampled.','Nearest-point operation uses actual native triangles in Blender BVH float precision; no vertex KD surrogate.','No game rendering, runtime performance, normalmap or artistic approval.']}
 (D/'metrics.json').write_text(json.dumps(report,indent=2)+'\n');np.savez_compressed(D/'metrics-samples.npz',native_sample_points=S,native_face=FI,native_uv=SU,native_normal_union_offset=delta,exposed_cube_points=ext,exposed_cube_id=eo,exposed_cube_face_axis=ea,exposed_nearest_native_face=nearface,exposed_nearest_native_point=npnt,exposed_native_distance_mm=dist)
 print(D.name,json.dumps({k:report[k]for k in ['cube_count','native_normal_ray_outward_offset_mm','exposed_cube_to_native_actual_triangle_distance_mm']}),flush=True)
