import bpy,json,numpy as np
from mathutils import Vector
from mathutils.bvhtree import BVHTree
r='/workspace/scratch/212c580ada5b/paz-arm-chain/';bpy.ops.wm.open_mainfile(filepath=r+'V84-whole-arm-chain-TRIAL.blend',use_scripts=False);o=bpy.data.objects['Maria — túnica e mangas integradas'];h=bpy.data.objects['Maria — mão protetora anatômica'];key=o.data.shape_keys.key_blocks['CADEIA84 — ombro cotovelo punho reversível'];hk=h.data.shape_keys.key_blocks[-1];report={}
def tree(ob,dg):
 m=ob.evaluated_get(dg).to_mesh();ps=[ob.matrix_world@v.co for v in m.vertices];fs=[tuple(f.vertices) for f in m.polygons];b=BVHTree.FromPolygons(ps,fs);ob.evaluated_get(dg).to_mesh_clear();return b
for ver in ['V75','V84']:
 key.value=int(ver=='V84');hk.value=int(ver=='V84')
 for k in o.data.shape_keys.key_blocks:
  if 'TESTE75' in k.name:k.value=int(ver=='V75')
 bpy.context.view_layer.update();dg=bpy.context.evaluated_depsgraph_get();ht=tree(h,dg);tt=tree(o,dg);pairs={}
 for x in bpy.data.objects:
  if x.type=='MESH' and not x.hide_render and ('Menino' in x.name or 'menino' in x.name):
   xt=tree(x,dg);pairs[x.name]={'hand':len(ht.overlap(xt)),'tunic':len(tt.overlap(xt))}
 pairs['hand_tunic_pairs']=len(ht.overlap(tt));report[ver]=pairs
json.dump(report,open(r+'contact-audit.json','w'),indent=2);print(report)
