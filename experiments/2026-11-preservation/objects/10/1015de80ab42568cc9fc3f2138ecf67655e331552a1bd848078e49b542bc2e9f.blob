for pose in chosen:
 ax,ay,az=pose['angles_deg'];R=Matrix.Rotation(math.radians(az),3,'Z')@Matrix.Rotation(math.radians(ay),3,'Y')@Matrix.Rotation(math.radians(ax),3,'X');trans=Vector((0,-pose['outward_shift'],0));target=np.array([tuple(pivot+R@(Vector(x)-pivot)+trans) for x in p]);q=p+weights[:,None]*(target-p);q[list(boundary)]=p[list(boundary)];q[list(core)]=target[list(core)];rots=np.tile(np.eye(3),(len(p),1,1));residual=1
 sup_index={i:k for k,i in enumerate(sup)};ei=np.array([i for i in sup for j in adj[i]]);ej=np.array([j for i in sup for j in adj[i]]);di=np.array([sup_index[i] for i in ei]);fsel=np.array([i in index for i in ei]);fi=ei[fsel];fj=ej[fsel];fk=np.array([index[i] for i in fi]);fixed=np.array([j not in index for j in fj]);pdiff=p[ei]-p[ej]
 for it in range(1000):
  cov=np.zeros((len(sup),3,3));np.add.at(cov,di,np.einsum('ni,nj->nij',q[ei]-q[ej],pdiff));uu,ss,vv=np.linalg.svd(cov);rr=uu@vv;bad=np.linalg.det(rr)<0;uu[bad,:,-1]*=-1;rots[sup]=uu@vv
  rhs=np.zeros((len(free),3));terms=.5*np.einsum('nij,nj->ni',rots[fi]+rots[fj],p[fi]-p[fj]);terms[fixed]+=q[fj[fixed]];np.add.at(rhs,fk,terms)
  new=np.column_stack([solve(rhs[:,d]) for d in range(3)]);residual=float(np.max(np.linalg.norm(new-q[free],axis=1)));q[free]=new
  if residual<1e-6:break
 ratios=np.linalg.norm(q[edgeids[:,0]]-q[edgeids[:,1]],axis=1)/oldlength;nn=np.cross(q[tri[:,1]]-q[tri[:,0]],q[tri[:,2]]-q[tri[:,0]]);nn/=np.maximum(np.linalg.norm(nn,axis=1)[:,None],1e-12);angs=np.degrees(np.arccos(np.clip(np.sum(nn*oldn,axis=1),-1,1)));newh=[pivot+R@(v-pivot)+trans for v in hp];bv=BVHTree.FromPolygons([Vector(v) for v in q],tfaces);signed=[]
 for i in upper:
