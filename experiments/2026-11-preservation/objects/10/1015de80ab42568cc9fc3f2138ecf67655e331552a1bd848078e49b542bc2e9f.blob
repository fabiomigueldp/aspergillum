 overlap=len(BVHTree.FromPolygons(newh,handfaces).overlap(bv));report={'angles':pose['angles_deg'],'iterations':it+1,'residual_m':residual,'edge_ratio_min':float(ratios.min()),'edge_ratio_max':float(ratios.max()),'edges_over_20pct':int(np.sum((ratios<.8)|(ratios>1.2))),'normal_max_deg':float(angs.max()),'normal_over15':int(np.sum(angs>15)),'faces_reversed':int(np.sum(angs>90)),'outside_support_max_delta':float(np.max(np.linalg.norm(q[[i for i in range(len(p)) if i not in support]]-p[[i for i in range(len(p)) if i not in support]],axis=1))),'min_hand_clearance':min(signed),'hand_triangle_intersections':overlap,'mean_tip_gap_previous_pose':pose['mean_tip_gap'],'core_count':len(core),'boundary_count':len(boundary)};report['passes']=report['edges_over_20pct']==0 and report['normal_over15']==0 and overlap==0 and min(signed)>=0;reports.append(report)
 if report['passes'] and (best is None or pose['mean_tip_gap']<best[0]):best=(pose['mean_tip_gap'],q.copy(),newh,report)
json.dump({'method':'ARAP local/global elastic solve, fixed boundary, rigid cuff core handles, torso unchanged','trials':reports,'chosen':best[3] if best else None},open(r+'V47-arap-converged-verification.json','w'),indent=2);print(reports)
