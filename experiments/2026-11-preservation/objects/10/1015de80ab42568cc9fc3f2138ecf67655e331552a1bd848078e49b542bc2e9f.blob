t=bpy.data.objects['Maria — túnica e mangas integradas'];t.shape_key_clear();m=t.data;p=np.array([tuple(v.co) for v in m.vertices]);weights=np.array([v.value for v in m.attributes['.sculpt_mask'].data]);seed=json.load(open(r+'checkpoint-20261102/cuff-mask-seed.json'));support={i for i,w in seed['weights']};adj=[set() for _ in p]
for e in m.edges:i,j=e.vertices;adj[i].add(j);adj[j].add(i)
boundary={i for i in support if any(j not in support for j in adj[i])};core={i for i in support if weights[i]>.999999};free=sorted(support-boundary-core);index={i:k for k,i in enumerate(free)};rows=[];cols=[];values=[]
