import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';import assert from 'node:assert/strict';import {buildSync} from 'esbuild';
const root=path.resolve(import.meta.dirname,'../..'),inputs={};const sha=x=>crypto.createHash('sha256').update(x).digest('hex');const read=p=>{const b=fs.readFileSync(path.join(root,p));inputs[p]=sha(b);return b;};
function domain(p){const result=buildSync({entryPoints:[path.join(root,p)],bundle:true,write:false,platform:'node',format:'esm',metafile:true});for(const f of Object.keys(result.metafile.inputs)){const full=path.resolve(f);inputs[path.relative(root,full)]=sha(fs.readFileSync(full));}return import('data:text/javascript;base64,'+Buffer.from(result.outputFiles[0].contents).toString('base64'));}
const {resolveDocking}=await domain('src/domain/docking.ts');const {loadFromAspersorium,createDefaultAspergillumState}=await domain('src/domain/aspergillum.ts');
const radices=[2,3,7,7],keys=radices.map((_,i)=>`aspergillum:state_${i}`),rotate='aspergillum:rotation';
const semantic=s=>({water:Math.min(16,s['aspergillum:water_base']+s['aspergillum:water_offset']),occupied:s['aspergillum:has_aspergillum'],cosmetic:s['aspergillum:has_aspergillum']?s['aspergillum:cosmetic']:0,rotation:s[rotate]});
function encode(t){assert(Number.isInteger(t.water)&&t.water>=0&&t.water<=16);assert(Number.isInteger(t.cosmetic)&&t.cosmetic>=0&&t.cosmetic<=15);assert(Number.isInteger(t.rotation)&&t.rotation>=0&&t.rotation<16);assert.equal(typeof t.occupied,'boolean');let n=t.water*17+(t.occupied?t.cosmetic+1:0);const s={[rotate]:t.rotation};for(let i=0;i<4;i++){s[keys[i]]=n%radices[i];n=Math.floor(n/radices[i]);}assert.equal(n,0);return s;}
function decode(s){let n=0,m=1;for(let i=0;i<4;i++){assert(Number.isInteger(s[keys[i]])&&s[keys[i]]>=0&&s[keys[i]]<radices[i]);n+=s[keys[i]]*m;m*=radices[i];}if(n>288)n=0;const o=n%17;return {water:Math.floor(n/17),occupied:o!==0,cosmetic:o?o-1:0,rotation:s[rotate]};}
const b=JSON.parse(read('packs/behavior/blocks/aspersorium.block.json'))['minecraft:block'],candidate=structuredClone(b);
const n=`(${keys.map((k,i)=>`${radices.slice(0,i).reduce((a,b)=>a*b,1)} * q.block_state('${k}')`).join(' + ')})`,safe=`(${n} <= 288 ? ${n} : 0)`,water=`math.floor(${safe} / 17)`,occ=`math.mod(${safe}, 17)`,base=`(math.floor(${water} / 9) * 9)`;
const replacements={'aspergillum:has_aspergillum':`(${occ} != 0)`,'aspergillum:cosmetic':`(${occ} == 0 ? 0 : ${occ} - 1)`,'aspergillum:water_base':base,'aspergillum:water_offset':`(${water} - ${base})`};
function replace(s){for(const[k,v]of Object.entries(replacements))s=s.replaceAll(`q.block_state('${k}')`,v);return s;}
for(const k of Object.keys(replacements))delete candidate.description.states[k];for(let i=0;i<4;i++)candidate.description.states[keys[i]]=Array.from({length:radices[i]},(_,i)=>i);
function vis(c){if(c['minecraft:geometry']?.bone_visibility)for(const[k,v]of Object.entries(c['minecraft:geometry'].bone_visibility))if(typeof v==='string')c['minecraft:geometry'].bone_visibility[k]=replace(v);}
vis(candidate.components);for(const p of candidate.permutations){p.condition=replace(p.condition);vis(p.components);}
const cache=new Map();const ev=(s,states)=>{if(typeof s!=='string')return s;let f=cache.get(s);if(!f){f=Function('q','math',`return (${s});`);cache.set(s,f);}return f({block_state:k=>states[k]},{floor:Math.floor,mod:(a,b)=>a%b});};
function components(b,s){const c=structuredClone(b.components);for(const p of b.permutations??[])if(ev(p.condition,s))Object.assign(c,structuredClone(p.components));if(c['minecraft:geometry']?.bone_visibility)for(const[k,v]of Object.entries(c['minecraft:geometry'].bone_visibility))c['minecraft:geometry'].bone_visibility[k]=!!ev(v,s);return c;}
const product=states=>Object.entries(states).reduce((rows,[k,values])=>rows.flatMap(row=>values.map(v=>({...row,[k]:v}))),[{}]);const oldstates=product(b.description.states),newstates=product(candidate.description.states);let semanticChecks=0,componentChecks=0,waterAliases=0,emptyCosmeticAliases=0;
for(const old of oldstates){const t=semantic(old),encoded=encode(t);assert.deepEqual(decode(encoded),t);semanticChecks++;if(old['aspergillum:water_base']+old['aspergillum:water_offset']>16)waterAliases++;if(!old['aspergillum:has_aspergillum']&&old['aspergillum:cosmetic']!==0)emptyCosmeticAliases++;else{assert.deepEqual(components(candidate,encoded),components(b,old));componentChecks++;}}
for(const s of newstates){const t=decode(s),old={'aspergillum:water_base':t.water>=9?9:0,'aspergillum:water_offset':t.water>=9?t.water-9:t.water,'aspergillum:has_aspergillum':t.occupied,'aspergillum:cosmetic':t.cosmetic,[rotate]:t.rotation};assert.deepEqual(components(candidate,s),components(b,old));componentChecks++;}
let dockingCases=0,loadingCases=0,undockingCases=0,recolorCases=0;
for(let water=0;water<=16;water++)for(let rotation=0;rotation<16;rotation++)for(let cosmetic=0;cosmetic<16;cosmetic++){
 const occupied={water,rotation,cosmetic,occupied:true},empty={water,rotation,cosmetic:0,occupied:false};assert.deepEqual(decode(encode({...occupied,occupied:false})),empty);undockingCases++;
 for(let nextCosmetic=0;nextCosmetic<16;nextCosmetic++){assert.deepEqual(decode(encode({...occupied,cosmetic:nextCosmetic})),{...occupied,cosmetic:nextCosmetic});recolorCases++;}
 for(let charges=0;charges<=4;charges++){
  const decoded=decode(encode(empty));const before=resolveDocking(water,charges),after=resolveDocking(decoded.water,charges);assert.deepEqual(after,before);assert.equal(after.nextWater+after.remainingCharges,water+charges);assert.deepEqual(decode(encode({water:after.nextWater,rotation,cosmetic,occupied:true})),{water:after.nextWater,rotation,cosmetic,occupied:true});dockingCases++;
  const item={...createDefaultAspergillumState(charges),cosmeticId:`test_${cosmetic}`,sprayProfileId:'retained'};
  for(const policy of ['consume','retain']){const expected=loadFromAspersorium(item,water,policy),actual=loadFromAspersorium(item,decoded.water,policy);assert.deepEqual(actual,expected);assert.equal(decode(encode({...empty,water:actual.nextWater})).water,actual.nextWater);if(policy==='consume')assert.equal(actual.state.charges+actual.nextWater,charges+water);else assert.equal(actual.nextWater,water);loadingCases++;}
 }
}
for(const[p,h]of Object.entries(inputs))assert.equal(sha(fs.readFileSync(path.join(root,p))),h);
const report={schemaVersion:1,createdAt:new Date().toISOString(),scope:'Read-only in-memory alternative. No production writes.',counts:{aspersorium:newstates.length,table:288,inventoryProxies:16,aspergillum:newstates.length+304,combined:59840+newstates.length+304,remaining:65536-59840-newstates.length-304},codec:{semanticWater:17,semanticOccupancy:17,logicalCases:289,packedCases:294,radices,rotations:16,paddingAliases:5},verification:{oldStates:oldstates.length,semanticChecks,componentChecks,waterAliasInputs:waterAliases,emptyCosmeticAliasInputs:emptyCosmeticAliases,actualPureDomainDockingCases:dockingCases,actualPureDomainLoadingCases:loadingCases,projectedUndockCases:undockingCases,projectedRecolorCases:recolorCases,inputsUnchanged:true},normalization:'Water(9,8) already decodes to16 and is explicitly canonicalized. Empty nonzero cosmetic is explicitly canonicalized; inverse raw-state restoration requires original snapshot metadata.',limitations:['Actual pure domain resolveDocking/loadFromAspersorium functions were executed, but no inventory, registry, transaction, event handler or Minecraft engine was executed.','This couples water and occupancy in a schema: every mutator must decode and encode the full tuple, preserving unrelated values and late conflict detection.','Requires the same raw registry/world/pack backup and mismatch report as the simpler occupancy candidate. No implementation approval assumed.','688 states is a modest reserve for these two packs only, not a performance guarantee.'],inputs};
fs.writeFileSync(path.join(import.meta.dirname,'aspergillum-coupled-state-report.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report,null,2));
