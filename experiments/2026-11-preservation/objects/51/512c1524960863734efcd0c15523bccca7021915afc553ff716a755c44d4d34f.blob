from pathlib import Path
import numpy as np,json,gzip
from PIL import Image
from scipy.spatial.transform import Rotation
O=Path(__file__).resolve().parent;V=O.parent;g=json.loads((V/'resource_pack/models/entity/paz_v75_v14_lab_sculpture.geo.json').read_text())['minecraft:geometry'][0];records=[json.loads(l)for l in gzip.open(V/'export_work/transport_faces.jsonl.gz','rt')];actual=np.fromfile(O/'actual-module-faces.f64','<f8').reshape(-1,4,8);maps=json.loads((O/'actual-module-face-map.json').read_text());lookup={(r['bone'],r['cube'],r['face']):i for i,r in enumerate(maps)};col=np.array(Image.open(V/'resource_pack/textures/entity/paz_v75_v14_lab_sculpture.png'));errs=[];uvdiff=[];flippeddiff=[];normalerr=[];maskdiff=[];own_winding_dot=[]
for r in records:
 c=g['bones'][r['part']]['cubes'][r['cube_index']];s=np.array(c['size']);o=np.array(c['origin']);p=np.array(c['pivot'])*[-1,1,1];frombb=np.array([-o[0]-s[0],o[1],o[2]]);rot=Rotation.from_euler('xyz',np.array(c['rotation'])*[-1,-1,1],degrees=True).as_matrix();local=np.array([[0,s[1],0],[s[0],s[1],0],[0,0,0],[s[0],0,0]]);desired=((local+frombb-p)@rot.T+p)*[-1,1,1]/16
 a=actual[lookup[(r['bone'],r['cube_index'],'south')]];wn=np.cross(a[2,:3]-a[0,:3],a[1,:3]-a[0,:3]);wn/=np.linalg.norm(wn);own_winding_dot.append(float(wn@a[0,5:8]));dist=np.linalg.norm(desired[:,None,:]-a[None,:,:3],axis=2);idx=dist.argmin(1);errs.append(float(dist.min(1).max()));u,v=c['uv']['south']['uv'];expected=np.array([[u,v],[u+20,v],[u,v+20],[u+20,v+20]]);got=np.column_stack([a[idx,3]*4096,(1-a[idx,4])*4096]);uvdiff.append(float(abs(expected-got).max()));flip=got.copy();flip[:,0]=2*u+20-flip[:,0];flippeddiff.append(float(abs(expected-flip).max()));normalerr.append(float(np.max(np.linalg.norm(a[:,5:8]-rot[:,2]*[-1,1,1],axis=1))));tile=col[v:v+20,u:u+20,3]>0;maskdiff.append(int(np.count_nonzero(tile!=tile[:,::-1])))
rep={'new_faces_compared':len(records),'max_unordered_corner_distance_blocks':max(errs),'max_joint_position_uv_difference_texels':max(uvdiff),'faces_with_horizontal_uv_mismatch':sum(x>1 for x in uvdiff),'max_joint_position_uv_difference_after_U_mirror_texels':max(flippeddiff),'own_winding_dot_normal_range':[min(own_winding_dot),max(own_winding_dot)],'faces_attribute_normal_opposite_own_winding':sum(x<-.99 for x in own_winding_dot),'max_normal_vector_distance':max(normalerr),'faces_with_reversed_normal_attribute':sum(x>1.99 for x in normalerr),'tiles_with_asymmetric_alpha':sum(x>0 for x in maskdiff),'max_alpha_pixels_changed_by_U_mirror':max(maskdiff),'mean_alpha_pixels_changed_by_U_mirror':float(np.mean(maskdiff)),'interpretation':'Actual unmodified Aspergillum builds matching corner sets but reversed south normal attributes (zero-depth Three BoxGeometry) and horizontally mirrored south UV relative to the official Blockbench primary-source harness and the exporter/importer convention. This is an external viewer disagreement, not a new V14 triangle geometry regression. Prior corner-set comparison did not test this association.','engine_tested':False};(O/'joint-position-uv-comparison.json').write_text(json.dumps(rep,indent=2));print(json.dumps(rep,indent=2))
