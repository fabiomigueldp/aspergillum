from pathlib import Path
import numpy as np,json
from PIL import Image,ImageDraw
from scipy.ndimage import binary_erosion,distance_transform_edt
W=Path(__file__).resolve().parent;B=W.parents[1]
z=np.load(B/'band_shell_v13/constrained_fit/retained-band.npz');old=z['points'][z['triangles']]
s=np.load(B/'ear_rim_v11/structural_rebuild/retained-shell.npz');a=np.load(B/'body_interface_v9/constrained_fit/retained-anatomy.npz');common=np.concatenate([s['points'][s['triangles']],a['points'][a['triangles']]])
views=[('band-front',(.035,-3.5,3.58),(.035,-.30,3.58),.52),('head-front',(.25,-3.5,3.44),(.03,-.20,3.43),.85),('profile',(3,-.1,3.4),(.03,-.10,3.42),.8),('back',(2,3,3.5),(.03,-.1,3.34),.95),('left-ear',(-3,-.16,3.50),(-.085,-.205,3.485),.50),('right-ear',(3,-.16,3.48),(.17,-.205,3.46),.50),('left-oblique',(-2,-1.5,3.82),(-.085,-.205,3.485),.50),('right-oblique',(2,-1.5,3.82),(.17,-.205,3.46),.50)]
N=2048

def mask(tri,pos,target,scale):
 f=np.array(target)-pos;f/=np.linalg.norm(f);r=np.cross(f,[0,0,1]);r/=np.linalg.norm(r);u=np.cross(r,f);a=tri-np.array(target);xy=np.stack((a@r,-a@u),axis=-1)/scale*N+N/2;im=Image.new('1',(N,N));dr=ImageDraw.Draw(im)
 for t in xy:dr.polygon([tuple(q)for q in t],fill=1)
 return np.array(im)

for D in sorted(W.glob('budget-*')):
 d=np.load(D/'band.npz');new=d['points'][d['triangles']];rows={};thumbs=[]
 for name,pos,target,scale in views:
  oldm=mask(old,pos,target,scale);newm=mask(new,pos,target,scale);cm=mask(common,pos,target,scale);data={}
  for scope,o,n in [('band-only',oldm,newm),('native-three-part-union',oldm|cm,newm|cm)]:
   b0=o^binary_erosion(o);b1=n^binary_erosion(n);ds=np.r_[distance_transform_edt(~b1)[b0],distance_transform_edt(~b0)[b1]]*scale/N*1000
   data[scope]={'old_coverage_pixels':int(o.sum()),'new_coverage_pixels':int(n.sum()),'added_pixels':int(np.sum(n&~o)),'removed_pixels':int(np.sum(o&~n)),'iou':float(np.sum(o&n)/np.sum(o|n)),'boundary_nearest_distance_max_mm':float(ds.max()),'boundary_nearest_distance_p95_mm':float(np.percentile(ds,95)),'pixel_mm':scale/N*1000}
   rgb=np.full((N,N,3),255,np.uint8);rgb[o&n]=[110,110,110];rgb[o&~n]=[235,60,60];rgb[n&~o]=[45,90,230];im=Image.fromarray(rgb);im.save(D/f'coverage-{scope}-{name}.png')
   if scope=='band-only':
    im.thumbnail((512,512));can=Image.new('RGB',(512,540),'white');can.paste(im);ImageDraw.Draw(can).text((10,518),f'{name}: +{data[scope]["added_pixels"]} / -{data[scope]["removed_pixels"]} px',fill='black');thumbs.append(can)
  rows[name]=data
 out=Image.new('RGB',(512*4,540*2),'white')
 for i,im in enumerate(thumbs):out.paste(im,(i%4*512,i//4*540))
 out.save(D/'coverage-band-overview.png')
 (D/'silhouette-metrics.json').write_text(json.dumps({'method':'2048x2048 orthographic binary union of actual JSON-decoded positive-depth cuboid triangles, compared with native V13; includes independent band-only and native shell+anatomy+band coverage. Coverage only, not shading or frontmost visible identity. Red is removed, blue added. Finite resolution/views, not 3D silhouette guarantee.','views':rows},indent=2)+'\n')
 print(D.name,json.dumps({k:{s:r[s]['boundary_nearest_distance_max_mm']for s in r}for k,r in rows.items()}),flush=True)
