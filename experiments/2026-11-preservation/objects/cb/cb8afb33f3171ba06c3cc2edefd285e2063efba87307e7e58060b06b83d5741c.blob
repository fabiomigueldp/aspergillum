from pathlib import Path
import sys,json,hashlib,numpy as np
O=Path(__file__).resolve().parent;B=O.parent.parent
base=np.load(B/'body_interface_v8/anatomy_fit/baseline-welded.npz');v8=np.load(B/'body_interface_v8/anatomy_fit/retained-anatomy.npz');p0=base['points'];p8=v8['points'];f=base['triangles'];prot=v8['protected_vertices'];active=v8['active_vertices'];selected=sys.argv[1] if len(sys.argv)>1 else 'intrinsic097-c30-iteration00';sel=O/(selected+'.npz');candidate=np.load(sel);p=candidate['points']
def strain(p,ref):
 e1=ref[f[:,1]]-ref[f[:,0]];e2=ref[f[:,2]]-ref[f[:,0]];raw=np.cross(e1,e2);a=np.linalg.norm(raw,axis=1);valid=a>2e-12;fv=f[valid];e1=e1[valid];e2=e2[valid];n=raw[valid]/a[valid,None];l1=np.linalg.norm(e1,axis=1);x=e1/l1[:,None];y=np.cross(n,x);R=np.zeros((len(fv),2,2));R[:,0,0]=l1;R[:,0,1]=np.sum(e2*x,axis=1);R[:,1,1]=np.sum(e2*y,axis=1);E=np.stack([p[fv[:,1]]-p[fv[:,0]],p[fv[:,2]]-p[fv[:,0]]],axis=2);sv=np.linalg.svd(E@np.linalg.inv(R),compute_uv=False);r=np.cross(E[:,:,0],E[:,:,1]);ar=np.linalg.norm(r,axis=1)/a[valid];cos=np.sum(r*n,axis=1)/np.linalg.norm(r,axis=1);ang=np.degrees(np.arccos(np.clip(cos,-1,1)));idx=np.flatnonzero(valid);return {'minimum_principal_stretch':float(sv.min()),'maximum_principal_stretch':float(sv.max()),'maximum_anisotropy':float((sv[:,0]/sv[:,1]).max()),'minimum_area_ratio':float(ar.min()),'maximum_area_ratio':float(ar.max()),'area_shrunk_faces':int(sum(ar<1-1e-8)),'directionally_compressed_faces':int(sum(sv[:,1]<1-1e-8)),'max_normal_rotation_degrees':float(ang.max()),'faces_area_below_0p95':idx[ar<.95].tolist(),'faces_stretch_below_0p95':idx[sv[:,1]<.95].tolist(),'faces_stretch_above_1p05':idx[sv[:,0]>1.05].tolist(),'worst_min_stretch_face':int(idx[np.unravel_index(sv.argmin(),sv.shape)[0]]),'worst_area_face':int(idx[ar.argmin()]),'nape_source_face6360':{'face':144,'area_ratio':float(ar[np.flatnonzero(idx==144)[0]]),'stretches':sv[np.flatnonzero(idx==144)[0]].tolist(),'normal_degrees':float(ang[np.flatnonzero(idx==144)[0]])}}
rows=[]
for path in sorted(O.glob('*-report.json')):
 d=json.loads(path.read_text())
 if 'iterations' not in d:continue
 for row in d['iterations']:
  row=dict(row);tag=d['tag'];file=O/f"{tag}-iteration{row['iteration']:02d}.npz"
  if file.exists():row['tag']=tag;row['file']=file.name;row['intrinsic_original']=strain(np.load(file)['points'],p0);rows.append(row)
report={'provisional_candidate':sel.name,'sha256':hashlib.sha256(sel.read_bytes()).hexdigest(),'status':'Research alternative only; not retained or approved; bounded compression remains. Await independent geometry and visuals.','same_connectivity':bool(np.array_equal(candidate['triangles'],f)),'same_source_indices':bool(np.array_equal(candidate['source_indices'],base['source_indices'])),'same_source_face_indices':bool(np.array_equal(candidate['source_face_indices'],base['source_face_indices'])),'explicit_protection':{'count':int(prot.sum()),'exact':bool(np.array_equal(p[prot],p0[prot]))},'outside_active':{'count':int((~active).sum()),'exact':bool(np.array_equal(p[~active],p0[~active]))},'ear_fixed_count':int(v8['protected_ears'].sum()),'quality_relative_to_original':strain(p,p0),'quality_relative_to_v8':strain(p,p8),'scope':'All vertices/faces correspond to original baseline; original microscopic3v2f component remains exact; no shell/band/alpha/source mutation.','proposed_bounded_quality_gate':{'area_ratio_min':.95,'principal_stretch_min':.95,'principal_stretch_max':1.05,'max_normal_degrees':20,'important':'This is an explicit experimental tolerance, not user approval of compression. A literal no-compression criterion requires all area ratios and minimum principal stretches >=1.'},'strict_no_compression':False,'trials':rows}
# Contact deltas in exact triangle identities; position labels are baseline centroids.
a=np.load(O/(selected+'-contacts.npz'));old=np.load(B/'body_interface_v9/independent_diagnosis/independent-baseline-v8-contacts.npz');print('contact archive keys',old.files)
# Parse contacts saved with each solver baseline from independent arrays if known.
for name in ['shell','band']:
 current=set(map(tuple,a['body_'+name+'_pairs']));keybase=next((k for k in old.files if 'baseline' in k and name in k),None);keyv8=next((k for k in old.files if 'v8' in k and name in k),None)
 if keybase is None:continue
 bas=set(map(tuple,old[keybase]));pre=set(map(tuple,old[keyv8]));report[name+'_deltas']={'count':len(current),'new_vs_original':[{'body_face':int(i),'body_source_face':int(base['source_face_indices'][i]),'obstacle_face':int(j),'original_centroid':p0[f[i]].mean(0).tolist(),'candidate_centroid':p[f[i]].mean(0).tolist(),'protected_vertex_count':int(prot[f[i]].sum())} for i,j in sorted(current-bas)],'new_vs_v8':[[int(i),int(j)] for i,j in sorted(current-pre)],'removed_vs_original_count':len(bas-current),'removed_vs_v8_count':len(pre-current)}
(O/(selected+'-full-report.json')).write_text(json.dumps(report,indent=2));print(json.dumps({k:v for k,v in report.items() if k not in ['trials','shell_deltas','band_deltas']},indent=2))
