import numpy as np,json
from scipy.optimize import minimize
from mathutils.bvhtree import BVHTree
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/'
d=np.load(r+'neck-whole-fold-collar-proof.npz');V=d['points'];T=d['triangles'];R=d['inner_rings'];e=np.load(r+'neck-collar-exact-obstacles.npz');OT=e['outside_triangles'];HP=e['skin_points'];HT=e['skin_triangles'];audit=json.load(open(r+'neck-collar-internal-dof-audit.json'));normals=np.array([x['normal'] for x in audit['constraints'][:2]]);dist=np.array([x['plane_distance'][0] for x in audit['constraints'][:2]]);margin=1e-5
sol=minimize(lambda x:.5*np.dot(x,x),np.zeros(3),jac=lambda x:x,constraints=[{'type':'ineq','fun':lambda x:dist+normals@x-margin,'jac':lambda x:normals}],method='SLSQP',options={'ftol':1e-15,'maxiter':100})
assert sol.success and np.min(dist+normals@sol.x-margin)>-1e-10
Q=V.copy();j=int(np.where(R[1]==186401)[0][0]);ids=[int(R[0,j]),int(R[1,j])];Q[ids]+=sol.x
ct=BVHTree.FromPolygons(Q.tolist(),T.tolist(),all_triangles=True);ot=BVHTree.FromPolygons(Q.tolist(),OT.tolist(),all_triangles=True);ht=BVHTree.FromPolygons(HP.tolist(),HT.tolist(),all_triangles=True);outside=[(a,b) for a,b in ct.overlap(ot) if not set(T[a])&set(OT[b])];sp=[(a,b) for a,b in ct.overlap(ct) if a<b and not set(T[a])&set(T[b])];skin=ct.overlap(ht)
A=V[T];B=Q[T];na=np.cross(A[:,1]-A[:,0],A[:,2]-A[:,0]);nb=np.cross(B[:,1]-B[:,0],B[:,2]-B[:,0]);ratio=np.linalg.norm(nb,axis=1)/np.linalg.norm(na,axis=1)
rp={'method':'Minimal paired XYZ translation satisfying two full obstacle triangle supporting-plane halfspaces; only one paired inner node, fixed outer rings, exact source triangulations','moved_ids':ids,'delta':sol.x.tolist(),'maximum_delta_m':float(np.linalg.norm(sol.x)),'support_plane_clearance_m':(dist+normals@sol.x).tolist(),'skin_pairs':len(skin),'outside_pairs':[(a,b,int(e['outside_source_faces'][b])) for a,b in outside],'self_pairs':sp,'area_ratio_range':[float(ratio.min()),float(ratio.max())],'flips':int(np.sum(np.sum(na*nb,axis=1)<=0)),'pair_vector_delta':float(np.max(abs((Q[R[1]]-Q[R[0]])-(V[R[1]]-V[R[0]])))),'outer_delta':float(max(np.max(abs(Q[d['outer_loop']]-V[d['outer_loop']])),np.max(abs(Q[d['paired_outer']]-V[d['paired_outer']])))),'center_filled':False,'blend_saved':False};json.dump(rp,open(r+'neck-collar-internal-dof-proof.json','w'),indent=2);np.savez(r+'neck-collar-internal-dof-proof.npz',points=Q,triangles=T,inner_rings=R);print(rp)
