import bpy,json,math
from mathutils import Vector
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/'
bpy.ops.wm.open_mainfile(filepath=r+'cuff-manual-mask-visible.blend',use_scripts=False)
o=bpy.data.objects['Maria — túnica e mangas integradas'];m=o.data;weights=[v.value for v in m.attributes['.sculpt_mask'].data];orig=[v.co.copy() for v in m.vertices];delta=Vector((0,.005,0));o.shape_key_add(name='Basis');key=o.shape_key_add(name='DIAGNÓSTICO — cuff 5 mm posterior, NÃO PROMOVER')
for i,v in enumerate(key.data):v.co=orig[i]+delta*weights[i]
