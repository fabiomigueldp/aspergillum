  fail=np.array(fail,dtype=int);boundary[tag]={'sample_count':len(fractions)*len(records),'transparent_or_outside_count':len(fail),'outside_rect_count':outrect,'unique_halves_with_failed_probe':int(len(np.unique(fail))),'max_recovered_coordinate_error':worstdelta,'failure_parts':{str(p):int((part[fail]==p).sum())for p in src},'first_failure_rows':[{'part':int(part[i]),'native_face':int(native_face[i]),'half':int(half[i])}for i in fail[:10]]}
 parts={}
 for p,d in src.items():
