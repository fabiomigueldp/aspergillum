 rep={'resolution':N,'hashes':{str(p.relative_to(B)):sha(p)for p in [gp,tp,W/'transport_faces.jsonl.gz',W/'transport_arrays.npz']},'checks':{k:bool(v)for k,v in checks.items()},'new_quads':len(records),'max_child_coordinate_error_blocks':float(errors.max()),'max_orientation_error_degrees':float(max(angle)),'max_plane_error_blocks':float(max(plane)),'mask_opaque_pixels':int(tile.sum()),'mask_expected_opaque_pixels':N*(N+1)//2,'parts':parts,'bound_derivation':'Verified actual image is column<=row. Canonical right triangle has legs a,b and cell area ab/N². N(N+1)/2 cells are opaque; triangle area ab/2. Entire triangle interior lies in these cells (except measure-zero float/border effects); extra=area/N, missing=0. Diagonal outer cell corners are at normalized x+y=1+1/N; maximum perpendicular overhang ab/(N sqrt(a²+b²)).','boundary_probe_sampling':'Initial probe uses local tile coordinates before adding atlas U origin; actual complete-atlas address arithmetic is separately tested by audit_shared_boundary_scale.py.','boundary_probes':boundary,'critical_shell_face4488_overhang_mm':float(bounds[(part==1)&(native_face==4488)].max()*1000),'limitations':'Exact planar cell-support proof assumes ideal nearest mip0 sampling. Discrete float64 boundary probes are separately reported, not silently covered by ideal proof. No float32 shader/mips/bilinear/runtime or PBR equivalence.'};results.append(rep);allarrays[str(N)+'_half_overhang']=bounds;print(N,{k:v for k,v in rep.items()if k not in ['hashes','parts','boundary_probes']},flush=True)
