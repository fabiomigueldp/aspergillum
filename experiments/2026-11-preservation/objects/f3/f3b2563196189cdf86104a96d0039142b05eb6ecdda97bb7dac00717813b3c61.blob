for N in [128,512,2048]:
 gp=W/f'shared_mask_{N}.geo.json';tp=W/f'shared_mask_{N}.png';sc=json_faces(gp,texture=tp);g=sc['geo'];tex=sc['texture'];tile=tex[:N,2048:2048+N,3]>0;expected=np.arange(N)[None,:]<=np.arange(N)[:,None];checks={'mask_exact_column_le_row':np.array_equal(tile,expected),'alpha_binary':set(np.unique(tex[:,:,3])).issubset({0,255}),'legacy_rgba_exact':np.array_equal(tex[:2048,:2048],oldtex),'untouched_17_bones_exact':all(b==old['bones'][i]for i,b in enumerate(g['bones'])if i not in src),'only_south_positive_width_height_zero_depth':True,'expected_source_face_half_complete_unique':True,'uv_exact_shared_origin_and_size':True,'metadata_native_vertices_exact':True};errors=[];areas=[];bounds=[];angle=[];plane=[];role=[];basispoints=[]
 assert len(sc['q'])==len(records)
 for p,d in src.items():
