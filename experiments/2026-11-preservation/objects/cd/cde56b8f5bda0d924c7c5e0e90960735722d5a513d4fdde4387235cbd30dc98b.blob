import numpy as np,json
from mathutils.bvhtree import BVHTree
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';d=np.load(r+'interactive-cap-clearance-proof.npz');p=d['points'];T=d['triangles'];W=d['cap_weights'];s=np.load(r+'neck-collar-exact-obstacles.npz');tree=BVHTree.FromPolygons(p.tolist(),T.tolist(),all_triangles=True);skin=BVHTree.FromPolygons(s['skin_points'].tolist(),s['skin_triangles'].tolist(),all_triangles=True);hits=[a for a,b in tree.overlap(skin) if min(W[T[a]])>.999];ids=np.unique(T[hits]);area=np.linalg.norm(np.cross(p[T[:,1]]-p[T[:,0]],p[T[:,2]]-p[T[:,0]]),axis=1)/2;rp={'pure_cap_hit_bounds':[p[ids].min(0).tolist(),p[ids].max(0).tolist()],'hit_triangles':len(set(hits)),'degenerate_triangles':int((area<1e-12).sum()),'area_min':float(area.min()),'note':'Localizes failed projection; not a coverage certificate'};json.dump(rp,open(r+'interactive-cap-clearance-localization.json','w'),indent=2);print(rp)
