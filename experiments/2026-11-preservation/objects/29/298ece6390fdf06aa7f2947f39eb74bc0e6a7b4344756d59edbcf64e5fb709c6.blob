import bpy,numpy as np,json,bmesh,hashlib
from mathutils.bvhtree import BVHTree
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';name='GUI STUDY — whole-cloth cage NOT APPROVED'
bpy.ops.wm.open_mainfile(filepath=r+'interactive-whole-cloth-cage-before.blend',use_scripts=False)
def digest(o):
 p=np.array([v.co[:] for v in o.data.vertices],dtype=np.float32);return hashlib.sha256(p.tobytes()).hexdigest()
original={o.name:digest(o) for o in bpy.context.scene.objects if o.type=='MESH' and o.name!=name};old=np.array([v.co[:] for v in bpy.data.objects[name].data.vertices]);bpy.ops.wm.open_mainfile(filepath=r+'interactive-whole-cloth-cage-study.blend',use_scripts=False);changed=[o.name for o in bpy.context.scene.objects if o.type=='MESH' and o.name!=name and original.get(o.name)!=digest(o)];o=bpy.data.objects[name];p=np.array([v.co[:] for v in o.data.vertices]);delta=np.linalg.norm(p-old,axis=1);o.data.calc_loop_triangles();T=np.array([t.vertices[:] for t in o.data.loop_triangles]);A=old[T];B=p[T];na=np.cross(A[:,1]-A[:,0],A[:,2]-A[:,0]);nb=np.cross(B[:,1]-B[:,0],B[:,2]-B[:,0]);ar=np.linalg.norm(nb,axis=1)/np.maximum(np.linalg.norm(na,axis=1),1e-15);bm=bmesh.new();bm.from_mesh(o.data);bmesh.ops.recalc_face_normals(bm,faces=bm.faces);bm.to_mesh(o.data);bm.free();g=o.vertex_groups.new(name='Diagnostic thickness');g.add(list(range(336)),.1,'REPLACE');g.add(list(range(336,len(p))),1,'REPLACE');md=o.modifiers.new('Diagnostic shell','SOLIDIFY');md.thickness=.006;md.vertex_group=g.name;md.thickness_vertex_group=0;su=o.modifiers.new('Diagnostic smoothing','SUBSURF');su.levels=2;su.render_levels=2;bpy.context.view_layer.update();dg=bpy.context.evaluated_depsgraph_get();em=o.evaluated_get(dg).to_mesh();em.calc_loop_triangles();Q=np.array([v.co[:] for v in em.vertices]);NT=[list(t.vertices) for t in em.loop_triangles];o.evaluated_get(dg).to_mesh_clear();tree=BVHTree.FromPolygons(Q.tolist(),NT,all_triangles=True);sp=[(a,b) for a,b in tree.overlap(tree) if a<b and not set(NT[a])&set(NT[b])];d=np.load(r+'neck-collar-exact-obstacles.npz');hp=tree.overlap(BVHTree.FromPolygons(d['skin_points'].tolist(),d['skin_triangles'].tolist(),all_triangles=True));rp={'gui_changed_vertices':np.where(delta>1e-8)[0].tolist(),'gui_delta_max_m':float(delta.max()),'original_meshes_changed':changed,'source_face_area_ratio':[float(ar.min()),float(ar.max())],'source_flips':int((np.sum(na*nb,axis=1)<0).sum()),'evaluated_self_pairs':len(sp),'evaluated_skin_pairs':len(hp),'evaluated_vertices':len(Q),'status':'interactive cage only; no promotion'};json.dump(rp,open(r+'interactive-lowcage-verification.json','w'),indent=2);np.savez(r+'interactive-lowcage-evaluated.npz',points=Q,triangles=np.array(NT));print(rp)
