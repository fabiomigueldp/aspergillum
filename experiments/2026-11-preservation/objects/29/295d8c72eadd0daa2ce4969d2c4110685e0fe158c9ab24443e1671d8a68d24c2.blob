import test from 'node:test';
import assert from 'node:assert/strict';
import {normalizeStudioConfig,designId,studioDimensions,STUDIO_PRESETS,validateStudioCamera,migrateStudioConfig,studioFilename,studioWorldDimensions,studioOrientedVector} from '../src/shared/studio-contract.js';
import {build} from 'esbuild';
import {fileURLToPath} from 'node:url';
const bundled=await build({entryPoints:[fileURLToPath(new URL('../../addons/altare/tools/studio-domain.ts',import.meta.url))],bundle:true,format:'esm',platform:'neutral',write:false});
const {DESIGNS,compose}=await import('data:text/javascript;base64,'+Buffer.from(bundled.outputFiles[0].contents).toString('base64'));
const ids=new Set(DESIGNS.map(d=>d.id));
test('studio presets and the eight liturgical colors resolve real published designs',()=>{
 for(const preset of STUDIO_PRESETS){const id=designId(preset);if(id)assert.ok(ids.has(id));}
 for(const family of ['pilaster','ogive','trestle'])for(const surface of ['marble','limestone','walnut'])for(const color of ['white','red','green','purple','rose','black','gold','silver'])assert.ok(ids.has(designId({family,surface,textile:'palette',color,frontal:'cross'})));
 for(const family of ['coffer','baluster','crossbrace'])for(const textile of ['none','agnus','ruby','verdant','requiem','palette'])for(const color of ['white','red','green','purple','rose','black','gold','silver'])assert.ok(ids.has(designId({family,textile,color})));
});
test('studio composition uses addon domain roles and dimensions, including split centres',()=>{
 for(const width of [1,3,7,8,16]){
  const tiles=compose({width,depth:2,design:designId({family:'trestle',textile:'agnus'})});assert.equal(tiles.length,width*2);
  const centre=tiles.filter(t=>t.frontal>0);assert.equal(centre.length,width%2?1:2);assert.ok(tiles.every(t=>t.position.y===0));
 }
 assert.throws(()=>compose({width:17,depth:2}));assert.throws(()=>compose({width:7,depth:0}));
});
test('invalid imported scenes are rejected and export dimensions preserve aspect ratio',()=>{
 for(const bad of [{width:0},{width:NaN},{depth:17},{width:9,depth:9},{facing:4},{exposure:Infinity},{family:'missing'},{environment:'https://invalid'},{ornamental:'yes'}])assert.throws(()=>normalizeStudioConfig(bad));
 assert.deepEqual(studioDimensions('16:9',3840),{width:3840,height:2160});assert.deepEqual(studioDimensions('4:5',2560),{width:2048,height:2560});assert.throws(()=>studioDimensions('1:1',8192));
 for(const camera of [null,{position:[0,0,0],target:[0,0,0],projection:'perspective',orthoSpan:1},{position:[Infinity,0,0],target:[0,0,0],projection:'perspective',orthoSpan:1}])assert.throws(()=>validateStudioCamera(camera));
});

test('schema 1 scenes retain classic cloth and former Colonnade lace while schema 2 has universal styles',()=>{
 const a=migrateStudioConfig({family:'classic',cloth:4,textile:'agnus'},1);assert.equal(a.textile,'gold_long');assert.equal(a.cloth,4);
 const b=migrateStudioConfig({family:'colonnade',textile:'agnus'},1);assert.equal(b.textile,'lace');
 const c=migrateStudioConfig({family:'colonnade',textile:'agnus'},2);assert.equal(c.textile,'agnus');
 for(const family of ['classic','pilaster','ogive','trestle','coffer','baluster','colonnade','crossbrace']){
  assert.ok(ids.has(designId({family,textile:'lace'})));
  const style=normalizeStudioConfig({family,textile:'floral',color:'rose'});assert.equal(style.textile,'floral');assert.ok(ids.has(designId(style)));
 }
 assert.equal(normalizeStudioConfig({family:'classic',textile:'linen_long'}).cloth,2);
 assert.equal(normalizeStudioConfig({family:'classic',cloth:4}).textile,'gold_long');
});


test('cross-braced walnut scenes preserve joinery restrictions and every shared textile',()=>{
 const textiles=['none','linen_short','linen_long','gold_short','gold_long','agnus','floral','verdant','requiem','lace'];
 for(const textile of textiles)for(const width of [1,3,7,8,16]){
  const config=normalizeStudioConfig({family:'crossbrace',surface:'marble',frontal:'cross',textile,color:'purple',width,depth:2});
  assert.equal(config.family,'crossbrace');assert.equal(config.surface,'walnut');assert.equal(config.frontal,'none');
  const id=designId(config);assert.ok(ids.has(id));
  const tiles=compose({width,depth:2,design:id});assert.equal(tiles.length,width*2);
  assert.ok(tiles.every(tile=>tile.position.y===0));
  assert.deepEqual(migrateStudioConfig(JSON.parse(JSON.stringify(config)),2),config);
  assert.match(studioFilename(config),/^altare-crossbrace-walnut-/);
 }
 const presets=STUDIO_PRESETS.filter(p=>p.family==='crossbrace');
 assert.ok(presets.some(p=>p.textile==='none'&&p.dressing==='none'));
 assert.ok(presets.some(p=>p.textile==='linen_short'));
});


test('native Studio scenes preserve recipe, global pose and all fronts through JSON import/export',()=>{
 for(const textile of ['none','linen_short','linen_long','gold_short','gold_long','agnus','floral','verdant','requiem','lace'])for(const color of textile==='floral'?['white','red','green','purple','rose','black','gold','silver']:['red'])for(let facing=0;facing<4;facing++)for(const [width,depth] of [[1,1],[7,2],[8,2],[16,8],[8,16]]){
  const config=normalizeStudioConfig({family:'twin_pedestal',textile,color,facing,width,depth,surface:'marble',frontal:'cross'});
  assert.equal(config.surface,'walnut');assert.equal(config.frontal,'none');assert.equal(config.facing,facing);
  const restored=migrateStudioConfig(JSON.parse(JSON.stringify(config)),2);assert.deepEqual(restored,config);
  const tiles=compose({...restored,design:designId(restored)});assert.equal(tiles.length,width*depth);
  assert.ok(tiles.every(t=>t.facing===facing&&Number.isInteger(t.nativePose)));
  assert.equal(Math.max(...tiles.map(t=>t.position.x))+1,facing%2?depth:width);
  assert.equal(Math.max(...tiles.map(t=>t.position.z))+1,facing%2?width:depth);
  if(['agnus','floral','verdant','requiem'].includes(textile))assert.equal(tiles.filter(t=>t.frontal>0).length,width%2?1:2);
  assert.match(studioFilename(config),new RegExp('-f'+facing+'-'));
 }
 assert.equal(migrateStudioConfig({family:'crossbrace'},2).facing,0,'older scenes have their original north-facing layout');
 assert.ok(STUDIO_PRESETS.filter(p=>p.family==='twin_pedestal').length>=2);
});


test('physical bounds and front cameras follow the logical altar orientation',()=>{
 assert.deepEqual(studioWorldDimensions({width:8,depth:16,facing:1}),{width:16,depth:8});
 const expected=[[0,0,-1],[1,0,0],[0,0,1],[-1,0,0]];
 for(let facing=0;facing<4;facing++)assert.deepEqual(studioOrientedVector([0,0,-1],facing).map(v=>v===0?0:v),expected[facing]);
});
