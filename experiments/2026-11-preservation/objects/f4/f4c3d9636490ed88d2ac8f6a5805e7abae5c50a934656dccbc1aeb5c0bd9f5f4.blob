import bpy,math,bmesh,json
from mathutils import Vector
from mathutils.bvhtree import BVHTree
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/'
bpy.ops.wm.open_mainfile(filepath=r+'V29-double-band-trial.blend',use_scripts=False)
cap=bpy.data.objects['Maria — véu reconstruído de perfil'];mantle=bpy.data.objects['Maria — plano contínuo do manto'];head=bpy.data.objects['Maria — anatomia feminina adaptada CC0']
def mixed(o):
 out=[];ks=o.data.shape_keys.key_blocks if o.data.shape_keys else []
 for v in o.data.vertices:
  p=v.co.copy()
  for k in list(ks)[1:]:p+=(k.data[v.index].co-k.relative_key.data[v.index].co)*k.value
  out.append(p)
 return out
verts=mixed(cap);faces=[tuple(p.vertices) for p in cap.data.polygons];mp=mixed(mantle)
bvh=BVHTree.FromObject(head,bpy.context.evaluated_depsgraph_get())
start=23;end=89;W=end-start;N=36;topids=[44*112+i for i in range(start,end+1)]
prev=topids;adjust=0
for row in range(1,N+1):
 t=row/N;ids=[]
 for i in range(W+1):
  u=i/W;q=u*79;ix=min(78,int(q));f=q-ix
  bottom=mp[5*80+ix].lerp(mp[5*80+ix+1],f)
  top=verts[topids[i]]
  # Tangent downward at cap edge; shoulder tangent follows natural fall of mantle.
  c1=top+Vector((0,.010,-.115));c2=bottom+Vector((0,0,.105))
  p=top*(1-t)**3+3*c1*(1-t)**2*t+3*c2*(1-t)*t*t+bottom*t**3
  hit,n,_,dist=bvh.find_nearest(p)
  if hit is not None and (p-hit).dot(n)<.004:
   p=hit+n*.004;adjust+=1
  ids.append(len(verts));verts.append(p)
 for i in range(W):faces.append((prev[i],prev[i+1],ids[i+1],ids[i]))
 prev=ids
# Preserve full lower mantle silhouette, sampling its original five intervals.
for row in range(4,-1,-1):
 ids=[]
 for i in range(W+1):
  q=i/W*79;ix=min(78,int(q));f=q-ix;p=mp[row*80+ix].lerp(mp[row*80+ix+1],f)
  ids.append(len(verts));verts.append(p)
 for i in range(W):faces.append((prev[i],prev[i+1],ids[i+1],ids[i]))
 prev=ids
m=bpy.data.meshes.new('Véu e manto contínuos — estudo substitutivo');m.from_pydata(verts,[],faces);m.update();bm=bmesh.new();bm.from_mesh(m);bmesh.ops.recalc_face_normals(bm,faces=bm.faces);bm.to_mesh(m);bm.free()
o=bpy.data.objects.new('TESTE 31 — véu e manto superfície contínua',m);bpy.context.scene.collection.objects.link(o);o.data.materials.append(cap.data.materials[0])
for p in m.polygons:p.use_smooth=True
s=o.modifiers.new('Espessura','SOLIDIFY');s.thickness=.001;s.offset=0
s=o.modifiers.new('Suavidade','SUBSURF');s.levels=1
cap.hide_render=True;cap.hide_viewport=True;mantle.hide_render=True;mantle.hide_viewport=True
o['rollback']='Hide this replacement and unhide original veil and mantle. V29 file unchanged.'
json.dump({'vertices':len(verts),'faces':len(faces),'clearance_adjustments':adjust,'shared_top_boundary_vertices':len(topids)},open(r+'V31-change-report.json','w'),indent=2)
bpy.ops.wm.save_as_mainfile(filepath=r+'V31-continuous-veil-trial.blend')
s=bpy.context.scene;s.cycles.samples=32;s.render.resolution_x=600;s.render.resolution_y=800;s.render.resolution_percentage=100;c=s.camera
for view,loc,targ,scale in [('face',(-1.6,-5,3.7),(0,-.08,3.43),.88),('profile',(-5,-.05,3.6),(0,-.15,3.4),1.05)]:
 c.location=loc;c.rotation_euler=(Vector(targ)-c.location).to_track_quat('-Z','Y').to_euler();c.data.ortho_scale=scale;s.render.filepath=r+'V31-compare-'+view+'.png';bpy.ops.render.render(write_still=True)
