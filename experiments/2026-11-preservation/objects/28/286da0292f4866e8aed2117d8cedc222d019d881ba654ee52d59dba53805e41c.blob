import bpy,numpy as np,json,sys,hashlib
from pathlib import Path
from mathutils import Vector
R=Path(__file__).resolve().parents[1];S=R.parent.parent.parent/'paz-refinement/gui-test/checkpoint-V75-20261102/V75-tunic-lower-trial.blend';bpy.ops.wm.open_mainfile(filepath=str(S),use_scripts=False)
args=sys.argv[sys.argv.index('--')+1:] if '--' in sys.argv else ['paired'];variant=args[0]
for o in bpy.context.scene.objects:o.hide_render=True
s=bpy.context.scene;s.render.engine='CYCLES';s.cycles.samples=48;s.cycles.transparent_max_bounces=512;s.cycles.use_denoising=False;s.render.threads_mode='FIXED';s.render.threads=6;s.view_settings.view_transform='Standard';s.view_settings.look='None';s.render.resolution_x=900;s.render.resolution_y=900;s.render.resolution_percentage=100
s.world.use_nodes=True;bg=s.world.node_tree.nodes.get('Background');bg.inputs['Color'].default_value=(.60,.65,.72,1);bg.inputs['Strength'].default_value=.65
ld=bpy.data.lights.new('Identical neutral sun','SUN');lo=bpy.data.objects.new('Identical neutral sun',ld);s.collection.objects.link(lo);lo.hide_render=False;lo.rotation_euler=(.35,-.5,-.35);ld.energy=1.5;ld.angle=.1
m=bpy.data.materials.new('Plain diffuse ONE SIDED');m.use_nodes=True;n=m.node_tree.nodes;n.clear();bs=n.new('ShaderNodeBsdfDiffuse');bs.inputs['Color'].default_value=(.63,.62,.59,1);tr=n.new('ShaderNodeBsdfTransparent');gn=n.new('ShaderNodeNewGeometry');mix=n.new('ShaderNodeMixShader');out=n.new('ShaderNodeOutputMaterial');l=m.node_tree.links;l.new(gn.outputs['Backfacing'],mix.inputs[0]);l.new(bs.outputs[0],mix.inputs[1]);l.new(tr.outputs[0],mix.inputs[2]);l.new(mix.outputs[0],out.inputs[0])
for name in ['Maria — anatomia feminina adaptada CC0','Maria — auréola lisa']:
 ob=bpy.data.objects[name];ob.hide_render=False;ob.data.materials.clear();ob.data.materials.append(m)
if variant.startswith('bedrock'):
 import math
 from mathutils import Euler
 geo_path=R/'resource_pack/models/entity/paired_cap_band.geo.json';tex_path=R/'resource_pack/textures/entity/paired_cap_band.png';normal_path=R/('resource_pack/textures/entity/paired_cap_band_normal_param_dx.png' if variant=='bedrock-parametric' else ('resource_pack/textures/entity/paired_cap_band_normal_per_wall_dx.png' if variant=='bedrock-perwall' else 'resource_pack/textures/entity/paired_cap_band_normal_dx.png'))
 g=json.loads(geo_path.read_text())['minecraft:geometry'][0];tw=g['description']['texture_width'];th=g['description']['texture_height']
 verts=[];polys=[];uvs=[]
 for bone in g['bones']:
  for cube in bone['cubes']:
   o=Vector(cube['origin']);sz=Vector(cube['size']);piv=Vector(cube['pivot']);pb=Vector((-piv.x,piv.y,piv.z));ang=cube['rotation'];rot=Euler(tuple(math.radians(x) for x in [-ang[0],-ang[1],ang[2]]),'XYZ').to_matrix()
   face=[]
   for q in [(1,1,1),(1,0,1),(0,0,1),(0,1,1)]:
    p=o+Vector([q[i]*sz[i] for i in range(3)]);bb=Vector((-p.x,p.y,p.z));bb=rot@(bb-pb)+pb;face.append((bb.x/16,-bb.z/16,bb.y/16))
   st=len(verts);verts.extend(face);polys.append(tuple(range(st,st+4)))
   u,v=cube['uv']['south']['uv'];du,dv=cube['uv']['south']['uv_size'];uvs.extend([(u/tw,1-v/th),(u/tw,1-(v+dv)/th),((u+du)/tw,1-(v+dv)/th),((u+du)/tw,1-v/th)])
 me=bpy.data.meshes.new('ONLY JSON faces');me.from_pydata(verts,[],polys);me.update();ob=bpy.data.objects.new('V3 JSON cap band',me);s.collection.objects.link(ob);uv=me.uv_layers.new(name='Exact JSON UV')
 for loop,xy in zip(uv.data,uvs):loop.uv=xy
 mat=m.copy();mat.name='JSON albedo alpha and normal';n=mat.node_tree.nodes;l=mat.node_tree.links;bs=next(x for x in n if x.type=='BSDF_DIFFUSE');out=next(x for x in n if x.type=='OUTPUT_MATERIAL');tr=next(x for x in n if x.type=='BSDF_TRANSPARENT');prev=out.inputs[0].links[0].from_socket
 tex=n.new('ShaderNodeTexImage');tex.image=bpy.data.images.load(str(tex_path));tex.image.pack();tex.interpolation='Closest';tex.extension='CLIP';l.new(tex.outputs['Color'],bs.inputs['Color']);mix=n.new('ShaderNodeMixShader');l.new(tex.outputs['Alpha'],mix.inputs[0]);l.new(tr.outputs[0],mix.inputs[1]);l.new(prev,mix.inputs[2]);l.new(mix.outputs[0],out.inputs[0])
 if variant in ('bedrock-normal','bedrock-perwall','bedrock-parametric'):
  nt=n.new('ShaderNodeTexImage');nt.image=bpy.data.images.load(str(normal_path));nt.image.colorspace_settings.name='Non-Color';nt.image.pack();nt.interpolation='Closest';sep=n.new('ShaderNodeSeparateColor');sep.mode='RGB';inv=n.new('ShaderNodeMath');inv.operation='SUBTRACT';inv.inputs[0].default_value=1;comb=n.new('ShaderNodeCombineColor');comb.mode='RGB';nm=n.new('ShaderNodeNormalMap');nm.space='TANGENT';l.new(nt.outputs['Color'],sep.inputs[0]);l.new(sep.outputs['Red'],comb.inputs['Red']);l.new(sep.outputs['Green'],inv.inputs[1]);l.new(inv.outputs[0],comb.inputs['Green']);l.new(sep.outputs['Blue'],comb.inputs['Blue']);l.new(comb.outputs[0],nm.inputs['Color']);l.new(nm.outputs['Normal'],bs.inputs['Normal'])
 me.materials.append(mat)
else:
 for part in ['cap','band']:
  d=np.load(R/f'evidence/{part}-{variant}.npz');me=bpy.data.meshes.new(part+' '+variant);me.from_pydata(d['points'].tolist(),[],d['triangles'].tolist());me.update();ob=bpy.data.objects.new(part+' '+variant,me);s.collection.objects.link(ob);me.materials.append(m)
  # Flat triangles in structural diagnostic; no interpolated custom normals to disguise shape.
  for p in me.polygons:p.use_smooth=False
cam=s.camera;cam.hide_render=False;cam.data.type='ORTHO'
views=[('front',(.25,-3.5,3.44),(.03,-.20,3.43),.85),('threequarter',(2.1,-3.2,3.6),(.03,-.20,3.48),.70),('profile',(3,-.2,3.50),(.03,-.20,3.48),.70)]
for tag,pos,target,scale in views:
 cam.location=pos;cam.rotation_euler=(Vector(target)-cam.location).to_track_quat('-Z','Y').to_euler();cam.data.ortho_scale=scale;s.render.filepath=str(R/f'evidence/{variant}-{tag}.png');bpy.ops.render.render(write_still=True)
bpy.ops.wm.save_as_mainfile(filepath=str(R/f'evidence/{variant}-diagnostic.blend'))
(R/f'evidence/{variant}-render.json').write_text(json.dumps({'renderer':'Blender 4.3.2 Cycles','minecraft_screenshot':False,'variant':variant,'cap_band':('Reimported exported JSON + PNG, one-sided alpha, normal PNG' if variant in ('bedrock-normal','bedrock-perwall','bedrock-parametric') else ('Reimported JSON + PNG, one-sided alpha, no normal map' if variant.startswith('bedrock') else 'Native mesh diagnostic, flat triangle normals, no alpha mask')),'context':'Identical original V75 highpoly head and halo in every variant; not converted or claimed improved','mantle':'Omitted; no seam integration claim','one_sided':True,'samples':48,'resolution':[900,900]},indent=2))

if variant.startswith('bedrock'):
 p=R/f'evidence/{variant}-render.json';rep=json.loads(p.read_text());rep['input_sha256']={str(x.relative_to(R)):hashlib.sha256(x.read_bytes()).hexdigest() for x in [geo_path,tex_path,normal_path]};p.write_text(json.dumps(rep,indent=2))
