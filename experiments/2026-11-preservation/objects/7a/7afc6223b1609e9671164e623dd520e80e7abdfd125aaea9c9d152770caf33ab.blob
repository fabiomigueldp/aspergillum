R=Path(__file__).resolve().parents[1];B=R.parent;root=B.parent;gpath=R/'resource_pack/models/entity/paired_cap_band.geo.json';g=json.loads(gpath.read_text())['minecraft:geometry'][0];maps=json.loads((R/'evidence/alpha-triangle-map.json').read_text());errors=[];counters={};uv_ok=True;finite=True
