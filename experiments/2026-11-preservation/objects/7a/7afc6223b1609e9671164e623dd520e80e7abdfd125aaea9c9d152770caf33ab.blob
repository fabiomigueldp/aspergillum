 pi=m['part'];ci=counters.get(pi,0);counters[pi]=ci+1;c=g['bones'][pi]['cubes'][ci];ori=np.array(c['origin']);size=np.array(c['size']);pivot=np.array(c['pivot'])*[-1,1,1];rot=np.array(c['rotation'])*[-1,-1,1];M=Rotation.from_euler('xyz',rot,degrees=True).as_matrix();fr=np.array([-ori[0]-size[0],ori[1],ori[2]]);assert size[2]==0;assert set(c['uv'])=={'south'}
