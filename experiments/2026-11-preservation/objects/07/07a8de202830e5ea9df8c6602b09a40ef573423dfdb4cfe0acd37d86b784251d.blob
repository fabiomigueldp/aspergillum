import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';
import {twinPedestalCells} from '../assets-src/atelier/twin-pedestal-cell-study.mjs';
const out=path.resolve(import.meta.dirname,'../out/two-pedestal-integration');fs.mkdirSync(out,{recursive:true});
const sets={fullVisual:new Set(),shapeAndMaterials:new Set(),shapeOnly:new Set()},rows=[];let cells=0,maxCubes=0;
const hash=v=>crypto.createHash('sha256').update(JSON.stringify(v)).digest('hex');
function signature(g,mode){
 return g.bones.flatMap(b=>b.cubes).map(c=>{const n=structuredClone(c);if(mode!=='fullVisual')for(const [f,v] of Object.entries(n.uv))n.uv[f]=mode==='shapeOnly'?true:{material_instance:v.material_instance};return JSON.stringify(n);}).sort();
}
for(let w=1;w<=16;w++)for(let d=1;d<=8;d++)for(let f=0;f<4;f++){
 const plan=twinPedestalCells(w,d,f);let count=0;
 for(const cell of plan.cells){const g=cell.doc['minecraft:geometry'][0],cubes=g.bones.reduce((n,b)=>n+b.cubes.length,0);count+=cubes;maxCubes=Math.max(maxCubes,cubes);cells++;for(const mode of Object.keys(sets))sets[mode].add(hash(signature(g,mode)));}
 rows.push({w,d,f,cells:plan.cells.length,cubes:count});
 if([[1,1],[3,2],[7,2],[16,8]].some(([a,b])=>a===w&&b===d)&&f===0){const p=path.join(out,`cells-${w}x${d}.json`);fs.writeFileSync(p,JSON.stringify(plan));}
}
const counts=Object.fromEntries(Object.entries(sets).map(([k,s])=>[k,s.size]));
const report={scope:'Unregistered exact visual slicing study; no block catalog or runtime change',configurations:512,tileInstances:cells,maxCubesPerCell:maxCubes,counts,notes:['Full visual signatures preserve approved global UVs and materials.','Shape-only/material signatures are diagnostic counts, NOT actual compatible state counts: discarding UVs would change texture mapping.','Cube-representation signatures can overcount geometrically equivalent decompositions; these are measured construction counts, not a theoretical lower bound.','Counts exclude cloth, color variants, ownership metadata and palette padding.','Existing block states remain 80000; any positive registration requires an explicitly approved pre-release compatibility change.'],rows};
fs.writeFileSync(path.join(out,'visual-profile-report.json'),JSON.stringify(report,null,2));console.log(JSON.stringify({...report,rows:undefined},null,2));
