"""Compare only alternative alpha-cell coverage; reuse audited triangle projection."""
from pathlib import Path
O=Path(__file__).resolve().parent
exec(compile((O/'audit_transport.py').read_text().split('gdoc=json.loads')[0],str(O/'audit_transport.py'),'exec'))
old=np.array(Image.open(RP/'textures/entity/paz_v75_v14_lab_sculpture.png'));trialpath=W/'alpha-center-only-trial.png';trial=np.array(Image.open(trialpath));a=dict(np.load(OUT/'raster-audit-arrays.npz'));rows=[json.loads(l)for l in gzip.open(OUT/'raster-face-audit.jsonl.gz','rt')];sums={str(p):{'faces':0,'native_area_blocks2':0.,'old_added_area_blocks2':0.,'old_missing_area_blocks2':0.,'trial_added_area_blocks2':0.,'trial_missing_area_blocks2':0.,'trial_empty_faces':0,'max_trial_missing_fraction':0.,'max_trial_added_fraction':0.}for p in [0,1,15]};details=[]
for i,r in enumerate(rows):
 xy=a['triangle_tile_xy'][i];C=np.linalg.inv(np.column_stack([xy,np.ones(3)]).T);ia=cell_intersections(C,20);pixelarea=a['area_blocks2'][i]/polyarea(xy);tx,ty=r['uv'];mask=trial[ty:ty+20,tx:tx+20,3]>0;extra=float((mask.sum()-ia[mask].sum())*pixelarea);lost=float(ia[~mask].sum()*pixelarea);p=str(r['part']);z=sums[p];z['faces']+=1;z['native_area_blocks2']+=r['area_blocks2'];z['old_added_area_blocks2']+=r['outside_alpha_area_blocks2'];z['old_missing_area_blocks2']+=r['missing_native_area_blocks2'];z['trial_added_area_blocks2']+=extra;z['trial_missing_area_blocks2']+=lost;z['trial_empty_faces']+=int(not mask.any());z['max_trial_missing_fraction']=max(z['max_trial_missing_fraction'],lost/r['area_blocks2']);z['max_trial_added_fraction']=max(z['max_trial_added_fraction'],extra/r['area_blocks2']);details.append({'part':r['part'],'face':r['face'],'trial_added_fraction':extra/r['area_blocks2'],'trial_missing_fraction':lost/r['area_blocks2']})
 if i%3000==0:print('trial area',i,flush=True)
for z in sums.values():
 for x in ['old_added','old_missing','trial_added','trial_missing']:z[x+'_fraction_area_weighted']=z[x+'_area_blocks2']/z['native_area_blocks2']
rep={'trial_sha256':sha(trialpath),'constraints':{'same_shape':old.shape==trial.shape,'all_rgb_unchanged':bool(np.array_equal(old[:,:,:3],trial[:,:,:3])),'legacy_region_all_channels_unchanged':bool(np.array_equal(old[:2048,:2048],trial[:2048,:2048])),'binary_alpha':np.unique(trial[:,:,3]).tolist()},'parts':sums,'method':'Reuse independently derived native triangle→tile coordinates from the original audit. Recompute exact polygon intersection with unit pixel cells for only the alternative alpha. No geometry/transform/primary-source/legacy engine tests repeated.','limitations':['Per-face area totals are not union area or silhouette area.','Center-only alpha still expands beyond triangle in some pixel-cell corners and erodes inside other parts.','Nearest mip0 model only; closing one witness does not prove crack-free or acceptable rendering.']};save('alpha-center-only-independent-audit.json',rep);print(json.dumps(rep,indent=2));
with gzip.open(OUT/'alpha-center-only-face-audit.jsonl.gz','wt')as f:
 for r in details:f.write(json.dumps(r)+'\n')
