import bpy,numpy as np,json,sys
from pathlib import Path
from mathutils import Vector
coverage='--coverage' in sys.argv;prefix='coverage48-' if coverage else ('full48-' if '--full48' in sys.argv else '');R=Path('lit_surface_v16/lighting_research').resolve();V=Path('opaque_transport_v15/evidence').resolve();arrays={};records=[]
for variant,fn in [('masked','shared-2048-diagnostic.blend'),('clip','shared-2048-analytic-clip-control-diagnostic.blend')]:
 bpy.ops.wm.open_mainfile(filepath=str(V/fn));s=bpy.context.scene;s.render.threads_mode='FIXED';s.render.threads=2;s.cycles.samples=48 if prefix else 1;s.cycles.use_adaptive_sampling=False;s.cycles.use_denoising=False;s.cycles.seed=0;s.cycles.pixel_filter_type='BLACKMAN_HARRIS' if prefix else 'BOX';s.cycles.filter_width=1.5 if prefix else .01;s.cycles.max_bounces=0;s.cycles.diffuse_bounces=0
 
 if coverage:
  bg=s.world.node_tree.nodes.get('Background');bg.inputs['Color'].default_value=(0,0,0,1);bg.inputs['Strength'].default_value=0
 cam=s.camera;cam.location=(.035,-3.5,3.58);cam.rotation_euler=(Vector((.035,-.3,3.58))-cam.location).to_track_quat('-Z','Y').to_euler();cam.data.ortho_scale=.52
 s.render.resolution_x=s.render.resolution_y=1000;s.render.resolution_percentage=100;s.render.use_border=True;s.render.use_crop_to_border=True;s.render.border_min_x=.27;s.render.border_max_x=.74;s.render.border_min_y=.4;s.render.border_max_y=.6
 for ob in s.objects:
  if ob.type!='MESH':continue
  me=ob.data;pi=int(ob.name.split(' ')[0].split('_')[1]);a=me.color_attributes.new(name='SourceIdDiagnostic',type='FLOAT_COLOR',domain='CORNER')
  for p in me.polygons:
   native=pi in [0,1,15];source=p.index//2 if native else p.index;half=p.index%2 if native else 0;color=((1 if pi==0 else 0),(1 if pi==1 else 0),(1 if pi not in [0,1] else 0),1) if coverage else ((source+1)/65536,(pi+1)/32,(half+1)/4,1)
   for li in p.loop_indices:a.data[li].color=color
 for m in bpy.data.materials:
  if not m.use_nodes:continue
  n=m.node_tree.nodes;l=m.node_tree.links
  for bs in list(n):
   if bs.type!='BSDF_DIFFUSE':continue
   em=n.new('ShaderNodeEmission');attr=n.new('ShaderNodeAttribute');attr.attribute_name='SourceIdDiagnostic';l.new(attr.outputs['Color'],em.inputs['Color'])
   for lk in list(bs.outputs[0].links):l.new(em.outputs[0],lk.to_socket)
   n.remove(bs)
 s.render.image_settings.file_format='OPEN_EXR';s.render.image_settings.color_depth='32';s.render.image_settings.color_mode='RGBA';s.render.filepath=str(R/f'{prefix}{variant}-source-ids.exr');bpy.ops.render.render(write_still=True);im=bpy.data.images.load(s.render.filepath);ar=np.array(im.pixels[:],np.float32).reshape(im.size[1],im.size[0],4)[::-1];arrays[variant]=ar
 records.append({'variant':variant,'source':str(V/fn),'shape':list(ar.shape),'filter':s.cycles.pixel_filter_type+' '+str(s.cycles.filter_width),'samples':s.cycles.samples})
np.savez_compressed(R/(prefix+'source-id-pixels.npz'),**arrays)
(R/(prefix+'source-id-controls.json')).write_text(json.dumps({'scope':'First-opaque source or binary coverage emission; actual saved vertices/UV/alpha/backface preserved. Exact sample/filter settings in records. Not exact replay of adaptive lit paths.','channel_decode':('RGB=band,shell,other-part first-opaque coverage; black world=0' if coverage else 'RGB*[65536,32,4]-1 = source face, part id, source half'),'crop_origin_top_left':[270,400],'records':records},indent=2))
