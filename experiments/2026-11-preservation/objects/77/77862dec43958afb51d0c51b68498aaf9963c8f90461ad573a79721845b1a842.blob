import json,hashlib,math,numpy as np
from pathlib import Path
from scipy.spatial.transform import Rotation
from PIL import Image
ROOT=Path(__file__).resolve().parents[1]
g=json.load(open(ROOT/'resource_pack/models/entity/sculpture.geo.json'))
meta=json.load(open(ROOT/'evidence/source-export.json'));maps=json.load(open(ROOT/'evidence/alpha-triangle-map.json'))
errors=[];counters={};maxerr=0.;allpoints=[]
for m in maps:
 part=m['part'];ci=counters.get(part,0);counters[part]=ci+1;c=g['minecraft:geometry'][0]['bones'][part]['cubes'][ci]
 assert len(c['uv'])==1 and 'south' in c['uv'];o=c['origin'];s=c['size'];pj=c['pivot'];r=c['rotation']
 assert all(math.isfinite(x) for k in ('origin','size','pivot','rotation') for x in c[k]);assert min(s)>=0 and s[2]==0
 frombb=np.array([-o[0]-s[0],o[1],o[2]]);p=np.array([-pj[0],pj[1],pj[2]]);R=Rotation.from_euler('xyz',[-r[0],-r[1],r[2]],degrees=True).as_matrix()
 points=np.array([R@(frombb+np.array([u,v,0])-p)+p for u,v in m['mask_local']]);target=np.array([m['a'],m['b'],m['c']]);maxerr=max(maxerr,float(np.max(np.abs(points-target))))
 allpoints.extend(points.tolist())
 uv=c['uv']['south'];assert min(uv['uv'])>=0 and max(uv['uv'][i]+uv['uv_size'][i] for i in (0,1))<=4096
assert maxerr<1e-5
assert hashlib.sha256(Path(meta['source']).read_bytes()).hexdigest()==meta['sha256']
arr=np.array(Image.open(ROOT/'resource_pack/textures/entity/sculpture.png'))
assert arr.shape==(4096,4096,4);assert set(np.unique(arr[:,:,3]))=={0,255}
assert 'poly_mesh' not in json.dumps(g)
result={'tests_passed':['Only documented cube fields','Finite non-negative cube dimensions','All8312 cubes use exactly south face','All8312 geometric triangle correspondences reconstructed with Blockbench inverse','UV rectangles within4096 atlas','PNG alpha binary0/255','Original V75 source SHA256 unchanged','No poly_mesh'],'cube_count':len(maps),'roundtrip_max_absolute_model_units':maxerr,'roundtrip_max_absolute_blocks':maxerr/16,'unvalidated':['Bedrock parsing and content log','front/back culling','alpha at distance and mipmaps','performance on target mobile device'],'rejected_for_release':True}
(ROOT/'evidence/alpha-validation.json').write_text(json.dumps(result,indent=2));print(json.dumps(result,indent=2))
