for val,label in [(0,'before'),(1,'after')]:
 k.value=val;c.location=ct+Vector((-5,0,0));c.rotation_euler=(ct-c.location).to_track_quat('-Z','Y').to_euler();c.data.ortho_scale=.34;s.render.filepath=r+'V49-hand-close-'+label+'.png';bpy.ops.render.render(write_still=True)
