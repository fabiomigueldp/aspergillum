r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'V48-child-arm-trial.blend',use_scripts=False);o=bpy.data.objects['Menino — mão anatômica'];m=o.data;dg=bpy.context.evaluated_depsgraph_get();pp=[v.co.copy() for v in o.evaluated_get(dg).data.vertices];base=[v.co.copy() for v in m.vertices];sets=defaultdict(set)
for f,a in zip(m.polygons,m.attributes['.sculpt_face_set'].data):sets[a.value].update(f.vertices)
roots=[i for i,p in enumerate(base) if p.z>1.180];wrist=sum((pp[i] for i in roots),Vector())/len(roots)
def sm(x):x=max(0,min(1,x));return x*x*(3-2*x)
scaled=[wrist+(p-wrist)*(1.10+.05*sm(((p-wrist).length-.008)/.025)) for p in pp];new=[p.copy() for p in scaled];groups=[('little',[11,12,13],13),('ring',[5,14,17],17),('middle',[4,15,18],18),('index',[3,16,19],19)];centers={n:sum((scaled[i] for i in sets[ss[0]]),Vector())/len(sets[ss[0]]) for n,ss,prox in groups};mem={n:set().union(*(sets[s] for s in ss)) for n,ss,prox in groups};thumbcenter=sum((scaled[i] for i in sets[21]),Vector())/len(sets[21]);reports=[]
for i in sets[10]:
 dist={n:(scaled[i]-p).length for n,p in centers.items()};best=min(dist,key=dist.get)
 if dist[best]<(scaled[i]-thumbcenter).length:mem[best].add(i)
for n,ss,prox in groups:
 rootids=sorted(sets[prox],key=lambda i:(scaled[i]-wrist).length)[:max(8,len(sets[prox])//8)];pivot=sum((scaled[i] for i in rootids),Vector())/len(rootids);axis=(centers[n]-pivot).normalized()
 for i in mem[n]:
  weight=sm((scaled[i]-pivot).dot(axis)/.006);new[i]=pivot+Matrix.Rotation(math.radians(12)*weight,3,'X')@(scaled[i]-pivot)
 reports.append({'finger':n,'downward_rotation_deg':12,'pivot':list(pivot)})
k=o.shape_key_add(name='TESTE49 — escala mão e queda delicada dos dedos');k.value=1
for i,v in enumerate(k.data):v.co=m.vertices[i].co+new[i]-pp[i]
t=bpy.data.objects['Menino — túnica e mangas contínuas'];bv=BVHTree.FromPolygons([t.matrix_world@v.co for v in t.evaluated_get(dg).data.vertices],[tuple(f.vertices) for f in t.data.polygons]);faces=[tuple(f.vertices) for f in m.polygons];before=set(BVHTree.FromPolygons(pp,faces).overlap(bv));after=set(BVHTree.FromPolygons(new,faces).overlap(bv));added=after-before
report={'source':'V48','scope':'Only visible child hand; no sleeve/elbow/Maria edit','wrist_scale':1.10,'distal_scale':1.15,'fingers':reports,'hand_tunic_pairs_before':len(before),'hand_tunic_pairs_after':len(after),'added_pairs_facesets':sorted({m.attributes['.sculpt_face_set'].data[i].value for i,j in added}),'max_delta_m':max((a-b).length for a,b in zip(pp,new)),'wrist_center':list(wrist),'rollback':'TESTE49 value0 restores V48'};json.dump(report,open(r+'V49-child-hand-verification.json','w'),indent=2);print(report);bpy.ops.wm.save_as_mainfile(filepath=r+'V49-child-hand-trial.blend')
s=bpy.context.scene;s.cycles.samples=32;s.render.resolution_x=600;s.render.resolution_y=900;s.render.resolution_percentage=100;c=s.camera;ct=Vector((.025,-.265,1.25))
for view,off in [('front',(0,-5,0)),('profile_ref',(-5,0,0)),('threequarter',(-3,-5,0))]:
 c.location=ct+Vector(off);c.rotation_euler=(ct-c.location).to_track_quat('-Z','Y').to_euler();c.data.ortho_scale=1.65;s.render.filepath=r+'V49-child-after-'+view+'.png';bpy.ops.render.render(write_still=True)
