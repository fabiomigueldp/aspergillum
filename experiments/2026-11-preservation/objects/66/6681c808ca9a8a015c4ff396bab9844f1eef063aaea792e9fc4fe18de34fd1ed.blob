    def test_report_output_collision_blocked_before_writing(self):
        import contextlib
        with tempfile.TemporaryDirectory() as tmp:
            target=Path(tmp)/'same.mcaddon'
            with contextlib.redirect_stderr(io.StringIO()):
                result=addon.main(['build','--output',str(target),'--report',str(target)])
            self.assertEqual(result,2);self.assertFalse(target.exists())

    def test_report_output_resolved_alias_collision_blocked(self):
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp); (root/'alias').symlink_to(root,target_is_directory=True)
            with self.assertRaises(addon.AuditError):
                addon.validate_destinations(addon.ROOT/'source',addon.ROOT/'baseline-lock.json',root/'evidence.json',root/'x.mcaddon',root/'alias/x.mcaddon','build')

    def test_report_cannot_overwrite_input_paths(self):
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp); source=root/'source';source.mkdir(); (source/'block.json').write_text('{}')
            lock=root/'lock.json';lock.write_text('{}');evidence=root/'evidence.json';evidence.write_text('{}')
            for path in (source/'block.json',lock,evidence):
                with self.subTest(path=path),self.assertRaises(addon.AuditError):
                    addon.validate_destinations(source,lock,evidence,path,root/'build.mcaddon','audit')
                self.assertEqual(path.read_text(),'{}')

    def test_report_cannot_overwrite_existing_non_report(self):
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp); report=root/'archive.mcaddon';report.write_bytes(addon.package_bytes(self.files))
            before=report.read_bytes()
            with self.assertRaises(addon.AuditError):
                addon.validate_destinations(addon.ROOT/'source',addon.ROOT/'baseline-lock.json',root/'evidence.json',report,root/'other.mcaddon','audit')
            self.assertEqual(report.read_bytes(),before)

    def test_report_can_refresh_identified_audit_report(self):
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp); report=root/'audit.json';report.write_text(json.dumps(addon.audit(self.files,self.lock)))
            addon.validate_destinations(addon.ROOT/'source',addon.ROOT/'baseline-lock.json',root/'evidence.json',report,root/'other.mcaddon','audit')

    def test_report_symlink_is_blocked(self):
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp); other=root/'other.json'; other.write_text('{}'); report=root/'audit.json'; report.symlink_to(other)
            with self.assertRaises(addon.AuditError):
                addon.validate_destinations(addon.ROOT/'source',addon.ROOT/'baseline-lock.json',root/'evidence.json',report,root/'build.mcaddon','audit')

    def test_build_cannot_write_inside_source(self):
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp);source=root/'source';source.mkdir()
            with self.assertRaises(addon.AuditError):
                addon.validate_destinations(source,root/'lock.json',root/'evidence.json',root/'audit.json',source/'build.mcaddon','build')

if __name__ == '__main__':
    unittest.main(verbosity=2)
