    def test_rotation_can_make_valid_unrotated_size_invalid(self):
        d = addon.strict_json(self.files[addon.GEO])
        d['minecraft:geometry'][0]['bones'][0]['cubes'].append({
            'origin':[-15,0,-15], 'size':[30,1,30], 'pivot':[0,0,0], 'rotation':[0,45,0],
            'uv':copy.deepcopy(d['minecraft:geometry'][0]['bones'][0]['cubes'][0]['uv'])})
        with self.assertRaisesRegex(addon.AuditError, '30-unit'):
            addon.geometry_audit(d, (64,64))

    def test_single_axis_rotation_math(self):
        point = addon.rotate([2,0,0], [1,0,0], [0,90,0])
        self.assertAlmostEqual(point[0],1)
        self.assertAlmostEqual(point[2],-1)

