    def test_gate_rejects_different_engine(self):
        report=addon.audit(self.files,self.lock); package=addon.package_bytes(self.files)
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp); evidence=self.synthetic_evidence(report,package,root)
            evidence['minecraft_test']['engine_version']=[1,26,50]
            with self.assertRaisesRegex(addon.AuditError,'minimum target'):
                addon.release_gate(report,package,evidence,root)

    def test_gate_rejects_non_disposable_world(self):
        report=addon.audit(self.files,self.lock); package=addon.package_bytes(self.files)
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp); evidence=self.synthetic_evidence(report,package,root)
            evidence['minecraft_test']['disposable_world']=False
            with self.assertRaisesRegex(addon.AuditError,'disposable'):
                addon.release_gate(report,package,evidence,root)

    def test_build_never_overwrites(self):
        import contextlib
        with tempfile.TemporaryDirectory() as tmp:
            target=Path(tmp)/'existing.mcaddon'; target.write_bytes(b'preserve')
            with contextlib.redirect_stderr(io.StringIO()):
                result=addon.main(['build','--output',str(target),'--report',str(Path(tmp)/'audit.json')])
            self.assertEqual(result,2)
            self.assertEqual(target.read_bytes(),b'preserve')

    def test_failed_release_creates_no_artifact(self):
        import contextlib
        with tempfile.TemporaryDirectory() as tmp:
            target=Path(tmp)/'release.mcaddon'
            with contextlib.redirect_stderr(io.StringIO()):
                result=addon.main(['release','--output',str(target),'--evidence',str(Path(tmp)/'missing.json'),
                                   '--report',str(Path(tmp)/'audit.json')])
            self.assertEqual(result,2)
            self.assertFalse(target.exists())


