    def cube_mutation(self, change):
        self.mutate(addon.GEO, lambda d: change(d['minecraft:geometry'][0]['bones'][0]['cubes'][0]))

    def test_oversized_geometry_blocked(self):
        self.cube_mutation(lambda c: c.__setitem__('size', [31,1,1]))
        self.expect_blocked()

