    def test_gate_rejects_changed_visual_asset(self):
        report=addon.audit(self.files,self.lock); package=addon.package_bytes(self.files)
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp); evidence=self.synthetic_evidence(report,package,root)
