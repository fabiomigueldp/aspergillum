import copy
import io
import json
from pathlib import Path
import sys
import tempfile
import unittest
from zipfile import ZipFile, ZipInfo

sys.path.insert(0, str(Path(__file__).resolve().parents[1]/'tools'))
import addon

class AuditTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.baseline = addon.read_files(addon.ROOT/'source')
        cls.lock = addon.strict_json((addon.ROOT/'baseline-lock.json').read_bytes())

    def setUp(self):
        self.files = self.baseline.copy()

    def mutate(self, name, change):
        doc = addon.strict_json(self.files[name])
        change(doc)
        self.files[name] = json.dumps(doc).encode()

    def expect_blocked(self):
        with self.assertRaises((addon.AuditError, KeyError, ValueError, TypeError)):
            addon.audit(self.files, self.lock)

    def test_baseline_passes_but_is_not_release(self):
        report = addon.audit(self.files, self.lock)
        self.assertEqual(report['geometry']['cube_count'], 46)
        self.assertEqual(report['changed_files'], [])
        self.assertEqual(report['runtime_status'], 'not_run')
        self.assertFalse(report['release_eligible'])

    def test_existing_upper_interaction_limit_is_reported(self):
        report = addon.audit(self.files, self.lock)
        self.assertAlmostEqual(report['geometry']['rotated_bounds_pixels']['size'][1], 27.59005)
        self.assertTrue(any('upper part' in w for w in report['warnings']))

    def test_reproducible_build(self):
        first = addon.package_bytes(self.files)
        second = addon.package_bytes(dict(reversed(list(self.files.items()))))
        self.assertEqual(first, second)
        with ZipFile(io.BytesIO(first)) as z:
            self.assertEqual({n:z.read(n) for n in z.namelist()}, self.baseline)

    def test_original_archive_unchanged(self):
        original = addon.ROOT/self.lock['baseline_archive']
        self.assertEqual(addon.digest(original.read_bytes()), self.lock['baseline_archive_sha256'])

    def test_uuid_change_blocked(self):
        self.mutate('Paz_BP/manifest.json', lambda d: d['header'].__setitem__('uuid', '1b72745c-1637-4b71-9428-6234a2675ed5'))
        self.expect_blocked()

