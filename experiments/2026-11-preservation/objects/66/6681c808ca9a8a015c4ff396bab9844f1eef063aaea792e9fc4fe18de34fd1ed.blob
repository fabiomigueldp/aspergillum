    def test_unknown_critical_png_chunk_blocked(self):
        import struct,zlib
        kind=b'ABCD'; payload=b'bad'
        chunk=struct.pack('>I',len(payload))+kind+payload+struct.pack('>I',zlib.crc32(kind+payload)&0xffffffff)
        png=self.files[addon.PNG]; self.files[addon.PNG]=png[:33]+chunk+png[33:]
        self.expect_blocked()

