    def test_duplicate_json_key_blocked(self):
        with self.assertRaises(addon.AuditError):
            addon.strict_json('{"x":1,"x":2}')

    def test_nonfinite_json_blocked(self):
        for value in ('NaN','Infinity','-Infinity','1e999'):
            with self.subTest(value=value), self.assertRaises(addon.AuditError):
                addon.strict_json('{"x":'+value+'}')

    def test_unsafe_archive_names_blocked(self):
        for name in ('../escape','/tmp/escape','Paz_BP/../bad','Paz_BP\\bad'):
            with self.subTest(name=name), self.assertRaises(addon.AuditError):
                addon.safe_name(name)

    def test_duplicate_zip_entries_blocked(self):
        import warnings
        with tempfile.TemporaryDirectory() as tmp:
            path=Path(tmp)/'bad.zip'
            with warnings.catch_warnings():
                warnings.simplefilter('ignore')
                with ZipFile(path, 'w') as z:
                    z.writestr('same',b'one'); z.writestr('same',b'two')
            with self.assertRaises(addon.AuditError):
                addon.read_files(path)

    def test_symlink_source_blocked(self):
        with tempfile.TemporaryDirectory() as tmp:
            (Path(tmp)/'link').symlink_to(addon.ROOT/'source')
            with self.assertRaises(addon.AuditError):
                addon.read_files(Path(tmp))

    def test_release_requires_evidence(self):
        report=addon.audit(self.files,self.lock)
        with self.assertRaises(KeyError):
            addon.release_gate(report,addon.package_bytes(self.files),{},addon.ROOT/'evidence')

    def test_release_rejects_stale_source(self):
        report=addon.audit(self.files,self.lock)
        with self.assertRaisesRegex(addon.AuditError,'stale source'):
            addon.release_gate(report,b'',{'source_fingerprint_sha256':'outdated'},addon.ROOT/'evidence')

    def test_release_rejects_stale_package(self):
        report=addon.audit(self.files,self.lock)
        evidence={'source_fingerprint_sha256':report['source_fingerprint_sha256'],'package_sha256':'outdated'}
        with self.assertRaisesRegex(addon.AuditError,'stale package'):
            addon.release_gate(report,b'',evidence,addon.ROOT/'evidence')

    def test_release_rejects_unapproved_art(self):
        report=addon.audit(self.files,self.lock)
        package=addon.package_bytes(self.files)
        evidence={'source_fingerprint_sha256':report['source_fingerprint_sha256'],
                  'package_sha256':addon.digest(package),'visual_approval':{'status':'not_approved'}}
        with self.assertRaisesRegex(addon.AuditError,'visual approval'):
            addon.release_gate(report,package,evidence,addon.ROOT/'evidence')

    def test_art_change_tracked_never_automatically_approved(self):
        self.cube_mutation(lambda c: c['origin'].__setitem__(0,-3.9))
        report=addon.audit(self.files,self.lock)
        self.assertIn(addon.GEO,report['changed_files'])
        self.assertFalse(report['release_eligible'])


    def synthetic_evidence(self, report, package, root):
        # Synthetic unit-test data only. Never persisted as Minecraft evidence.
        log = root/'synthetic-unit-test-only.log'
        log.write_text('SYNTHETIC UNIT TEST. NO MINECRAFT RUN.\n')
        return {'source_fingerprint_sha256': report['source_fingerprint_sha256'],
                'package_sha256': addon.digest(package),
                'visual_approval': {'status':'approved','reviewer':'synthetic test fixture',
                                    'geometry_sha256':report['files_sha256'][addon.GEO]},
                'minecraft_test': {'status':'passed','tester':'synthetic test fixture',
                    'tested_at_utc':'synthetic test fixture', 'engine_version':[1,26,40],
                    'disposable_world':True,
                    'cases':{name:'passed' for name in addon.RUNTIME_CASES},
                    'content_log':{'path':log.name,'sha256':addon.digest(log.read_bytes()),
                                   'reviewed_no_addon_errors':True}}}

    def test_gate_accepts_complete_synthetic_unit_fixture(self):
        report=addon.audit(self.files,self.lock); package=addon.package_bytes(self.files)
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp); evidence=self.synthetic_evidence(report,package,root)
            addon.release_gate(report,package,evidence,root)

    def test_gate_rejects_missing_runtime_case(self):
        report=addon.audit(self.files,self.lock); package=addon.package_bytes(self.files)
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp); evidence=self.synthetic_evidence(report,package,root)
            evidence['minecraft_test']['cases']['save_reopen']='not_run'
            with self.assertRaisesRegex(addon.AuditError,'cases incomplete'):
                addon.release_gate(report,package,evidence,root)

