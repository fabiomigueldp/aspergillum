import bpy,math,json,bmesh
from mathutils import Matrix,Vector
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/'
bpy.ops.wm.open_mainfile(filepath=r+'V29-double-band-trial.blend',use_scripts=False)
R=bpy.data.objects['Maria — auréola lisa'].rotation_euler.to_matrix()@Matrix.Rotation(-math.pi/2,3,'X');Ri=R.transposed()
def bake(name,width):
 o=bpy.data.objects[name];saved_levels=[(md,md.levels) for md in o.modifiers if md.type=='SUBSURF']
 for md,_ in saved_levels:md.levels=md.render_levels
 attr=o.data.attributes.new('study_source_row','FLOAT','POINT')
 for i,d in enumerate(attr.data):d.value=i//width
 bpy.context.view_layer.update();dg=bpy.context.evaluated_depsgraph_get();m=bpy.data.meshes.new_from_object(o.evaluated_get(dg),preserve_all_data_layers=True,depsgraph=dg)
 coords=[v.co.copy() for v in m.vertices];rows=[d.value for d in m.attributes['study_source_row'].data];faces=[];removed=0
 for p in m.polygons:
  rim=all(rows[v]>=(9 if width==80 else 44)-.0001 for v in p.vertices)
  rear=True if width==80 else (Ri@p.center).y>1.012
  if rim and rear:removed+=1
  else:faces.append(tuple(p.vertices))
 # Remove helper attribute from original source datablock after bake.
 o.data.attributes.remove(attr)
 for md,level in saved_levels:md.levels=level
 counts={}
 for f in faces:
  for a,b in zip(f,f[1:]+f[:1]):
   e=tuple(sorted((a,b)));counts[e]=counts.get(e,0)+1
 adj={}
 for (a,b),n in counts.items():
  if n==1:adj.setdefault(a,[]).append(b);adj.setdefault(b,[]).append(a)
 assert all(len(v)==2 for v in adj.values()),'Non-loop boundary'
 first=next(iter(adj));loop=[first];prev=None;cur=first
 while True:
  nxt=next(x for x in adj[cur] if x!=prev)
  if nxt==first:break
  loop.append(nxt);prev,cur=cur,nxt
 assert len(loop)==len(adj),'Multiple boundary loops'
 return o,coords,faces,loop,removed
cap,cv,cf,cl,cr=bake('Maria — véu reconstruído de perfil',112)
man,mv,mf,ml,mr=bake('Maria — plano contínuo do manto',80)
# Align the two perimeter loops by nearest correspondence; preserve all baked coordinates.
k=min(range(len(ml)),key=lambda i:(mv[ml[i]]-cv[cl[0]]).length_squared);ml=ml[k:]+ml[:k]
forward=(mv[ml[len(ml)//4]]-cv[cl[len(cl)//4]]).length
reverse=(mv[ml[-len(ml)//4]]-cv[cl[len(cl)//4]]).length
if reverse<forward:ml=[ml[0]]+list(reversed(ml[1:]))
verts=cv+mv;off=len(cv);faces=cf+[tuple(v+off for v in f) for f in mf];i=j=0;bridges=0
while i<len(cl) or j<len(ml):
 a=cl[i%len(cl)];b=ml[j%len(ml)]+off
 if (i+1)/len(cl)<=(j+1)/len(ml):
  faces.append((a,cl[(i+1)%len(cl)],b));i+=1
 else:
  faces.append((a,ml[(j+1)%len(ml)]+off,b));j+=1
 bridges+=1
m=bpy.data.meshes.new('Superfícies avaliadas com costura superior');m.from_pydata(verts,[],faces);m.update();bm=bmesh.new();bm.from_mesh(m);bmesh.ops.recalc_face_normals(bm,faces=bm.faces)
nonman=sum(not e.is_manifold for e in bm.edges);bm.to_mesh(m);bm.free()
o=bpy.data.objects.new('TESTE 34 — conexão de superfícies avaliadas',m);bpy.context.scene.collection.objects.link(o);o.data.materials.append(cap.data.materials[0])
for p in m.polygons:p.use_smooth=True
cap.hide_render=True;cap.hide_viewport=True;man.hide_render=True;man.hide_viewport=True
maxdelta=max((m.vertices[off+i].co-p).length for i,p in enumerate(mv))
report={'baked_mantle_vertices':len(mv),'baked_cap_vertices':len(cv),'maximum_mantle_coordinate_delta':maxdelta,'removed_rim_faces':{'mantle':mr,'cap':cr},'added_seam_triangles':bridges,'nonmanifold_edges':nonman,'cap_loop':len(cl),'mantle_loop':len(ml)}
json.dump(report,open(r+'V34-verification.json','w'),indent=2)
bpy.ops.wm.save_as_mainfile(filepath=r+'V34-baked-seam-trial.blend')
s=bpy.context.scene;s.cycles.samples=32;s.render.resolution_x=600;s.render.resolution_y=800;s.render.resolution_percentage=100;c=s.camera
for view,loc,targ,scale in [('face',(-1.6,-5,3.7),(0,-.08,3.43),.88),('profile',(-5,-.05,3.6),(0,-.15,3.4),1.05)]:
 c.location=loc;c.rotation_euler=(Vector(targ)-c.location).to_track_quat('-Z','Y').to_euler();c.data.ortho_scale=scale;s.render.filepath=r+'V34-compare-'+view+'.png';bpy.ops.render.render(write_still=True)
