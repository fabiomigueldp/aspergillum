"""Independent V10 candidate review. Blender -b --python SCRIPT -- CANDIDATE TAG.
Only reads candidate and frozen inputs; writes this directory exclusively.
"""
from pathlib import Path
import numpy as np,json,hashlib,sys,importlib.util,time
sys.dont_write_bytecode=True
O=Path(__file__).resolve().parent;B=O.parents[1]
sys.path.insert(0,str(B/'body_interface_v9/independent_diagnosis'));from contact_limits import contacts
spec=importlib.util.spec_from_file_location('gate',B/'shell_band_v3/tools/independent_gate.py');gate=importlib.util.module_from_spec(spec);spec.loader.exec_module(gate)
args=sys.argv[sys.argv.index('--')+1:];path=Path(args[0]);tag=args[1]
basepath=B/'lateral_v7/adaptive_patch/adaptive-consistent-assembly.npz';bodypath=B/'body_interface_v9/constrained_fit/retained-anatomy.npz';bandpath=B/'shell_band_v5/retained_candidate/evidence/band-paired.npz'
locked=[basepath,bodypath,bandpath,B/'integration_v6/evidence/seam-source-inspection.npz',B/'integration_v6/evidence/seam-source-evaluated-compact.npz',B/'body_interface_v8/anatomy_fit/baseline-welded.npz',B/'body_interface_v8/anatomy_fit/retained-anatomy.npz',B/'pbr_normals_v2/evidence/repaired_meshes.npz',B/'pbr_normals_v2/resource_pack/models/entity/paz_v75_pbr_sculpture.geo.json',B/'pbr_normals_v2/resource_pack/textures/entity/paz_v75_pbr_sculpture.png']
hashes={str(p.relative_to(B)):hashlib.sha256(p.read_bytes()).hexdigest() for p in locked}
b=np.load(basepath);d=np.load(path);body=np.load(bodypath);band=np.load(bandpath);old=np.load(B/'body_interface_v9/independent_diagnosis/retained-anatomy-review-arrays.npz')
v=d['points'];f=d['triangles'];bv=b['points'];bf=b['triangles'];moved=np.linalg.norm(v-bv,axis=1)*1000;cancompare=np.array_equal(f,bf)
rep={'candidate':str(path),'sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'topology_identity':{k:bool(np.array_equal(d[k],b[k])) for k in ['triangles','source_indices','generated_vertices','face_parts']},'preservation':{},'contacts':{},'other_parts':{},'input_hashes_start':hashes,'limitations':['Strict crossings do not certify tangency/coplanarity/global clearance.','New triangle pairs are meaningful only with unchanged triangle/source identities.','Other parts 6/7/8/10/14 are legacy triangle proxies, not certified hybrid geometry.','Native geometry diagnostic, not Bedrock export or Minecraft test.']};out={'displacement_mm':moved}
for label,mask in [('source_vertices',~b['generated_vertices']),('cap_vertices',np.isin(np.arange(len(bv)),np.unique(bf[b['face_parts']==0]))),('mantle_vertices',np.isin(np.arange(len(bv)),np.unique(bf[b['face_parts']==2])))]:
 rep['preservation'][label]={'vertices':int(mask.sum()),'positions_bit_identical':bool(np.array_equal(v[mask],bv[mask])),'normals_bit_identical':bool(np.array_equal(d['normals'][mask],b['normals'][mask])) if 'normals' in d.files else None,'max_displacement_mm':float(moved[mask].max())}
rep['preservation']['anatomy_ears_frozen']={'input_sha256':hashes[str(bodypath.relative_to(B))],'ear_vertices':int(body['protected_ears'].sum()),'no_anatomy_candidate_loaded':True}
rep['displacement']={'moved_vertices':int((moved>1e-8).sum()),'mm_percentiles_moved':np.percentile(moved[moved>1e-8],[0,25,50,75,95,100]).tolist() if (moved>1e-8).any() else [0]*6}
mid=np.load(B/'lateral_v7/evidence/director-cone-midfield.npz');where={int(q):i for i,q in enumerate(d['source_indices'])};oi=np.array([where[int(q)] for q in mid['outer_source_ids']]);ii=np.array([where[int(q)] for q in mid['inner_source_ids']]);c=(v[oi]+v[ii])/2;dv=(v[ii]-v[oi])/2;half=np.linalg.norm(dv,axis=1);director=dv/np.maximum(half[:,None],1e-30);cf=mid['triangles'];raw=np.cross(c[cf[:,1]]-c[cf[:,0]],c[cf[:,2]]-c[cf[:,0]]);n=raw/np.maximum(np.linalg.norm(raw,axis=1)[:,None],1e-30);cos=np.einsum('ij,ikj->ik',n,director[cf]);cos*=np.sign(np.median(cos));gen=mid['generated_pair_indices'];rep['thickness']={'generated_pair_count':len(gen),'paired_full_thickness_mm_min_max':[float(half[gen].min()*2000),float(half[gen].max()*2000)],'paired_full_thickness_mm_max_change_vs_original':float(np.max(abs(half-mid['half_thickness']))*2000),'mixed_director_faces':int(((cos.min(1)<0)&(cos.max(1)>0)).sum()),'nonpositive_director_products':int((cos<=0).sum()),'min_director_face_cosine':float(cos.min()),'meaning':'Paired distances and offset transversality, not a global minimum wall thickness certificate.'}
if cancompare:
 p=v[f];p0=bv[bf];raw=np.cross(p[:,1]-p[:,0],p[:,2]-p[:,0]);r0=np.cross(p0[:,1]-p0[:,0],p0[:,2]-p0[:,0]);a=np.linalg.norm(raw,axis=1);a0=np.linalg.norm(r0,axis=1);ratio=a/np.maximum(a0,1e-30);co=np.einsum('ij,ij->i',raw,r0)/np.maximum(a*a0,1e-30);sv=np.linalg.svd(np.stack([p[:,1]-p[:,0],p[:,2]-p[:,0]],axis=2)@np.linalg.pinv(np.stack([p0[:,1]-p0[:,0],p0[:,2]-p0[:,0]],axis=2)),compute_uv=False)[:,:2];bridge=d['face_parts']==1;rep['triangle_quality']={'bridge_min_area_ratio':float(ratio[bridge].min()),'bridge_area_ratio_percentiles':np.percentile(ratio[bridge],[0,1,5,50,95,99,100]).tolist(),'bridge_intrinsic_stretch_min_max':[float(sv[bridge].min()),float(sv[bridge].max())],'bridge_face_rotation_max_degrees':float(np.degrees(np.arccos(np.clip(co[bridge],-1,1))).max()),'bridge_faces_normal_reversed_vs_v7':np.flatnonzero(bridge&(co<=0)).tolist()};out.update(area_ratio=ratio,intrinsic_stretches=sv)
rep['self_gate']=gate.review(path);print('self gate',rep['self_gate']['passes_screen'],rep['self_gate']['strict_crossings'],flush=True)
for name,ob in [('anatomy',body),('band',band)]:
 cc=contacts(v,f,ob['points'],ob['triangles']);out[name+'_pairs']=cc;prior=old['shell_pairs'][:,::-1] if name=='anatomy' else contacts(bv,bf,ob['points'],ob['triangles']);out['baseline_'+name+'_pairs']=prior;curset=set(map(tuple,cc));oldset=set(map(tuple,prior));new=sorted(curset-oldset);removed=sorted(oldset-curset);out[name+'_new_pairs']=np.array(new,int).reshape(-1,2);out[name+'_removed_pairs']=np.array(removed,int).reshape(-1,2);rep['contacts'][name]={'baseline':len(prior),'candidate':len(cc),'new':len(new),'removed':len(removed),'common':len(curset&oldset),'by_part':{str(k):int((d['face_parts'][cc[:,0]]==k).sum()) for k in range(3)},'new_by_part':{str(k):sum(d['face_parts'][r[0]]==k for r in new) for k in range(3)},'new_pairs':new};print('contacts',name,rep['contacts'][name]['baseline'],len(cc),'new',len(new),flush=True)
# New contacts elsewhere are isolated to faces incident to moved vertices. This includes source cap movement if present.
mp=json.loads((B/'pbr_normals_v2/evidence/alpha-triangle-map.json').read_text());meta=json.loads((B/'evidence/source-export.json').read_text());bridx=np.flatnonzero(np.any((moved>1e-8)[f],axis=1));br0=bridx.copy();rep['changed_shell_faces_checked_against_other_parts']=int(len(bridx))
for pi in list(range(2,15))+list(range(16,20)):
 t=np.array([[q[k] for k in ['a','b','c']] for q in mp if q['part']==pi]);t=t[:,:,[0,2,1]]/16;t[:,:,1]*=-1;ov=t.reshape(-1,3);of=np.arange(len(ov)).reshape(-1,3);sets={}
 for name,points,faces,ids in [('baseline',bv,bf[br0],br0),('candidate',v,f[bridx],bridx)]:
  pairs=contacts(points,faces,ov,of);pairs[:,0]=ids[pairs[:,0]];sets[name]=set(map(tuple,pairs))
 rep['other_parts'][str(pi)]={'name':meta['parts'][pi]['name'],'native_intended_geometry':pi not in [6,7,8,10,14],'baseline_changed_shell_face_pairs':len(sets['baseline']),'candidate_changed_shell_face_pairs':len(sets['candidate']),'new_pairs':sorted(sets['candidate']-sets['baseline']),'removed_pairs':sorted(sets['baseline']-sets['candidate'])}
rep['input_hashes_finish']={str(p.relative_to(B)):hashlib.sha256(p.read_bytes()).hexdigest() for p in locked};rep['inputs_intact_during_review']=rep['input_hashes_finish']==hashes
np.savez_compressed(O/(tag+'-review-arrays.npz'),**out);(O/(tag+'-review.json')).write_text(json.dumps(rep,indent=2,default=lambda x:x.item() if isinstance(x,np.generic) else x.tolist() if isinstance(x,np.ndarray) else str(x)));print(json.dumps({k:rep[k] for k in ['candidate','sha256','topology_identity','preservation','displacement','thickness','triangle_quality','inputs_intact_during_review']},indent=2),flush=True)
