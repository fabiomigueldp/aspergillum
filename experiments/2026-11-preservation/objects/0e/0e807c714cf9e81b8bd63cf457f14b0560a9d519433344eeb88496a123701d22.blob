"""Measure reconstructed rim spans between frozen outer/inner wall traces.
This avoids miscalling a grazing normal ray at a rim a wall-thickness minimum.
An offset pair retained elsewhere does not certify the new rim. Report both.
"""
from pathlib import Path
import sys,json,numpy as np
from collections import defaultdict,Counter
O=Path(__file__).resolve().parent;B=O.parents[1];tag=sys.argv[1];d=np.load(O/(tag+'.npz'));p=d['points'];f=d['triangles'];parts=d['face_parts'];src=np.load(B/'lateral_v7/adaptive_patch/adaptive-consistent-assembly.npz');side=np.full(len(src['points']),-1,int);where={int(s):i for i,s in enumerate(src['source_indices'])};cap=np.load(B/'shell_band_v4/evidence/cap-source-pairing.npz');mid=np.load(B/'lateral_v7/evidence/director-cone-midfield.npz')
for x,ids in [(0,cap['outer']),(1,cap['inner']),(0,mid['outer_source_ids']),(1,mid['inner_source_ids'])]:
 for s in ids:
  if int(s) in where:side[where[int(s)]]=x
fs=np.full(len(src['triangles']),-1,int)
for i,t in enumerate(src['triangles']):
 if np.all(side[t]==0):fs[i]=0
 elif np.all(side[t]==1):fs[i]=1
edges=defaultdict(list)
for i,t in enumerate(f):
 for k in range(3):edges[tuple(sorted((int(t[k]),int(t[(k+1)%3]))))].append(i)
# Rim plane clusters deduplicated via cutter ancestors, with 1e-8 coordinate
# quantization only for grouping planes; no geometry is rounded or changed.
meta=json.loads(str(d['provenance']));cut=np.load(O/meta['cutter']);cp=cut['points'];cf=cut['triangles'];raw=np.cross(cp[cf[:,1]]-cp[cf[:,0]],cp[cf[:,2]]-cp[cf[:,0]]);nn=raw/np.linalg.norm(raw,axis=1)[:,None];dd=-np.einsum('ij,ij->i',nn,cp[cf[:,0]]);planes={};group=np.full(len(cf),-1,int)
for i,(n,z) in enumerate(zip(nn,dd)):
 key=tuple(np.round(np.r_[n,z],8));group[i]=planes.setdefault(key,len(planes))
traces=defaultdict(lambda:defaultdict(list));rimfaces=defaultdict(list)
for i in np.flatnonzero(parts==3):rimfaces[int(group[d['cutter_face_indices'][i]])].append(int(i))
for e,adj in edges.items():
 if len(adj)!=2:continue
 ri=[i for i in adj if parts[i]==3];si=[i for i in adj if parts[i]!=3]
 if len(ri)==len(si)==1:
  s=int(fs[d['baseline_face_indices'][si[0]]]);g=int(group[d['cutter_face_indices'][ri[0]]]);traces[g][s].append(e)
def pointseg(x,a,b):
 ab=b-a;t=np.clip(np.dot(x-a,ab)/max(np.dot(ab,ab),1e-30),0,1);return np.linalg.norm(x-(a+t*ab))
def segdist(a,b,c,d):
 # Interior closest pair plus endpoint cases, robust for near-parallel segments.
 u=b-a;v=d-c;w=a-c;A=np.array([[u@u,-u@v],[-u@v,v@v]]);rhs=np.array([-u@w,v@w]);candidates=[pointseg(a,c,d),pointseg(b,c,d),pointseg(c,a,b),pointseg(d,a,b)]
 if abs(np.linalg.det(A))>1e-26:
  st=np.linalg.solve(A,rhs)
  if np.all(st>=0)&np.all(st<=1):candidates.append(np.linalg.norm(a+st[0]*u-c-st[1]*v))
 return min(candidates)
rows=[];globalmin=1e9
for g,faces in rimfaces.items():
 outer=traces[g][0];inner=traces[g][1];other=traces[g][-1];row={'plane_group':g,'rim_faces':faces,'outer_trace_edges':[list(e) for e in outer],'inner_trace_edges':[list(e) for e in inner],'unclassified_trace_edges':[list(e) for e in other]}
 if outer and inner:
  dist=[]
  for e in outer:
   vals=[segdist(p[e[0]],p[e[1]],p[q[0]],p[q[1]]) for q in inner];dist.append(min(vals))
  for e in inner:
   vals=[segdist(p[e[0]],p[e[1]],p[q[0]],p[q[1]]) for q in outer];dist.append(min(vals))
  row['outer_inner_trace_distance_mm_percentiles']=np.percentile(np.array(dist)*1000,[0,5,50,95,100]).tolist();globalmin=min(globalmin,min(dist))
 else:row['outer_inner_trace_distance_mm_percentiles']=None
 rows.append(row)
rep={'candidate':str(O/(tag+'.npz')),'method':'For each planar cutter facet, identify edge traces adjacent to inherited source faces known entirely outer or inner via original cap/bridge pairing. Measure closest 3D segment distances between these two traces. No geometry modified.','source_face_wall_class_counts':dict(Counter(map(int,fs))),'rim_plane_patches':len(rows),'patches_with_both_wall_traces':sum(r['outer_inner_trace_distance_mm_percentiles'] is not None for r in rows),'patches_without_both_wall_traces':[r['plane_group'] for r in rows if r['outer_inner_trace_distance_mm_percentiles'] is None],'minimum_trace_separation_mm':globalmin*1000 if globalmin<1e9 else None,'patches':rows,'limitations':['Trace separation measures local rim span on paired wall labels, not certified global volumetric thickness.','Small rim facets can touch only one wall where the contour crosses original open-edge closure; they require geometric review, not automatic deletion.','Counts of inherited all-outer/all-inner faces exclude original rounded closing faces with mixed/unpaired vertices.']};(O/(tag+'-rim-spans.json')).write_text(json.dumps(rep,indent=2));print(json.dumps({k:v for k,v in rep.items() if k!='patches'},indent=2))
