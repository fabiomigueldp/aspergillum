import bpy,numpy as np,json
from pathlib import Path
R=Path(__file__).resolve().parents[1];bpy.ops.wm.open_mainfile(filepath=str(R.parents[1]/'paz-refinement/gui-test/checkpoint-V75-20261102/V75-tunic-lower-trial.blend'),use_scripts=False)
o=bpy.data.objects['TESTE 34 — conexão de superfícies avaliadas'];dg=bpy.context.evaluated_depsgraph_get();m=bpy.data.meshes.new_from_object(o.evaluated_get(dg),depsgraph=dg);m.transform(o.matrix_world);normal=np.array([x.normal[:] for x in m.vertices]);pos=np.array([x.co[:] for x in m.vertices]);a=np.load(R/'evidence/seam-reconstruction-proof.npz');v=np.load(R.parent/'shell_band_v5/retained_candidate/evidence/cap-paired.npz');sn=normal[a['source_indices']].copy();sn[:len(v['points'])]=v['normals'];report={}
for tag,mask in [('cap-open',a['face_parts']==0),('bridge-exact',a['face_parts']==1),('mantle-rest',a['face_parts']==2),('seam-welded-compact',np.ones(len(a['triangles']),bool))]:
 f=a['triangles'][mask];ids=np.unique(f);mp=np.full(len(a['points']),-1);mp[ids]=np.arange(len(ids));f=mp[f];p=a['points'][ids];sid=a['source_indices'][ids];e=np.sort(np.concatenate([f[:,[0,1]],f[:,[1,2]],f[:,[2,0]]]),axis=1);ue,c=np.unique(e,axis=0,return_counts=True);bi=np.unique(ue[c==1]);np.savez_compressed(R/('evidence/'+tag+'.npz'),points=p,triangles=f,normals=sn[ids],source_indices=sid,boundary_indices=bi,boundary_source_indices=sid[bi],boundary_edges=ue[c==1],face_parts=a['face_parts'][mask]);report[tag]={'vertices':len(p),'triangles':len(f),'boundary_edges':int((c==1).sum()),'nonmanifold_edges':int((c>2).sum()),'source_coordinate_max_error':float(abs(p-pos[sid]).max()),'normals':'Original V5 source normals for retained V5 vertices; evaluated TESTE34 V75 source normals for inserted seam and mantle/bridge vertices.'}
report['loose_unused_source_vertices_removed']=len(a['points'])-report['seam-welded-compact']['vertices'];report['caveat']='Topological weld proven. No geometric self-intersection or Minecraft runtime proof. Normals preserved as source samples; not final atlas shading.';(R/'evidence/seam-parts-export.json').write_text(json.dumps(report,ensure_ascii=False,indent=2));print(json.dumps(report,ensure_ascii=False,indent=2))
