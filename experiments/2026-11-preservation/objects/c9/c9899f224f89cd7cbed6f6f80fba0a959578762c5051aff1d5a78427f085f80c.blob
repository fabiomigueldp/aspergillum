"""Refresh experiment inventory without creating/replacing a retained candidate.
This only records files that actually exist. Geometry is not modified.
"""
from pathlib import Path
import json,hashlib,ast
import numpy as np
O=Path(__file__).resolve().parent;B=O.parents[1]
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
rows=[]
for tag in ['polygonal-pinna-0.5mm','polygonal-pinna-0.5mm-clean','polygonal-pinna-0.6mm','polygonal-pinna-0.6mm-clean']:
 path=O/(tag+'.npz')
 if not path.exists():continue
 d=np.load(path);row={'tag':tag,'file':path.name,'sha256':sha(path),'vertices':len(d['points']),'triangles':len(d['triangles']),'new_vertices':int(d['generated_vertices'].sum()),'new_termination_faces':int((d['face_parts']==3).sum()),'role':'experiment, not Bedrock/export','decision':'Rejected: overlapping coplanar band/shell termination surfaces on identical cutter.' if '0.5mm' in tag else 'Retained technically and locally after independent geometry plus nine-view visual review; exact selected checkpoint is the clean candidate.'}
 if tag.endswith('-clean'):
  raw=np.load(O/(tag.removesuffix('-clean')+'.npz'));row['same_geometry_as_raw']=bool(np.array_equal(d['points'],raw['points']) and np.array_equal(d['triangles'],raw['triangles']))
 rows.append(row)
ret=O/'retained-band.npz'
if ret.exists():
 rows.append({'file':ret.name,'sha256':sha(ret),'role':'local retained copy; identity in retained-identity.json','matches':[x['file'] for x in rows if x['sha256']==sha(ret)]})
manifest={'scope':'V12 isolated local band reconstruction; no export or publication','executed_cutter_margins_mm':[0.5,0.6],'number_of_geometrically_distinct_band_trials':2,'checkpoints':rows,'inputs':{str(p.relative_to(B)):sha(p) for p in [B/'shell_band_v5/retained_candidate/evidence/band-paired.npz',B/'ear_rim_v11/structural_rebuild/retained-shell.npz',B/'body_interface_v9/constrained_fit/retained-anatomy.npz']},'auxiliary_source_parameter_file':{'file':'shell_band_v3/evidence/band-source-parameters.npz','sha256':sha(B/'shell_band_v3/evidence/band-source-parameters.npz')},'frozen_source_policy':'Hash-only validation; prior complete gates were not rerun.'}
(O/'trials-manifest.json').write_text(json.dumps(manifest,indent=2))
scripts=[]
for p in sorted(O.glob('*.py')):ast.parse(p.read_text());scripts.append({'file':p.name,'sha256':sha(p),'syntax':'OK'})
(O/'final-validation.json').write_text(json.dumps({'inputs':manifest['inputs'],'input_hashes_equal_first_build':manifest['inputs']==json.loads((O/'polygonal-pinna-0.5mm-construction.json').read_text())['input_hashes_start'],'scripts':scripts,'retained_present':ret.exists(),'retained_byte_identical_to_selected':(ret.read_bytes()==(O/'polygonal-pinna-0.6mm-clean.npz').read_bytes()) if ret.exists() else None,'candidate_invariants':{t:json.loads((O/(t+'-preservation.json')).read_text())['construction_invariants_pass'] for t in ['polygonal-pinna-0.5mm-clean','polygonal-pinna-0.6mm-clean']},'exported_or_published':False},indent=2))
files=[{'file':p.name,'bytes':p.stat().st_size,'sha256':sha(p)} for p in sorted(O.iterdir()) if p.is_file() and p.name!='file-manifest.json']
(O/'file-manifest.json').write_text(json.dumps(files,indent=2));print(json.dumps({'checkpoints':len(rows),'files':len(files),'syntax_scripts':len(scripts)},indent=2))
