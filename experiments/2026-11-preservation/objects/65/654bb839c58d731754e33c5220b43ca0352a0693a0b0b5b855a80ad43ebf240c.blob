import bpy,json,math,numpy as np
from mathutils import Vector
from collections import Counter
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'V59-child-tunic-trial.blend',use_scripts=False);o=bpy.data.objects['Menino — túnica e mangas contínuas'];k=o.data.shape_keys.key_blocks[-1];states=[]
for value in [0,1]:
 k.value=value;bpy.context.view_layer.update();dg=bpy.context.evaluated_depsgraph_get();p=[o.matrix_world@v.co for v in o.evaluated_get(dg).data.vertices];states.append(p)
a,b=states;faces=[tuple(f.vertices) for f in o.data.polygons];changed=[i for i,f in enumerate(faces) if any((a[v]-b[v]).length>1e-8 for v in f)];angles=[];quality=[]
def av(p,f):return sum(((p[f[j]]-p[f[0]]).cross(p[f[j+1]]-p[f[0]])*.5 for j in range(1,len(f)-1)),Vector())
for p in states:
 aspects=[];zero=0
 for i in changed:
  f=faces[i]
  for j in range(1,len(f)-1):
   x,y,z=[p[v] for v in [f[0],f[j],f[j+1]]];area=(y-x).cross(z-x).length/2;long=max((x-y).length,(x-z).length,(y-z).length)
   if area<1e-12:zero+=1
   else:aspects.append(long*long/(2*area))
 quality.append({'degenerate_triangles':zero,'aspect_ratio_p95':float(np.percentile(aspects,95)),'aspect_ratio_max':max(aspects)})
for i in changed:
 n0,n1=av(a,faces[i]),av(b,faces[i]);angles.append(math.degrees(n0.angle(n1)))
ec=Counter(tuple(sorted((f[i],f[(i+1)%len(f)]))) for f in faces for i in range(len(f)));d={'changed_faces':len(changed),'local_before_after':quality,'normal_rotation_deg_max':max(angles),'normal_rotation_deg_p95':float(np.percentile(angles,95)),'faces_normal_rotation_over_90':sum(t>90 for t in angles),'boundary_edges':sum(v==1 for v in ec.values()),'nonmanifold_edges':sum(v!=2 for v in ec.values()),'nonfinite_vertices':sum(not all(math.isfinite(x) for x in p) for p in b),'packed_images':[(im.name,bool(im.packed_file)) for im in bpy.data.images]};json.dump(d,open(r+'V59-face-quality-audit.json','w'),indent=2);print(d)
