import bpy,json,math,heapq
from mathutils import Vector
from mathutils.bvhtree import BVHTree
from mathutils.kdtree import KDTree
from collections import Counter
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'V52-child-face-trial.blend',use_scripts=False)
h=bpy.data.objects['Menino — base infantil anatômica CC0'];n=bpy.data.objects['Menino — pescoço'];dg=bpy.context.evaluated_depsgraph_get();hm=bpy.data.meshes.new_from_object(h.evaluated_get(dg));nm=bpy.data.meshes.new_from_object(n.evaluated_get(dg));nm.transform(n.matrix_world);original=[v.co.copy() for v in hm.vertices];protected=[p for p in original if p.y<-.335 or p.z>1.72]
u=bpy.data.objects.new('Menino — cabeça colo unidos V54 reversível',hm);bpy.context.collection.objects.link(u);tmp=bpy.data.objects.new('Temporary neck operand',nm);bpy.context.collection.objects.link(tmp);bpy.context.view_layer.objects.active=u;u.select_set(True);mod=u.modifiers.new('Union junction only','BOOLEAN');mod.operation='UNION';mod.solver='EXACT';mod.object=tmp;bpy.ops.object.modifier_apply(modifier=mod.name);bpy.data.objects.remove(tmp,do_unlink=True)
headbv=BVHTree.FromObject(h,dg);np=[n.matrix_world@v.co for v in n.evaluated_get(dg).data.vertices];nbv=BVHTree.FromPolygons(np,[tuple(p.vertices) for p in n.data.polygons]);p=[v.co.copy() for v in u.data.vertices];adj=[set() for v in p]
for e in u.data.edges:a,b=e.vertices;adj[a].add(b);adj[b].add(a)
seeds=[i for i,q in enumerate(p) if headbv.find_nearest(q)[3]<.00001 and nbv.find_nearest(q)[3]<.00001];dist=[1e9]*len(p);queue=[]
for i in seeds:dist[i]=0;heapq.heappush(queue,(0,i))
while queue:
 d,i=heapq.heappop(queue)
 if d!=dist[i] or d>.018:continue
 for j in adj[i]:
  nd=d+(p[j]-p[i]).length
  if nd<dist[j]:dist[j]=nd;heapq.heappush(queue,(nd,j))
def sm(t):t=max(0,min(1,t));return t*t*(3-2*t)
w=[(1-sm(d/.018))*(1-sm((-.32-q.y)/.015))*(1-sm((q.z-1.71)/.01))*sm((q.z-1.59)/.02) for q,d in zip(p,dist)]
new=[q.copy() for q in p]
for it in range(12):
 new=[q+(sum((new[j] for j in adj[i]),Vector())/len(adj[i])-q)*(.28*w[i]) if adj[i] else q for i,q in enumerate(new)]
for v,q in zip(u.data.vertices,new):v.co=q
for f in u.data.polygons:f.use_smooth=True
u.data.update();h.hide_render=True;h.hide_set(True);n.hide_render=True;n.hide_set(True)
kd=KDTree(len(new))
for i,q in enumerate(new):kd.insert(q,i)
kd.balance();preserved=max(kd.find(q)[2] for q in protected)
fs=[tuple(f.vertices) for f in u.data.polygons];edges=Counter(tuple(sorted((f[i],f[(i+1)%len(f)]))) for f in fs for i in range(len(f)));bv=BVHTree.FromPolygons(new,fs);pairs=[(i,j) for i,j in bv.overlap(bv) if i<j and not set(fs[i])&set(fs[j])]
report={'source':'V52','intersection_seed_count':len(seeds),'vertices':len(new),'faces':len(fs),'boundary_edges':sum(c==1 for c in edges.values()),'nonmanifold_edges':sum(c!=2 for c in edges.values()),'self_intersections_nonadjacent':len(pairs),'smoothing_max_delta_m':max((a-b).length for a,b in zip(p,new)),'protected_original_head_vertices':len(protected),'protected_max_nearest_vertex_delta_m':preserved,'rollback':'Hide V54 union and unhide original child head and neck; both original geometries and keys unchanged'};json.dump(report,open(r+'V54-child-neck-verification.json','w'),indent=2);bpy.ops.wm.save_as_mainfile(filepath=r+'V54-child-neck-trial.blend')
s=bpy.context.scene;s.cycles.samples=32;s.render.resolution_x=700;s.render.resolution_y=700;s.render.resolution_percentage=100;c=s.camera;ct=Vector((.025,-.265,1.82));c.data.ortho_scale=.43
for label,off in [('profile',(-3,0,0)),('front',(0,-3,0)),('threequarter',(-2,-3,0))]:
 c.location=ct+Vector(off);c.rotation_euler=(ct-c.location).to_track_quat('-Z','Y').to_euler();s.render.filepath=r+'V54-child-neck-'+label+'.png';bpy.ops.render.render(write_still=True)
print(report)
