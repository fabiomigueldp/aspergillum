import bpy,json,math
from mathutils import Vector,Matrix
from mathutils.bvhtree import BVHTree
from collections import defaultdict
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'V43-hand-contact-trial.blend',use_scripts=False)
o=bpy.data.objects['Maria — mão ao peito anatômica'];m=o.data;dg=bpy.context.evaluated_depsgraph_get();before=[v.co.copy() for v in o.evaluated_get(dg).data.vertices];base=[v.co.copy() for v in m.vertices];bv=BVHTree.FromObject(bpy.data.objects['Maria — túnica e mangas integradas'],dg)
sets=defaultdict(set)
for p,a in zip(m.polygons,m.attributes['.sculpt_face_set'].data):sets[a.value].update(p.vertices)
def sm(t):t=max(0,min(1,t));return t*t*(3-2*t)
pivot=Vector((.11,-.18,2.96));rotw=[sm((p.z-2.94)/.06) for p in base];shiftw=[sm((p.z-2.94)/.06) for p in base]
faces=[list(p.vertices) for p in m.polygons if all(base[i].z>3.0 for i in p.vertices)]
trials=[];best=None
for angle in [0,-5,-10,-15,-20]:
 new=[pivot+Matrix.Rotation(math.radians(angle)*w,3,'X')@(p-pivot) for p,w in zip(before,rotw)];shift=0
 for iteration in range(20):
  need=0
  for i,p in enumerate(new):
   if base[i].z<=3.0:continue
   q,n,_,_=bv.find_nearest(p);signed=(p-q).dot(n)
   if signed<.0008 and shiftw[i]>.001:need=max(need,(.0008-signed)/max(.01,-n.y*shiftw[i]))
  if need<1e-7:break
  shift+=need
  for p,w in zip(new,shiftw):p.y-=need*w
 gaps=[]
 for fs in [3,4,5,11,21]:gaps.append(min(bv.find_nearest(new[i])[3] for i in sets[fs]))
 signed=[]
 for i,p in enumerate(new):
  if base[i].z>3.0:
   q,n,_,_=bv.find_nearest(p);signed.append((p-q).dot(n))
 overlaps=len(BVHTree.FromPolygons(new,faces).overlap(bv));score=sum(gaps)/len(gaps)
 info={'angle_deg':angle,'outward_correction':shift,'fingertip_min_gaps':gaps,'mean_tip_gap':score,'min_signed_clearance':min(signed),'triangle_intersections':overlaps};trials.append(info)
 if overlaps==0 and min(signed)>=0 and (best is None or score<best[0]):best=(score,new,info)
score,new,info=best
k=o.shape_key_add(name='TESTE 45 — mão rígida com transição restrita ao punho');k.value=1
for i,v in enumerate(k.data):v.co=m.vertices[i].co+(new[i]-before[i])
json.dump({'method':'Entire hand above z3.0 rotated rigidly about wrist; transition restricted to lower wrist z2.94-3.0. V43 thumb cleanup retained. No metacarpal bend.','chosen':info,'candidates':trials},open(r+'V45-verification.json','w'),indent=2)
bpy.ops.wm.save_as_mainfile(filepath=r+'V45-hand-angle-trial.blend')
center=sum(base,Vector())/len(base);s=bpy.context.scene;s.cycles.samples=32;s.render.resolution_x=600;s.render.resolution_y=800;s.render.resolution_percentage=100;c=s.camera
for view,off in [('front',(0,-5,0)),('threequarter',(-3,-5,.2)),('profile',(5,0,0))]:
 c.location=center+Vector(off);c.rotation_euler=(center-c.location).to_track_quat('-Z','Y').to_euler();c.data.ortho_scale=.48;s.render.filepath=r+'V45-hand-'+view+'.png';bpy.ops.render.render(write_still=True)
