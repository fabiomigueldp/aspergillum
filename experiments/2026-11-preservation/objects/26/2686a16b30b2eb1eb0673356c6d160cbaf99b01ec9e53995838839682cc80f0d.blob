"""Reduce only the mantle by paired source samples, preserving the full 640-point seam."""
from pathlib import Path
import numpy as np,json,sys
from scipy.spatial import Delaunay
R=Path(__file__).resolve().parents[1];E=R/'evidence';s=np.load(E/'mantle-hidden-source.npz');pa=np.load(E/'mantle-source-parameters.npz')['params'];pairs=np.load(E/'mantle-pairing.npz');om=pairs['outer'];pairmap=dict(zip(om.tolist(),pairs['inner'].tolist()));final=np.load(E/'seam-source-inspection.npz')['points'];rest=np.load(E/'mantle-rest.npz');normalmap=dict(zip((rest['source_indices']-160386).tolist(),rest['normals']));off=160386;MAXROW=float(sys.argv[1]) if len(sys.argv)>1 else 9.;TAG='mantle-paired' if MAXROW==9 else 'mantle-cut-'+str(MAXROW).replace('.','p')
boundmask=((pa[om,0]==0)|(pa[om,0]==MAXROW)|(pa[om,1]==0)|(pa[om,1]==79))&(pa[om,0]<=MAXROW);selected=set(om[boundmask].tolist());selected.update(i for i in range(800) if pa[i,0]<=MAXROW);ids=np.array(sorted(selected));n=len(ids);ii=np.array([pairmap[int(i)] for i in ids]);src=np.concatenate([ids,ii]);points=final[src+off]
# Scale parameter directions by median physical spacing of the control net.
v=final[off:off+800].reshape(10,80,3);si=np.median(np.linalg.norm(np.diff(v,axis=0),axis=2));sj=np.median(np.linalg.norm(np.diff(v,axis=1),axis=2));uv=pa[ids]*[si,sj];tri=Delaunay(uv).simplices.copy();raw=np.cross(points[tri[:,1]]-points[tri[:,0]],points[tri[:,2]]-points[tri[:,0]]);norm=np.array([normalmap[int(i)] for i in src]);expected=norm[tri].mean(1)
if np.median(np.einsum('ij,ij->i',raw,expected))<0:tri=tri[:,::-1]
edges={}
for t in tri:
 for a,b in zip(t,np.roll(t,-1)):edges.setdefault(tuple(sorted((int(a),int(b)))),[]).append((int(a),int(b)))
bound=[es[0] for es in edges.values() if len(es)==1];f=tri.tolist()+(tri[:,::-1]+n).tolist();wall=[0]*len(tri)+[1]*len(tri)
for a,b in bound:
 if pa[ids[a],0]==MAXROW and pa[ids[b],0]==MAXROW:continue
 f.extend([[b,a,a+n],[b,a+n,b+n]]);wall.extend([2,2])
# The original source seam has 3 intermediate rim vertices at each top end.
seam=np.where(pa[:,0]==MAXROW)[0];extra=sorted(set(seam.tolist())-set(src.tolist()));positions=points.tolist();normals=norm.tolist();src=src.tolist()
for corner in [0.,79.]:
 os=int(om[np.all(pa[om]==[MAXROW,corner],axis=1)][0]);ins=pairmap[os];a=src.index(os);b=src.index(ins);extraids=[i for i in extra if np.all(pa[i]==[MAXROW,corner])]
 p0=final[os+off];p1=final[ins+off];axis=p1-p0;order=sorted(extraids,key=lambda i:float((final[i+off]-p0)@axis))
 chain=[a]
 for i in order:chain.append(len(src));src.append(i);positions.append(final[i+off].tolist());normals.append(normalmap[i].tolist())
 chain.append(b);found=[]
 for ti,t in enumerate(f):
  if a in t and b in t:found.append(ti)
 assert len(found)==1,(corner,found)
 ti=found[0];t=f[ti];c=next(i for i in t if i not in (a,b));edge_forward=any(t[k]==a and t[(k+1)%3]==b for k in range(3))
 if not edge_forward:chain=chain[::-1]
 new=[[chain[k],chain[k+1],c] for k in range(len(chain)-1)];f[ti]=new[0];f.extend(new[1:]);wall.extend([2]*(len(new)-1))
p=np.array(positions);ff=np.array(f);src=np.array(src);norm=np.array(normals);assert set(seam.tolist())<=set(src.tolist())
np.savez_compressed(E/(TAG+'.npz'),points=p,triangles=ff,normals=norm,source_indices=src+off,wall_class=np.array(wall))
rep={'outer_samples':n,'vertices':len(p),'triangles':len(ff),'source_exact_coordinates':bool(np.array_equal(p,final[src+off])),'source_normals':'Final evaluated V75 samples from mantle-rest','parameter_scales':[float(si),float(sj)],'fixed_seam_vertices':len(seam),'all_seam_source_ids_retained':True,'source_vertices_moved':False,'engine_tested':False,'gate_pending':True};(E/(TAG+'-build.json')).write_text(json.dumps(rep,indent=2));print(rep)
