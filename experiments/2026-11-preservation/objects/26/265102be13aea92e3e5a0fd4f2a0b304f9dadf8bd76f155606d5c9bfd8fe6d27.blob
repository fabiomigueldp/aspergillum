base=set(json.load(open(r+'neck-whole-fold-mask-audit.json'))['patch_faces']);em=o.evaluated_get(dg).to_mesh();em.calc_loop_triangles();TT=np.array([t.vertices[:] for t in em.loop_triangles]);FM=np.array([t.polygon_index for t in em.loop_triangles]);o.evaluated_get(dg).to_mesh_clear();P=p[TT];lo=P.min(1);hi=P.max(1);e1=P[:,1]-P[:,0];e2=P[:,2]-P[:,0]
pairlist=np.load(r+'neck-source-layer-pairs.npz')['pairs']+160386;pairmap={int(a):int(b) for a,b in pairlist for a,b in [(a,b),(b,a)]};lookup={tuple(sorted(f)):fi for fi,f in enumerate(fs)};incident=collections.defaultdict(set)
for fi,f in enumerate(fs):
 for a,b in zip(f,f[1:]+f[:1]):incident[tuple(sorted((a,b)))].add(fi)
def audit(patch):
 counts=collections.Counter(tuple(sorted((a,b))) for fi in patch for a,b in zip(fs[fi],fs[fi][1:]+fs[fi][:1]));edges=[e for e,n in counts.items() if n==1];out=~np.isin(FM,list(patch));hits=[]
 for a,b in edges:
  A=p[a];D=p[b]-A;ids=np.where(out & (hi>=np.minimum(p[a],p[b])-1e-10).all(1)&(lo<=np.maximum(p[a],p[b])+1e-10).all(1)&~np.isin(TT,[a,b]).any(1))[0]
  if not len(ids):continue
  H=np.cross(np.broadcast_to(D,(len(ids),3)),e2[ids]);det=np.sum(e1[ids]*H,axis=1);valid=abs(det)>1e-15;ids=ids[valid];H=H[valid];det=det[valid]
  S=A-P[ids,0];u=np.sum(S*H,axis=1)/det;Q=np.cross(S,e1[ids]);v=Q@D/det;t=np.sum(e2[ids]*Q,axis=1)/det
  for j in np.where((u>1e-9)&(v>1e-9)&(u+v<1-1e-9)&(t>1e-9)&(t<1-1e-9))[0]:hits.append({'edge':[a,b],'triangle':TT[ids[j]].tolist(),'source_face':int(FM[ids[j]]),'t':float(t[j])})
 badj=collections.defaultdict(set)
 for a,b in edges:badj[a].add(b);badj[b].add(a)
 return hits,edges,sum(len(x)!=2 for x in badj.values())
