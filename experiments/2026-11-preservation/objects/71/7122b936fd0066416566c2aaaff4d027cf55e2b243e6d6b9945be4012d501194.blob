import {chromium} from 'playwright';
import fs from 'node:fs/promises';
import path from 'node:path';
// Environment adapter only: retain checked-in CLI and verified backend selection.
// Managed Chromium download failed; use preinstalled Chromium with this same Playwright.
const originalLaunch=chromium.launch.bind(chromium);
chromium.launch=async options=>{
  const {channel,...rest}=options;
  const browser=await originalLaunch({...rest,executablePath:'/usr/bin/chromium'});
  const failures=[];
  const originalNewContext=browser.newContext.bind(browser);
  browser.newContext=async options=>{
    const c=await originalNewContext(options);
    c.on('page',p=>{p.on('response',r=>{if(r.status()>=400)failures.push({url:r.url(),status:r.status()});});p.on('console',m=>{if(m.type()==='error')failures.push({console:m.text()});});});
    return c;
  };
  const originalClose=browser.close.bind(browser);
  browser.close=async()=>{
    const a=process.argv.indexOf('--output');
    if(a>=0){
      const dir=path.resolve(process.argv[a+1]);
      await fs.mkdir(dir,{recursive:true});
      const snapshots=[];
      for(const c of browser.contexts())for(const p of c.pages()){
        if(p.url().includes('bedrock-renderer'))snapshots.push(await p.evaluate(()=>({url:location.href,inspector:document.querySelector('#inspector-content')?.innerText??document.body.innerText,api:window.__BEDROCK_CAPTURE__?.version})).catch(e=>({error:e.message})));
      }
      await fs.writeFile(path.join(dir,'runtime-audit.json'),JSON.stringify({environmentAdapter:'Preinstalled /usr/bin/chromium via exact Playwright dependency; original CLI and backend verifier unchanged.',browserVersion:browser.version(),failures,snapshots},null,2));
    }
    return originalClose();
  };
  return browser;
};
await import('./scripts/capture-assets.mjs');
