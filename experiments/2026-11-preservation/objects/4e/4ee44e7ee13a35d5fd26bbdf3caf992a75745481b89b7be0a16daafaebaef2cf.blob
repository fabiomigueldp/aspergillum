from collections import Counter
report=json.load(open(r+'V49-root-contact-detail.json')); edge=Counter(tuple(sorted((f[i],f[(i+1)%len(f)]))) for f in states[1][3] for i in range(len(f)))
report['tunic_boundary_edges']=sum(v==1 for v in edge.values());report['tunic_nonmanifold_edges']=sum(v!=2 for v in edge.values())
for state in [0,1]:
 hp,tp,hf,tf,tb=states[state];inside=[]
 for i,p in enumerate(hp):
  loc,n,f,d=tb.find_nearest(p)
  if (p-loc).dot(n)<-1e-7:inside.append((i,d))
 report['wrist_inside_'+str(state)]={'count':len(inside),'max_depth_m':max(d for i,d in inside),'original_z_min':min(h.data.vertices[i].co.z for i,d in inside),'original_z_max':max(h.data.vertices[i].co.z for i,d in inside)}
json.dump(report,open(r+'V49-root-contact-detail.json','w'),indent=2);print({k:v for k,v in report.items() if k.startswith('wrist') or k.startswith('tunic')})
