from pathlib import Path
import hashlib,json
O=Path(__file__).resolve().parent;B=O.parents[1]
rels=['band_shell_v13/constrained_fit/retained-band.npz','ear_rim_v11/structural_rebuild/retained-shell.npz','body_interface_v9/constrained_fit/retained-anatomy.npz','pbr_normals_v2/resource_pack/models/entity/paz_v75_pbr_sculpture.geo.json','pbr_normals_v2/resource_pack/textures/entity/paz_v75_pbr_sculpture.png','pbr_normals_v2/resource_pack/textures/entity/paz_v75_pbr_sculpture_normal_dx.png','assembly_transport_v14/independent_validation/critical-ray-alpha-comparison.json','assembly_transport_v14/independent_validation/critical-ray-center-only-trial.json','assembly_transport_v14/independent_validation/raster-audit-arrays.npz','assembly_transport_v14/independent_validation/source-preservation-final.json','band_shell_v13/independent_diagnosis/visible-blue-ray-witnesses.json','band_shell_v13/independent_diagnosis/valley-dense-map.npz']
frozen={r:hashlib.sha256((B/r).read_bytes()).hexdigest() for r in rels}
prev=json.load(open(B/'assembly_transport_v14/independent_validation/source-preservation-final.json'))
checks=[{'file':r['file'],'matches_V14_frozen':frozen[r['file']]==r['sha256']} for r in prev]
report={'scope':'Independent V15 candidate audit. Inputs and existing V14 findings reused without rerunning completed source/viewer tests. All writes restricted to independent_validation.','frozen_sha256':frozen,'native_hashes_match_V14':checks,'contracts':{'critical_rays':'Reuse exact 18 central rays and tangent-plane 5x5 offsets from the frozen V14 report, 450 total. Independently intersect candidate JSON faces and nearest mip0 actual alpha. Compare native first part, missing hits, extra hits, and depth deltas. Preserve front-face test.','geometry_uv':'Independently reconstruct actual JSON face corners with explicit matrices, verify finite values, orientation and retained source mapping where supplied. Compare unrelated bones against frozen legacy and/or V14 context. Test only documented math, not runtime behavior.','full_band':'Sample all native band face interiors and relevant exterior/return roles, not merely critical points. Measure support and offsets using actual candidate faces/alpha. Use fixed orthographic silhouette support scans with declared resolution and bounded view coverage where feasible.','cost':'Count actual cubes, mapped faces and implied raster triangles; file and decoded RGBA sizes. These are costs, not engine limits or performance.','preservation':'Rehash frozen inputs at end; all candidate claims bound to exact output hashes.','exclusions':'No Minecraft/engine tests, no performance claims, no source geometry edits, no exporter edits, no pack promotion, saves or services.'}}
(O/'test-contract-and-input-hashes.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(report,indent=2))
