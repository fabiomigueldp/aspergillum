from pathlib import Path
import numpy as np,json,sys,hashlib
R=Path(__file__).resolve().parents[1];B=R.parent
base=np.load(B/'body_interface_v8/anatomy_fit/baseline-welded.npz');f=base['triangles'];x=base['points'][f];e=x[:,1]-x[:,0];e2=x[:,2]-x[:,0];el=np.linalg.norm(e,axis=1);u=e/np.maximum(el[:,None],1e-30);proj=(e2*u).sum(1);hvec=e2-proj[:,None]*u;h=np.linalg.norm(hvec,axis=1);valid=(el*h)>1e-12;ids=np.flatnonzero(valid)
A=np.zeros((len(ids),2,2));A[:,0,0]=el[valid];A[:,0,1]=proj[valid];A[:,1,1]=h[valid];inv=np.linalg.inv(A);rows={}
for item in sys.argv[1:-1]:
 name,path=item.split('=',1);p=Path(path);d=np.load(p);assert np.array_equal(d['triangles'],f);v=d['points'];y=v[f];E=np.stack((y[:,1]-y[:,0],y[:,2]-y[:,0]),-1);F=E[valid]@inv;sv=np.linalg.svd(F,compute_uv=False);area=sv[:,0]*sv[:,1];moved=np.linalg.norm(v-base['points'],axis=1);changed=(moved[f].max(1)>1e-10)[valid];k=int(np.argmin(sv[:,1]));j=int(np.argmax(sv[:,0]));report={'path':str(p),'sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'main_faces_measured':len(ids),'tiny_faces_excluded_ids':np.flatnonzero(~valid).tolist(),'excluded_positions_unchanged':bool(np.array_equal(y[~valid],x[~valid])),'minimum_principal_stretch':float(sv[:,1].min()),'minimum_stretch_triangle_id':int(ids[k]),'maximum_principal_stretch':float(sv[:,0].max()),'maximum_stretch_triangle_id':int(ids[j]),'minimum_area_ratio':float(area.min()),'maximum_anisotropy':float((sv[:,0]/sv[:,1]).max()),'faces_with_min_stretch_below_0p9':int((sv[:,1]<.9).sum()),'faces_with_max_stretch_above_1p1':int((sv[:,0]>1.1).sum()),'changed_face_count':int(changed.sum()),'changed_min_stretch_p05_median':np.quantile(sv[changed,1],[.05,.5]).tolist() if changed.any() else [],'changed_max_stretch_p95':float(np.quantile(sv[changed,0],.95)) if changed.any() else 1};rows[name]=report;print(name,report,flush=True)
out={'method':'Per-triangle 3x2 deformation gradient from original V8 welded baseline; exact singular values measure intrinsic compression/stretch, independent of rigid face rotation. These are distortion metrics, not a collision or artistic certificate.','rows':rows};(R/'evidence'/sys.argv[-1]).write_text(json.dumps(out,indent=2))
