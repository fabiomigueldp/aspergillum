import bpy,json
from mathutils import Vector
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';records=[]
for version,file in [('V20',r+'../Nossa_Senhora_da_Paz_v20_estudo.blend'),('V75',r+'V75-tunic-lower-trial.blend')]:
 bpy.ops.wm.open_mainfile(filepath=file,use_scripts=False);s=bpy.context.scene;s.render.engine='CYCLES';s.cycles.samples=48;s.render.resolution_x=600;s.render.resolution_y=900;s.render.resolution_percentage=100;s.view_settings.view_transform='AgX';s.view_settings.exposure=0;s.view_settings.gamma=1
 for o in list(bpy.data.objects):
  if o.type=='LIGHT':bpy.data.objects.remove(o,do_unlink=True)
 w=bpy.data.worlds.new('Comparison neutral world');w.use_nodes=True;w.node_tree.nodes['Background'].inputs[0].default_value=(.18,.18,.18,1);w.node_tree.nodes['Background'].inputs[1].default_value=.35;s.world=w
 for name,loc,power,size in [('Key',(-3,-4,6),700,4),('Fill',(3,-1,4),250,3)]:
  d=bpy.data.lights.new(name,'AREA');d.energy=power;d.shape='DISK';d.size=size;o=bpy.data.objects.new(name,d);s.collection.objects.link(o);o.location=loc;o.rotation_euler=(Vector((0,0,2))-o.location).to_track_quat('-Z','Y').to_euler()
 c=s.camera;c.data.type='ORTHO';c.data.ortho_scale=4.15;target=Vector((0,-.03,2.06))
 for view,offset in [('profile',(-8,0,0)),('front',(0,-8,0))]:
  c.location=target+Vector(offset);c.rotation_euler=(target-c.location).to_track_quat('-Z','Y').to_euler();s.render.filepath=r+version+'-global-comparison-'+view+'.png';bpy.ops.render.render(write_still=True)
 records.append({'version':version,'source':file})
json.dump({'files':records,'resolution':[600,900],'samples':48,'ortho_scale':4.15,'target':list(target),'lighting':'Neutral world .35; area key700W size4 at(-3,-4,6); fill250W size3 at(3,-1,4)','note':'Same render settings, no geometry or files changed. Reference camera is not calibrated.'},open(r+'V20-V75-comparison-settings.json','w'),indent=2)
