import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';
import {buildNativePedestalStudy} from '../assets-src/atelier/twin-pedestal-codebook-study.mjs';
const out=path.resolve(import.meta.dirname,'../out/two-pedestal-integration');fs.mkdirSync(out,{recursive:true});const book=buildNativePedestalStudy(),data=JSON.stringify(book),file=path.join(out,'native-codebook-study.json');fs.writeFileSync(file,data);const report={...book.stats,registered:book.registered,stateDigits:book.stateDigits,declaredStates:book.declaredStates,padding:book.padding,bytes:Buffer.byteLength(data),sha256:crypto.createHash('sha256').update(data).digest('hex')};fs.writeFileSync(path.join(out,'native-codebook-report.json'),JSON.stringify(report,null,2));console.log(JSON.stringify(report,null,2));
