import bpy,numpy as np,json
from pathlib import Path
from mathutils import Vector
from mathutils.bvhtree import BVHTree
R=Path(__file__).resolve().parents[1];B=R.parent;cap=np.load(B/'shell_band_v5/retained_candidate/evidence/cap-paired.npz');ff=cap['triangles'][np.all(cap['source_side'][cap['triangles']]==0,axis=1)];ct=BVHTree.FromPolygons(cap['points'].tolist(),ff.tolist(),all_triangles=True);samples=np.load(B/'shell_band_v5/evidence/review-holdout-points.npz')['points'];hv=np.load(B/'shell_band_v4/evidence/head-source.npz');ht=BVHTree.FromPolygons(hv['points'].tolist(),hv['triangles'].tolist(),all_triangles=True);old=np.load(B/'pbr_normals_v2/evidence/repaired_meshes.npz');lf=old['low_f'][old['low_m']==15];lt=BVHTree.FromPolygons(old['low_v'].tolist(),lf.tolist(),all_triangles=True);high=[];low=[];positions=[]
for p in samples:
 q=ct.find_nearest(Vector(p))[0];positions.append(q[:]);a,na,_,_=ht.find_nearest(q);b,nb,_,_=lt.find_nearest(q);high.append(float((q-a).dot(na)));low.append(float((q-b).dot(nb)))
high=np.array(high);low=np.array(low);new=(low<-.0001)&(high>=-.0001);rep={'samples':len(samples),'seed':20261104,'method':'Project fixed held-out outer crown samples onto V5 cap, compare nearest-face plane signed proxy against source highpoly head versus the actual legacy reduced part15 head. Not an exact SDF or collision proof.','source_highpoly_negative_over_0p1mm':int((high<-.0001).sum()),'legacy_negative_over_0p1mm':int((low<-.0001).sum()),'new_threshold_events_from_legacy_head':int(new.sum()),'recovered_events':int(((high<-.0001)&(low>=-.0001)).sum()),'legacy_max_inward_proxy':float(max(0,-low.min())),'legacy_signed_delta_vs_high_quantiles':np.quantile(low-high,[0,.01,.5,.99,1]).tolist(),'interpretation':'Total threshold count is lower with the legacy head, but 1,011 events change locally into the negative class while 1,285 recover. This is an interface diagnosis, not evidence of aggregate regression or exact intersections. Colored one-sided renders expose local body/cap contact that the same-stone highpoly-context previews cannot certify.','runtime_tested':False};(R/'evidence/legacy-head-contact.json').write_text(json.dumps(rep,indent=2));np.savez_compressed(R/'evidence/legacy-head-contact.npz',points=np.array(positions),high_proxy=high,legacy_proxy=low,new_events=new);print(rep)
