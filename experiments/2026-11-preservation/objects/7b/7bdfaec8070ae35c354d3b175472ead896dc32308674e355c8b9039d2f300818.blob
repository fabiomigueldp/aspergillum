from pathlib import Path
import numpy as np,json,sys,hashlib
from collections import Counter,defaultdict
O=Path(__file__).resolve().parent;B=O.parents[1];tag=sys.argv[1] if len(sys.argv)>1 else 'valley-source-mask-n8';path=B/f'band_shell_v13/constrained_fit/{tag}.npz';c=np.load(path);b=np.load(B/'band_ear_v12/structural_rebuild/retained-band.npz');p=b['points'];f=b['triangles'];q=c['points'];g=c['triangles'];parents=c['v13_parent_face_indices'];roles=c['v13_face_roles'];vp=c['v13_parent_vertex_indices'];old=vp>=0
assert len(set(vp[old]))==len(p) and np.array_equal(q[old],p[vp[old]])
# Check every unprojected old-face domain by original oriented triangle plane and barycentrics, not UV attributes.
tri=p[f];area=np.linalg.norm(np.cross(tri[:,1]-tri[:,0],tri[:,2]-tri[:,0]),axis=1)/2;ct=q[g];careas=np.linalg.norm(np.cross(ct[:,1]-ct[:,0],ct[:,2]-ct[:,0]),axis=1)/2;patched=np.unique(parents[roles==2]);notpatch=np.setdiff1d(np.arange(len(f)),patched);rows=[]
for fi in notpatch:
 ix=np.flatnonzero(parents==fi);t=tri[fi];basis=np.stack([t[1]-t[0],t[2]-t[0]],1);n=np.cross(basis[:,0],basis[:,1]);n/=np.linalg.norm(n);ps=ct[ix].reshape(-1,3);sol=np.linalg.lstsq(basis,(ps-t[0]).T,rcond=None)[0].T;bar=np.c_[1-sol.sum(1),sol];planemax=np.max(np.abs((ps-t[0])@n));rows.append({'parent_face':int(fi),'children':len(ix),'max_plane_error_m':float(planemax),'minimum_barycentric':float(bar.min()),'area_error_m2':float(abs(careas[ix].sum()-area[fi]))})
# Actual 3D coverage of each old ridge segment by candidate mesh edges.
edges=np.unique(np.sort(np.concatenate([g[:,[0,1]],g[:,[1,2]],g[:,[2,0]]]),1),axis=0);ep=q[edges];oldedges=np.unique(np.sort(np.concatenate([f[:,[0,1]],f[:,[1,2]],f[:,[2,0]]]),1),axis=0);uv=b['source_uv'];side=b['source_side'];rr=[]
for a,d in oldedges:
 if side[a]!=side[d] or side[a] not in [0,1] or not any(abs(uv[a,1]-v)<1e-9 and abs(uv[d,1]-v)<1e-9 for v in [3,13]):continue
 p0,p1=p[[a,d]];vec=p1-p0;ll=vec@vec;t=(ep-p0)@vec/ll;perp=np.linalg.norm(ep-p0-t[:,:,None]*vec,axis=2);good=(perp.max(1)<1e-10)&(t.min(1)>=-1e-10)&(t.max(1)<=1+1e-10)&(t.max(1)-t.min(1)>1e-10);ints=np.sort(t[good],axis=1);ints=ints[np.argsort(ints[:,0])];cursor=0.;gap=0.;overlap=0.
 for lo,hi in ints:gap+=max(0,lo-cursor);overlap+=max(0,min(cursor,hi)-lo);cursor=max(cursor,hi)
 gap+=max(0,1-cursor);rr.append({'old_edge':[int(a),int(d)],'source_v':float(uv[a,1]),'side':int(side[a]),'segments':int(good.sum()),'gap_mm':float(gap*np.sqrt(ll)*1000),'duplicate_length_mm':float(overlap*np.sqrt(ll)*1000)})
rep={'candidate':str(path),'sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'existing_vertices':len(p),'existing_vertices_bit_identical':True,'nonpatch_parent_faces':len(notpatch),'nonpatch_max_plane_error_m':max(r['max_plane_error_m'] for r in rows),'nonpatch_min_barycentric':min(r['minimum_barycentric'] for r in rows),'nonpatch_max_area_error_m2':max(r['area_error_m2'] for r in rows),'patch_parent_faces':patched.tolist(),'patch_part_histogram':dict(Counter(map(int,b['face_parts'][patched]))),'ridge_edges_checked':len(rr),'ridge_total_gap_mm':sum(r['gap_mm'] for r in rr),'ridge_total_duplicate_length_mm':sum(r['duplicate_length_mm'] for r in rr),'central_valley_parent_faces_projected':int(sum(np.any((uv[f[i],0]>=80-1e-10)&(uv[f[i],0]<=96+1e-10)) and np.all((uv[f[i],0]>=80-1e-10)&(uv[f[i],0]<=96+1e-10)) for i in patched)),'scope':'Checks changed candidate against frozen V12, not repeated gates on V11/V12. Domain plane/barycentric/area and exact ridge-interval checks are independent of candidate UV labels. Overlap/self intersections reviewed separately.'}
(O/f'{tag}-preservation.json').write_text(json.dumps(rep,indent=2));(O/f'{tag}-nonpatch-domains.json').write_text(json.dumps(rows,indent=2));(O/f'{tag}-ridge-intervals.json').write_text(json.dumps(rr,indent=2));print(json.dumps(rep,indent=2))
