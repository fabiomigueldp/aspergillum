import numpy as np,json,sys,importlib.util,hashlib
from pathlib import Path
from mathutils.bvhtree import BVHTree
sys.dont_write_bytecode=True;O=Path(__file__).resolve().parent;B=O.parent.parent
spec=importlib.util.spec_from_file_location('gate',B/'shell_band_v3/tools/independent_gate.py');gate=importlib.util.module_from_spec(spec);spec.loader.exec_module(gate)
base=np.load(B/'body_interface_v8/anatomy_fit/baseline-welded.npz');cand=np.load(B/'body_interface_v8/anatomy_fit/retained-anatomy.npz');maps=json.loads((B/'pbr_normals_v2/evidence/alpha-triangle-map.json').read_text());meta=json.loads((B/'evidence/source-export.json').read_text());rep={'candidate_sha256':hashlib.sha256((B/'body_interface_v8/anatomy_fit/retained-anatomy.npz').read_bytes()).hexdigest(),'method':'Intended triangle geometry against unchanged parts plus native V5 band. Special hybrid parts6/7/8/10/14 are proxies only, explicitly flagged. No alpha expansion or engine test.','rows':{}};bt={k:BVHTree.FromPolygons(d['points'].tolist(),d['triangles'].tolist(),all_triangles=True,epsilon=0) for k,d in [('baseline',base),('candidate',cand)]}
for pi in list(range(2,15))+list(range(16,20))+['band']:
 if pi=='band':
  a=np.load(B/'shell_band_v5/retained_candidate/evidence/band-paired.npz');v=a['points'];f=a['triangles'];name='V5 native retained band';auth=True
 else:
  t=np.array([[q[k] for k in ['a','b','c']] for q in maps if q['part']==pi]);t=t[:,:,[0,2,1]]/16;t[:,:,1]*=-1;v=t.reshape(-1,3);f=np.arange(len(v)).reshape(-1,3);name=meta['parts'][pi]['name'];auth=pi not in [6,7,8,10,14]
 tree=BVHTree.FromPolygons(v.tolist(),f.tolist(),all_triangles=True,epsilon=0);pairs={}
 for tag,d in [('baseline',base),('candidate',cand)]:
  rows=[]
  for i,j in bt[tag].overlap(tree):
   w=gate.strict_hits(d['points'][d['triangles'][i]],v[f[j]])+gate.strict_hits(v[f[j]],d['points'][d['triangles'][i]])
   if w:rows.append([int(i),int(j)])
  pairs[tag]=set(tuple(x) for x in rows)
 rep['rows'][str(pi)]={'name':name,'matches_current_geometry_before_alpha':auth,'baseline_pairs':len(pairs['baseline']),'candidate_pairs':len(pairs['candidate']),'new_pairs':sorted(pairs['candidate']-pairs['baseline']),'removed_pairs':sorted(pairs['baseline']-pairs['candidate'])}
 print(pi,name,len(pairs['baseline']),len(pairs['candidate']),'new',len(pairs['candidate']-pairs['baseline']),flush=True)
(O/'retained-anatomy-other-contacts.json').write_text(json.dumps(rep,ensure_ascii=False,indent=2))
