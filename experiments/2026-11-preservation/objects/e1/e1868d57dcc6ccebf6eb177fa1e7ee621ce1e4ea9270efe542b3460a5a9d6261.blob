W=B/'opaque_transport_v15/shared_mask';mapping=np.load(W/'transport_arrays.npz');sc=json_faces(W/'shared_mask_2048.geo.json');reports=[];results={}
def unit(v):return v/np.maximum(np.linalg.norm(v,axis=-1,keepdims=True),1e-300)
def angle(a,b):return np.degrees(np.arccos(np.clip(np.sum(unit(a)*unit(b),axis=-1),-1,1)))
def stats(a):return {'q0_q50_q90_q95_q99_q100_deg':np.quantile(a,[0,.5,.9,.95,.99,1]).tolist(),'count_gt_0_1deg':int((a>.1).sum()),'count_gt_1deg':int((a>1).sum()),'count_gt_5deg':int((a>5).sum()),'count_gt_15deg':int((a>15).sum()),'count_gt_45deg':int((a>45).sum()),'count_gt_90deg':int((a>90).sum())}
for part in [0,1,15]:
 q=np.load(O/f'blender-quads-part{part:02d}-actual-normals.npz');t=np.load(O/f'blender-clipped-part{part:02d}-actual-normals.npz');native=dict(np.load(SOURCE[part]));ids=np.flatnonzero(mapping['part']==part);face=mapping['native_face'][ids];half=mapping['half'][ids];native_tri=native['points'][native['triangles'][face]];source=unit(np.cross(native_tri[:,1]-native_tri[:,0],native_tri[:,2]-native_tri[:,0]));exact=sc['n'][sc['part']==part];exactpos=sc['q'][sc['part']==part];qpos=q['face_vertices'];tpos=t['face_vertices'];quadN=q['polygon_normal'];triN=t['polygon_normal'];crossN=unit(np.cross(qpos[:,1]-qpos[:,0],qpos[:,2]-qpos[:,0]));newell=unit(np.sum(np.cross(qpos,np.roll(qpos,-1,axis=1)),axis=1));angles={'saved_quad_vs_source':angle(quadN,source),'saved_clipped_vs_source':angle(triN,source),'saved_quad_vs_exact_json_frame':angle(quadN,exact),'saved_clipped_vs_exact_json_frame':angle(triN,exact),'saved_quad_vs_saved_clipped':angle(quadN,triN),'float64_first_triangle_cross_vs_source':angle(crossN,source),'float64_newell_of_saved_float32_corners_vs_source':angle(newell,source),'exact_json_vs_source':angle(exact,source)};centers=tpos.mean(1);localuv=np.mean(native['source_uv'][native['triangles'][face]],axis=1)if'source_uv'in native else np.zeros((len(face),2));largest=np.argsort(angles['saved_quad_vs_source'])[-30:][::-1];witness=[]
 for i in largest:
