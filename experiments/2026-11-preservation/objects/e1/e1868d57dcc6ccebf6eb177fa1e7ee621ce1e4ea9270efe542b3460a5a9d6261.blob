   x=(centers[i,0]-.035)/.52*1000+500;y=500-(centers[i,2]-3.58)/.52*1000;col=(230,20,20)if e>15 else(255,150,0)if e>5 else(235,220,0);draw.ellipse((x-2,y-2,x+2,y+2),fill=col)
  base.save(O/'blender-band-quad-normal-error-projections.png')
 results.update({f'part{part}_{k}':v for k,v in angles.items()});results[f'part{part}_native_face']=face;results[f'part{part}_half']=half;results[f'part{part}_centers']=centers;reports.append(row);print(part,{k:row[k]for k in ['half_faces','actual_clipped_vertices_bit_exact_to_quad_first_three','actual_saved_quad_corner_error_vs_float64_JSON_max_mm','zero_saved_quad_normals','zero_saved_clipped_normals','angle_metrics']},flush=True)
np.savez_compressed(O/'blender-normal-confound-arrays.npz',**results);save(O/'blender-normal-confound.json',{'method':'Read actual MeshPolygon normals and float32 corner positions from both saved Blender scenes without saving them. Compare against independent native float64 triangle normals and exact JSON frame normals; use shared source mapping to relate every face. Additional float64 crosses/Newell use actual saved corner coordinates to separate storage-coordinate distortion from Blender polygon-normal computation.','parts':reports,'projection_overlay':'blender-band-quad-normal-error-projections.png marks face-centroid projections with quad-vs-source error>1deg yellow,>5deg orange,>15deg red. It does not test visibility/depth and includes rear faces.','limitations':'Direct scene-data evidence only. It identifies normal differences between controls, not final shader causality. No material/alpha or saved source scene is modified.'})
