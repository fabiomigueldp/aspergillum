 facearea=np.linalg.norm(np.cross(native_tri[:,1]-native_tri[:,0],native_tri[:,2]-native_tri[:,0]),axis=1)/2;row={'part':part,'half_faces':len(face),'actual_clipped_vertices_bit_exact_to_quad_first_three':bool(np.array_equal(tpos,qpos[:,:3])),'actual_saved_quad_corner_error_vs_float64_JSON_max_mm':float(np.linalg.norm(qpos-exactpos,axis=2).max()*1000),'zero_saved_quad_normals':int((np.linalg.norm(quadN,axis=1)<.5).sum()),'zero_saved_clipped_normals':int((np.linalg.norm(triN,axis=1)<.5).sum()),'angle_metrics':{k:stats(v)for k,v in angles.items()},'native_child_area_fraction_quad_error_gt1deg':float(mapping['child_area_blocks2'][ids][angles['saved_quad_vs_source']>1].sum()/mapping['child_area_blocks2'][ids].sum()),'worst_quad_faces':witness}
 if part==0:
  row['by_face_part']={str(k):{'half_faces':int((native['face_parts'][face]==k).sum()),'quad':stats(angles['saved_quad_vs_source'][native['face_parts'][face]==k]),'clipped':stats(angles['saved_clipped_vs_source'][native['face_parts'][face]==k])}for k in np.unique(native['face_parts'])};row['by_v13_face_role']={str(k):{'half_faces':int((native['v13_face_roles'][face]==k).sum()),'quad':stats(angles['saved_quad_vs_source'][native['v13_face_roles'][face]==k]),'clipped':stats(angles['saved_clipped_vs_source'][native['v13_face_roles'][face]==k])}for k in np.unique(native['v13_face_roles'])}
