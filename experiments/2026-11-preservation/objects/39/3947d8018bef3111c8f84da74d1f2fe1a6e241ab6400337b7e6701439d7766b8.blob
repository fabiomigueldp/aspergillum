"""Hypothetical Float32 absolute-endpoint sensitivity, NOT engine behavior."""
from pathlib import Path
import json,numpy as np
W=Path(__file__).resolve().parent;a=np.load(W/'transport_arrays.npz');g=json.loads((W/'shared_mask_2048.geo.json').read_text())['minecraft:geometry'][0]
c=[g['bones'][int(p)]['cubes'][int(i)]for p,i in zip(a['part'],a['cube_index'])];s=np.array([x['size']for x in c]);o=np.array([x['origin']for x in c]);o[:,0]=-o[:,0]-s[:,0];lo=o.astype(np.float32);hi=(o+s).astype(np.float32);lost=(lo[:,:2]==hi[:,:2]).any(axis=1)
r={'status':'hypothetical precision sensitivity, not engine prediction','method':'Decode final south cube unrotated absolute endpoint coordinates in Float64, then store each absolute endpoint directly as Float32. Test equality of each positive leg endpoint. Actual engine/importer may center vertices or transform in another order, so this does not establish runtime collapse.','half_triangle_count':len(c),'collapsed_half_count':int(lost.sum()),'collapsed_child_area_blocks2':float(a['child_area_blocks2'][lost].sum()),'fraction_of_new_surface_area':float(a['child_area_blocks2'][lost].sum()/a['child_area_blocks2'].sum()),'rows':[{'part':int(a['part'][i]),'face':int(a['native_face'][i]),'half':int(a['half'][i]),'cube_index':int(a['cube_index'][i]),'leg_lengths_blocks':(s[i,:2]/16).tolist(),'child_area_blocks2':float(a['child_area_blocks2'][i])}for i in np.flatnonzero(lost)]};(W/'precision-sensitivity.json').write_text(json.dumps(r,indent=2)+'\n');print(json.dumps(r,indent=2))
