diff --git a/addons/altare/assets-src/atelier/crossbrace-model.mjs b/addons/altare/assets-src/atelier/crossbrace-model.mjs
new file mode 100644
index 0000000..792c5d2
--- /dev/null
+++ b/addons/altare/assets-src/atelier/crossbrace-model.mjs
@@ -0,0 +1,99 @@
+import {box,rect,rotateCube} from '../block-primitives.mjs';
+
+// Cruzeta: an open walnut frame. A bay is a frame, never a solid chest.
+// The contour is compiled, so internal faces/posts are not merely hidden.
+export const crossbraceProfile=Object.freeze({top:16,slabBottom:14.2,outer:7.8,inner:6.2,railBottom:1.45,railTop:12.15,braceBottom:2.38,braceTop:12.26});
+const exposed=(mask,side)=>!!(mask&(1<<((side+4)%4)));
+const round=v=>Number(v.toFixed(9));
+// One 1.6-unit motif per post; rails keep a nearly constant texel/world scale even
+// when a corner shortens a bay. Eight periods fit the largest 14.4-unit rail.
+const inlayScale=8.75,inlayPeriod=14;
+function inlay(width,center=72){
+ // Crop whole rail periods, never half a diamond at a butt joint.
+ const periods=Math.round(width/1.8);
+ if(width>1.6)return rect('joinery_inlay',0,0,periods*16,128);
+ const pixels=Math.round(width*inlayScale);
+ return rect('joinery_inlay',center-pixels/2,0,pixels,128);
+}
+function peg(x,y){
+ const c=member([x-.17,y-.17,-7.56],[.34,.34,1.12],'wood_cross');
+ c.pivot=[x,y,-7];c.rotation=[0,0,45];
+ // A tiny maple end-grain insert, sampled from the same opaque wood atlas.
+ for(const f of ['north','south'])c.uv[f]=rect('joinery_inlay',0,18,1,1);
+ return c;
+}
+function member(origin,size,surface='stone'){
+ const c=box(origin.map(round),size.map(round),surface);
+ for(const uv of Object.values(c.uv))uv.uv_size=uv.uv_size.map(v=>Math.min(128,v));return c;
+}
+function turn(c,side){
+ const out=rotateCube(c,side);
+ if(c.rotation){const [x,y,z]=c.rotation;out.rotation=side===1?[-z,y,x]:side===2?[-x,y,-z]:side===3?[z,y,-x]:[x,y,z];}
+ return out;
+}
+function brace(a,b,z){
+ const x=(a[0]+b[0])/2,y=(a[1]+b[1])/2,length=Math.hypot(b[0]-a[0],b[1]-a[1]);
+ const c=member([x-length/2,y-.42,z],[length,.84,.48],'wood_cross');
+ c.pivot=[x,y,z+.24];c.rotation=[0,0,round(Math.atan2(b[1]-a[1],b[0]-a[0])*180/Math.PI)];return c;
+}
+function post(corner){
+ const x=corner?-7.8:-8,w=corner?1.6:.8,z=-7.8,d=1.6;
+ const shaft=member([x+(corner?.12:0),1.4,z+.12],[w-(corner?.24:.12),10.75,d-.24]);
+ const foot=member([x,0,z],[w,1.4,d],'wood_cross');
+ const cap=member([x,12.15,z],[w,2.05,d],'wood_cross');
+ // A single diamond on a capital; feet retain only the two quiet filets.
+ // Shared half posts crop complementary halves of one complete motif.
+ for(const f of ['north','south','east','west']){
+  foot.uv[f]=rect('joinery_inlay',0,0,1,128);
+  shaft.uv[f]=rect('stone',0,0,12,86);
+  cap.uv[f]=inlay(1.6);
+ }
+ if(!corner){
+  cap.uv.north=inlay(.8,72-inlayPeriod/4);cap.uv.south=inlay(.8,72+inlayPeriod/4);
+  shaft.uv.north=rect('stone',0,0,6,86);shaft.uv.south=rect('stone',6,0,6,86);
+  // The face at the module cut is internal, so emit neither duplicate cap.
+  for(const c of [foot,shaft,cap])delete c.uv.west;
+ }
+ return [foot,shaft,cap];
+}
+function mirror(c){
+ const out=structuredClone(c);out.origin[0]=round(-c.origin[0]-c.size[0]);
+ const e=out.uv.east,w=out.uv.west;delete out.uv.east;delete out.uv.west;if(e)out.uv.west=e;if(w)out.uv.east=w;
+ // Reflection exchanges the front/back UV halves; the complete shared post
+ // matches a corner's continuous grain/motif rather than repeating a half.
+ const n=out.uv.north,s=out.uv.south;if(n)out.uv.south=n;if(s)out.uv.north=s;
+ return out;
+}
+export function crossbraceArchitecture(edges=15){
+ if(!Number.isInteger(edges)||edges<0||edges>15)throw Error('Invalid Cruzeta contour');
+ const bones=[],add=(name,cubes)=>bones.push({name,cubes});
+ for(let side=0;side<4;side++){
+  if(!exposed(edges,side))continue;
+  const left=exposed(edges,side+3),right=exposed(edges,side+1);
+  if(left)add(`crossbrace_corner_${side}`,post(true).map(c=>turn(c,side)));
+  else add(`crossbrace_half_${side}_left`,post(false).map(c=>turn(c,side)));
+  if(!right)add(`crossbrace_half_${side}_right`,post(false).map(mirror).map(c=>turn(c,side)));
+  const a=left?-6.2:-7.2,b=right?6.2:7.2;
+  const top=member([a,12.15,-7.62],[b-a,2.05,1.24],'wood_cross');
+  const bottom=member([a-.12,1.45,-7.5],[b-a+.24,1.05,1],'wood_cross');
+  top.uv.north=inlay(b-a,64);top.uv.south=inlay(b-a,64);
+  // Two offset half-depth members meet at a common plane and are joined
+  // with a through-peg. This is a pegged double-layer X, not a local half-lap.
+  const inset=.14,lo=crossbraceProfile.braceBottom,hi=crossbraceProfile.braceTop;
+  const diagonalA=brace([a-inset,lo],[b+inset,hi],-7.48);
+  const diagonalB=brace([a-inset,hi],[b+inset,lo],-7);
+  add(`crossbrace_bay_${side}`,[top,bottom,diagonalA,diagonalB,peg((a+b)/2,(lo+hi)/2)].map(c=>turn(c,side)));
+ }
+ return {bones};
+}
+export function crossbraceCollision(edges){
+ // One narrow perimeter frame envelope per exposed face, plus the slab.
+ // Unlike a full cube, the centre of the table is free. AABB envelopes are
+ // deliberately conservative across the diagonal openings, like trestles.
+ const result=[{origin:[-8,14.2,-8],size:[16,1.8,16]}];
+ for(let side=0;side<4;side++)if(exposed(edges,side)){
+  const c=rotateCube({origin:[-8,0,-7.8],size:[16,14.2,1.6],uv:{}},side);
+  result.push({origin:c.origin,size:c.size});
+ }
+ return result;
+}
diff --git a/addons/altare/docs/CROSSBRACE_0.12.0.md b/addons/altare/docs/CROSSBRACE_0.12.0.md
new file mode 100644
index 0000000..f520c7e
--- /dev/null
+++ b/addons/altare/docs/CROSSBRACE_0.12.0.md
@@ -0,0 +1,59 @@
+# Cruzeta em nogueira — 0.12.0
+
+Registro da primeira revisão. A revisão diagnóstica atual e seu reteste estão em [Polimento 0.12.1](CROSSBRACE_0.12.1.md).
+
+## Intenção e construção
+
+O oitavo modelo é uma mesa de marcenaria aberta. Não é uma recoloração da Arca ou uma variação dos Balaústres: cada vão tem travessa superior, travessa inferior e diagonais em X. Pés e cabeças escalonadas enquadram os montantes verticais. A nogueira escura recebe filetes e pequenos losangos de madeira clara, sem ouro ou emissividade, na travessa superior e nos encaixes.
+
+A construção vive em `assets-src/atelier/crossbrace-model.mjs`. Somente o contorno exposto recebe estrutura; uma quina usa um único montante. Em trechos contínuos, cada célula contribui com meio montante, formando uma junta compartilhada. Os veios permanecem verticais nos montantes e horizontais nas travessas/diagonais antes da rotação. As duas diagonais ocupam metades adjacentes da profundidade, com plano de encontro comum, sem duas faces exteriores coplanares no cruzamento. Não se declara uma simulação física de marcenaria.
+
+O tampo termina exatamente em y=16. A estrutura é idêntica sob todos os tecidos. A marchetaria é um mapa autoral procedural de 64², derivado no build; mapas das famílias anteriores não mudam. Textura de madeira e objetos litúrgicos não são imagens inventadas para o render: a prévia usa os arquivos distribuídos.
+
+## Estado e compatibilidade
+
+- 17 novos IDs: `altare:j_crossbrace_*` e `altare:u_crossbrace_walnut_*_none`. Não muda UUID, nome ou significado de qualquer estado anterior.
+- Dez desenhos de toalha e oito cores do Floral IHS. Sem aplique adicional; material fixo nogueira.
+- Sem toalha usa o codec simétrico já existente: somente `altare:edges`, 16 estados. A direção tem significado apenas quando uma toalha direcional é escolhida.
+- O leitor do codec simétrico deriva o material do design. Colunata continua mármore/0; Cruzeta usa nogueira/2. A ordem dos sete modelos antigos no editor é preservada; Cruzeta é acrescentada ao final.
+- Altare passa de 78.432 a **80.000** estados. A economia de 48 estados no novo bare impede ultrapassar o teto de 80.000; o teto não foi elevado. Com Aspergillum local: **89.744**, abaixo do teto diagnóstico de 90.000, mas acima da referência global de 65.536. Outros add-ons não estão incluídos.
+- A colisão possui até cinco caixas: tampo e até quatro envoltórias estreitas dos quadros. O centro está livre. Os pequenos vãos entre diagonais têm colisão conservadora, não recorte físico fino. Seleção conserva o cubo completo.
+- As geometrias novas usam no máximo **46 cubos e 211 faces**, abaixo do teto de 50 cubos por módulo, inclusive no isolado vestido. Não se acrescenta exceção de complexidade ao validador.
+- Mapas únicos: 33,2255859375 MiB antes de mipmaps/ícones, abaixo do teto existente de 33,25 MiB.
+
+Mundos anteriores só recebem a família após aplicar a ferramenta. Downgrade após colocar os novos IDs não é seguro: voltar ao acabamento anterior antes de remover a 0.12.0, sempre em cópia do mundo. O add-on não captura nem recria objetos acima da mensa.
+
+## Verificação reproduzível
+
+Na raiz:
+
+```
+npm --prefix addons/altare run check
+npm --prefix addons/altare run package
+node addons/altare/tools/capture-cpu.mjs
+```
+
+`crossbrace.node.ts` verifica orçamento, 17 acabamentos, codec simétrico, 16 contornos, dimensões de 1×1 a 16×8, quatro frentes, invariância sob dez tecidos, caixas de colisão e vértices rotacionados. Os testes existentes de marcenaria, editor e tecido incluem a nova família. O Estúdio 2.3.0 oferece dois presets: madeira exposta e linho curto.
+
+A prévia alternativa requer Python 3 com NumPy/Pillow e usa o adaptador geométrico compartilhado do projeto, incluindo transformações/UV reais, seguido de rasterização CPU. É **prévia técnica externa**, com iluminação simplificada e somente cor: não usa WebGL, PBR, iluminação nativa ou paridade Minecraft. O renderer oficial Chromium não pôde iniciar por restrição do ambiente; a restrição não foi contornada. Os manifests preservam os hashes dos modelos e mapas utilizados.
+
+## Resultados desta revisão
+
+- 108 testes Altare, 107 testes Aspergillum e 84 testes viewer aprovados; tipos, documentação e build aprovados.
+- Creator Tools no alvo 1.26.40: zero erros, zero avisos inesperados e 2.084 avisos limitados das famílias anteriores. Cruzeta não usa a exceção de complexidade. As consultas npm devolveram 502; a checagem foi offline, complementada pelos tipos estáveis instalados.
+- Os 397 blocos, 4.108 geometrias e 258 arquivos de textura anteriores são byte a byte idênticos à baseline. Os 78.432 estados antigos decodificam de modo idêntico; 1.568 estados novos e 25.088 reparos de contorno passaram.
+- Os 5.393 arquivos do pacote correspondem aos gerados. As 38 fontes de geometria/mapas das prévias correspondem ao pacote final.
+
+## Reteste no Minecraft
+
+1. Fazer uma cópia do mundo. Importar somente BP/RP Altare **[0,12,0]**, sem revisão concorrente, no alvo mínimo 1.26.40; sem experimentos.
+2. `/function altare/dev_kit`. Montar 1×1, 3×2, 7×2 e 8×2. Abrir Acabamento do altar e selecionar Cruzeta.
+3. Sem toalha: observar frente, verso, quatro quinas, interior e underside. Conferir cruzamentos sem cintilação, nenhuma duplicação de montantes e continuidade das travessas.
+4. Alternar todas as dez toalhas, principalmente linho curto, renda e Floral IHS verde/roxo. Conferir o verso do tecido através do quadro, centro ímpar e dois meios centros no par.
+5. Colocar pedra vanilla e caldeirinha sobre a mensa. Trocar de/para modelos antigos, aplicar, cancelar, restaurar e reabrir. Objetos superiores devem permanecer no lugar.
+6. Testar quatro frentes, remoção/reposição de módulos, salvar/reabrir e multiplayer. Reaplicar depois de redimensionar para recentralizar a toalha.
+7. Conferir luz através da mesa, colisão conservadora dos quadros, apoio do tampo, Content Log sem novos erros e profiling no dispositivo-alvo.
+
+Se a consulta de versão do Creator Tools falhar mesmo em `--offline`, o CLI pode cair no fallback 1.26.0 e rejeitar até arquivos já publicados. Neste ambiente, a validação é repetida com a opção existente `MCT_TEST_PINNED_MC_VERSION=1.26.40`, fixando o alvo declarado no manifest. Isso não altera schemas, arquivos ou a política de avisos.
+
+Build e validação offline não substituem essa etapa. A versão continua diagnóstica e não é promovida como fisicamente aprovada sem o teste do arquivo exato.
diff --git a/addons/altare/docs/CROSSBRACE_0.12.1.md b/addons/altare/docs/CROSSBRACE_0.12.1.md
new file mode 100644
index 0000000..1516119
--- /dev/null
+++ b/addons/altare/docs/CROSSBRACE_0.12.1.md
@@ -0,0 +1,53 @@
+# Cruzeta: juntas e marchetaria — 0.12.1
+
+Revisão da [primeira construção](CROSSBRACE_0.12.0.md), após comparação visual de frente, costas, quinas e encontros de módulos. O diagnóstico anterior não foi publicado nem aprovado no Minecraft.
+
+## Alterações justificadas pela inspeção
+
+1. **Marchetaria proporcional.** Na primeira versão, o mesmo recorte de quatro losangos ocupava tanto a travessa larga como a cabeça estreita. Agora cada cabeça tem um motivo legível; os pés conservam apenas dois filetes. Travessas usam períodos completos, sem cortar um losango na ponta. A densidade horizontal fica dentro de 5% da referência do apoio, inclusive quando uma quina encurta o vão. O atlas continua 64², com oito períodos alinhados à grade de pixels. O material continua madeira opaca, sem metal ou emissão.
+2. **Apoios simétricos e juntas fechadas.** O fuste de quina recua 0,12 unidade em todas as quatro faces e passa a ter seção 1,36 × 1,36. As travessas inferiores avançam os mesmos 0,12 até a face real do apoio. Meios montantes continuam compartilhados; UVs complementares recompõem o veio e o motivo completos. Faces internas das meias colunas não são emitidas.
+3. **X duplo cavilhado.** As diagonais continuam em camadas adjacentes de meia profundidade. Uma pequena cavilha de madeira, centrada no cruzamento, atravessa ambas e dá leitura de junção. Não é descrito como meia-madeira localizada nem como simulação física. Fazer o rebaixo localizado integral exigiria mais peças; não se elevou o orçamento para isso.
+
+A mensa, sua altura y=16, os dez tecidos e seus recortes não mudam. O tampo não recebe um chanfro especulativo. Nas imagens CPU inspecionadas, o afastamento do tecido e as quinas continuam legíveis; iluminação, culling nativo e comportamento em movimento ainda exigem o jogo.
+
+## Contratos e custo
+
+- Mesmos 414 blocos, 4.700 geometrias, 17 acabamentos Cruzeta e 80.000 estados Altare.
+- Nenhuma mudança de UUID, codec, state, colisão, aplicação/rollback ou preservação de objetos sobre a mensa.
+- Cruzeta usa até 50 cubos e 235 faces. O teto de 50 é preservado, sem nova exceção de complexidade.
+- Mesmos 33,2255859375 MiB de mapas únicos; só o trio novo `crossbrace_inlay` muda visualmente. Mapas das outras famílias são preservados.
+- Aspergillum permanece 1.2.5; Estúdio permanece 2.3.0 e consome os novos recursos pelo catálogo/hash gerado.
+
+## Verificação reproduzível
+
+```
+npm --prefix addons/altare run check
+HOME=/tmp/altare-creator-home MCT_TEST_PINNED_MC_VERSION=1.26.40 node addons/altare/tools/package.mjs
+python addons/altare/tools/cpu-rasterize.py --test-camera
+node addons/altare/tools/capture-cpu.mjs --matrix
+```
+
+O pin usa a opção existente do Creator Tools e o alvo declarado, porque a consulta de versão offline havia caído indevidamente no fallback 1.26.0. Não altera schemas ou política de avisos.
+
+A matriz gera 35 PNGs: cenas principais 1×1, 3×2, 7×2 e 8×2; todos os dez tecidos e oito cores Floral IHS; quatro frentes; junção frontal/traseira, rasantes frente/verso, vista inferior, 1×3, 2×2 e lateral com linho longo. `--only <id>` permite repetir uma cena; `--out <diretório>` conserva comparações. Os manifests registram hashes dos arquivos de geometria/mapas realmente consumidos.
+
+A revisão independente detectou que a primeira câmera CPU espelhava horizontalmente a projeção inteira. A base foi corrigida apenas no capturador: norte projeta +X à esquerda, sul projeta +X à direita, e +Y continua para cima. Um teste de cinco bases ortonormais com determinante +1 protege essa convenção. Nenhuma arte/UV do tecido distribuído foi invertida para compensar a prévia.
+
+A ferramenta CPU mantém o mesmo adaptador geométrico do projeto e suas UVs. Não executa Chromium, GPU ou PBR, e não prova paridade Bedrock. O Chromium continua bloqueado pelo ambiente; nenhuma restrição foi contornada.
+
+## Resultado desta rodada
+
+- 111/111 testes Altare, 107/107 Aspergillum e 84/84 viewer; tipos, builds, documentação e validação estrutural aprovados.
+- Creator Tools no alvo 1.26.40: zero erros, zero avisos inesperados e os 2.084 avisos limitados das famílias anteriores. Cruzeta não usa exceção. As consultas de registry npm receberam 502; a validação offline é complementada pelos tipos estáveis instalados.
+- 35 PNGs finais, com 137 hashes de geometria/mapas e cinco hashes dos capturadores/adaptadores conferidos. Câmera corrigida e monogramas legíveis, revisados independentemente.
+- Todas as 414 definições de bloco e runtime são byte-idênticos à 0.12.0. Só 555 geometrias Cruzeta, seus três mapas próprios e seis arquivos de metadados de versão mudaram. Da baseline 0.11.2, todos os 397 blocos, 4.108 geometrias e 258 arquivos de textura permanecem idênticos.
+- Os 5.393 arquivos do `.mcaddon` foram comparados aos packs gerados, sem divergência. SHA-256: `5c19edfd4b2b0bf3855b9691e3b875dcb179e98b0ae1a33cef4b02970a1affb7`.
+
+## Reteste do arquivo exato no Minecraft
+
+1. Copiar o mundo, remover revisão concorrente e importar BP/RP **[0,12,1]**, no alvo mínimo 1.26.40, sem experimentos.
+2. Montar 1×1, 2×1, 3×2, 7×2 e 8×2. Examinar frente, verso, quinas e parte inferior: filetes contínuos, um apoio por junta, fustes simétricos, cavilhas centrais e nenhum brilho/cintilação de faces.
+3. Alternar todas as dez toalhas e as quatro frentes; conferir oito cores Floral IHS, seu centro ímpar e centro dividido par. Olhar o verso do tecido através do quadro.
+4. Trocar modelos, aplicar/cancelar/restaurar, remover/repor módulos e salvar/reabrir. Objetos acima da mensa devem permanecer. Testar colisão estreita conservadora, multiplayer, Content Log e desempenho no dispositivo-alvo.
+
+Só essa importação permite encerrar o gate visual/físico. A revisão continua diagnóstica.
diff --git a/addons/altare/docs/EDITOR_CHOICES_0.12.3.md b/addons/altare/docs/EDITOR_CHOICES_0.12.3.md
