import bpy,json,pathlib,math
from mathutils import Vector
D=pathlib.Path(__file__).parent
geo=json.loads((D/'paz_v75_voxel.geo.json').read_text())
bpy.ops.object.select_all(action='SELECT');bpy.ops.object.delete(use_global=False)
mats=[]
for name,col in [('Stone',(.63,.62,.59,1)),('Base',(.47,.45,.41,1))]:
 m=bpy.data.materials.new(name);m.diffuse_color=col;mats.append(m)
vs=[];fs=[];mi=[]
for c in geo['minecraft:geometry'][0]['bones'][0]['cubes']:
 # Invert JSON mapping to Blender: x=-bedrockX, y=-bedrockZ, z=bedrockY.
 o=c['origin'];s=c['size'];i=len(vs)
 for z in (0,1):
  for y in (0,1):
   for x in (0,1):vs.append((-(o[0]+x*s[0])/16,-(o[2]+y*s[2])/16,(o[1]+z*s[1])/16))
 for face in [(0,1,3,2),(4,6,7,5),(0,4,5,1),(2,3,7,6),(0,2,6,4),(1,5,7,3)]:fs.append(tuple(i+j for j in face));mi.append(0 if c['uv']['north']['uv'][0]==2 else 1)
mesh=bpy.data.meshes.new('Reconstructed exported cuboids');mesh.from_pydata(vs,[],fs);mesh.update();obj=bpy.data.objects.new('V75 voxel JSON reconstruction',mesh);bpy.context.collection.objects.link(obj)
for m in mats:mesh.materials.append(m)
for p,m in zip(mesh.polygons,mi):p.material_index=m
scene=bpy.context.scene;scene.render.engine='CYCLES';scene.cycles.samples=24;scene.cycles.use_denoising=False
scene.render.resolution_x=900;scene.render.resolution_y=1000;scene.render.resolution_percentage=100
scene.world.color=(.18,.18,.18)
bpy.ops.object.camera_add();cam=bpy.context.object;cam.data.type='ORTHO';cam.data.ortho_scale=4.5;scene.camera=cam
for pos,power,size in [((3,-4,6),600,4),((-3,-1,3),350,3),((1,3,5),500,3)]:
 bpy.ops.object.light_add(type='AREA',location=pos);light=bpy.context.object;light.data.energy=power;light.data.shape='DISK';light.data.size=size;light.rotation_euler=(Vector((0,0,1.8))-light.location).to_track_quat('-Z','Y').to_euler()
scene.view_settings.view_transform='AgX'
for name,pos in [('front',(0,-8,2.2)),('three_quarter',(5,-8,3.5)),('back',(0,8,2.2))]:
 cam.location=pos;cam.rotation_euler=(Vector((0,0,1.9))-cam.location).to_track_quat('-Z','Y').to_euler();scene.render.filepath=str(D/(name+'_offline.png'));bpy.ops.render.render(write_still=True)
bpy.ops.wm.save_as_mainfile(filepath=str(D/'voxel_reconstruction.blend'))
