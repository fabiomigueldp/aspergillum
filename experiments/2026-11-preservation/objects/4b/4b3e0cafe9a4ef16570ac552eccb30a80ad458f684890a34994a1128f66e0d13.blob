from pathlib import Path
import numpy as np,json,hashlib
R=Path(__file__).resolve().parents[2];E=R/'lateral_v7/evidence';O=R/'lateral_v7/adaptive_patch'
a=np.load(O/'adaptive-consistent-assembly.npz');base=np.load(R/'integration_v6/evidence/seam-hermite-physical-7p5-assembly.npz');old=np.load(E/'director-cone-midfield.npz');mid=old;field=np.load(E/'offset-reach-field.npz');ids=a['source_indices'];where={int(s):i for i,s in enumerate(ids)};source=~a['generated_vertices'];gen=old['generated_pair_indices'];outer=np.array([where[int(s)] for s in old['outer_source_ids']]);inner=np.array([where[int(s)] for s in old['inner_source_ids']]);center=(a['points'][outer]+a['points'][inner])/2;dv=(a['points'][inner]-a['points'][outer])/2;half=np.linalg.norm(dv,axis=1);director=dv/half[:,None];tri=mid['triangles'];normal=np.cross(center[tri[:,1]]-center[tri[:,0]],center[tri[:,2]]-center[tri[:,0]]);normal/=np.linalg.norm(normal,axis=1)[:,None];cos=np.einsum('ij,ikj->ik',normal,director[tri]);cos*=np.sign(np.median(cos));central=gen[(old['uv'][gen,1]>=.2)&(old['uv'][gen,1]<=.8)];ci=np.r_[outer[central],inner[central]];disp=np.linalg.norm(a['points']-base['points'],axis=1);cd=np.linalg.norm(center-old['center'],axis=1);angle=np.degrees(np.arccos(np.clip((director*old['original_director']).sum(1),-1,1)))
restr=[]
for face in [10958,10959,10976]:
 q=a['points'][a['triangles'][face]];n=np.cross(q[1]-q[0],q[2]-q[0]);n/=np.linalg.norm(n)
 for sid in [186439,186440]:
  v=where[sid];margin=float((a['points'][v]-q[0])@n);restr.append(dict(mantle_face=face,generated_outer_source_id=sid,final_signed_support_distance_mm=margin*1000,meets_requested_0p2mm=margin>=.0002-1e-12))
parts=[]
for part,name in [(0,'cap'),(2,'mantle')]:
 ff=a['triangles'][a['face_parts']==part];vv=np.unique(ff);parts.append(dict(part=name,faces=int(len(ff)),source_face_indices_identical=bool(np.array_equal(ff,base['triangles'][base['face_parts']==part])),positions_bitwise_identical=bool(np.array_equal(a['points'][vv],base['points'][vv])),normals_bitwise_identical=bool(np.array_equal(a['normals'][vv],base['normals'][vv]))))
report={'candidate_sha256':hashlib.sha256((O/'adaptive-consistent-assembly.npz').read_bytes()).hexdigest(),'vertices':len(ids),'triangles':len(a['triangles']),'all_source_ids_identical':bool(np.array_equal(ids,base['source_indices'])),'all_triangles_identical':bool(np.array_equal(a['triangles'],base['triangles'])),'all_face_parts_identical':bool(np.array_equal(a['face_parts'],base['face_parts'])),'all_source_positions_bitwise_identical':bool(np.array_equal(a['points'][source],base['points'][source])),'all_source_normals_bitwise_identical':bool(np.array_equal(a['normals'][source],base['normals'][source])),'parts':parts,'central_wall_vertices':len(ci),'central_wall_positions_bitwise_identical':bool(np.array_equal(a['points'][ci],base['points'][ci])),'central_wall_max_displacement_mm':float(disp[ci].max()*1000),'original_half_thickness_max_error':float(np.max(abs(half-old['half_thickness']))),'full_thickness_generated_min_max_mm':[float(half[gen].min()*2000),float(half[gen].max()*2000)],'shell_max_displacement_mm':float(disp.max()*1000),'shell_max_displacement_source_id':int(ids[np.argmax(disp)]),'center_max_displacement_mm':float(cd.max()*1000),'generated_director_angle_change_max_degrees':float(angle[gen].max()),'mixed_director_faces':int(((cos.min(1)<0)&(cos.max(1)>0)).sum()),'nonpositive_director_products':int((cos<=0).sum()),'min_director_face_cosine':float(cos.min()),'obstacle_support_constraints':restr,'limits':['Strict-crossing gate is not a tangency, coplanar-overlap, minimum-clearance or geometric fidelity certificate.','This review includes whole 12484-face cap/bridge/mantle assembly, not other head/body objects or game export.','Six final support-plane constraints checked directly; this is not a global clearance certificate.']}
(E/'adaptive-consistent-independent-invariants.json').write_text(json.dumps(report,indent=2));print(json.dumps(report,indent=2))
