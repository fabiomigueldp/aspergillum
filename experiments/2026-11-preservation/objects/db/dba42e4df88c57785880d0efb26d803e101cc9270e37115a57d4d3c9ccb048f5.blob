  "sampling_caveats": [
    "Face-grid area weighting is not uniform: reported quantiles are deterministic sample quantiles, not area percentiles.",
    "Strictly interior removal excludes hidden cube faces but does not form a Boolean union mesh. Coplanar shared faces may remain sampled.",
    "Nearest-point operation uses actual native triangles in Blender BVH float precision; no vertex KD surrogate.",
    "No game rendering, runtime performance, normalmap or artistic approval."
  ],
  "native_normal_ray_baseline_correction": {
    "method": "Each exact same outward normal ray is cast against native V13 triangles first. Candidate-minus-native first-entry depth removes self-occlusion already present in native. Raw offsets relative to the originating point include large inherited offsets and MUST NOT be interpreted as local surface error.",
    "native_ray_misses": 0,
