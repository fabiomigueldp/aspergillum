import bpy,numpy as np,json,hashlib,sys
from pathlib import Path
from mathutils import Vector
O=Path(__file__).resolve().parent;B=O.parents[1];D=B/'lit_surface_v16/transparent_trim';rows=[];tags=sys.argv[sys.argv.index('--')+1:]if '--'in sys.argv else ['roi68-depth1','roi68-depth2','roi68-depth3'];basealpha=np.load(O/'alpha-quads.npy');T=np.load(B/'opaque_transport_v15/shared_mask/transport_arrays.npz');maps={p:np.flatnonzero(T['part']==p)for p in [0,1,15]}
for tag in tags:
 path=B/'lit_surface_v16/evidence'/(tag+'-diagnostic.blend');before=hashlib.sha256(path.read_bytes()).hexdigest();bpy.ops.wm.open_mainfile(filepath=str(path));s=bpy.context.scene;cam=s.camera;cam.location=(.035,-3.5,3.58);cam.rotation_euler=(Vector((.035,-.30,3.58))-cam.location).to_track_quat('-Z','Y').to_euler();cam.data.ortho_scale=.52;s.render.resolution_x=s.render.resolution_y=1000;bpy.context.view_layer.update();R=np.array(cam.matrix_world.to_3x3(),dtype=np.float64);C=np.array(cam.location,dtype=np.float64);mapping=np.load(D/(tag+'-cube-map.npz'));mappart={p:mapping['original_cube_index'][mapping['part']==p]for p in np.unique(mapping['part'])};arrays={k:[]for k in ['triangles','uv','part','polygon','local_triangle','polygon_normal','corner_normal','loop_triangle_normal','masked','native_face','half','original_cube_index']};objs=[];seenimage=False
 for ob in sorted((ob for ob in s.objects if ob.type=='MESH'),key=lambda ob:ob.name):
  me=ob.data;me.calc_loop_triangles();part=int(ob.name.split()[0].split('_')[1]);M=np.array(ob.matrix_world);co=np.array([v.co[:]for v in me.vertices]);co=co@M[:3,:3].T+M[:3,3];ti=np.array([t.vertices[:]for t in me.loop_triangles]);li=np.array([t.loops[:]for t in me.loop_triangles]);pi=np.array([t.polygon_index for t in me.loop_triangles]);nt=len(ti);uv=np.array([l.uv[:]for l in me.uv_layers.active.data]);pn=np.array([p.normal[:]for p in me.polygons]);cn=np.array([n.vector[:]for n in me.corner_normals]);tn=np.array([t.normal[:]for t in me.loop_triangles]);mat=me.materials[0];masked=any(l.from_socket.name=='Alpha'for l in mat.node_tree.links)
  if not seenimage:
   im=next(n.image for n in mat.node_tree.nodes if n.type=='TEX_IMAGE');image=np.empty(len(im.pixels),np.float32);im.pixels.foreach_get(image);aa=image.reshape(im.size[1],im.size[0],4)[:,:,3];assert np.array_equal(aa,basealpha);seenimage=True
  orig=mappart[part][pi]if part in maps else pi.copy();nf=T['native_face'][maps[part][orig]]if part in maps else pi.copy();half=T['half'][maps[part][orig]]if part in maps else np.full(nt,-1)
  for k,v in {'triangles':co[ti],'uv':uv[li],'part':np.full(nt,part),'polygon':pi,'local_triangle':np.arange(nt),'polygon_normal':pn[pi]@M[:3,:3].T,'corner_normal':cn[li]@M[:3,:3].T,'loop_triangle_normal':tn@M[:3,:3].T,'masked':np.full(nt,masked),'native_face':nf,'half':half,'original_cube_index':orig}.items():arrays[k].append(v)
  objs.append({'name':ob.name,'polygons':len(me.polygons),'triangles':nt,'all_flat':not any(p.use_smooth for p in me.polygons),'material':mat.name})
 a={k:np.concatenate(v)for k,v in arrays.items()};a.update(camera_origin=C,camera_rotation=R,camera_scale=np.array(cam.data.ortho_scale));np.savez_compressed(O/(tag+'-renderer-inputs.npz'),**a);rows.append({'tag':tag,'source':str(path),'sha256_before':before,'sha256_after':hashlib.sha256(path.read_bytes()).hexdigest(),'all_packed_alpha_equal_to_original':True,'objects':objs,'triangle_count':len(a['triangles']),'camera_clip_start':cam.data.clip_start});print(tag,len(a['triangles']),flush=True)
(O/('trim-renderer-inputs-'+tags[0]+'.json')).write_text(json.dumps(rows,indent=2))
