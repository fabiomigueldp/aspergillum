"""Independent topology/provenance/contact/thickness sampling for rebuilt V11.
Run Blender --python this.py -- CANDIDATE TAG. Read-only inputs; outputs here.
"""
from pathlib import Path
import sys,json,hashlib,itertools,time
import numpy as np
from collections import defaultdict,Counter
from mathutils.bvhtree import BVHTree
from mathutils import Vector
from scipy.spatial import cKDTree
sys.dont_write_bytecode=True
O=Path(__file__).resolve().parent;B=O.parents[1]
args=sys.argv[sys.argv.index('--')+1:];path=Path(args[0]).resolve();tag=args[1]
basepath=B/'lateral_v7/adaptive_patch/adaptive-consistent-assembly.npz';ap=B/'body_interface_v9/constrained_fit/retained-anatomy.npz';bp=B/'shell_band_v5/retained_candidate/evidence/band-paired.npz';locked=[basepath,ap,bp]
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest();hash0={str(p.relative_to(B)):sha(p) for p in locked}
d=np.load(path);s=np.load(basepath);a=np.load(ap);b=np.load(bp);p=d['points'];f=d['triangles'];p0=s['points'];f0=s['triangles'];part=d['face_parts'];role=d['face_roles'];vf=d['baseline_vertex_indices'];ff=d['baseline_face_indices'];new=part==3;prov=json.loads(str(d['provenance']));cutter=np.load(path.parent/prov['cutter'])
raw=np.cross(p[f[:,1]]-p[f[:,0]],p[f[:,2]]-p[f[:,0]]);dblarea=np.linalg.norm(raw,axis=1);norm=raw/np.maximum(dblarea[:,None],1e-300);area=dblarea/2
edges=defaultdict(list);links=defaultdict(list);vfaces=defaultdict(list)
for i,t in enumerate(f):
 for k in range(3):
  x,y=int(t[k]),int(t[(k+1)%3]);edges[tuple(sorted((x,y)))].append((x,y,i));links[x].append((int(t[(k+1)%3]),int(t[(k+2)%3])));vfaces[x].append(i)
adj=set();badlinks=[]
for v,fs in vfaces.items():adj.update(itertools.combinations(fs,2))
for v,es in links.items():
 g=defaultdict(set)
 for x,y in es:g[x].add(y);g[y].add(x)
 seen=set();todo=[next(iter(g))]
 while todo:
  x=todo.pop()
  if x not in seen:seen.add(x);todo.extend(g[x]-seen)
 if len(seen)!=len(g) or any(len(ns)!=2 for ns in g.values()):badlinks.append(v)
nei=defaultdict(set)
for x,y in edges:nei[x].add(y);nei[y].add(x)
left=set(range(len(p)));components=[]
while left:
 seen=set();todo=[next(iter(left))]
 while todo:
  x=todo.pop()
  if x not in seen:seen.add(x);todo.extend(nei[x]-seen)
 left-=seen;fi=np.flatnonzero(np.any(np.isin(f,list(seen)),1));components.append({'vertices':len(seen),'faces':len(fi),'signed_volume_m3':float(np.einsum('ij,ij->i',p[f[fi,0]],np.cross(p[f[fi,1]],p[f[fi,2]])).sum()/6)})
tree=BVHTree.FromPolygons(p.tolist(),f.tolist(),all_triangles=True,epsilon=0)
def hits(v1,f1,v2,f2,pairs):
 if not len(pairs):return pairs,np.zeros((0,3)),np.zeros(0,int)
 aa=v1[f1[pairs[:,0]]];bb=v2[f2[pairs[:,1]]];hit=np.zeros(len(pairs),bool);pts=[];pointpairs=[]
 for orig,tar in [(aa,bb),(bb,aa)]:
  e1,e2=tar[:,1]-tar[:,0],tar[:,2]-tar[:,0]
  for k in range(3):
   pp=orig[:,k];dr=orig[:,(k+1)%3]-pp;h=np.cross(dr,e2);det=np.einsum('ij,ij->i',e1,h);valid=abs(det)>1e-12*np.linalg.norm(e1,axis=1)*np.linalg.norm(e2,axis=1)*np.linalg.norm(dr,axis=1);den=np.where(valid,det,1);ss=pp-tar[:,0];u=np.einsum('ij,ij->i',ss,h)/den;q=np.cross(ss,e1);vv=np.einsum('ij,ij->i',dr,q)/den;tt=np.einsum('ij,ij->i',e2,q)/den;ok=valid&(tt>1e-8)&(tt<1-1e-8)&(u>1e-8)&(vv>1e-8)&(u+vv<1-1e-8);hit|=ok;pts.extend((pp+tt[:,None]*dr)[ok].tolist());pointpairs.extend(np.flatnonzero(ok).tolist())
 return pairs[hit],np.array(pts,float).reshape(-1,3),np.array(pointpairs,int)
bvh=set(tuple(sorted((i,j))) for i,j in tree.overlap(tree) if i!=j);allpairs=np.array(sorted(bvh|adj),int);cross,wpts,wi=hits(p,f,p,f,allpairs);shared=np.array([len(set(f[i])&set(f[j])) for i,j in cross]);print('self',len(cross),'adj tested',len(adj),flush=True)
quality={};lens=np.linalg.norm(p[f[:,[1,2,0]]]-p[f],axis=2);angles=[]
for k in range(3):
 x=p[f[:,(k+1)%3]]-p[f[:,k]];y=p[f[:,(k+2)%3]]-p[f[:,k]];angles.append(np.degrees(np.arctan2(np.linalg.norm(np.cross(x,y),axis=1),np.einsum('ij,ij->i',x,y))))
minangle=np.min(angles,axis=0);aspect=lens.max(1)**2/np.maximum(dblarea,1e-300)
for label,mask in [('whole',np.ones(len(f),bool)),('new_rim',new),('trimmed_source',role==1),('unchanged_source',role==0)]:
 quality[label]={'faces':int(mask.sum()),'area_mm2_percentiles':np.percentile(area[mask]*1e6,[0,1,5,50,95,99,100]).tolist(),'minimum_angle_degrees_percentiles':np.percentile(minangle[mask],[0,1,5,50,95,99,100]).tolist(),'max_edge_over_min_altitude_percentiles':np.percentile(aspect[mask],[0,50,95,99,100]).tolist(),'min_angle_under_1_degree_faces':int((mask&(minangle<1)).sum()),'min_angle_under_0_1_degree_faces':int((mask&(minangle<.1)).sum())}
exact=np.flatnonzero(role==0);exactfails=[];orientationfails=[]
for i in exact:
 parent=f0[ff[i]];mapped=vf[f[i]]
 if not any(np.array_equal(mapped,np.roll(parent,k)) for k in range(3)):exactfails.append(int(i))
for i in np.flatnonzero(ff>=0):
 tr=p0[f0[ff[i]]];n=np.cross(tr[1]-tr[0],tr[2]-tr[0]);
 if norm[i]@n<=0:orientationfails.append(int(i))
parent_dist=[];parent_bary=[]
for i in np.flatnonzero(role==1):
 tr=p0[f0[ff[i]]];A=np.stack([tr[1]-tr[0],tr[2]-tr[0]],1);uv=np.linalg.lstsq(A,(p[f[i]]-tr[0]).T,rcond=None)[0].T;recon=tr[0]+uv@A.T;parent_dist.extend(np.linalg.norm(recon-p[f[i]],axis=1).tolist());parent_bary.extend(np.c_[1-uv.sum(1),uv].tolist())
# Is every removed/trimmed old face actually intersected by one cutter volume?
def clip(tr,pl):
 poly=list(tr)
 for n in pl:
  if not len(poly):return []
  out=[]
  for x,y in zip(poly,poly[1:]+poly[:1]):
   dx=x@n[:3]+n[3];dy=y@n[:3]+n[3];ix=dx<=1e-10;iy=dy<=1e-10
   if ix:out.append(x)
   if ix!=iy:out.append(x+(y-x)*dx/(dx-dy))
  poly=out
 return poly
changed=np.setdiff1d(np.arange(len(f0)),ff[exact]);outside=[]
for i in changed:
 if not any(len(clip(p0[f0[i]],cutter['planes'][cutter['face_sides']==side])) for side in [-1,1]):outside.append(int(i))
rep={'candidate':str(path.relative_to(B)),'sha256':sha(path),'new_connectivity':not (len(f)==len(f0) and np.array_equal(f,f0)),'input_hashes_start':hash0,'topology':{'vertices':len(p),'triangles':len(f),'edges':len(edges),'euler':len(p)-len(edges)+len(f),'components':components,'boundary_edges':sum(len(es)==1 for es in edges.values()),'non_two_face_edges':sum(len(es)!=2 for es in edges.values()),'inconsistent_edge_winding':sum(len(es)==2 and es[0][:2]==es[1][:2] for es in edges.values()),'bad_vertex_links':badlinks,'unused_vertices':sorted(set(range(len(p)))-set(vfaces)),'duplicate_triangle_index_sets':len(f)-len(set(map(tuple,np.sort(f,axis=1)))),'degenerate_faces_under_1e_16_m2':np.flatnonzero(area<1e-16).tolist()},'self_intersection':{'bvh_candidates':len(bvh),'explicit_adjacent_pairs_tested':len(adj),'union_pairs_tested':len(allpairs),'strict_crossings':len(cross),'crossing_pairs':cross.tolist(),'shared_vertices_histogram':dict(Counter(map(int,shared))),'spatial_witness_points':len(wpts),'scale_relative_parallel_tolerance':1e-12},'quality':quality,'preservation':{'surviving_vertices':int((vf>=0).sum()),'surviving_positions_bit_exact':bool(np.array_equal(p[vf>=0],p0[vf[vf>=0]])),'new_vertices':int((vf<0).sum()),'exact_faces':len(exact),'exact_oriented_face_lineage_failures':exactfails,'inherited_faces_reversed_against_parent':orientationfails,'changed_old_faces':len(changed),'changed_old_faces_not_intersecting_cutter_volumes':outside,'trimmed_vertex_to_parent_plane_max_mm':max(parent_dist)*1000,'trimmed_vertex_barycentric_min':float(np.min(parent_bary)),'mantle_faces_exact':bool(np.all(role[part==2]==0))},'contacts':{},'limitations':['No clinical/anatomical interpretation of the coordinate ear mask.','Strict crossing tests do not certify tangencies or general coplanar overlaps.','Changed tessellation invalidates raw pair identity comparisons; contact counts and spatial witnesses are reported, not new pair claims.','Near-rim ray chord measurements are actual sampled mesh intersections, not a global positive-thickness certificate.','No alpha, normalmap, highpoly head/halo, Bedrock export or Minecraft test.']}
out={'self_pairs':cross,'self_witness_points':wpts,'self_witness_pair_indices':allpairs[wi],'face_area':area,'face_min_angle_degrees':minangle,'face_aspect':aspect}
oldw=np.array([r['point'] for r in json.loads((O/'contact-spatial-witnesses.json').read_text())]);oldtree=cKDTree(oldw)
for label,ob in [('anatomy',a),('band',b)]:
 v2=ob['points'];f2=ob['triangles'];t2=BVHTree.FromPolygons(v2.tolist(),f2.tolist(),all_triangles=True,epsilon=0);pairs=np.array(tree.overlap(t2),int).reshape(-1,2);cc,pts,idx=hits(p,f,v2,f2,pairs);r={'strict_crossing_pairs':len(cc),'unique_shell_faces':len(np.unique(cc[:,0])),'unique_obstacle_faces':len(np.unique(cc[:,1])),'by_shell_part':dict(Counter(map(int,part[cc[:,0]]))),'by_face_role':dict(Counter(map(int,role[cc[:,0]]))),'spatial_witness_points':len(pts),'spatial_box':{'min':pts.min(0).tolist(),'max':pts.max(0).tolist()} if len(pts) else None,'rim_contact_pairs':cc[new[cc[:,0]]].tolist()}
 if label=='anatomy':
  ear=np.any(a['protected_ears'][f2[cc[:,1]]],axis=1);r['incident_ear_pairs']=int(ear.sum());r['all_vertices_ear_pairs']=int(np.all(a['protected_ears'][f2[cc[:,1]]],axis=1).sum());r['witness_nearest_baseline_witness_mm_percentiles']=np.percentile(oldtree.query(pts)[0]*1000,[0,50,95,100]).tolist() if len(pts) else [];r['non_ear_pairs']=cc[~ear].tolist()
 rep['contacts'][label]=r;out[label+'_pairs']=cc;out[label+'_witness_points']=pts;out[label+'_witness_pair_indices']=pairs[idx];print(label,len(cc),'rim',len(r['rim_contact_pairs']),flush=True)
# Rim boundary segments: inherited faces that share a true rim edge, not old pair offsets.
bound=[]
for edge,es in edges.items():
 if len(es)==2 and sum(new[q[2]] for q in es)==1:
  old=next(q[2] for q in es if not new[q[2]]);rim=next(q[2] for q in es if new[q[2]]);bound.append((edge,old,rim))
samples=[];rayeps=1e-7
for edge,old,rim in bound:
 mid=p[list(edge)].mean(0);cent=p[f[old]].mean(0)
 for alpha in [.02,.1,.5,1.0]:
  pt=(1-alpha)*mid+alpha*cent;direction=-norm[old];loc,n,hitid,dist=tree.ray_cast(Vector(pt+rayeps*direction),Vector(direction),.15)
  if loc is not None:
   samples.append({'face':old,'rim_face':rim,'boundary_edge':list(edge),'alpha_to_face_centroid':alpha,'point':pt.tolist(),'hit':list(loc),'hit_face':int(hitid),'thickness_chord_mm':float((dist+rayeps)*1000),'exit_facing':float(np.dot(n,direction)),'hit_part':int(part[hitid]),'hit_is_start_face':bool(hitid==old)})
valid=[r for r in samples if not r['hit_is_start_face'] and r['exit_facing']>1e-5];vals=[r['thickness_chord_mm'] for r in valid];rep['near_rim_thickness']={'method':'From every inherited face/rim shared edge, sample at 2%,10%,50%,100% toward inherited face centroid; cast into material along that face negative normal to first shell hit. Actual rebuilt mesh, never old paired distances.','boundary_edges':len(bound),'rays_cast':4*len(bound),'hits':len(samples),'valid_exit_hits':len(valid),'ray_start_inset_mm':rayeps*1000,'valid_chord_mm_percentiles':np.percentile(vals,[0,1,5,50,95,99,100]).tolist() if vals else [],'shortest_20_samples':sorted(valid,key=lambda x:x['thickness_chord_mm'])[:20],'caution':'Normals/first-hit float32 BVH and discrete samples only; adjacent rim can bound a local chord. This is not global minimum thickness, and near a sharp corner chord can tend to zero.'}
rep['input_hashes_finish']={str(p.relative_to(B)):sha(p) for p in locked};rep['frozen_inputs_intact']=rep['input_hashes_finish']==hash0
np.savez_compressed(O/(tag+'-review-arrays.npz'),**out);(O/(tag+'-review.json')).write_text(json.dumps(rep,indent=2));(O/(tag+'-thickness-samples.json')).write_text(json.dumps(samples,indent=2));print(json.dumps({k:rep[k] for k in ['topology','self_intersection','preservation','near_rim_thickness','frozen_inputs_intact']},indent=2),flush=True)
