"""Unretained diagnostic: ONLY new tile alpha changes from conservative 0.75 to 0.
No geometry/RGB/source/material/retained-atlas changes. Does not render or fix artifacts.
"""
from pathlib import Path
import json,hashlib,gzip
import numpy as np
from PIL import Image
W=Path(__file__).resolve().parent;R=W.parent/'resource_pack';P=R/'textures/entity/paz_v75_v14_lab_sculpture.png';O=W/'alpha-center-only-trial.png';G=R/'models/entity/paz_v75_v14_lab_sculpture.geo.json'
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
# Snapshot every completed RP asset before touching the diagnostic's own destination.
oldhash={str(p.relative_to(R)):sha(p)for p in R.rglob('*')if p.is_file()}
a=np.array(Image.open(P).convert('RGBA'));trial=a.copy();data=np.load(W/'transport_arrays.npz');part=data['part'];uv=data['uv'];tr=data['triangle_bb'];quad=data['quad_size'];masks=data['mask_local'];Y,X=np.mgrid[:20,:20];counts={str(k):{'tiles':0,'old_opaque_pixels':0,'new_opaque_pixels':0,'opaque_to_transparent':0,'transparent_to_opaque':0,'exact_edge_distance_zero_samples':0}for k in [0,1,15]}
for i in range(len(part)):
 tx,ty=uv[i];p=tr[i];u=p[1]-p[0];w=np.linalg.norm(u);u/=w;vec=p[2]-p[0];t=vec@u;vv=vec-t*u;h=np.linalg.norm(vv);mu,mv=masks[i,0];ww,hh=quad[i];px=(X+.5)/20*ww-mu;py=(1-(Y+.5)/20)*hh-mv;points=np.array([[0.,0.],[w,0.],[t,h]]);covered=np.ones((20,20),bool);zero=0
 for j in range(3):
  q=points[j];z=points[(j+1)%3];edge=z-q;dist=(edge[0]*(py-q[1])-edge[1]*(px-q[0]))/np.linalg.norm(edge);zero+=int((dist==0).sum());covered&=dist>=0
 old=a[ty:ty+20,tx:tx+20,3]>0;stat=counts[str(part[i])];stat['tiles']+=1;stat['old_opaque_pixels']+=int(old.sum());stat['new_opaque_pixels']+=int(covered.sum());stat['opaque_to_transparent']+=int((old&~covered).sum());stat['transparent_to_opaque']+=int((~old&covered).sum());stat['exact_edge_distance_zero_samples']+=zero;trial[ty:ty+20,tx:tx+20,3]=covered.astype(np.uint8)*255
assert np.array_equal(a[:,:,:3],trial[:,:,:3]);assert np.array_equal(a[:2048,:2048],trial[:2048,:2048]);assert all(s['transparent_to_opaque']==0 for s in counts.values());Image.fromarray(trial).save(O)
checks={'rgb_entire_atlas_bit_exact':np.array_equal(a[:,:,:3],trial[:,:,:3]),'legacy_quadrant_rgba_bit_exact':np.array_equal(a[:2048,:2048],trial[:2048,:2048]),'all_resource_pack_assets_byte_unchanged':oldhash=={str(p.relative_to(R)):sha(p)for p in R.rglob('*')if p.is_file()},'binary_alpha_only':np.array_equal(np.unique(trial[:,:,3]),[0,255])};assert all(checks.values())
# Local witness identified by independent validator: native shell face4488, tile local pixel(16,11).
i=int(np.flatnonzero((part==1)&(data['native_face']==4488))[0]);tx,ty=uv[i];witness={'part':1,'native_face':4488,'tile_local_xy':[16,11],'atlas_xy':[int(tx+16),int(ty+11)],'old_alpha':int(a[ty+11,tx+16,3]),'trial_alpha':int(trial[ty+11,tx+16,3]),'claim':'Only the identified texel is tested here; full ray re-test and paired visual review remain pending.'}
report={'status':'UNRETAINED_CAUSE_DIAGNOSTIC_NOT_A_FIX','source_atlas':str(P.relative_to(W.parent)),'source_sha256':sha(P),'output_file':O.name,'output_sha256':sha(O),'geometry_sha256_unchanged':sha(G),'contract':{'only_change':'Alpha channel of the 18,484 new 20 x 20 tiles. RGB everywhere and full 2048 x 2048 legacy quadrant unchanged. No RP files changed.','test_parameter':'Original conservative half-plane threshold −0.75*min(world_units_per_texel) becomes 0.','pixel_rule':'Keep alpha 255 iff all three signed edge distances at the pixel center are >=0; otherwise 0. Exact boundary centers are included, without epsilon or dilation. This is center-only coverage, not polygon area antialiasing.','scope':'Standalone PNG under export_work; not referenced by any retained entity/texture_set. No rendering or retention recommendation.','limitations':'Removing conservative coverage can expose cracks or jagged edges. This tests dilation against sampling gaps; it does not certify a working fix or Bedrock runtime.'},'per_part':counts,'totals':{k:sum(s[k]for s in counts.values())for k in next(iter(counts.values()))},'checks':checks,'critical_shell_texel':witness}
(W/'alpha-center-only-trial-report.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(report,indent=2))
