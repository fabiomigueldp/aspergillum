O=Path(__file__).resolve().parent;V=O.parent;B=V.parent;oldg=json.loads((B/'pbr_normals_v2/resource_pack/models/entity/paz_v75_pbr_sculpture.geo.json').read_text())['minecraft:geometry'][0];newg=json.loads((V/'resource_pack/models/entity/paz_v75_v14_lab_sculpture.geo.json').read_text())['minecraft:geometry'][0];oldm=[r for r in json.loads((B/'pbr_normals_v2/evidence/alpha-triangle-map.json').read_text())if r['part']==15];newm=[json.loads(l)for l in gzip.open(V/'export_work/transport_faces.jsonl.gz','rt')if json.loads(l)['part']==15];d=np.load(B/'body_interface_v9/constrained_fit/retained-anatomy.npz');images={'V2':np.array(Image.open(B/'pbr_normals_v2/resource_pack/textures/entity/paz_v75_pbr_sculpture.png')),'V14':np.array(Image.open(V/'resource_pack/textures/entity/paz_v75_v14_lab_sculpture.png'))};act=np.fromfile(O/'actual-module-faces.f64','<f8').reshape(-1,4,8);maps=json.loads((O/'actual-module-face-map.json').read_text());lookup={(m['bone'],m['cube'],m['face']):i for i,m in enumerate(maps)}
def area(t):return float(np.linalg.norm(np.cross(t[1]-t[0],t[2]-t[0]))*.5)
def rec(c,mask,dtype=np.float64):
 s=np.array(c['size'],dtype=dtype);o=np.array(c['origin'],dtype=dtype);p=np.array(c['pivot'],dtype=dtype)*np.array([-1,1,1],dtype=dtype);o=np.array([-o[0]-s[0],o[1],o[2]],dtype=dtype);r=Rotation.from_euler('xyz',np.array(c['rotation'])*[-1,-1,1],degrees=True).as_matrix().astype(dtype);q=np.column_stack([mask,np.zeros(3)]).astype(dtype);bb=(q+o-p)@r.T+p;return bb[:,[0,2,1]]*np.array([1,-1,1],dtype=dtype)/dtype(16)
