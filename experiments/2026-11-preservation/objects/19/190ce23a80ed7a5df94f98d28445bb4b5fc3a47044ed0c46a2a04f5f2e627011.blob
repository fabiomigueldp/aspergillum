for fi in [424,1131]:
 source=d['points'][d['triangles'][fi]];row={'native_face':fi,'native_vertex_ids':d['triangles'][fi].tolist(),'source_area_blocks2':area(source),'source_vertices_f32_area_blocks2':area(source.astype(np.float32)),'source_all_vertex_normals_zero':bool(np.all(d['normals'][d['triangles'][fi]]==0))}
 for name,g,m in [('V2',oldg,oldm),('V14',newg,newm)]:
