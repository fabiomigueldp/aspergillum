+    const impacted = blocks.map((block) => block.asBlock());
+    const event = {
+      cancel,
+      getImpactedBlocks: vi.fn(() => impacted),
+      setImpactedBlocks: vi.fn((_blocks: typeof impacted) => {}),
+    };
+    return event;
+  }
+  function dispatch(event: ReturnType<typeof eventFor>): void {
+    const subscribers = engine.before.get("explosion");
+    if (subscribers?.length !== 1) throw new Error("Expected exactly one production explosion-before subscription");
+    for (const callback of subscribers) callback(event);
+  }
+  function occupy(kind: "aspersorium" | "table", block: FakeBlock) {
+    block.permutation = new FakePermutation(block.typeId, kind === "aspersorium"
+      ? { ...encodeAspersoriumContents({ waterUnits: 14, cosmeticIndex: 0 }), [ROTATION_STATE]: 7 }
+      : { ...encodeTableContents({ cosmeticIndex: 0 }), [TABLE_ROTATION_STATE]: 11 }).asPermutation();
