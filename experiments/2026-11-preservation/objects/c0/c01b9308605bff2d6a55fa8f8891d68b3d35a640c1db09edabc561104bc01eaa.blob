@@ -0,0 +1,32 @@
+import type { Block } from "@minecraft/server";
+import { readAspersoriumContents, readTableContents } from "../infrastructure/compact-block-state";
+import { ASPERSORIUM_BLOCK, SACRISTAN_TABLE_BLOCK } from "../infrastructure/constants";
+import { getDockedSnapshot } from "../infrastructure/docked-item-registry";
+
+export type BlockDestructionRisk = "occupied" | "orphaned" | "unreadable";
+
+/** Read-only guard shared by cancellable destruction routes, never recovery. */
+export function blockDestructionRisk(block: Block): BlockDestructionRisk | undefined {
+  let kind: "aspersorium" | "table";
+  try {
+    const id = block.typeId;
+    if (id === ASPERSORIUM_BLOCK) kind = "aspersorium";
+    else if (id === SACRISTAN_TABLE_BLOCK) kind = "table";
+    else return undefined;
+  } catch {
+    // Unknown ownership is not permission to change another pack's behavior.
+    return undefined;
+  }
+
+  try {
+    if (!block.isValid) return "unreadable";
+    const contents = kind === "aspersorium" ? readAspersoriumContents(block.permutation) : readTableContents(block.permutation);
+    if (contents.cosmeticIndex !== null) return "occupied";
+    if (getDockedSnapshot(block.dimension.id, block.location) !== undefined) return "orphaned";
+    return undefined;
+  } catch {
+    // Once ownership is established, uncertainty preserves the block and raw
+    // registry rather than triggering a non-atomic destruction/recovery path.
+    return "unreadable";
+  }
+}
--- /dev/null
+++ b/src/application/explosion-prevention.ts
@@ -0,0 +1,28 @@
+import type { Block, ExplosionBeforeEvent } from "@minecraft/server";
+import { blockDestructionRisk } from "./block-destruction-safety";
+
+/** Selectively prevent destruction; do not attempt delivery or registry repair. */
+export function preventUnsafeExplosionBlockDamage(event: ExplosionBeforeEvent): void {
+  if (event.cancel) return;
+  let impacted: Block[];
+  try {
+    impacted = event.getImpactedBlocks();
+  } catch (error) {
+    // With no known affected block, there is no basis to cancel other projects'
+    // explosions. Report this unprotected path rather than claiming success.
+    console.warn(`[Aspergillum] Explosion impact list unavailable: ${String(error)}`);
+    return;
+  }
+  const remaining = impacted.filter((block) => blockDestructionRisk(block) === undefined);
+  if (remaining.length === impacted.length) return;
+
+  try {
+    // Synchronous, one call, retaining other blocks' order and object identities.
+    event.setImpactedBlocks(remaining);
+  } catch (error) {
+    // The call may have changed the list before throwing. Never retry or assume
+    // no effect. Known at-risk blocks justify cancelling this whole explosion.
+    event.cancel = true;
+    console.warn(`[Aspergillum] Cancelled explosion after block exclusion failed: ${String(error)}`);
+  }
+}
