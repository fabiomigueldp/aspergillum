import bpy,numpy as np,json,collections
from scipy.sparse import coo_matrix
from scipy.sparse.csgraph import connected_components
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'V63-opposite-ankle-trial.blend',use_scripts=False);o=bpy.data.objects['Maria — túnica e mangas integradas'];p=np.array([v.co[:] for v in o.data.vertices]);edges=np.array([e.vertices[:] for e in o.data.edges]);seed=np.argmin(np.linalg.norm(p-np.array([-.226,-.206,2.0]),axis=1));mask=p[:,2]<2.11;inds=np.where(mask)[0];idx=np.full(len(p),-1);idx[inds]=np.arange(len(inds));ee=edges[mask[edges].all(axis=1)];a=idx[ee];g=coo_matrix((np.ones(len(a)*2),(np.r_[a[:,0],a[:,1]],np.r_[a[:,1],a[:,0]])),shape=(len(inds),len(inds)));n,l=connected_components(g);sel=set(inds[l==l[idx[seed]]].tolist());keep=[];removed=[];lower=set(i for i in sel if p[i,2]<2.015)
for f in o.data.polygons:
 v=list(f.vertices)
 if all(i in sel for i in v) and not all(i in lower for i in v):removed.append(v)
 else:keep.append(v)
c=collections.Counter(tuple(sorted((f[i],f[(i+1)%len(f)]))) for f in keep for i in range(len(f)));be=[e for e,n in c.items() if n==1];adj=collections.defaultdict(list)
for a,b in be:adj[a].append(b);adj[b].append(a)
print('boundary vertices',len(adj),'degree',collections.Counter(map(len,adj.values())))
loops=[];unseen=set(adj)
while unseen:
 start=next(iter(unseen));loop=[start];prev=None;cur=start
 while True:
  ns=[n for n in adj[cur] if n!=prev];nxt=ns[0]
  if nxt==start:break
  if nxt in loop:raise RuntimeError('bad loop')
  loop.append(nxt);prev,cur=cur,nxt
 unseen-=set(loop);loops.append(loop)
print('LOOPS',[(len(v),p[v].min(axis=0).tolist(),p[v].max(axis=0).tolist()) for v in loops]);json.dump({'p':p.tolist(),'keep':keep,'loops':loops,'lower':list(lower),'removed_count':len(removed)},open(r+'V66-sleeve-boundary-input.json','w'))
