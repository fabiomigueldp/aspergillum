from pathlib import Path
import numpy as np,json,sys
O=Path(__file__).resolve().parent;B=O.parents[1];tag=sys.argv[1];out={}
for label,path in [('candidate',B/f'band_ear_v12/structural_rebuild/{tag}.npz')]:
 d=np.load(path);p=d['points'];f=d['triangles'];q=p.astype(np.float32).astype(np.float64);t=p[f];tq=q[f];raw=np.cross(t[:,1]-t[:,0],t[:,2]-t[:,0]);rq=np.cross(tq[:,1]-tq[:,0],tq[:,2]-tq[:,0]);ar=np.linalg.norm(raw,axis=1)/2;aq=np.linalg.norm(rq,axis=1)/2;cos=np.einsum('ij,ij->i',raw,rq)/np.maximum(4*ar*aq,1e-300);ratio=aq/np.maximum(ar,1e-300);lens=np.linalg.norm(t[:,[1,2,0]]-t,axis=2);h=2*ar/np.maximum(lens.max(1),1e-300);parts=d['face_parts'];role=d['face_roles'] if 'face_roles' in d.files else np.zeros(len(f),int);rep={'vertices_merged_by_float32':len(q)-len(np.unique(q,axis=0)),'max_coordinate_rounding_mm':float(np.linalg.norm(q-p,axis=1).max()*1000),'degenerate64_under_1e16m2':np.flatnonzero(ar<1e-16).tolist(),'degenerate32_under_1e16m2':np.flatnonzero(aq<1e-16).tolist(),'exactly_zero_area32':np.flatnonzero(aq==0).tolist(),'orientation_reversed32_vs64':np.flatnonzero(cos<=0).tolist(),'minimum_altitude_mm64':float(h.min()*1000),'groups':{}}
 for group,mask in [('all',np.ones(len(f),bool)),('rim',parts==3),('trimmed',role==1),('exact',role==0)]:
  if not mask.any():continue
  rep['groups'][group]={'faces':int(mask.sum()),'area64_m2_min':float(ar[mask].min()),'area32_m2_min':float(aq[mask].min()),'area32_to64_percentiles':np.percentile(ratio[mask],[0,1,50,99,100]).tolist(),'minimum_altitude64_mm':float(h[mask].min()*1000),'max_normal_rotation_deg':float(np.degrees(np.arccos(np.clip(cos[mask],-1,1))).max()),'faces_rotation_over_1deg':np.flatnonzero(mask&(cos<np.cos(np.deg2rad(1)))).tolist()}
 ids=np.flatnonzero((aq<1e-16)|(cos<=0)|(ratio<.9)|(ratio>1.1));rep['outlier_faces']=[{'face':int(i),'part':int(parts[i]),'role':int(role[i]),'vertices':f[i].tolist(),'area64_m2':float(ar[i]),'area32_m2':float(aq[i]),'area_ratio':float(ratio[i]),'altitude64_mm':float(h[i]*1000),'normal_cosine':float(cos[i]),'points64':t[i].tolist(),'points32':tq[i].tolist()} for i in ids];out[label]=rep
out['method']='Round every stored vertex directly to IEEE754float32 and back tofloat64, recompute areas/orientation with double arithmetic. This is a transport-conditioning diagnostic, not Blender render or Bedrock engine validation.'
(O/(tag+'-float32-check.json')).write_text(json.dumps(out,indent=2));print(json.dumps({k:{q:v for q,v in x.items() if q!='outlier_faces'} if isinstance(x,dict) else x for k,x in out.items()},indent=2))
