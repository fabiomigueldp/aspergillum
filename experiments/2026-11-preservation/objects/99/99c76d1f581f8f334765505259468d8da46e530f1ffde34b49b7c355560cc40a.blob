import bpy,numpy as np,json
from pathlib import Path
R=Path(__file__).resolve().parents[1];B=R.parent/'shell_band_v3';S=R.parent.parent/'paz-refinement/gui-test/checkpoint-V75-20261102/V75-tunic-lower-trial.blend';bpy.ops.wm.open_mainfile(filepath=str(S),use_scripts=False);o=bpy.data.objects['Maria — véu reconstruído de perfil'];o.hide_viewport=False;o.hide_set(False)
for name,fun in [('lab_row',lambda i:i//112),('lab_sin',lambda i:np.sin(2*np.pi*(i%112)/112)),('lab_cos',lambda i:np.cos(2*np.pi*(i%112)/112))]:
 a=o.data.attributes.new(name,'FLOAT','POINT')
 for i,x in enumerate(a.data):x.value=fun(i)
for m in o.modifiers:
 if m.type=='SUBSURF':m.levels=m.render_levels
bpy.context.view_layer.update();dg=bpy.context.evaluated_depsgraph_get();me=bpy.data.meshes.new_from_object(o.evaluated_get(dg),preserve_all_data_layers=True,depsgraph=dg);params=np.array([[me.attributes[n].data[i].value for n in ['lab_row','lab_sin','lab_cos']] for i in range(len(me.vertices))]);src=np.load(B/'evidence/cap-source.npz');v=np.array([o.matrix_world@x.co for x in me.vertices]);assert np.array_equal(v,src['points']);np.savez_compressed(R/'evidence/cap-source-parameters.npz',params=params)
h=bpy.data.objects['Maria — anatomia feminina adaptada CC0'];m=bpy.data.meshes.new_from_object(h.evaluated_get(dg),depsgraph=dg);m.transform(h.matrix_world);m.calc_loop_triangles();np.savez_compressed(R/'evidence/head-source.npz',points=np.array([x.co[:] for x in m.vertices]),triangles=np.array([t.vertices[:] for t in m.loop_triangles]));print('EXACT CAP PARAMS',len(params),'HEAD',len(m.vertices),flush=True)
