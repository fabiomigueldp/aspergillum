"""Measure reconstructed rim attachment curves, not inherited vertex-pair offsets."""
from pathlib import Path
import numpy as np,json,sys
from collections import defaultdict
from scipy.sparse import coo_matrix
from scipy.sparse.csgraph import dijkstra
O=Path(__file__).resolve().parent;B=O.parents[1];tag=sys.argv[1];d=np.load(B/f'band_ear_v12/structural_rebuild/{tag}.npz');s=np.load(B/'shell_band_v5/retained_candidate/evidence/band-paired.npz');p=d['points'];f=d['triangles'];new=d['face_parts']==3;parents=d['baseline_face_indices'];side=s['source_side'];fc=np.array([x[0] if np.all(x==x[0]) else -2 for x in side[s['triangles']]]);edges=defaultdict(list)
for i,t in enumerate(f):
 for k in range(3):edges[tuple(sorted((int(t[k]),int(t[(k+1)%3]))))].append(i)
graph=defaultdict(set);bound=[]
for e,es in edges.items():
 if len(es)==2 and all(new[es]):graph[es[0]].add(es[1]);graph[es[1]].add(es[0])
 if len(es)==2 and sum(new[es])==1:
  old=next(i for i in es if not new[i]);rim=next(i for i in es if new[i]);bound.append({'edge':e,'source_face':old,'rim_face':rim,'wall_side':int(fc[parents[old]])})
left=set(np.flatnonzero(new));comps=[]
while left:
 seen=set();todo=[next(iter(left))]
 while todo:
  i=todo.pop()
  if i not in seen:seen.add(i);todo.extend(graph[i]-seen)
 left-=seen;comps.append(seen)
def point_seg(q,a,b):
 ab=b-a;t=np.clip(np.dot(q-a,ab)/max(np.dot(ab,ab),1e-300),0,1);r=a+t*ab;return np.linalg.norm(q-r),r
# Ericson-style closest points on finite segments; includes parallel cases.
def segseg(p1,q1,p2,q2):
 d1=q1-p1;d2=q2-p2;r=p1-p2;a=d1@d1;e=d2@d2;ff=d2@r;c=d1@r;b=d1@d2;den=a*e-b*b
 if a<1e-30:return point_seg(p1,p2,q2)[0],p1,point_seg(p1,p2,q2)[1]
 if e<1e-30:return point_seg(p2,p1,q1)[0],point_seg(p2,p1,q1)[1],p2
 ss=np.clip((b*ff-c*e)/den,0,1) if den>1e-25*a*e else 0.;tt=(b*ss+ff)/e
 if tt<0:tt=0;ss=np.clip(-c/a,0,1)
 elif tt>1:tt=1;ss=np.clip((b-c)/a,0,1)
 x=p1+d1*ss;y=p2+d2*tt;return np.linalg.norm(x-y),x,y
rows=[]
for ci,comp in enumerate(comps):
 cc=[r for r in bound if r['rim_face'] in comp];bd={k:[r for r in cc if r['wall_side']==k] for k in [-2,-1,0,1]};verts=np.unique(f[list(comp)]);r={'component':ci,'faces':len(comp),'vertices':len(verts),'bounds_min':p[verts].min(0).tolist(),'bounds_max':p[verts].max(0).tolist(),'attachment_edges_by_wall_side':{str(k):len(v) for k,v in bd.items()},'opposite_wall_curves_present':bool(bd[0] and bd[1])}
 if bd[0] and bd[1]:
  vals=[];best=(float('inf'),None,None,None,None)
  for a in bd[0]:
   md=float('inf')
   for b in bd[1]:
    dist,x,y=segseg(*p[list(a['edge'])],*p[list(b['edge'])]);md=min(md,dist)
    if dist<best[0]:best=(float(dist),x.tolist(),y.tolist(),list(a['edge']),list(b['edge']))
   vals.append(md*1000)
  r['side0_edge_nearest_side1_distance_mm_percentiles']=np.percentile(vals,[0,5,50,95,100]).tolist();r['exact_segment_pair_minimum']={'distance_mm':best[0]*1000,'point0':best[1],'point1':best[2],'edge0':best[3],'edge1':best[4]}
  used=set(verts);gi={int(q):i for i,q in enumerate(verts)};rr=[];cols=[];weights=[]
  for e,es in edges.items():
   if any(i in comp for i in es):
    u,v=e;w=np.linalg.norm(p[u]-p[v]);rr.extend([gi[u],gi[v]]);cols.extend([gi[v],gi[u]]);weights.extend([w,w])
  mat=coo_matrix((weights,(rr,cols)),shape=(len(verts),len(verts))).tocsr();sources=np.unique([gi[i] for row in bd[0] for i in row['edge']]);targets=np.unique([gi[i] for row in bd[1] for i in row['edge']]);dist=dijkstra(mat,directed=False,indices=sources,min_only=True);r['rim_edge_graph_to_opposite_lip_mm_percentiles']=np.percentile(dist[targets]*1000,[0,5,50,95,100]).tolist()
 rows.append(r)
summary={'wall_side_definition':'V5 band source_side=0 outward and source_side=1 inward. Baseline triangles with all3vertices on same identified wall inherit side. -2mixed and-1unmapped are not assigned artificially.','method':'Extract exact new-rim/inherited-surface interface edges. Per rim edge-connected component measure all segment distances between wall0 and wall1 attachment curves and shortest path along rim edge graph.','components':rows,'limits':['Lip distance is actual new closing geometry, not original paired offsets and not global wall minimum.','Nearest opposite lip can come from a nearby fold; witness coordinates supplied. Rim-edge path is discrete upper bound on surface geodesic.','Components attached only to one known wall are pocket candidates, not automatically invalid.','Topology, sample chords and visual inspection remain necessary.']}
(O/(tag+'-rim-lips.json')).write_text(json.dumps(summary,indent=2));print(json.dumps(summary,indent=2))
