import bpy,math,json,hashlib
from mathutils import Vector
from mathutils.bvhtree import BVHTree
from collections import Counter
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'V49-child-hand-trial.blend',use_scripts=False)
old=bpy.data.objects['Menino — cabelo rente'];head=bpy.data.objects['Menino — base infantil anatômica CC0'];dg=bpy.context.evaluated_depsgraph_get();bv=BVHTree.FromObject(head,dg);center=Vector((.025,-.235,1.80));N=128;R=48;verts=[];faces=[];miss=[]
def sm(t):t=max(0,min(1,t));return t*t*(3-2*t)
def surface(d,thickness):
 loc,n,idx,dist=bv.ray_cast(center+d*.6,-d,1.2)
 if loc is None:raise RuntimeError('No scalp hit')
 return loc+n*thickness
verts.append(surface(Vector((0,0,1)),.003))
for j in range(1,R+1):
 t=j/R
 for i in range(N):
  phi=2*math.pi*i/N;front=-math.sin(phi);thetaMax=math.radians(80-12*max(front,0)+25*max(-front,0));theta=t*thetaMax
  d=Vector((math.sin(theta)*math.cos(phi),math.sin(theta)*math.sin(phi),math.cos(theta)))
  thickness=.003*(1-sm((t-.83)/.17))-.00045*sm((t-.97)/.03)
  verts.append(surface(d,thickness))
for i in range(N):faces.append((0,1+i,1+(i+1)%N))
for j in range(R-1):
 a=1+j*N;b=a+N
 for i in range(N):faces.append((a+i,b+i,b+(i+1)%N,a+(i+1)%N))
m=bpy.data.meshes.new('V50 scalp continuous retopology');m.from_pydata(verts,[],faces);m.update();o=bpy.data.objects.new('Menino — cabelo contínuo V50 reversível',m);bpy.context.collection.objects.link(o)
for mat in old.data.materials:m.materials.append(mat)
for p in m.polygons:p.use_smooth=True
old.hide_render=True;old.hide_set(True)
o['rollback']='Hide this object and unhide Menino — cabelo rente; V49 source untouched.'
# Explicitly verify normals face away from scalp center.
wrong=sum(p.normal.dot(p.center-center)<0 for p in m.polygons)
if wrong>len(m.polygons)//2:
 for p in m.polygons:p.flip()
 m.update()
edge=Counter(tuple(sorted((f[i],f[(i+1)%len(f)]))) for f in faces for i in range(len(f)))
report={'source':'V49','scope':'Only old hair visibility plus new separate cap; no other geometry change','vertices':len(verts),'faces':len(faces),'boundary_edges':sum(n==1 for n in edge.values()),'nonmanifold_edges_excluding_boundary':sum(n>2 for n in edge.values()),'thickness_top_m':.003,'terminal_inset_m':.00045,'scalp_ray_misses':0,'no_curls_added':True,'rollback':o['rollback']};json.dump(report,open(r+'V50-child-hair-verification.json','w'),indent=2)
bpy.ops.wm.save_as_mainfile(filepath=r+'V50-child-hair-trial.blend')
s=bpy.context.scene;s.cycles.samples=32;s.render.resolution_x=700;s.render.resolution_y=700;s.render.resolution_percentage=100;c=s.camera;ct=Vector((.025,-.265,1.82));c.data.ortho_scale=.43
for label,off in [('profile',(-3,0,0)),('front',(0,-3,0)),('threequarter',(-2,-3,0))]:
 c.location=ct+Vector(off);c.rotation_euler=(ct-c.location).to_track_quat('-Z','Y').to_euler();s.render.filepath=r+'V50-child-hair-'+label+'.png';bpy.ops.render.render(write_still=True)
print(report)
