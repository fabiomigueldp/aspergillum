"""Audit-only report builder. Never writes outside anatomy_fit."""
from pathlib import Path
import numpy as np,json,hashlib
O=Path(__file__).resolve().parent;B=O.parent.parent
base=np.load(O/'baseline-welded.npz');p0=base['points'];f=base['triangles'];ids=base['source_indices'];lf=np.load(B/'body_interface_v8/independent_diagnosis/legacy-part15.npz');legacy=lf['points'][lf['triangles']];native=p0[f]
error=np.min([np.max(abs(native-np.roll(legacy,k,axis=1)),axis=(1,2)) for k in range(3)],axis=0)
sh=np.load(B/'lateral_v7/adaptive_patch/adaptive-consistent-assembly.npz');prior=np.load(B/'body_interface_v8/independent_diagnosis/v7__legacy_body__contacts.npz');bc=prior['pairs'][:,::-1]
d=np.load(O/'inward-0p5mm-iteration00.npz');mask=d['protected_vertices'];active=d['active_vertices'];changed=d['changed_vertices'];x,y,z=p0.T;broad=((y<-.28)&(z<3.565))|(((x<-.08)|(x>.16))&(y<-.145)&(y>-.26)&(z>3.405)&(z<3.55))|(z<3.28);np.save(O/'explicit-protected-mask.npy',broad);dd=d['points']-p0;mm=np.linalg.norm(dd,axis=1)*1000
report={'baseline':{'vertices':len(p0),'triangles':len(f),'legacy_coordinate_match_max_cyclic_error':float(error.max()),'source_indices_are_global_repaired_low_v':True,'source_face_indices_are_global_repaired_low_f':True,'source_face_order_is_alpha_triangle_map_part15_order':True,'part15_local_vertex_index':'source_indices - 4820','tiny_component':'Three vertices/two triangles retained exactly; original source double area about 1e-14. Two collapsed12-triangle components were already excluded by intended export; no additional deletion here.'},'fixed_mask':{'explicit_protected':int(mask.sum()),'nonactive':int((~active).sum()),'changed':int(changed.sum()),'unchanged':int((~changed).sum()),'protected_exact':bool(np.array_equal(d['points'][mask],p0[mask])),'nonactive_exact':bool(np.array_equal(d['points'][~active],p0[~active])),'connectivity_exact':bool(np.array_equal(f,d['triangles'])),'source_indices_exact':bool(np.array_equal(ids,d['source_indices']))},'variants':{},'scope_caveat':'Mask is a conservative coordinate-feature region plus cavity coverage criterion, not a hand-labeled anatomical segmentation or formal camera-visible-silhouette certificate. Parent renderer must visually validate.'}
# Record first broad-mask incompatibility, rather than letting it disappear when mask narrowed.
fb=np.unique(bc[:,0][np.all(broad[f[bc[:,0]]],axis=1)])
report['exploratory_broad_mask']={'definition':'face y<-.28,z<3.565; ears (x<-.08 or x>.16),-.26<y<-.145,3.405<z<3.55; lowerneck z<3.28','protected_vertices':int(broad.sum()),'all_fixed_contact_body_faces':len(fb),'face_ids':fb.tolist(),'source_face_ids':base['source_face_indices'][fb].tolist(),'bbox':[native[fb].min((0,1)).tolist(),native[fb].max((0,1)).tolist()],'not_current_mask':True}
for name in ['inward-0p5mm','inward-0p3mm-max5','inward-0p5mm-max10']:
 r=json.loads((O/f'{name}-report.json').read_text());r['scope']['world_frame_source_indices_connectivity_preserved']=r['scope'].pop('coordinates_source_indices_connectivity_preserved',True)
 # Correct old numerical denominator floor in min-normal-dot metric without touching geometry.
 for row in r['iterations']:
  a=np.load(O/f'{name}-iteration{row["iteration"]:02d}.npz');p=a['points'];n=np.cross(p[f[:,1]]-p[f[:,0]],p[f[:,2]]-p[f[:,0]]);n0=np.cross(p0[f[:,1]]-p0[f[:,0]],p0[f[:,2]]-p0[f[:,0]]);co=np.sum(n*n0,axis=1)/np.maximum(np.linalg.norm(n,axis=1)*np.linalg.norm(n0,axis=1),1e-40);row['face_normal_dot_min']=float(co.min());row['face_flips']=int(sum(co<=0));row['min_main_component_area_ratio']=float(np.min(np.linalg.norm(n,axis=1)[np.linalg.norm(n0,axis=1)>1e-10]/np.linalg.norm(n0,axis=1)[np.linalg.norm(n0,axis=1)>1e-10]));row['protected_bitwise_exact']=bool(np.array_equal(p[a['protected_vertices']],p0[a['protected_vertices']]))
 r['baseline']['face_normal_dot_min']=1.;(O/f'{name}-report.json').write_text(json.dumps(r,indent=2));report['variants'][name]=r['iterations']
cp=np.load(O/'inward-0p5mm-iteration00-contacts.npz')['body_shell_pairs'];rows=[]
for bi,si in cp:
 inds=f[bi];cat='protected-only' if np.all(mask[inds]) else ('fixed-only' if np.all(~active[inds]) else 'mixed-or-active');rows.append({'body_face':int(bi),'source_face':int(base['source_face_indices'][bi]),'shell_face':int(si),'shell_part':int(sh['face_parts'][si]),'class':cat,'body_vertex_ids':inds.tolist(),'source_vertex_ids':ids[inds].tolist(),'protected_vertex_count':int(mask[inds].sum()),'changed_vertex_count':int(changed[inds].sum()),'body_centroid_xyz':d['points'][inds].mean(0).tolist()})
(O/'initial-candidate-residual-map.json').write_text(json.dumps({'candidate':'inward-0p5mm-iteration00.npz','crossing_pairs':len(cp),'all_fixed_body_faces':np.unique(cp[np.all(~active[f[cp[:,0]]],axis=1),0]).tolist(),'all_protected_body_faces':np.unique(cp[np.all(mask[f[cp[:,0]]],axis=1),0]).tolist(),'pairs':rows},indent=2))
report['initial_candidate_residual']={'crossing_pairs':len(cp),'all_fixed_pairs':int(np.sum(np.all(~active[f[cp[:,0]]],axis=1))),'all_protected_pairs':int(np.sum(np.all(mask[f[cp[:,0]]],axis=1))),'all_fixed_body_faces':len(np.unique(cp[np.all(~active[f[cp[:,0]]],axis=1),0])),'all_protected_body_faces':len(np.unique(cp[np.all(mask[f[cp[:,0]]],axis=1),0])),'map':'initial-candidate-residual-map.json'}
report['largest_displacements']=[{'welded_vertex':int(i),'source_vertex':int(ids[i]),'source_xyz':p0[i].tolist(),'displacement_mm':float(mm[i])} for i in np.argsort(mm)[-15:][::-1]]
report['inputs_sha256']={str(p.relative_to(B)):hashlib.sha256(p.read_bytes()).hexdigest() for p in [B/'lateral_v7/adaptive_patch/adaptive-consistent-assembly.npz',B/'pbr_normals_v2/evidence/repaired_meshes.npz',B/'pbr_normals_v2/evidence/alpha-triangle-map.json',B/'body_interface_v8/independent_diagnosis/legacy-part15.npz']}
(O/'audit-summary.json').write_text(json.dumps(report,indent=2));print(json.dumps({k:report[k] for k in ['baseline','fixed_mask','initial_candidate_residual']},indent=2))
