import bpy,math,json
from mathutils import Vector
from mathutils.bvhtree import BVHTree
r='/workspace/scratch/212c580ada5b/paz-refinement/gui-test/';bpy.ops.wm.open_mainfile(filepath=r+'V50-child-hair-trial.blend',use_scripts=False)
o=bpy.data.objects['Menino — cabelo contínuo V50 reversível'];head=bpy.data.objects['Menino — base infantil anatômica CC0'];bv=BVHTree.FromObject(head,bpy.context.evaluated_depsgraph_get());center=Vector((.025,-.235,1.80));N=128;R=48
if not o.data.shape_keys:o.shape_key_add(name='Basis')
k=o.shape_key_add(name='TESTE51 — massas capilares rasas e contorno sutil');k.value=1
base=[v.co.copy() for v in o.data.vertices]
def sm(t):t=max(0,min(1,t));return t*t*(3-2*t)
def gauss(x,w):return math.exp(-(x/w)**2)
for idx,p in enumerate(base):
 if idx==0:t=0;phi=0
 else:j=(idx-1)//N+1;i=(idx-1)%N;t=j/R;phi=2*math.pi*i/N
 front=-math.sin(phi);thetaMax=math.radians(80-12*max(front,0)+25*max(-front,0))
 # Broad, non-periodic hairline asymmetry; at most about 1 degree, not engraved.
 delta=math.radians(.85*math.exp(-((phi-3.8)/.6)**2)-.6*math.exp(-((phi-5.0)/.55)**2)+.45*math.exp(-((phi-2.8)/.5)**2))
 theta=t*(thetaMax+delta*sm((t-.65)/.35));d=Vector((math.sin(theta)*math.cos(phi),math.sin(theta)*math.sin(phi),math.cos(theta)))
 loc,n,f,dist=bv.ray_cast(center+d*.6,-d,1.2)
 if loc is None:raise RuntimeError('scalp miss')
 thickness=.003*(1-sm((t-.83)/.17))-.00045*sm((t-.97)/.03)
 y=loc.y;x=loc.x;backflow=(y+.26)
 mass=0
 for cx,width,amp,sweep in [(-.022,.024,.0018,.16),(.021,.025,.0015,-.09),(.064,.022,.0012,-.20)]:
  axis=cx+sweep*backflow+.08*backflow*backflow
  mass+=amp*gauss(x-axis,width)*gauss(y+.245,.12)
 mass*=1-sm((t-.79)/.18)
 k.data[idx].co=loc+n*(thickness+mass)
delta=max((v.co-p).length for v,p in zip(k.data,base));faces=[tuple(f.vertices) for f in o.data.polygons];p=[v.co for v in k.data];bb=BVHTree.FromPolygons(p,faces);pairs=[(i,j) for i,j in bb.overlap(bb) if i<j and not set(faces[i])&set(faces[j])]
report={'source':'V50','scope':'Only new hair object shape key','max_delta_m':delta,'nonadjacent_self_intersections':len(pairs),'mass_count':3,'nominal_peak_amplitudes_m':[.0018,.0015,.0012],'no_grooves_or_curls':True,'rollback':'TESTE51 key value0 restores V50'};json.dump(report,open(r+'V51-child-hair-verification.json','w'),indent=2);bpy.ops.wm.save_as_mainfile(filepath=r+'V51-child-hair-trial.blend')
s=bpy.context.scene;s.cycles.samples=32;s.render.resolution_x=700;s.render.resolution_y=700;s.render.resolution_percentage=100;c=s.camera;ct=Vector((.025,-.265,1.82));c.data.ortho_scale=.43
for label,off in [('profile',(-3,0,0)),('front',(0,-3,0)),('threequarter',(-2,-3,0))]:
 c.location=ct+Vector(off);c.rotation_euler=(ct-c.location).to_track_quat('-Z','Y').to_euler();s.render.filepath=r+'V51-child-hair-'+label+'.png';bpy.ops.render.render(write_still=True)
print(report)
