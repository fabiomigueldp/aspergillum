for i,q in enumerate(pp):kd.insert(q,i)
kd.balance();protected=[q for q in original if q.y<-.335 or q.z>1.72];areas=[f.area*1e6 for f in mesh.polygons[-len(newfaces):]]
report={'source':'V52 with raw union only as boundary extraction, no smoothed V54 geometry','removed_irregular_faces':data['removed_count'],'lower_boundary_vertices':len(L),'upper_boundary_vertices':len(U),'regular_interior_samples_per_ring':N,'new_ring_faces':len(newfaces),'boundary_edges':sum(v==1 for v in edge.values()),'nonmanifold_edges':sum(v!=2 for v in edge.values()),'nonadjacent_self_intersections':len(pairs),'protected_face_cranium_max_delta_m':max(kd.find(q)[2] for q in protected),'new_face_area_mm2_min':min(areas),'new_face_area_mm2_max':max(areas),'new_face_area_mm2_median':float(np.median(areas)),'rollback':'Hide V55 object, unhide original child head and neck. V52 unchanged.'};json.dump(report,open(r+'V55-child-neck-verification.json','w'),indent=2);bpy.ops.wm.save_as_mainfile(filepath=r+'V55-child-neck-trial.blend')
