def sample(ids,ang,a):
 aa=ang+[ang[0]+2*math.pi];vv=ids+[ids[0]]
 if a<aa[0]:a+=2*math.pi
 i=min(len(ids)-1,int(np.searchsorted(aa,a,side='right'))-1);t=(a-aa[i])/(aa[i+1]-aa[i]);return p[vv[i]].lerp(p[vv[i+1]],t)
N=128;K=16;rings=[];angles=[i*2*math.pi/N for i in range(N)]
for j in range(1,K):
 t=j/K;ring=[]
 for a in angles:
  lo=sample(L,la,a);up=sample(U,ua,a);d=up-lo;ln=nb.find_nearest(lo)[1];un=hb.find_nearest(up)[1];tl=d-ln*d.dot(ln);tu=d-un*d.dot(un)
  if tl.length:tl=tl.normalized()*d.length
  if tu.length:tu=tu.normalized()*d.length
  q=(2*t**3-3*t*t+1)*lo+(t**3-2*t*t+t)*tl+(-2*t**3+3*t*t)*up+(t**3-t*t)*tu
  ring.append(len(p));p.append(q)
 rings.append(ring)
