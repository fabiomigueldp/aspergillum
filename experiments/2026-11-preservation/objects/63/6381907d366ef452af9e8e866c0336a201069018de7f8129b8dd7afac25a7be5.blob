"""Quantization, paired-wall orientation and UV-domain checks for a saved trial."""
from pathlib import Path
import numpy as np,json,sys,collections
O=Path(__file__).resolve().parent;B=O.parents[1];tag=sys.argv[1];d=dict(np.load(O/(tag+'.npz')));old=dict(np.load(B/'band_ear_v12/structural_rebuild/retained-band.npz'));p=d['points'];f=d['triangles'];part=d['face_parts'];role=d['v13_face_roles'];uv=d['source_uv'];par=d['v13_parent_face_indices'];q=p.astype(np.float32).astype(float);t=p[f];tq=q[f];raw=np.cross(t[:,1]-t[:,0],t[:,2]-t[:,0]);rawq=np.cross(tq[:,1]-tq[:,0],tq[:,2]-tq[:,0]);ar=np.linalg.norm(raw,axis=1);aq=np.linalg.norm(rawq,axis=1);normal=raw/ar[:,None];cos=(raw*rawq).sum(1)/(ar*aq);edge=np.linalg.norm(t[:,[1,2,0]]-t,axis=2);alt=ar/edge.max(1);angles=[]
for j in range(3):
 e1=t[:,(j+1)%3]-t[:,j];e2=t[:,(j+2)%3]-t[:,j];angles.append(np.degrees(np.arctan2(np.linalg.norm(np.cross(e1,e2),axis=1),(e1*e2).sum(1))))
ang=np.min(angles,axis=0);report={'candidate':tag+'.npz','float32':{'unique_float64_positions':len(np.unique(p,axis=0)),'unique_float32_positions':len(np.unique(q,axis=0)),'vertex_merge_count':len(np.unique(p,axis=0))-len(np.unique(q,axis=0)),'max_position_rounding_mm':float(np.linalg.norm(p-q,axis=1).max()*1000),'degenerate_faces_under_1e_16_m2':int((aq<2e-16).sum()),'normal_flips_against_float64':int((cos<=0).sum()),'max_normal_rotation_deg':float(np.rad2deg(np.arccos(np.clip(cos,-1,1))).max()),'face_area_ratio_range':[float((aq/ar).min()),float((aq/ar).max())]},'quality':{},'wall_pairs':{},'uv_domain':{}}
edges=collections.defaultdict(list);links=collections.defaultdict(list);nei=collections.defaultdict(set)
for j,face in enumerate(f):
 for k in range(3):
  a,b,c=map(int,[face[k],face[(k+1)%3],face[(k+2)%3]]);edges[tuple(sorted((a,b)))].append((a,b,j));nei[a].add(b);nei[b].add(a);links[a].append((b,c))
left=set(range(len(p)));components=[]
while left:
 seen=set();todo=[next(iter(left))]
 while todo:
  a=todo.pop()
  if a not in seen:seen.add(a);todo.extend(nei[a]-seen)
 left-=seen;components.append(len(seen))
badlinks=[]
for a,es in links.items():
 g=collections.defaultdict(set)
 for b,c in es:g[b].add(c);g[c].add(b)
 seen=set();todo=[next(iter(g))]
 while todo:
  b=todo.pop()
  if b not in seen:seen.add(b);todo.extend(g[b]-seen)
 if len(seen)!=len(g) or any(len(x)!=2 for x in g.values()):badlinks.append(a)
report['topology']={'vertices':len(p),'triangles':len(f),'edges':len(edges),'euler':len(p)-len(edges)+len(f),'components_vertices':sorted(components,reverse=True),'boundary_edges':sum(len(x)==1 for x in edges.values()),'non_two_face_edges':sum(len(x)!=2 for x in edges.values()),'inconsistent_edge_winding':sum(len(x)==2 and x[0][:2]==x[1][:2] for x in edges.values()),'bad_vertex_links':badlinks,'unused_vertices':sorted(set(range(len(p)))-set(f.ravel())),'duplicate_triangle_index_sets':len(f)-len(set(map(tuple,np.sort(f,axis=1)))),'signed_volume_m3':float(np.einsum('ij,ij->i',p[f[:,0]],np.cross(p[f[:,1]],p[f[:,2]])).sum()/6)}
for label,mask in [('all',np.ones(len(f),bool)),('restored',role==2),('conformity_neighbors',role==1),('untouched',role==0)]:report['quality'][label]={'faces':int(mask.sum()),'minimum_area_mm2':float(ar[mask].min()*0.5e6),'minimum_altitude_mm':float(alt[mask].min()*1000),'minimum_angle_deg':float(ang[mask].min()),'faces_under_1degree':int((ang[mask]<1).sum()),'float32_max_normal_rotation_deg':float(np.rad2deg(np.arccos(np.clip(cos[mask],-1,1))).max())}
key=lambda a:tuple(np.round(a,10));iv={key(uv[i]):int(i) for i in np.flatnonzero(d['source_side']==1)};of=np.flatnonzero((part==0)&(role==2));ov=np.unique(f[of]);pairs=np.array([[i,iv[key(uv[i])]] for i in ov]);vmap={int(a):int(b) for a,b in pairs};delta=p[f[of]]-p[np.array([[vmap[int(i)] for i in row] for row in f[of]])];span=np.linalg.norm(p[pairs[:,0]]-p[pairs[:,1]],axis=1);projection=(delta*normal[of,None]).sum(2);mid=(p[f[of]]+p[np.array([[vmap[int(i)] for i in row] for row in f[of]])])/2;mn=np.cross(mid[:,1]-mid[:,0],mid[:,2]-mid[:,0]);mn/=np.linalg.norm(mn,axis=1)[:,None];director=(delta*mn[:,None]).sum(2)
report['wall_pairs']={'sampled_vertex_pairs':len(pairs),'outer_patch_triangles':len(of),'pair_span_mm_quantiles':np.quantile(span*1000,[0,.01,.5,.99,1]).tolist(),'projection_to_outer_face_normal_mm_quantiles':np.quantile(projection*1000,[0,.01,.5,.99,1]).tolist(),'opposing_vertex_pair_nonpositive_outer_normal_count':int((projection<=0).sum()),'mixed_director_midplane_triangles':int((director.min(1)*director.max(1)<=0).sum()),'all_projection_weights_pairwise_identical':bool(np.array_equal(d['v13_source_projection_weight'][pairs[:,0]],d['v13_source_projection_weight'][pairs[:,1]])),'limits':'Pair distances and projection on containing face normals are local finite samples, not minimum thickness or global separation. Independent normal-ray chords are separate.'}
rows=[]
for j in np.unique(par[role==2]):
 ids=np.flatnonzero(par==j);src=old['source_uv'][old['triangles'][j]];target=uv[f[ids]];E=np.stack([src[1]-src[0],src[2]-src[0]],axis=1);coords=(target-src[0])@np.linalg.inv(E).T;bc=np.concatenate([1-coords.sum(-1,keepdims=True),coords],axis=-1);area=np.linalg.det(E)/2;child=np.linalg.det(np.stack([target[:,1]-target[:,0],target[:,2]-target[:,0]],axis=-1))/2;rows.append({'old_face':int(j),'child_faces':len(ids),'minimum_parent_barycentric':float(bc.min()),'signed_uv_area_error':float(child.sum()-area),'reversed_uv_children':int((child*area<=0).sum())})
report['uv_domain']={'restored_old_faces':len(rows),'max_signed_area_error':max(abs(r['signed_uv_area_error']) for r in rows),'minimum_parent_barycentric':min(r['minimum_parent_barycentric'] for r in rows),'reversed_uv_children':sum(r['reversed_uv_children'] for r in rows),'rows':rows,'limits':'Signed area plus containment/orientation checks; independent coplanarity/intersections additionally test spatial overlap. Not visibility.'};report['limits']=['Float32 test is direct coordinate quantization, not Bedrock JSON/cubos/PBR/culling/mipmaps/engine validation.','Shell and anatomy are frozen inputs; none of their unchanged gates rerun.'];(O/(tag+'-numeric-wall-domain.json')).write_text(json.dumps(report,indent=2));print(json.dumps({k:v for k,v in report.items() if k!='uv_domain'},indent=2));print({k:v for k,v in report['uv_domain'].items() if k!='rows'})
