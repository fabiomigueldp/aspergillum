import bpy,numpy as np,json,hashlib
from pathlib import Path
R=Path(__file__).resolve().parents[1];S=R.parent.parent/'paz-refinement/gui-test/checkpoint-V75-20261102/V75-tunic-lower-trial.blend';bpy.ops.wm.open_mainfile(filepath=str(S),use_scripts=False);bpy.context.view_layer.update();dg=bpy.context.evaluated_depsgraph_get();o=bpy.data.objects['TESTE 34 — conexão de superfícies avaliadas'];m=bpy.data.meshes.new_from_object(o.evaluated_get(dg),depsgraph=dg);m.transform(o.matrix_world);v=np.array([x.co[:] for x in m.vertices]);src=np.load(R/'evidence/cap-source.npz')['points'];delta=np.linalg.norm(v[:len(src)]-src,axis=1);report={'retained_source_sha256':hashlib.sha256(S.read_bytes()).hexdigest(),'source_cap_vertex_count':len(src),'joined_vertex_count':len(v),'joined_cap_max_vertex_delta':float(delta.max()),'joined_cap_mean_vertex_delta':float(delta.mean()),'cap_matches_actual_visible_V75':bool(delta.max()<1e-7),'source_key_74_value':o.data.shape_keys.key_blocks['TESTE74 — bainha inferior reversível'].value,'scope':'Vertex correspondence only. Standalone cap restored its rear rim; original joined seam/mantle must still be preserved and reintegrated separately.'};(R/'evidence/current-source-correspondence.json').write_text(json.dumps(report,indent=2));print(report)
