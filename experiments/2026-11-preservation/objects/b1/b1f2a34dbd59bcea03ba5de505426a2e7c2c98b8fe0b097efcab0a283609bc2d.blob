"""Independent exposed-contact and explicit adjacent-triangle checks. Blender Python.
No external rendering and no candidate/source modifications. Finite rays are not hiddenness proof.
"""
from pathlib import Path
import numpy as np,json,sys,importlib.util,itertools
sys.dont_write_bytecode=True
from mathutils.bvhtree import BVHTree
O=Path(__file__).resolve().parent;B=O.parents[1]
args=sys.argv[sys.argv.index('--')+1:];path=Path(args[0]);tag=args[1];d=np.load(path);v=d['points'];f=d['triangles'];body=np.load(B/'body_interface_v9/constrained_fit/retained-anatomy.npz');band=np.load(B/'shell_band_v5/retained_candidate/evidence/band-paired.npz');p=np.load(O/(tag+'-review-arrays.npz'));dirs=np.load(B/'body_interface_v9/independent_diagnosis/ear-visibility-real-mask.npz')['directions']
spec=importlib.util.spec_from_file_location('gate',B/'shell_band_v3/tools/independent_gate.py');gate=importlib.util.module_from_spec(spec);spec.loader.exec_module(gate)
vv=np.r_[v,body['points'],band['points']];ff=np.r_[f,body['triangles']+len(v),band['triangles']+len(v)+len(body['points'])];tree=BVHTree.FromPolygons(vv.tolist(),ff.tolist(),all_triangles=True,epsilon=0)
rep={'candidate':str(path),'directions':len(dirs),'new_against':'V7 native shell with retained V9 anatomy and V5 band','rows':{},'limitations':['Finite ray samples at strict crossing witnesses: an escaped ray proves exposure for that sample; no escaped rays do not prove universal invisibility.','Occluders: native shell, anatomy and band. Other legacy parts are omitted, so escaping rays may be blocked elsewhere in the whole sculpture.','Intersection chord is not penetration depth or perceived defect size.','Adjacent noncoplanar strict crossings only; general coplanarity is not certified.']}
for name,ob in [('anatomy',body),('band',band)]:
 rows=[]
 for i,j in p[name+'_new_pairs']:
  a=v[f[i]];b=ob['points'][ob['triangles'][j]];w=np.array(gate.strict_hits(a,b)+gate.strict_hits(b,a));dist=np.linalg.norm(w[:,None,:]-w[None,:,:],axis=-1);ends=np.unravel_index(dist.argmax(),dist.shape);samples=np.array([w[ends[0]],w[ends[1]],w.mean(0)]);n1=np.cross(a[1]-a[0],a[2]-a[0]);n1/=np.linalg.norm(n1);n2=np.cross(b[1]-b[0],b[2]-b[0]);n2/=np.linalg.norm(n2);escaping=[]
  for si,q in enumerate(samples):
   for di in np.flatnonzero((dirs@n1>-.01)&(dirs@n2>-.01)):
    dr=dirs[di];h=tree.ray_cast(tuple(q+dr*2e-6),tuple(dr),2.)
    if h[0] is None:escaping.append([si,int(di)]);break
  rows.append({'shell_face':int(i),'shell_part':int(d['face_parts'][i]),'other_face':int(j),'ear_vertices':int(body['protected_ears'][body['triangles'][j]].sum()) if name=='anatomy' else None,'witness_centroid':w.mean(0).tolist(),'intersection_chord_mm':float(dist.max()*1000),'sample_escaping_camera_rays':escaping})
 rep['rows'][name]=rows;rep[name+'_summary']={'new_pairs':len(rows),'ray_escape_pairs':sum(bool(x['sample_escaping_camera_rays']) for x in rows),'new_by_shell_part':{str(k):sum(x['shell_part']==k for x in rows) for k in range(3)},'ray_escape_by_shell_part':{str(k):sum(x['shell_part']==k and bool(x['sample_escaping_camera_rays']) for x in rows) for k in range(3)},'max_chord_mm':max((x['intersection_chord_mm'] for x in rows),default=0)};print(name,rep[name+'_summary'],flush=True)
# Explicitly check ALL sharing-vertex triangle pairs, which BVH implementations can suppress.
vf=[[] for _ in range(len(v))]
for i,tri in enumerate(f):
 for x in tri:vf[x].append(i)
adj=set()
for fs in vf:adj.update(itertools.combinations(fs,2))
adj=np.array(sorted(adj),int);aa=v[f[adj[:,0]]];bb=v[f[adj[:,1]]];hit=np.zeros(len(adj),bool);legacyhit=np.zeros(len(adj),bool)
for orig,tar in [(aa,bb),(bb,aa)]:
 e1,e2=tar[:,1]-tar[:,0],tar[:,2]-tar[:,0]
 for k in range(3):
  pp=orig[:,k];dr=orig[:,(k+1)%3]-pp;h=np.cross(dr,e2);det=np.einsum('ij,ij->i',e1,h);legacyvalid=abs(det)>1e-20;valid=abs(det)>1e-12*np.linalg.norm(e1,axis=1)*np.linalg.norm(e2,axis=1)*np.linalg.norm(dr,axis=1);den=np.where(legacyvalid,det,1);ss=pp-tar[:,0];u=np.einsum('ij,ij->i',ss,h)/den;qq=np.cross(ss,e1);vv0=np.einsum('ij,ij->i',dr,qq)/den;tt=np.einsum('ij,ij->i',e2,qq)/den;strict=(tt>1e-8)&(tt<1-1e-8)&(u>1e-8)&(vv0>1e-8)&(u+vv0<1-1e-8);hit|=valid&strict;legacyhit|=legacyvalid&strict
rep['explicit_adjacent_face_test']={'pairs_checked':len(adj),'scale_relative_parallel_tolerance':1e-12,'strict_crossing_pairs':int(hit.sum()),'crossings':adj[hit].tolist(),'raw_absolute_tolerance_artifacts_removed':adj[legacyhit&~hit].tolist()}
(O/(tag+'-new-contact-visibility.json')).write_text(json.dumps(rep,indent=2));print(rep['explicit_adjacent_face_test'],flush=True)
