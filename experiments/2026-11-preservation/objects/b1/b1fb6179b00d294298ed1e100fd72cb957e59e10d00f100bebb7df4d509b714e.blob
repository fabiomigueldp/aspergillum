"""Local cap+bridge paired-center relaxation with unchanged wall offsets.
Frozen body/band/mantle; exact connectivity. Soft metric/normal/scalp constraints,
NOT a global clearance guarantee. Every outer iteration persisted separately.
blender -b -t 3 --python relax_paired.py -- TAG STRETCH_FLOOR TARGET_WEIGHT [SEED]
"""
from pathlib import Path
import sys,json,time,hashlib
import numpy as np
from scipy.optimize import minimize
from scipy.sparse import coo_matrix
from mathutils.bvhtree import BVHTree
O=Path(__file__).resolve().parent;sys.path.insert(0,str(O));sys.dont_write_bytecode=True
import scan_boundary as sb
lib=sb.lib;B=sb.B;p0=sb.p0;f=sb.f;a=sb.a;groups=sb.groups;center=p0.mean(0);P0=(p0-center)*1000
args=sys.argv[sys.argv.index('--')+1:] if '--' in sys.argv else []
tag=args[0] if args else 'relax065';sf=float(args[1]) if len(args)>1 else .65;tw=float(args[2]) if len(args)>2 else 2.;seed=args[3] if len(args)>3 else 'boundary-posterior-30mm'
assert not (O/(tag+'-iteration00.npz')).exists(),'Refuse overwriting prior trial'
w=sb.field_weight(sb.centers);active=w>1e-4;ids=np.flatnonzero(active);nv=len(ids);gi=np.full(len(groups),-1,int);gi[ids]=np.arange(nv);vg=np.full(len(p0),-1,int)
for j,g in enumerate(groups):vg[g]=gi[j]
mov=vg>=0;faces=np.any(mov[f],axis=1);gf=f[faces];t=P0[gf];r0=np.cross(t[:,1]-t[:,0],t[:,2]-t[:,0]);area0=np.linalg.norm(r0,axis=1);norm0=r0/area0[:,None];e1=t[:,1]-t[:,0];e2=t[:,2]-t[:,0];l=np.linalg.norm(e1,axis=1);ex=e1/l[:,None];ey=np.cross(norm0,ex);R=np.zeros((len(gf),2,2));R[:,0,0]=l;R[:,0,1]=np.sum(e2*ex,axis=1);R[:,1,1]=np.sum(e2*ey,axis=1);Ri=np.linalg.inv(R)
edges=np.unique(np.sort(np.concatenate([gf[:,[0,1]],gf[:,[1,2]],gf[:,[2,0]]]),axis=1),axis=0);ed0=np.linalg.norm(P0[edges[:,1]]-P0[edges[:,0]],axis=1)
# Translation graph for thin-plate smoothing, including fixed-neighbor rows.
adj=[set() for i in range(nv)];fixeddeg=np.zeros(nv)
for u,v in edges:
 i,j=vg[u],vg[v]
 if i==j:continue
 if i>=0:
  if j>=0:adj[i].add(j)
  else:fixeddeg[i]+=1
 if j>=0:
  if i>=0:adj[j].add(i)
  else:fixeddeg[j]+=1
rr=[];cc=[];vv=[]
for i,ns in enumerate(adj):
 den=max(len(ns)+min(fixeddeg[i],3),1);rr.append(i);cc.append(i);vv.append(1)
 for j in ns:rr.append(i);cc.append(j);vv.append(-1/den)
L=coo_matrix((vv,(rr,cc)),shape=(nv,nv)).tocsr()
target=np.zeros((nv,3));target[:,1]=w[ids]*30
# Restrict desired movement mostly to high-exposure ear-zone support, no invisibility premise.
weights=tw*(.08+.92*w[ids]**4)
seedp=np.load(O/(seed+'.npz'))['points'];x=np.array([(seedp[g[:2]]-p0[g[:2]]).mean(0)*1000 for g in groups])[ids].ravel()
body=lib.body;bp=(body['points']-center)*1000;bf=body['triangles'];bodyraw=np.cross(bp[bf[:,1]]-bp[bf[:,0]],bp[bf[:,2]]-bp[bf[:,0]]);bn=bodyraw/np.maximum(np.linalg.norm(bodyraw,axis=1)[:,None],1e-20);earfaces=np.any(body['protected_ears'][bf],axis=1);non=np.flatnonzero(~earfaces);tree=BVHTree.FromPolygons(body['points'].tolist(),bf[non].tolist(),all_triangles=True,epsilon=0)
# Dense finite samples of moving shell faces and vertices.
sfi=[];sbary=[]
for tri in gf:
 for bary in [(.5,.5,0),(.5,0,.5),(0,.5,.5),(1/3,1/3,1/3)]:sfi.append(tri);sbary.append(bary)
for i in np.flatnonzero(mov):sfi.append([i,i,i]);sbary.append([1,0,0])
sfi=np.array(sfi);sbary=np.array(sbary)
def points(x):
 P=P0.copy();P[mov]+=x.reshape(nv,3)[vg[mov]];return P
def constraints(P):
 ps=(P[sfi]*sbary[:,:,None]).sum(1);near=[tree.find_nearest(tuple(v/1000+center)) for v in ps];ind=non[np.array([a[2] for a in near])];qq=(np.array([a[0] for a in near])-center)*1000;dist=np.array([a[3]*1000 for a in near]);norm=bn[ind];signed=np.sum((ps-qq)*norm,axis=1)
 # Ignore projections at the open ear-exclusion boundary: only finite interior footpoints.
 tri=bp[bf[ind]];e1=tri[:,1]-tri[:,0];e2=tri[:,2]-tri[:,0];delta=qq-tri[:,0];g11=(e1*e1).sum(1);g12=(e1*e2).sum(1);g22=(e2*e2).sum(1);det=g11*g22-g12*g12;d1=(delta*e1).sum(1);d2=(delta*e2).sum(1);u=(g22*d1-g12*d2)/np.maximum(det,1e-20);v=(g11*d2-g12*d1)/np.maximum(det,1e-20);valid=(dist<18)&(u>.0001)&(v>.0001)&(u+v<.9999)
 return sfi[valid],sbary[valid],norm[valid],qq[valid]
def objective(x,con):
 X=x.reshape(nv,3);P=points(x);G=np.zeros_like(P);delta=X-target;loss=float(np.sum(weights[:,None]*delta**2));GX=2*weights[:,None]*delta
 LP=L@X;loss+=.2*np.sum(LP**2);GX+=.4*(L.T@LP)
 tt=P[gf];u=tt[:,1]-tt[:,0];v=tt[:,2]-tt[:,0];F=np.stack([u,v],axis=2)@Ri;U,S,V=np.linalg.svd(F,full_matrices=False);lo=np.minimum(S-sf,0);hi=np.maximum(S-1.5,0);loss+=2e4*np.sum(lo*lo+hi*hi)+2*np.sum((S-1)**2);gF=(U*(4e4*(lo+hi)+4*(S-1))[:,None,:])@V;gE=gF@np.transpose(Ri,(0,2,1));np.add.at(G,gf[:,1],gE[:,:,0]);np.add.at(G,gf[:,2],gE[:,:,1]);np.add.at(G,gf[:,0],-gE.sum(2))
 raw=np.cross(u,v);ar=np.maximum(np.linalg.norm(raw,axis=1),1e-14);nn=raw/ar[:,None];ratio=ar/area0;low=np.minimum(ratio-.6,0);loss+=2e4*np.sum(low*low);da=4e4*low/area0;g1=np.cross(v,nn)*da[:,None];g2=np.cross(nn,u)*da[:,None];np.add.at(G,gf[:,1],g1);np.add.at(G,gf[:,2],g2);np.add.at(G,gf[:,0],-g1-g2)
 cos=np.sum(nn*norm0,axis=1);bad=np.minimum(cos-np.cos(np.deg2rad(75)),0);loss+=1e4*np.sum(bad*bad);gr=2e4*bad[:,None]*(norm0-nn*cos[:,None])/ar[:,None];g1=np.cross(v,gr);g2=np.cross(gr,u);np.add.at(G,gf[:,1],g1);np.add.at(G,gf[:,2],g2);np.add.at(G,gf[:,0],-g1-g2)
 fi,bb,normal,q=con;pp=(P[fi]*bb[:,:,None]).sum(1);gap=np.sum((pp-q)*normal,axis=1)-.3;bad=np.minimum(gap,0);loss+=50*np.sum(bad*bad);cg=100*bad[:,None]*normal
 for k in range(3):np.add.at(G,fi[:,k],cg*bb[:,k,None])
 np.add.at(GX,vg[mov],G[mov]);return loss,GX.ravel()
logs=[]
for it in range(4):
 con=constraints(points(x));start=time.time()
 if it==0:
  _,g=objective(x,con);rng=np.random.default_rng(75);errs=[]
  for j in rng.choice(len(x),12,replace=False):
   xx=x.copy();xx[j]+=1e-5;fp=objective(xx,con)[0];xx[j]-=2e-5;fm=objective(xx,con)[0];num=(fp-fm)/2e-5;errs.append(abs(num-g[j])/max(1,abs(num)))
  print('gradient',max(errs),flush=True);assert max(errs)<1e-3
 bounds=[(-18,18),(-5,35),(-18,18)]*nv
 opt=minimize(lambda xx:objective(xx,con),x,jac=True,method='L-BFGS-B',bounds=bounds,options={'maxiter':900,'ftol':1e-9,'gtol':1e-5,'maxls':40,'maxcor':25});x=opt.x;P=points(x);p=p0.copy();p[mov]=P[mov]/1000+center;name=f'{tag}-iteration{it:02d}';vals={k:a[k] for k in a.files};raw=np.cross(p[f[:,1]]-p[f[:,0]],p[f[:,2]]-p[f[:,0]]);norm=np.zeros_like(p)
 for k in range(3):np.add.at(norm,f[:,k],raw)
 norm/=np.maximum(np.linalg.norm(norm,axis=1)[:,None],1e-24);params={'method':'Local pair-center translations with fixed offsets, thin-plate displacement graph, intrinsic metric and area and normal penalties, finite non-ear skin support planes','stretch_floor_target':sf,'target_weight':tw,'target_posterior_mm':30,'skin_target_mm':.3,'seed':seed,'active_pair_groups':nv,'soft_constraints':True};vals.update(points=p,normals=norm,provenance=np.array(json.dumps(params)));out=O/(name+'.npz');np.savez_compressed(out,**vals);rep,cs,bd,selfp=lib.metrics(p,lib.basepairs);rep.update(tag=name,parameters=params,solver_success=bool(opt.success),solver_message=opt.message,solver_iterations=opt.nit,objective=opt.fun,seconds=time.time()-start,skin_constraints=len(con[0]),sha256=hashlib.sha256(out.read_bytes()).hexdigest());np.savez_compressed(O/(name+'-contacts.npz'),shell_body_pairs=cs,shell_band_pairs=bd,self_pairs=selfp);(O/(name+'-metrics.json')).write_text(json.dumps(rep,indent=2));logs.append(rep);(O/(tag+'-summary.json')).write_text(json.dumps(logs,indent=2));print(json.dumps(rep),flush=True)
