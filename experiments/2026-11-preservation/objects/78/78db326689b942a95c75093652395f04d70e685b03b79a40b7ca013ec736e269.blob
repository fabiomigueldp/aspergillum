def strict_longdouble(p,f,pairs):
 aa=np.asarray(p[f[pairs[:,0]]],np.longdouble);bb=np.asarray(p[f[pairs[:,1]]],np.longdouble);hit=np.zeros(len(pairs),bool)
 for orig,tar in [(aa,bb),(bb,aa)]:
  e1,e2=tar[:,1]-tar[:,0],tar[:,2]-tar[:,0]
  for k in range(3):
   pp=orig[:,k];dr=orig[:,(k+1)%3]-pp;h=np.cross(dr,e2);det=np.einsum('ij,ij->i',e1,h);valid=det!=0;den=np.where(valid,det,1);ss=pp-tar[:,0];u=np.einsum('ij,ij->i',ss,h)/den;q=np.cross(ss,e1);vv=np.einsum('ij,ij->i',dr,q)/den;tt=np.einsum('ij,ij->i',e2,q)/den;hit|=valid&(tt>0)&(tt<1)&(u>0)&(vv>0)&(u+vv<1)
 return pairs[hit]
