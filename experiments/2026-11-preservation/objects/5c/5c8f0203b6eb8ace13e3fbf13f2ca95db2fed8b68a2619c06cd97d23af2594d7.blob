          "value": "Bordada · longa",
          "options": [
            "Sem toalha",
            "Linho · curta",
            "Linho · longa",
            "Bordada · curta",
            "Bordada · longa",
            "Branco e ouro · Cordeiro",
            "Floral IHS",
            "Branco e verde · IHS",
            "Preto e prata · cruzes",
            "Renda floral"
          ]
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "header",
          "key": "altare.menu.frontal",
          "text": "Frente e detalhes"
        },
        {
          "kind": "toggle",
          "key": "altare.menu.ornamental",
          "text": "Imagem de Guadalupe",
          "value": true
        },
        {
          "kind": "dropdown",
          "key": "altare.menu.front",
          "text": "Frente",
          "value": "Norte",
          "options": [
            "Norte",
            "Leste",
            "Sul",
