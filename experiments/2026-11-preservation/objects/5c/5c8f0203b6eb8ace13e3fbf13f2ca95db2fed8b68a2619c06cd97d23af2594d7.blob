          "text": "Estrutura"
        },
        {
          "kind": "dropdown",
          "key": "altare.menu.model",
          "text": "Modelo",
          "value": "Clássico",
          "options": [
            "Clássico",
            "Pilastras",
            "Ogivas",
            "Cavaletes",
            "Arca",
            "Balaústres",
            "Colunata dourada",
            "Cruzeta",
            "Dois pedestais"
          ]
        },
        {
          "kind": "dropdown",
          "key": "altare.menu.surface",
          "text": "Material",
          "value": "Mármore claro",
          "options": [
            "Mármore claro",
            "Calcário quente",
            "Pedra escura"
          ]
        },
        {
          "kind": "spacer"
        },
