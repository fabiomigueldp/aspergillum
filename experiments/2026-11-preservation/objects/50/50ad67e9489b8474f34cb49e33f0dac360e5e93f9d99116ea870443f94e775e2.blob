from pathlib import Path
import numpy as np,json,collections
from scipy.optimize import minimize
O=Path(__file__).resolve().parent
exec((O/'diagnose_lateral.py').read_text().split("h=analyze(")[0])
a=np.load(O/'cone-thickness-0p1.npz');d=np.load(O/'director-cone-midfield.npz');gate=json.loads((O/'cone-thickness-0p1-gate.json').read_text());mp={int(s):i for ids in [d['outer_source_ids'],d['inner_source_ids']] for i,s in enumerate(ids)};cp=d['center'];mf=d['triangles'];mfmap={tuple(sorted(f)):i for i,f in enumerate(mf)};fn=np.cross(cp[mf[:,1]]-cp[mf[:,0]],cp[mf[:,2]]-cp[mf[:,0]]);fn/=np.linalg.norm(fn,axis=1)[:,None]
def distance(A,B):
 def point(T,u):return T[0]+u[0]*(T[1]-T[0])+u[1]*(T[2]-T[0])
 def objective(u):return np.sum((point(A,u[:2])-point(B,u[2:]))**2)
 out=minimize(objective,[1/3]*4,bounds=[(0,1)]*4,constraints=[{'type':'ineq','fun':lambda u:1-u[0]-u[1]},{'type':'ineq','fun':lambda u:1-u[2]-u[3]}],method='SLSQP',options={'ftol':1e-20,'maxiter':1000})
 return {'distance':float(np.sqrt(max(out.fun,0))),'converged':bool(out.success),'closest_points':[point(A,out.x[:2]).tolist(),point(B,out.x[2:]).tolist()]}
res=[];mans=[]
for x in gate['crossings']:
 parts=a['face_parts'][x['triangles']];fs=[classify(ids,p) for ids,p in zip(x['source_indices'],parts)];rec=dict(**x,classification=fs)
 if list(parts)==[1,1]:
  ids=[[mp[int(s)] for s in f] for f in x['source_indices']];ci=[mfmap[tuple(sorted(f))] for f in ids];ang=float(np.degrees(np.arccos(np.clip(np.dot(fn[ci[0]],fn[ci[1]]),-1,1))));rec.update(center_triangle_ids=ci,center_shared_vertices=len(set(ids[0])&set(ids[1])),center_normal_angle_degrees=ang,center_centroid_distance=float(np.linalg.norm(cp[ids[0]].mean(0)-cp[ids[1]].mean(0))),center_triangle_distance=distance(cp[ids[0]],cp[ids[1]]),center_uv=[d['uv'][ids[0]].tolist(),d['uv'][ids[1]].tolist()]);res.append(rec)
 else:mans.append(rec)
summary={'bridge_bridge_pairs':len(res),'wall_pairs':dict(collections.Counter(' x '.join(f['wall'] for f in r['classification']) for r in res)),'physical_shared_vertices':dict(collections.Counter(r['shared_vertices'] for r in res)),'center_shared_vertices':dict(collections.Counter(r['center_shared_vertices'] for r in res)),'center_normal_angles_min_max':[min(r['center_normal_angle_degrees'] for r in res),max(r['center_normal_angle_degrees'] for r in res)],'nonadjacent_center_distances':[r['center_triangle_distance']['distance'] for r in res if r['center_shared_vertices']==0],'mantle_pair_count':len(mans),'mantle_unique_face_count':len(set(r['triangles'][1] for r in mans)),'details':res,'mantle_details':mans}
(O/'residual-0p1-analysis.json').write_text(json.dumps(summary,indent=2));print(json.dumps({k:v for k,v in summary.items() if not k.endswith('details')},indent=2));
for r in res:print(r['triangles'],r['shared_vertices'],r['center_shared_vertices'],r['center_normal_angle_degrees'],r['center_triangle_distance']['distance'],r['classification'])
